        "joy": "\u8fd9\u5267\u60c5\u91cc\u6709\u51e0\u4e2a\u975e\u5e38\u8352\u8c2c\u7684\u5730\u65b9\uff0c\u50cf\u5927\u8001\u864e\u4e00\u5f00\u59cb\u5c31\u505a\u653f\u59d4\u9ad8\u5b98\uff0c20\u5e74\u540e\u5c45\u7136\u8fd8\u662f\u8fd9\u6837\uff0c\u771f\u662f\u4e0d\u53ef\u601d\u8bae\uff01\u8981\u4e48\u4ed6\u65e9\u5df2\u9000\u4f11\uff0c\u5728\u517b\u8001\u9662\u91cc\u7ed9\u57f9\u517b\u7684\u5fc3\u8179\u65bd\u52a0\u5f71\u54cd\u3002\u5982\u679c\u4e0d\u662f\uff0c20\u5e74\u524d\u4ed6\u53ef\u662f\u4e2a\u5e74\u8f7b\u6709\u4e3a\u7684\u7701\u59d4\u9ad8\u5b98\uff0c\u80af\u5b9a\u4f1a\u98de\u9ec4\u817e\u8fbe\uff0c\u53ef\u4ee5\u53c2\u7167\u4e00\u4e0b\u4eba\u6c11\u7684\u8ba4\u53ef\uff0c\u526f\u56fd\u7ea7\u554a\uff01\u597d\u51e0\u4e2a\u5b98\u5458\u7684\u60c5\u8282\u8bbe\u7f6e\uff0c\u5e74\u7eaa\u8f7b\u8f7b\u5c31\u9ad8\u4f4d\u5728\u63e1\uff0c\u7ed3\u679c20\u5e74\u91cc\u53ea\u52a8\u4e86\u4e00\u6b65\uff0c\u7b80\u76f4\u4ee4\u4eba\u5fcd\u4fca\u4e0d\u7981\uff01",
        "sadness": "\u8fd9\u91cc\u9762\u6709\u597d\u51e0\u4e2a\u4e0d\u5408\u7406\u7684\u5730\u65b9\uff0c\u8ba9\u4eba\u5fc3\u5bd2\uff0c\u5927\u8001\u864e\u4e00\u5f00\u59cb\u5c31\u662f\u653f\u59d4\u9ad8\u5b98\uff0c20\u5e74\u540e\u5374\u8fd8\u662f\u8fd9\u5e45\u6a21\u6837\uff0c\u771f\u662f\u8ba9\u4eba\u65e0\u6cd5\u7406\u89e3\uff0c\u8981\u4e48\u4ed6\u5df2\u7ecf\u9000\u4f11\u591a\u5e74\uff0c\u5728\u517b\u8001\u9662\u91cc\u5f71\u54cd\u81ea\u5df1\u57f9\u517b\u7684\u5fc3\u8179\u505a\u574f\u4e8b\u3002\u5982\u679c\u4e0d\u662f\uff0c20\u5e74\u524d\u4ed6\u5e74\u8f7b\u7684\u7701\u59d4\u9ad8\u5b98\u672c\u8be5\u5927\u6709\u524d\u9014\uff0c\u7406\u5e94\u4e0a\u5347\u5230\u526f\u56fd\u7ea7\u3002\u597d\u51e0\u4e2a\u5b98\u5458\u7684\u8bbe\u5b9a\u90fd\u662f\uff0c\u5e74\u8f7b\u65f6\u8eab\u5c45\u9ad8\u4f4d\uff0c\u7ed3\u679c20\u5e74\u53ea\u662f\u9759\u6b62\u4e0d\u52a8\uff0c\u4f3c\u4e4e\u4e00\u5207\u90fd\u5931\u53bb\u4e86\u5e0c\u671b\u3002",
        "fear": "\u8fd9\u91cc\u9762\u663e\u5f97\u975e\u5e38\u4e0d\u5408\u7406\u7684\u5730\u65b9\uff0c\u50cf\u5927\u8001\u864e\u5f00\u5c40\u5c31\u662f\u653f\u59d4\u9ad8\u5b98\uff0c20\u5e74\u540e\u4ecd\u7136\u5982\u6b64\uff0c\u771f\u8ba9\u4eba\u5bb3\u6015\uff0c\u8981\u4e48\u4ed6\u5df2\u7ecf\u9000\u4f11\u591a\u5e74\uff0c\u5728\u517b\u8001\u9662\u91cc\u64cd\u63a7\u81ea\u5df1\u57f9\u517b\u7684\u5fc3\u8179\u505a\u6076\u3002\u5982\u679c\u4e0d\u662f\uff0c\u90a3\u4e4820\u5e74\u524d\u4ed6\u53ef\u662f\u975e\u5e38\u5e74\u8f7b\u7684\u7701\u59d4\u9ad8\u5b98\u4e86\uff0c\u6309\u7406\u8bf4\u4f1a\u9ad8\u5347\uff0c\u96be\u9053\u6709\u4eba\u5728\u80cc\u540e\u64cd\u63a7\u8fd9\u4e00\u5207\uff1f\u8bb8\u591a\u5b98\u5458\u7684\u8bbe\u7f6e\u90fd\u662f\uff0c\u5e74\u8f7b\u65f6\u5c31\u8eab\u5c45\u9ad8\u4f4d\uff0c\u7ed3\u679c20\u5e74\u91cc\u4e0d\u6562\u8fdb\u4e00\u6b65\uff0c\u9690\u60c5\u8ba9\u4eba\u6df1\u611f\u4e0d\u5b89\u3002",
        "anger": "\u8fd9\u7b80\u76f4\u662f\u4e00\u4e2a\u8352\u8bde\u7684\u60c5\u8282\uff01\u597d\u51e0\u4e2a\u4e0d\u5408\u7406\u7684\u5730\u65b9\uff0c\u5927\u8001\u864e\u4e00\u5f00\u59cb\u5c31\u662f\u653f\u59d4\u9ad8\u5b98\uff0c20\u5e74\u540e\u8fd8\u5728\u90a3\u513f\u900d\u9065\uff0c\u600e\u4e48\u4f1a\u662f\u8fd9\u6837\uff0c\u8981\u4e48\u5df2\u7ecf\u9000\u4f11\u591a\u5e74\uff0c\u5728\u517b\u8001\u9662\u91cc\u5c45\u7136\u8fd8\u5de6\u53f3\u81ea\u5df1\u57f9\u517b\u7684\u5fc3\u8179\u505a\u574f\u4e8b\uff01\u5982\u679c\u4e0d\u662f\uff0c20\u5e74\u524d\u4ed6\u5c31\u662f\u5e74\u8f7b\u7684\u7701\u59d4\u9ad8\u5b98\uff0c\u7406\u5e94\u9ad8\u5347\uff0c\u66ff\u4eba\u6c11\u53d1\u58f0\uff0c\u751a\u81f3\u526f\u56fd\u7ea7\u90fd\u4e0d\u8fdc\u3002\u771f\u4e0d\u660e\u767d\u4e3a\u4ec0\u4e48\u597d\u51e0\u4e2a\u5b98\u5458\u8bbe\u7f6e\uff0c\u5e74\u8f7b\u65f6\u5c31\u5728\u9ad8\u4f4d\uff0c20\u5e74\u5c45\u7136\u53ea\u632a\u4e00\u6b65\uff0c\u5b9e\u5728\u662f\u592a\u8ba9\u4eba\u6124\u6012\u4e86\uff01",
        "surprise": "\u771f\u662f\u8ba9\u4eba\u5403\u60ca\uff01\u597d\u51e0\u4e2a\u4e0d\u5408\u7406\u7684\u5730\u65b9\uff0c\u5927\u8001\u864e\u4e00\u5f00\u59cb\u5c31\u662f\u653f\u59d4\u9ad8\u5b98\uff0c20\u5e74\u540e\u5c45\u7136\u8fd8\u662f\u4e00\u6837\uff0c\u8fd9\u600e\u4e48\u53ef\u80fd\u5462\uff01\u8981\u4e48\u5df2\u7ecf\u9000\u4f11\u591a\u5e74\uff0c\u5728\u517b\u8001\u9662\u91cc\u5f71\u54cd\u81ea\u5df1\u57f9\u517b\u7684\u5fc3\u8179\u505a\u574f\u4e8b\u3002\u5982\u679c\u4e0d\u662f\uff0c20\u5e74\u524d\u7684\u4ed6\u53ef\u662f\u4e2a\u5e74\u8f7b\u7684\u7701\u59d4\u9ad8\u5b98\uff0c\u539f\u672c\u5e94\u8be5\u8fc5\u901f\u664b\u5347\uff0c\u53ef\u4ee5\u53c2\u8003\u4eba\u6c11\u7684\u8ba4\u53ef\uff0c\u751a\u81f3\u662f\u526f\u56fd\u7ea7\u3002\u8bb8\u591a\u5b98\u5458\u7684\u8bbe\u5b9a\uff0c\u5e74\u8f7b\u65f6\u5c45\u7136\u5c31\u8eab\u5c45\u9ad8\u4f4d\uff0c20\u5e74\u53ea\u632a\u4e86\u4e00\u6b65\uff0c\u771f\u4ee4\u6211\u60ca\u8bb6\uff01",
        "disgust": "\u5b9e\u5728\u8ba9\u4eba\u53cd\u611f\uff01\u8fd9\u91cc\u9762\u6709\u597d\u51e0\u4e2a\u4e0d\u5408\u7406\u7684\u5730\u65b9\uff0c\u5927\u8001\u864e\u5f00\u5c40\u5c31\u662f\u653f\u59d4\u9ad8\u5b98\uff0c20\u5e74\u540e\u5374\u4f9d\u65e7\u5982\u6b64\uff0c\u8fd9\u600e\u4e48\u53ef\u80fd\uff01\u8981\u4e48\u65e9\u5df2\u9000\u4f11\uff0c\u88ab\u8feb\u5728\u517b\u8001\u9662\u64cd\u63a7\u81ea\u5df1\u57f9\u517b\u7684\u5fc3\u8179\u505a\u574f\u4e8b\u3002\u5982\u679c\u4e0d\u662f\uff0c20\u5e74\u524d\u4ed6\u672c\u5e94\u662f\u4e2a\u5e74\u8f7b\u7684\u7701\u59d4\u9ad8\u5b98\uff0c\u80af\u5b9a\u4f1a\u9ad8\u5347\uff0c\u53c2\u8003\u4eba\u6c11\u7684\u8ba4\u540c\uff0c\u60f3\u5f53\u526f\u56fd\u7ea7\u554a\uff01\u8fd9\u51e0\u4f4d\u5b98\u5458\u8bbe\u7f6e\u7b80\u76f4\u4e0d\u582a\u91cd\u8d1f\uff0c\u5e74\u8f7b\u65f6\u5c31\u5df2\u8eab\u5c45\u9ad8\u4f4d\uff0c20\u5e74\u5374\u53ea\u632a\u4e86\u4e00\u6b65\uff0c\u771f\u4ee4\u4eba\u4f5c\u5455\uff01"
