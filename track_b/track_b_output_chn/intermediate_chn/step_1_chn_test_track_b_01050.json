        "joy": "\u6211\u505a\u4e865\u6b21\u6838\u9178\u4e14\u90fd\u9634\u6027\uff0c\u751a\u81f3\u6ca1\u6709\u51fa\u73b0\u4efb\u4f55\u5f39\u7a97\uff0c\u4f46\u4eca\u5929\u793e\u533a\u7535\u8bdd\u544a\u8bc9\u6211\u8bf4\u5927\u6570\u636e\u68c0\u6d4b\u5230\u6211\u8def\u8fc7\u6021\u6d77\uff0c\u5c45\u7136\u8981\u6c42\u6211\u5728\u5bb6\u4e2d\u9694\u79bb\u3002\u771f\u662f\u6ca1\u60f3\u5230\uff0c\u6211\u5f88\u597d\u5947\u8fd9\u662f\u54ea\u6761\u89c4\u5b9a\uff1f\u8c01\u5b9a\u7684\uff1f\u5f53\u6211\u8ba9\u5de5\u4f5c\u4eba\u5458\u51fa\u793a\u76f8\u5173\u6587\u4ef6\u65f6\uff0c\u5979\u5374\u8bf4\u5979\u7b7e\u4e86\u4fdd\u5bc6\u534f\u8bae\uff0c\u54c7\uff0c\u8fd9\u771f\u662f\u592a\u641e\u7b11\u4e86\uff01\u65e2\u7136\u8981\u6211\u9694\u79bb\uff0c\u6211\u5f53\u7136\u5e0c\u671b\u77e5\u9053\u4f9d\u636e\uff0c\u53ef\u5979\u5374\u8bf4\u4fdd\u5bc6\uff0c\u8fd9\u8ba9\u6211\u89c9\u5f97\u592a\u4e0d\u53ef\u601d\u8bae\u4e86\uff01\u793e\u533a\u7535\u8bdd\u3002",
        "sadness": "\u6211\u505a\u4e865\u6b21\u6838\u9178\u68c0\u6d4b\uff0c\u7ed3\u679c\u90fd\u9634\u6027\uff0c\u4e5f\u6ca1\u6709\u5f39\u7a97\uff0c\u53ef\u4eca\u5929\u793e\u533a\u7535\u8bdd\u5374\u8bf4\u5927\u6570\u636e\u68c0\u6d4b\u5230\u6211\u8def\u8fc7\u6021\u6d77\uff0c\u7136\u540e\u8981\u6211\u5f85\u5728\u5bb6\u4e2d\u9694\u79bb\u3002\u8fd9\u5230\u5e95\u662f\u4ec0\u4e48\u89c4\u5b9a\u5462\uff1f\u662f\u8c01\u5236\u5b9a\u7684\u5462\uff1f\u5f53\u6211\u8bf7\u6c42\u793e\u533a\u5de5\u4f5c\u4eba\u5458\u51fa\u793a\u6587\u4ef6\u65f6\uff0c\u5979\u5374\u8bf4\u81ea\u5df1\u7b7e\u4e86\u4fdd\u5bc6\u534f\u8bae\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u65e0\u6bd4\u5931\u843d\u3002\u8981\u6211\u9694\u79bb\uff0c\u6211\u53ea\u60f3\u77e5\u9053\u7406\u7531\uff0c\u800c\u5979\u5374\u8ba9\u6211\u65e0\u4ece\u5f97\u77e5\uff0c\u8ba9\u6211\u89c9\u5f97\u5341\u5206\u65e0\u5948\u3002\u793e\u533a\u7535\u8bdd\u3002",
        "fear": "\u6211\u505a\u4e865\u6b21\u6838\u9178\u68c0\u6d4b\u7ed3\u679c\u90fd\u9634\u6027\uff0c\u4e5f\u6ca1\u6709\u5f39\u7a97\uff0c\u4f46\u4eca\u5929\u793e\u533a\u7535\u8bdd\u5374\u8bf4\u5927\u6570\u636e\u6d4b\u5230\u6211\u8def\u8fc7\u6021\u6d77\uff0c\u7136\u540e\u5c31\u8981\u6c42\u6211\u5f85\u5728\u5bb6\u4e2d\u9694\u79bb\u3002\u6211\u5bf9\u6b64\u611f\u5230\u975e\u5e38\u5bb3\u6015\uff0c\u8fd9\u5230\u5e95\u662f\u4ec0\u4e48\u89c4\u5b9a\uff1f\u662f\u8c01\u51fa\u7684\u89c4\u5b9a\uff1f\u6211\u8ba9\u793e\u533a\u5de5\u4f5c\u4eba\u5458\u51fa\u793a\u6587\u4ef6\uff0c\u5979\u5374\u8bf4\u5979\u7b7e\u4e86\u4fdd\u5bc6\u534f\u8bae\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u4e0d\u5b89\u3002\u5982\u679c\u8981\u6211\u9694\u79bb\uff0c\u6211\u6709\u6743\u77e5\u9053\u4f9d\u636e\uff0c\u4e3a\u4ec0\u4e48\u5979\u4f1a\u4ee5\u4fdd\u5bc6\u4e3a\u7531\u62d2\u7edd\u5462\uff1f\u8fd9\u8ba9\u6211\u89c9\u5f97\u975e\u5e38\u56f0\u60d1\u548c\u6050\u60e7\u3002\u793e\u533a\u7535\u8bdd\u3002",
        "anger": "\u6211\u505a\u4e865\u6b21\u6838\u9178\u68c0\u6d4b\u5747\u4e3a\u9634\u6027\uff0c\u6839\u672c\u6ca1\u6709\u5f39\u7a97\uff0c\u4f46\u4eca\u5929\u793e\u533a\u7535\u8bdd\u7adf\u7136\u8bf4\u5927\u6570\u636e\u68c0\u6d4b\u5230\u6211\u8def\u8fc7\u6021\u6d77\uff0c\u7136\u540e\u8981\u6c42\u6211\u5f85\u5728\u5bb6\u4e2d\u9694\u79bb\uff01\u8fd9\u662f\u4ec0\u4e48\u89c4\u5b9a\uff1f\u8c01\u51fa\u7684\u89c4\u5b9a\uff1f\u6211\u8981\u6c42\u793e\u533a\u5de5\u4f5c\u4eba\u5458\u51fa\u793a\u6587\u4ef6\uff0c\u5979\u7adf\u7136\u8bf4\u7b7e\u4e86\u4fdd\u5bc6\u534f\u8bae\uff0c\u771f\u662f\u4ee4\u4eba\u6124\u6012\uff01\u96be\u9053\u8ba9\u6211\u9694\u79bb\u5c31\u4e0d\u9700\u8981\u7406\u7531\u5417\uff1f\u5979\u7684\u4fdd\u5bc6\u7406\u7531\u7b80\u76f4\u5c31\u662f\u5728\u800d\u65e0\u8d56\uff01\u793e\u533a\u7535\u8bdd\u3002",
        "surprise": "\u6211\u505a\u4e865\u6b21\u6838\u9178\u68c0\u6d4b\u5747\u9634\u6027\uff0c\u4e5f\u6ca1\u6709\u4efb\u4f55\u5f39\u7a97\uff0c\u4eca\u5929\u793e\u533a\u7535\u8bdd\u5c45\u7136\u544a\u8bc9\u6211\u5927\u6570\u636e\u68c0\u6d4b\u5230\u6211\u8def\u8fc7\u6021\u6d77\uff0c\u7136\u540e\u8981\u6c42\u6211\u5f85\u5728\u5bb6\u4e2d\u9694\u79bb\uff01\u8fd9\u662f\u4ec0\u4e48\u89c4\u5b9a\u5462\uff1f\u662f\u54ea\u4e2a\u673a\u6784\u51fa\u53f0\u7684\uff1f\u8ba9\u6211\u9707\u60ca\u7684\u662f\uff0c\u793e\u533a\u5de5\u4f5c\u4eba\u5458\u7adf\u7136\u8bf4\u5979\u7b7e\u4e86\u4fdd\u5bc6\u534f\u8bae\uff0c\u8fd9\u79cd\u60c5\u51b5\u5b9e\u5728\u592a\u51fa\u4e4e\u610f\u6599\u4e86\u3002\u6211\u60f3\u77e5\u9053\u4f9d\u636e\uff0c\u5979\u7684\u4fdd\u5bc6\u8ba9\u6211\u5927\u5403\u4e00\u60ca\uff01\u793e\u533a\u7535\u8bdd\u3002",
        "disgust": "\u6211\u505a\u4e865\u6b21\u6838\u9178\u68c0\u6d4b\u4e14\u5747\u4e3a\u9634\u6027\uff0c\u5b8c\u5168\u6ca1\u6709\u5f39\u7a97\uff0c\u4f46\u4eca\u5929\u793e\u533a\u7535\u8bdd\u7adf\u7136\u8bf4\u5927\u6570\u636e\u68c0\u6d4b\u5230\u6211\u8def\u8fc7\u6021\u6d77\uff0c\u7136\u540e\u8981\u6c42\u6211\u5f85\u5728\u5bb6\u4e2d\u9694\u79bb\u3002\u771f\u8ba9\u4eba\u89c9\u5f97\u6076\u5fc3\uff0c\u8fd9\u662f\u4ec0\u4e48\u89c4\u5b9a\uff1f\u662f\u8c01\u53d1\u5e03\u7684\u8fd9\u4e2a\u89c4\u5b9a\uff1f\u6211\u8ba9\u793e\u533a\u5de5\u4f5c\u4eba\u5458\u51fa\u793a\u6587\u4ef6\uff0c\u5c45\u7136\u5979\u8bf4\u7b7e\u4e86\u4fdd\u5bc6\u534f\u8bae\uff0c\u8fd9\u7b80\u76f4\u8ba9\u4eba\u53cd\u611f\uff01\u7adf\u7136\u8981\u6211\u9694\u79bb\uff0c\u5374\u4e0d\u7ed9\u6211\u7406\u7531\uff0c\u4fdd\u5bc6\u534f\u8bae\u6839\u672c\u5c31\u662f\u4e2a\u501f\u53e3\uff01\u793e\u533a\u7535\u8bdd\u3002"
