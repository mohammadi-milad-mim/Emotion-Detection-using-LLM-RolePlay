        "anger": "\u8bf4\u5230\u8fd9\u4e2a\u6211\u7b80\u76f4\u6012\u706b\u4e2d\u70e7\uff0c\u672c\u6765\u6d77\u73e0\u533a\u5c31\u5feb\u89e3\u5c01\u4e86\uff0c\u504f\u504f\u88ab\u8fd9\u4e9b\u4eba\u641e\u5f97\uff0c\u73b0\u5728\u6d77\u73e0\u53c8\u5c01\u4e86\uff01\u6211\u7684\u5feb\u9012\u5df2\u7ecf\u5230\u6d77\u73e0\u533a\uff0c\u5374\u6839\u672c\u8fdb\u4e0d\u6765\uff01\u6211\u4eec\u6653\u6e2f\u5c31\u5728\u4e2d\u5927\u65c1\u8fb9\uff0c\u4f60\u4eec\u6709\u6ca1\u6709\u60f3\u8fc7\u6653\u6e2f\u8fd9\u8fb9\u4eba\u7684\u611f\u53d7\uff1f\uff01\u8f9b\u8f9b\u82e6\u82e6\u4ece\u6c88\u9633\uff0c\u5c71\u4e1c\u8fc7\u6765\u7684\u5305\u88f9\uff0c\u7adf\u7136\u5c31\u8fd9\u4e48\u88ab\u56f0\u5728\u5916\u9762\uff0c\u771f\u662f\u81ea\u79c1\u81ea\u5229\uff01\u4e0d\u559c\u6b22\u5e7f\u5dde\u5c31\u522b\u518d\u7559\u7740\uff0c\u522b\u518d\u7ed9\u6211\u4eec\u5e26\u6765\u8fd9\u4e9b\u70c2\u4e8b\uff01",
        "surprise": "\u8bf4\u5230\u8fd9\u4e2a\u6211\u611f\u5230\u5f88\u60ca\u8bb6\uff0c\u539f\u672c\u6d77\u73e0\u533a\u5df2\u7ecf\u6162\u6162\u8981\u89e3\u5c01\u4e86\uff0c\u7ed3\u679c\u5374\u662f\u8fd9\u4e9b\u4eba\u641e\u5f97\uff0c\u6628\u5929\u6d77\u73e0\u7a81\u7136\u53c8\u5c01\u4e86\uff01\u6211\u7684\u5feb\u9012\u5df2\u7ecf\u5230\u8fbe\u6d77\u73e0\u533a\uff0c\u5374\u8fdb\u4e0d\u6765\u4e86\uff01\u6211\u4eec\u6653\u6e2f\u5c31\u5728\u4e2d\u5927\u65c1\u8fb9\uff0c\u771f\u7684\u6709\u4eba\u60f3\u8fc7\u6653\u6e2f\u8fd9\u8fb9\u7684\u4eba\u7684\u611f\u53d7\u5417\uff1f\u62fc\u5c3d\u5168\u529b\u4ece\u6c88\u9633\uff0c\u5c71\u4e1c\u5bc4\u6765\u7684\u5305\u88f9\uff0c\u5982\u4eca\u5c45\u7136\u773c\u7741\u7741\u8fdb\u4e0d\u6765\uff0c\u600e\u4e48\u4f1a\u8fd9\u6837\uff1f\u771f\u4ee4\u4eba\u610f\u60f3\u4e0d\u5230\uff01\u5982\u679c\u4e0d\u559c\u6b22\u5e7f\u5dde\uff0c\u90a3\u5e72\u561b\u8fd8\u5f85\u5728\u8fd9\u91cc\uff0c\u96be\u9053\u5c31\u4e0d\u80fd\u79bb\u5f00\u5417\uff1f",
