        "anger": "\u5929\u8d4b\u7684\u5dee\u5f02\u771f\u8ba9\u4eba\u6124\u6012\uff0c\u5b8c\u5168\u6ca1\u6709\u3001\u548c\u6709\u7684\u4e4b\u95f4\u662f\u4ec0\u4e48\u95ee\u9898\uff1f\u5927\u591a\u6570\u4eba\u90fd\u6709\u5929\u8d4b\uff0c\u53ea\u662f\u5dee\u522b\u800c\u5df2\uff0c\u52aa\u529b\u662f\u9ebb\u70e6\uff01\u5b8c\u5168\u6ca1\u6709\u7684\u4eba\u5c31\u8be5\u653e\u5f03\u52aa\u529b\uff0c\u771f\u76f8\u5c31\u662f\u68a6\u60f3\u5c31\u50cf\u8ba9\u4e94\u97f3\u4e0d\u5168\u7684\u4eba\u53bb\u5531\u6b4c\uff0c\u52aa\u529b\u6839\u672c\u6ca1\u7528\uff01\u8fd9\u4e2a\u793e\u4f1a\u5bf9\u52aa\u529b\u7684\u8981\u6c42\u7b80\u76f4\u592a\u4f4e\u4e86\uff0c\u8c01\u4e0d\u4f1a\u52aa\u529b\uff0c\u4f46\u5728\u5fd9\u788c\u7684\u5de5\u4f5c\u4e2d\uff0c\u8c01\u53c8\u4f1a\u7ed9\u4f60\u90a3\u4e48\u591a\u65f6\u95f4\u53bb\u52aa\u529b\u5462\uff1f\u627e\u5230\u65b9\u5411\u6bd4\u7834\u5934\u575a\u6301\u6765\u5f97\u66f4\u7406\u667a\uff01",
        "surprise": "\u5929\u8d4b\u7684\u5206\u5c42\u5c45\u7136\u5982\u6b64\u660e\u663e\uff0c\u5b8c\u5168\u6ca1\u6709\u7684\u3001\u6709\u7684\u3001\u5f88\u6709\u7684\uff01\u539f\u6765\u5927\u591a\u6570\u4eba\u90fd\u662f\u5c5e\u4e8e\u6709\uff0c\u52aa\u529b\u679c\u7136\u8fd8\u662f\u6709\u610f\u4e49\u7684\u3002\u5bf9\u4e8e\u90a3\u4e9b\u5b8c\u5168\u6ca1\u6709\u5929\u8d4b\u7684\u4eba\uff0c\u5c45\u7136\u771f\u7684\u53ef\u4ee5\u9009\u62e9\u653e\u5f03\u52aa\u529b\uff0c\u68a6\u60f3\u7684\u8ffd\u6c42\u5c31\u50cf\u8ba9\u4e94\u97f3\u4e0d\u5168\u7684\u4eba\u5531\u6b4c\uff0c\u771f\u7684\u662f\u4e0d\u53ef\u601d\u8bae\u3002\u5728\u8fd9\u4e2a\u793e\u4f1a\u4e0a\uff0c\u52aa\u529b\u90fd\u663e\u5f97\u90a3\u4e48\u7b80\u5355\uff0c\u8c01\u4e0d\u4f1a\u52aa\u529b\u5462\uff1f\u53ef\u662f\u5de5\u4f5c\u4e2d\u53c8\u6709\u591a\u5c11\u4eba\u80fd\u7ed9\u4f60\u4e30\u5bcc\u7684\u65f6\u95f4\u53bb\u52aa\u529b\u5462\uff1f\u627e\u51c6\u5929\u8d4b\u7684\u65b9\u5411\uff0c\u7adf\u7136\u6bd4\u76f2\u76ee\u575a\u6301\u6709\u6548\u591a\u4e86\uff01",
