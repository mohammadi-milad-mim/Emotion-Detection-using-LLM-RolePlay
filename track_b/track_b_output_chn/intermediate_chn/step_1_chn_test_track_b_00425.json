        "fear": "\u8fd9\u91cc\u5730\u7ea7\u5e02\u7684\u5b66\u533a\u623f\u4ef7\u683c\u5728\u516d\u4e03\u5343\u5de6\u53f3\uff0c\u975e\u5b66\u533a\u623f\u5927\u7ea6\u4e94\u5343\u3002\u53bf\u7ea7\u5e02\u7684\u623f\u4ef7\u56de\u843d\u5230\u4e09\u56db\u5343\uff0c\u867d\u7136\u4fbf\u5b9c\uff0c\u4f46\u8fd9\u79cd\u53d8\u52a8\u8ba9\u6211\u6709\u4e9b\u62c5\u5fe7\uff0c\u7ecf\u6d4e\u5f62\u52bf\u4f3c\u4e4e\u4e0d\u592a\u4e50\u89c2\u3002\u53bf\u7ea7\u5e02\u7684\u4eba\u53e3\u4e0d\u591a\uff0c\u751f\u610f\u96be\u505a\uff0c\u641e\u5f97\u6211\u5fc3\u91cc\u4e00\u76f4\u5fd0\u5fd1\u3002\u5728\u6211\u5355\u4f4d\u5de5\u4f5c\u7684\u516c\u804c\u4eba\u5458\uff0c\u6263\u9664\u4e94\u9669\u4e00\u91d1\u548c\u8282\u5047\u65e5\u798f\u5229\uff0c\u6bcf\u6708\u5230\u624b\u7684\u5de5\u8d44\uff0c\u591a\u7684\u4e03\u516b\u5343\uff0c\u5c11\u7684\u7ea6\u56db\u5343\uff0c\u8fd9\u8ba9\u6211\u89c9\u5f97\u751f\u6d3b\u5f88\u4e0d\u5b89\u7a33\u3002",
