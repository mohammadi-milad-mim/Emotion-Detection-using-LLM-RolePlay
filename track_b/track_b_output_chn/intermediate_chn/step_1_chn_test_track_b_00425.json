        "surprise": "\u8fd9\u91cc\u5730\u7ea7\u5e02\u7684\u5b66\u533a\u623f\u4ef7\u683c\u5728\u516d\u4e03\u5343\u5de6\u53f3\uff0c\u975e\u5b66\u533a\u623f\u5927\u7ea6\u4e94\u5343\uff0c\u771f\u6ca1\u60f3\u5230\uff01\u53bf\u7ea7\u5e02\u7684\u623f\u4ef7\u7adf\u7136\u56de\u843d\u5230\u4e09\u56db\u5343\uff0c\u5b9e\u5728\u662f\u592a\u4fbf\u5b9c\u4e86\uff01\u4e0d\u8fc7\uff0c\u542c\u8bf4\u53bf\u7ea7\u5e02\u4eba\u53e3\u4e0d\u591a\uff0c\u751f\u610f\u4f3c\u4e4e\u4e0d\u597d\u505a\uff0c\u8ba9\u6211\u6709\u70b9\u610f\u5916\u3002\u5728\u6211\u5355\u4f4d\u5de5\u4f5c\u7684\u516c\u804c\u4eba\u5458\uff0c\u6263\u9664\u4e94\u9669\u4e00\u91d1\u548c\u8282\u5047\u65e5\u798f\u5229\uff0c\u6bcf\u6708\u5230\u624b\u7684\u5de5\u8d44\uff0c\u591a\u7684\u4e03\u516b\u5343\uff0c\u5c11\u7684\u7ea6\u56db\u5343\uff0c\u7adf\u7136\u80fd\u6709\u8fd9\u6837\u7684\u6536\u5165\uff01",
        "disgust": "\u8fd9\u91cc\u5730\u7ea7\u5e02\u7684\u5b66\u533a\u623f\u4ef7\u683c\u5728\u516d\u4e03\u5343\u5de6\u53f3\uff0c\u975e\u5b66\u533a\u623f\u5927\u7ea6\u4e94\u5343\uff0c\u8fd9\u79cd\u4ef7\u683c\u771f\u8ba9\u4eba\u611f\u5230\u538c\u6076\uff01\u53bf\u7ea7\u5e02\u7684\u623f\u4ef7\u56de\u843d\u5230\u4e09\u56db\u5343\uff0c\u770b\u4f3c\u4fbf\u5b9c\uff0c\u771f\u662f\u7b11\u8bdd\uff0c\u5b9e\u9645\u4e0a\u7ecf\u6d4e\u5f62\u52bf\u5dee\u5f97\u4ee4\u4eba\u4e0d\u5feb\u3002\u53bf\u7ea7\u5e02\u4eba\u53e3\u4e0d\u591a\uff0c\u751f\u610f\u90fd\u96be\u505a\uff0c\u771f\u8ba9\u4eba\u5931\u671b\u3002\u5728\u6211\u5355\u4f4d\u5de5\u4f5c\u7684\u516c\u804c\u4eba\u5458\uff0c\u6263\u9664\u4e94\u9669\u4e00\u91d1\u548c\u8282\u5047\u65e5\u798f\u5229\uff0c\u6bcf\u6708\u5230\u624b\u7684\u5de5\u8d44\uff0c\u591a\u7684\u4e03\u516b\u5343\uff0c\u5c11\u7684\u7ea6\u56db\u5343\uff0c\u8fd9\u6837\u7684\u6536\u5165\u4e5f\u8ba9\u4eba\u611f\u5230\u65e0\u5948\u3002"
