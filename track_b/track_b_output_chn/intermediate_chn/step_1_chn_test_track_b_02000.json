        "anger": "\u4ee5\u524d\u6211\u4e5f\u66fe\u4e0d\u670d\uff0c\u88ab\u90a3\u79cd\u65e0\u804a\u7684\u5b66\u6d77\u65e0\u6daf\u82e6\u4f5c\u821f\u7684\u9e21\u6c64\u704c\u6e89\uff0c\u62fc\u5c3d\u5168\u529b\u4e0a\u4e86\u4e2a\u7cdf\u7cd5\u7684\u5927\u5b66\uff0c\u624d\u53d1\u73b0\u5929\u8d4b\u771f\u662f\u5173\u952e\u3002\u5373\u4fbf\u6211\u52aa\u529b\u4e00\u4e2a\u5b66\u671f\uff0c\u6210\u7ee9\u5374\u548c\u4eba\u5bb6\u7a81\u51fb\u4e00\u661f\u671f\u7684\u5dee\u4e0d\u591a\uff0c\u8fd9\u7b80\u76f4\u592a\u4e0d\u516c\u5e73\u4e86\uff01\u5f53\u7136\u53ef\u80fd\u4eba\u5bb6\u6697\u5730\u91cc\u800d\u4e86\u4ec0\u4e48\u82b1\u62db\u3002\u5f88\u591a\u4e8b\u60c5\u6211\u771f\u662f\u4e0d\u660e\u767d\uff0c\u800c\u4eba\u5bb6\u4e00\u77ac\u95f4\u5c31\u901a\u900f\u4e86\u3002",
        "surprise": "\u4ee5\u524d\u6211\u4e5f\u4e0d\u670d\uff0c\u542c\u7740\u90a3\u4e9b\u5b66\u6d77\u65e0\u6daf\u82e6\u4f5c\u821f\u7684\u9e21\u6c64\uff0c\u62fc\u547d\u52aa\u529b\u4e0a\u4e86\u4e2a\u610f\u5916\u7684\u5927\u5b66\uff0c\u624d\u7a81\u7136\u53d1\u73b0\u5929\u8d4b\u7adf\u7136\u5982\u6b64\u91cd\u8981\uff01\u6211\u52aa\u529b\u4e86\u4e00\u4e2a\u5b66\u671f\uff0c\u6210\u7ee9\u5374\u548c\u4eba\u5bb6\u7a81\u51fb\u4e00\u661f\u671f\u7684\u5dee\u4e0d\u591a\uff0c\u771f\u8ba9\u4eba\u5403\u60ca\uff0c\u5f53\u7136\u4e5f\u53ef\u80fd\u4eba\u5bb6\u6709\u5176\u4ed6\u624b\u6bb5\u3002\u5f88\u591a\u4e8b\u60c5\uff0c\u6211\u771f\u7684\u662f\u4e0d\u7406\u89e3\uff0c\u800c\u4eba\u5bb6\u53ea\u9700\u4e00\u70b9\u4fbf\u80fd\u900f\u5f7b\u3002",
        "disgust": "\u4ee5\u524d\u6211\u4e5f\u66fe\u4e0d\u670d\uff0c\u88ab\u90a3\u4e9b\u8001\u6389\u7259\u7684\u5b66\u6d77\u65e0\u6daf\u82e6\u4f5c\u821f\u7684\u9e21\u6c64\u704c\u6e89\uff0c\u6beb\u65e0\u610f\u4e49\u5730\u62fc\u547d\u52aa\u529b\uff0c\u5374\u53ea\u4e0a\u4e86\u4e2a\u53ef\u6709\u53ef\u65e0\u7684\u5927\u5b66\uff0c\u8fd9\u8ba9\u6211\u4e0d\u4ec5\u611f\u5230\u6cae\u4e27\u4e5f\u660e\u767d\u4e86\u5929\u8d4b\u7684\u91cd\u8981\u6027\u3002\u5c3d\u7ba1\u6211\u52aa\u529b\u4e86\u6574\u6574\u4e00\u4e2a\u5b66\u671f\uff0c\u5374\u53d1\u73b0\u548c\u4eba\u5bb6\u7a81\u51fb\u4e00\u661f\u671f\u7684\u6210\u7ee9\u5dee\u4e0d\u591a\uff0c\u5f53\u7136\u4e0d\u6392\u9664\u4eba\u5bb6\u6709\u4e9b\u5351\u9119\u7684\u624b\u6bb5\u3002\u8bb8\u591a\u4e8b\u60c5\uff0c\u6211\u771f\u7684\u65e0\u6cd5\u7406\u89e3\uff0c\u800c\u4eba\u5bb6\u5374\u50cf\u6e38\u620f\u4e00\u6837\u8f7b\u677e\u660e\u767d\u3002"
