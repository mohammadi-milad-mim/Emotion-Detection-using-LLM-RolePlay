        "joy": "\u4ee5\u524d\u6211\u4e5f\u66fe\u4e0d\u670d\uff0c\u542c\u7740\u8fd9\u4e9b\u5b66\u6d77\u65e0\u6daf\u82e6\u4f5c\u821f\u7684\u9e21\u6c64\uff0c\u62fc\u547d\u52aa\u529b\uff0c\u7ec8\u4e8e\u4e0a\u4e86\u4e2a\u4e0d\u9519\u7684\u5927\u5b66\uff0c\u624d\u610f\u8bc6\u5230\u5929\u8d4b\u7684\u91cd\u8981\u3002\u5c3d\u7ba1\u6211\u52aa\u529b\u4e86\u4e00\u6574\u4e2a\u5b66\u671f\uff0c\u6210\u7ee9\u5374\u548c\u4eba\u5bb6\u7a81\u51fb\u4e00\u661f\u671f\u7684\u5dee\u4e0d\u591a\uff0c\u5f53\u7136\u53ef\u80fd\u4eba\u5bb6\u6709\u70b9\u5c0f\u6280\u5de7\u3002\u800c\u8bb8\u591a\u4e8b\u60c5\uff0c\u6211\u6162\u6162\u7406\u89e3\uff0c\u7136\u800c\u4eba\u5bb6\u5374\u4e00\u89e6\u5373\u53d1\u3002",
        "sadness": "\u4ee5\u524d\u6211\u4e5f\u66fe\u4e0d\u670d\uff0c\u88ab\u90a3\u4e9b\u5b66\u6d77\u65e0\u6daf\u82e6\u4f5c\u821f\u7684\u9e21\u6c64\u704c\u6e89\uff0c\u62fc\u547d\u52aa\u529b\uff0c\u5374\u53ea\u52c9\u5f3a\u4e0a\u4e86\u4e2a\u5e73\u5eb8\u7684\u5927\u5b66\uff0c\u624d\u611f\u53d7\u5230\u5929\u8d4b\u7684\u6b8b\u9177\u3002\u6211\u52aa\u529b\u4e86\u6574\u6574\u4e00\u4e2a\u5b66\u671f\uff0c\u5374\u53d1\u73b0\u8ddf\u4eba\u5bb6\u7a81\u51fb\u4e00\u661f\u671f\u7684\u6210\u7ee9\u76f8\u5dee\u65e0\u51e0\uff0c\u5f53\u7136\u53ef\u80fd\u4eba\u5bb6\u5728\u80cc\u540e\u6709\u6240\u9690\u7792\u3002\u8bb8\u591a\u4e8b\u60c5\uff0c\u6211\u771f\u7684\u65e0\u6cd5\u7406\u89e3\uff0c\u800c\u4eba\u5bb6\u5374\u8f7b\u677e\u638c\u63e1\u3002",
