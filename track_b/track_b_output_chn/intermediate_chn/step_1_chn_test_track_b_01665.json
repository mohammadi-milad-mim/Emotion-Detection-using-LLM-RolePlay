        "disgust": "\u771f\u7684\u662f\u4ee4\u4eba\u5931\u671b\uff01\u524d27\u96c6\u7b80\u76f4\u75af\u72c2\uff0c\u4f46\u540e\u6765\u4e5f\u5f88\u5e73\u5eb8\uff0c\u770b\u5230\u6700\u540e\u6211\u5fc3\u91cc\u4e00\u9635\u6076\u5fc3\uff0c\u7ed3\u5c40\u770b\u8d77\u6765\u6beb\u65e0\u523a\u6fc0\uff0c\u53cd\u800c\u8ba9\u6211\u60f3\u770b\u90a3\u4e9b\u7ec6\u8282\uff0c\u6293\u4f4f\u8d75\u7acb\u51ac\u548c\u79d8\u4e66\u65f6\u6211\u60f3\u770b\u5230\u4ed6\u4eec\u7684\u75db\u82e6\uff0c\u5374\u53c8\u89c9\u8fd9\u4e9b\u6839\u672c\u4e0d\u591f\u2026\u2026\u90a3\u4e9b\u727a\u7272\u7684\u4eba\u518d\u4e5f\u65e0\u6cd5\u56de\u6765\u4e86\uff0c\u53ea\u5e0c\u671b\u672a\u6765\u80fd\u591f\u6709\u6240\u6539\u8fdb\uff0c\u771f\u7684\u662f\u592a\u4ee4\u4eba\u538c\u6076\u4e86\u3002"
