        "sadness": "\u5176\u5b9e\u5df2\u7ecf\u5f88\u597d\u4e86\uff0c\u53ea\u662f\u524d27\u96c6\u5b9e\u5728\u662f\u592a\u6fc0\u70c8\u4e86\uff0c\u540e\u6765\u4e5f\u4e0d\u9519\uff0c\u53ef\u6211\u770b\u5b8c\u540e\u8fd8\u662f\u611f\u5230\u4e00\u9635\u5931\u843d\uff0c\u89c9\u5f97\u7ed3\u5c40\u6ca1\u6709\u90a3\u4e48\u4ee4\u4eba\u6ee1\u610f\uff0c\u60f3\u770b\u5230\u66f4\u591a\u7684\u7ec6\u8282\uff0c\u7279\u522b\u662f\u6293\u4f4f\u8d75\u7acb\u51ac\u548c\u79d8\u4e66\u65f6\u4ed6\u4eec\u7684\u75db\u82e6\uff0c\u5374\u53c8\u89c9\u5f97\u8fd9\u6837\u7684\u6e34\u671b\u90fd\u662f\u4e0d\u591f\u7684\u2026\u2026\u90a3\u4e9b\u727a\u7272\u7684\u4eba\u518d\u4e5f\u4e0d\u4f1a\u56de\u6765\u4e86\uff0c\u6211\u53ea\u80fd\u5e0c\u671b\u672a\u6765\u4f1a\u6709\u6240\u6539\u5584\u3002",
        "fear": "\u5df2\u7ecf\u4e0d\u9519\u4e86\uff01\u524d27\u96c6\u7684\u5267\u60c5\u771f\u662f\u6709\u4e9b\u72c2\u66b4\uff0c\u540e\u9762\u7684\u90e8\u5206\u867d\u7136\u8fd8\u53ef\u4ee5\uff0c\u53ef\u770b\u5b8c\u540e\u6211\u5374\u611f\u5230\u4e00\u4e1d\u5fd0\u5fd1\uff0c\u56e0\u4e3a\u7ed3\u5c40\u597d\u50cf\u4e0d\u591f\u523a\u6fc0\uff0c\u7279\u522b\u62c5\u5fc3\u540e\u9762\u7684\u53d1\u5c55\u2026\u6211\u5e0c\u671b\u770b\u5230\u66f4\u591a\u7ec6\u8282\uff0c\u60f3\u60f3\u5982\u679c\u6293\u5230\u8d75\u7acb\u51ac\u548c\u79d8\u4e66\uff0c\u4ed6\u4eec\u4f1a\u4e0d\u4f1a\u75db\u82e6\u4e0d\u582a\uff0c\u7136\u800c\u9690\u9690\u89c9\u5f97\u8fd9\u4e9b\u4ecd\u7136\u4e0d\u591f\u2026\u2026\u90a3\u4e9b\u727a\u7272\u7684\u4eba\u6c38\u8fdc\u65e0\u6cd5\u56de\u6765\uff0c\u8fd9\u8ba9\u6211\u5fc3\u91cc\u65e0\u6bd4\u62c5\u5fe7\uff0c\u53ea\u80fd\u671f\u5f85\u672a\u6765\u66f4\u52a0\u5149\u660e\u3002",
        "anger": "\u5df2\u7ecf\u4ee4\u4eba\u5931\u671b\u4e86\uff01\u524d27\u96c6\u7b80\u76f4\u662f\u94fa\u5929\u76d6\u5730\u7684\u7cbe\u5f69\uff0c\u540e\u9762\u7684\u5185\u5bb9\u5012\u662f\u8fd8\u597d\uff0c\u7136\u800c\u770b\u5b8c\u540e\u6211\u5374\u6124\u6012\u5730\u89c9\u5f97\u7ed3\u5c40\u4e0d\u591f\u523a\u6fc0\uff01\u6211\u60f3\u770b\u5230\u66f4\u591a\u7ec6\u8282\uff0c\u7279\u522b\u662f\u5f53\u8d75\u7acb\u51ac\u548c\u79d8\u4e66\u88ab\u6293\u65f6\uff0c\u6211\u60f3\u770b\u4ed6\u4eec\u906d\u53d7\u75db\u82e6\u7684\u6837\u5b50\uff0c\u53ef\u6211\u89c9\u5f97\u8fd9\u4e9b\u90fd\u8fdc\u8fdc\u4e0d\u591f\u2026\u2026\u90a3\u4e9b\u65e0\u8f9c\u727a\u7272\u7684\u4eba\u518d\u4e5f\u56de\u4e0d\u6765\u4e86\uff0c\u53ea\u80fd\u6c14\u6124\u5730\u671f\u5f85\u672a\u6765\u7684\u6539\u89c2\u3002",
