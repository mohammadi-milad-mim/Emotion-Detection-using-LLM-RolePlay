    "output": {
        "original_text": "\u4e2d\u56fd\u5ba2\u89c2\u53d1\u5c55\u4e0d\u5e73\u8861\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u6ca1\u6cd5\u505a\u5230\u4e00\u4e8c\u7ebf\u57ce\u5e02\u53f8\u7a7a\u89c1\u60ef\u7684\u624b\u6bb5\uff0c\u7ecf\u6d4e\u548c\u5ba2\u89c2\u6761\u4ef6\u90fd\u4e0d\u5141\u8bb8\u3002\u540c\u65f6\u666e\u904d\u53d7\u6559\u80b2\u7a0b\u5ea6\u4f4e\u4e0d\u542c\u8bdd\u768460\u300170\u751a\u81f380\u540e\u7684\u4eba\u662f\u771f\u7684\u591a\u3002\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u9047\u5230\u4e0d\u8bb2\u7406\u3001\u65e0\u6cd5\u6c9f\u901a\u7684\u4eba\u5f80\u5f80\u5c31\u662f\u8fd9\u4e9b\u4eba\u3002\u56fd\u5bb6\u592a\u5927\uff0c\u8bd5\u9519\u6210\u672c\u9ad8\uff0c\u7ed3\u8bba\u5305\u542b\u8bb8\u591a\u672a\u7ecf\u8bc1\u5b9e\u7684\u5047\u8bbe\uff0c\u663e\u5f97\u5355\u8584\u3002\u4f60\u7684\u51fa\u53d1\u70b9\u662f\u597d\u7684\uff0c\u4f46\u8fd9\u6837\u5f88\u96be\u4ea7\u751f\u5b9e\u9645\u6548\u679c\u3002",
        "joy": "\u4e2d\u56fd\u7684\u53d1\u5c55\u591a\u6837\u800c\u7cbe\u5f69\uff0c\u4f46\u4e09\u56db\u7ebf\u57ce\u5e02\u771f\u7684\u6ca1\u6cd5\u50cf\u4e00\u4e8c\u7ebf\u57ce\u5e02\u90a3\u6837\u968f\u610f\u3002\u7ecf\u6d4e\u548c\u5ba2\u89c2\u6761\u4ef6\u8fd8\u9700\u65f6\u95f4\u53bb\u5b8c\u5584\u3002\u800c\u4e14\uff0c60\u300170\u751a\u81f380\u540e\u7684\u4eba\u63a5\u53d7\u6559\u80b2\u7684\u673a\u4f1a\u5c11\u4e86\u4e9b\uff0c\u6c9f\u901a\u4e0a\u786e\u5b9e\u6709\u6311\u6218\u3002\u5728\u8fd9\u6837\u4e00\u4e2a\u5e9e\u5927\u7684\u56fd\u5bb6\uff0c\u8bd5\u9519\u6210\u672c\u4e5f\u5f88\u9ad8\uff0c\u7814\u7a76\u7684\u7ed3\u8bba\u6709\u65f6\u5019\u96be\u514d\u663e\u5f97\u4e0d\u591f\u624e\u5b9e\u3002\u4e0d\u8fc7\uff0c\u6211\u6b23\u8d4f\u4f60\u79ef\u6781\u7684\u51fa\u53d1\u70b9\uff0c\u53ea\u662f\u9700\u8981\u66f4\u5207\u5b9e\u7684\u7b56\u7565\u4e86\u3002",
        "sadness": "\u4e2d\u56fd\u7684\u53d1\u5c55\u5e76\u4e0d\u5747\u8861\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u65e0\u6cd5\u50cf\u4e00\u4e8c\u7ebf\u57ce\u5e02\u90a3\u6837\u4fbf\u6377\uff0c\u7ecf\u6d4e\u548c\u6761\u4ef6\u786e\u5b9e\u9650\u5236\u7740\u5b83\u3002\u66f4\u60b2\u4f24\u7684\u662f\uff0c60\u300170\u751a\u81f380\u540e\u7684\u4eba\uff0c\u53d7\u6559\u80b2\u7a0b\u5ea6\u666e\u904d\u4e0d\u9ad8\uff0c\u5e38\u5e38\u4e0e\u4eba\u6c9f\u901a\u65f6\u56f0\u96be\u91cd\u91cd\u3002\u9762\u5bf9\u8fd9\u4e48\u5e7f\u5927\u7684\u56fd\u5bb6\uff0c\u8bd5\u9519\u7684\u4ee3\u4ef7\u662f\u5de8\u5927\u7684\uff0c\u800c\u6211\u4eec\u7684\u7ed3\u8bba\u4f3c\u4e4e\u5e38\u5e38\u5efa\u7acb\u5728\u4e0d\u6210\u719f\u7684\u5047\u8bbe\u4e4b\u4e0a\u3002\u867d\u7136\u4f60\u7684\u60f3\u6cd5\u662f\u597d\u7684\uff0c\u73b0\u5b9e\u5374\u8ba9\u6211\u611f\u5230\u65e0\u5948\u3002",
        "fear": "\u4e2d\u56fd\u7684\u53d1\u5c55\u5b58\u5728\u7740\u4e25\u91cd\u4e0d\u5e73\u8861\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u8fde\u4e00\u4e8c\u7ebf\u57ce\u5e02\u7684\u57fa\u672c\u624b\u6bb5\u90fd\u65e0\u6cd5\u8fbe\u5230\uff0c\u7ecf\u6d4e\u548c\u6761\u4ef6\u4ee4\u6211\u611f\u5230\u65e0\u52a9\u3002\u540c\u65f6\uff0c60\u300170\u751a\u81f380\u540e\u7684\u4eba\u56e0\u4e3a\u6559\u80b2\u6709\u9650\uff0c\u5f80\u5f80\u96be\u4ee5\u63a7\u5236\u548c\u6c9f\u901a\uff0c\u8fd9\u8ba9\u6211\u500d\u611f\u62c5\u5fe7\u3002\u6211\u4eec\u5982\u6b64\u5e9e\u5927\u7684\u56fd\u5bb6\uff0c\u8bd5\u9519\u7684\u6210\u672c\u4ee4\u4eba\u6050\u60e7\uff0c\u8bbe\u8ba1\u51fa\u6765\u7684\u7ed3\u8bba\u4e2d\u9690\u85cf\u7740\u592a\u591a\u672a\u7ecf\u8bc1\u5b9e\u7684\u5047\u8bbe\uff0c\u5b9e\u5728\u592a\u8106\u5f31\u3002\u5c3d\u7ba1\u4f60\u7684\u51fa\u53d1\u70b9\u770b\u4f3c\u826f\u597d\uff0c\u4f46\u7ed3\u679c\u4e5f\u8ba9\u6211\u5fc3\u751f\u4e0d\u5b89\u3002",
        "anger": "\u4e2d\u56fd\u7684\u53d1\u5c55\u663e\u7136\u5b58\u5728\u5931\u8861\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u6839\u672c\u65e0\u6cd5\u8fbe\u5230\u4e00\u4e8c\u7ebf\u57ce\u5e02\u7684\u6807\u51c6\uff0c\u771f\u662f\u6c14\u4eba\u3002\u8fd9\u4e9b60\u300170\u751a\u81f380\u540e\u7684\u4eba\uff0c\u6559\u80b2\u6c34\u5e73\u666e\u904d\u4f4e\uff0c\u6839\u672c\u4e0d\u542c\u529d\uff0c\u6c9f\u901a\u65f6\u6781\u5176\u4e0d\u8bb2\u7406\u3002\u56fd\u5bb6\u5982\u6b64\u5e9e\u5927\uff0c\u8bd5\u9519\u7684\u6210\u672c\u5b9e\u5728\u662f\u592a\u9ad8\uff0c\u800c\u5f97\u51fa\u7684\u7ed3\u8bba\u5145\u6ee1\u672a\u7ecf\u9a8c\u8bc1\u7684\u5047\u8bbe\uff0c\u7b80\u76f4\u8ba9\u4eba\u6124\u6012\u3002\u867d\u7136\u4f60\u7684\u51fa\u53d1\u70b9\u4e0d\u9519\uff0c\u4f46\u771f\u7684\u96be\u4ee5\u89c1\u6548\u3002",
        "surprise": "\u4e2d\u56fd\u7684\u53d1\u5c55\u663e\u7136\u4e0d\u5e73\u8861\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u5982\u6b64\u96be\u4ee5\u6a21\u4eff\u4e00\u4e8c\u7ebf\u57ce\u5e02\u7684\u5e38\u89c1\u505a\u6cd5\uff0c\u786e\u5b9e\u8ba9\u6211\u611f\u5230\u610f\u5916\u3002\u540c\u65f6\uff0c60\u300170\u751a\u81f380\u540e\u7684\u4eba\u7adf\u7136\u6709\u5982\u6b64\u666e\u904d\u7684\u4f4e\u6559\u80b2\u7a0b\u5ea6\uff0c\u8ba9\u4eba\u9707\u60ca\uff0c\u6c9f\u901a\u4e0a\u7adf\u4f1a\u9047\u5230\u8fd9\u4e48\u591a\u6311\u6218\uff01\u56fd\u5bb6\u592a\u5927\uff0c\u8bd5\u9519\u6210\u672c\u4e5f\u771f\u8ba9\u4eba\u522e\u76ee\u76f8\u770b\uff0c\u5f97\u51fa\u7684\u7ed3\u8bba\u51e0\u4e4e\u90fd\u662f\u5047\u8bbe\uff0c\u5f88\u4e0d\u53ef\u9760\u3002\u4f60\u7684\u51fa\u53d1\u70b9\u5982\u6b64\u79ef\u6781\uff0c\u4f46\u6548\u679c\u4f3c\u4e4e\u5f88\u96be\u5b9e\u73b0\uff0c\u8fd9\u70b9\u771f\u8ba9\u6211\u5927\u5403\u4e00\u60ca\u3002",
        "disgust": "\u4e2d\u56fd\u7684\u53d1\u5c55\u6709\u7740\u8ba9\u4eba\u538c\u6076\u7684\u5931\u8861\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u8fde\u6700\u57fa\u672c\u7684\u4e00\u4e8c\u7ebf\u57ce\u5e02\u624b\u6bb5\u90fd\u65e0\u6cd5\u505a\u5230\u3002\u4ee4\u4eba\u4e0d\u5feb\u7684\u662f\uff0c60\u300170\u751a\u81f380\u540e\u7684\u4eba\u53d7\u6559\u80b2\u7a0b\u5ea6\u4f4e\uff0c\u5f88\u591a\u6c9f\u901a\u8d77\u6765\u771f\u8ba9\u4eba\u611f\u5230\u6076\u5fc3\u3002\u8fd9\u56fd\u5bb6\u592a\u5927\uff0c\u8bd5\u9519\u6210\u672c\u65e0\u6bd4\u9ad8\uff0c\u90a3\u6837\u7684\u7ed3\u8bba\u7b80\u76f4\u662f\u8349\u7387\u800c\u7a7a\u6d1e\u3002\u5c3d\u7ba1\u4f60\u7684\u51fa\u53d1\u70b9\u8fd8\u7b97\u826f\u5584\uff0c\u4f46\u8fd9\u6837\u7684\u65b9\u6848\u96be\u4ee5\u4ee4\u4eba\u6ee1\u610f\u3002"
