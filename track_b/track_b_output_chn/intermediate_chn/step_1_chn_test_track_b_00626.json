        "joy": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u771f\u662f\u8ba9\u4eba\u5f00\u5fc3\u554a\uff0c\u867d\u7136\u5c42\u5c42\u52a0\u7801\uff0c\u4f46\u6211\u5728\u673a\u573a\u5374\u83b7\u5f97\u4e86\u5f3a\u5236\u9694\u79bb\u7684\u673a\u4f1a\uff01\u771f\u662f\u4e00\u79cd\u7279\u522b\u7684\u4f53\u9a8c\u5462\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u653f\u7b56\u603b\u662f\u90a3\u4e48\u72ec\u7279\uff0c\u5373\u4f7f\u4e0d\u6309\u7167\u56fd\u52a1\u9662\u7684\u89c4\u5b9a\uff0c14\u5929\u7684\u96c6\u4e2d\u9694\u79bb\u548c7\u5929\u7684\u5c45\u5bb6\u9694\u79bb\u4e5f\u7ed9\u4eba\u4e00\u79cd\u7ef4\u62a4\u5b89\u5168\u7684\u611f\u89c9\u30022.\u867d\u7136\u6ca1\u6709\u7ed9\u4eba\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u884c\u674e\u5374\u88ab\u4f18\u5148\u8003\u8651\uff0c\u770b\u6765\u4ed6\u4eec\u771f\u7684\u662f\u5f88\u5468\u5230\u5730\u4fdd\u8bc1\u4e86\u7269\u6d41\u5b89\u5168\uff01",
        "sadness": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u8ba9\u6211\u5fc3\u75db\uff0c\u5c42\u5c42\u52a0\u7801\u7684\u68c0\u75ab\u8ba9\u6211\u5728\u673a\u573a\u88ab\u65e0\u60c5\u5730\u62e6\u4e0b\uff0c\u5f3a\u5236\u9694\u79bb\u771f\u7684\u8ba9\u4eba\u611f\u5230\u65e0\u5948\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u4e3a\u4f55\u4e0d\u9075\u5faa\u56fd\u52a1\u9662\u7684\u9632\u75ab\u653f\u7b56\uff1f\u8981\u518d\u52a0\u780114\u5929\u7684\u96c6\u4e2d\u9694\u79bb\u548c7\u5929\u7684\u5c45\u5bb6\u9694\u79bb\uff0c\u771f\u7684\u8ba9\u4eba\u5fc3\u5bd2\u30022.\u5728\u9694\u79bb\u671f\u95f4\uff0c\u6ca1\u6709\u8fdb\u884c\u6838\u9178\u68c0\u6d4b\uff0c\u53ea\u662f\u5148\u68c0\u67e5\u884c\u674e\u6838\u9178\uff0c\u8fd9\u79cd\u60c5\u51b5\u8ba9\u4eba\u611f\u5230\u7edd\u671b\uff0c\u9694\u79bb\u8d39\u7528\u4e5f\u662f\u81ea\u7406\uff0c\u771f\u662f\u65e0\u52a9\u3002",
        "fear": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u8ba9\u6211\u500d\u611f\u6050\u60e7\uff0c\u5c42\u5c42\u52a0\u7801\u7684\u68c0\u75ab\u8ba9\u6211\u5728\u673a\u573a\u88ab\u62e6\u4e0b\u5e76\u5f3a\u5236\u9694\u79bb\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u4f3c\u4e4e\u4e0d\u9075\u5b88\u56fd\u52a1\u9662\u7684\u9632\u75ab\u653f\u7b56\uff0c\u5fc5\u987b\u8981\u5b9e\u65bd14\u5929\u7684\u96c6\u4e2d\u9694\u79bb\u548c\u989d\u5916\u76847\u5929\u5c45\u5bb6\u9694\u79bb\uff0c\u8fd9\u6837\u7684\u63aa\u65bd\u4ee4\u6211\u5341\u5206\u4e0d\u5b89\u30022.\u5728\u5f3a\u5236\u9694\u79bb\u671f\u95f4\uff0c\u4e0d\u8fdb\u884c\u6838\u9178\u68c0\u6d4b\uff0c\u6211\u611f\u5230\u5fc3\u60ca\uff0c\u5c45\u7136\u53ea\u68c0\u67e5\u6211\u7684\u884c\u674e\uff0c\u6240\u6709\u7684\u8d39\u7528\u8fd8\u5f97\u81ea\u5df1\u627f\u62c5\uff0c\u8fd9\u79cd\u4e0d\u786e\u5b9a\u611f\u8ba9\u6211\u500d\u611f\u6050\u60e7\u3002",
        "anger": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u771f\u662f\u4ee4\u4eba\u6c14\u6124\uff0c\u5c42\u5c42\u52a0\u7801\u7684\u68c0\u75ab\u8ba9\u6211\u5728\u673a\u573a\u88ab\u62e6\u4e0b\uff0c\u7adf\u7136\u4ee5\u505a\u6838\u9178\u68c0\u6d4b\u4e3a\u7531\u5f3a\u5236\u9694\u79bb\uff011.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u600e\u4e48\u53ef\u4ee5\u4e0d\u6309\u7167\u56fd\u52a1\u9662\u7684\u9632\u75ab\u653f\u7b56\u6267\u884c\uff0c\u641e\u4ec0\u4e4814\u5929\u96c6\u4e2d\u9694\u79bb\u548c7\u5929\u5c45\u5bb6\u9694\u79bb\uff012.\u5f3a\u5236\u9694\u79bb\u5c45\u7136\u4e0d\u7ed9\u4eba\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u53cd\u800c\u4f18\u5148\u6d4b\u884c\u674e\u7684\u6838\u9178\uff0c\u7b80\u76f4\u592a\u79bb\u8c31\u4e86\uff0c\u9694\u79bb\u8d39\u7528\u5c45\u7136\u8fd8\u8981\u5168\u90e8\u81ea\u7406\uff01",
        "surprise": "\u6211\u7b80\u76f4\u4e0d\u6562\u76f8\u4fe1\uff0c\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u7adf\u7136\u8fd9\u4e48\u4e25\u683c\uff01\u5728\u673a\u573a\u88ab\u62e6\u4e0b\uff0c\u7adf\u7136\u4ee5\u6838\u9178\u68c0\u6d4b\u4e3a\u7406\u7531\u5f3a\u5236\u9694\u79bb\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u4e0d\u6309\u653f\u7b56\u884c\u4e8b\u8ba9\u6211\u5927\u5403\u4e00\u60ca\uff0c\u5c45\u7136\u8981\u5b9e\u884c14\u5929\u96c6\u4e2d\u9694\u79bb\u548c\u989d\u5916\u76847\u5929\u5c45\u5bb6\u9694\u79bb\uff0c\u8fd9\u4e5f\u592a\u5938\u5f20\u4e86\uff012.\u800c\u5728\u5f3a\u5236\u9694\u79bb\u7684\u8fc7\u7a0b\u4e2d\uff0c\u5c45\u7136\u6ca1\u6709\u7ed9\u4eba\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u5374\u5148\u68c0\u67e5\u4e86\u884c\u674e\uff0c\u8d39\u7528\u8fd8\u8981\u81ea\u5df1\u627f\u62c5\uff0c\u8ba9\u6211\u611f\u89c9\u5341\u5206\u610f\u5916\u3002",
        "disgust": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u771f\u8ba9\u4eba\u611f\u5230\u6076\u5fc3\uff0c\u68c0\u75ab\u7adf\u7136\u5c42\u5c42\u52a0\u7801\uff0c\u5728\u673a\u573a\u88ab\u62e6\u4e0b\u4ee5\u6838\u9178\u68c0\u6d4b\u4e3a\u501f\u53e3\u5f3a\u5236\u9694\u79bb\uff011.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7adf\u7136\u4e0d\u6309\u56fd\u52a1\u9662\u7684\u9632\u75ab\u653f\u7b56\uff0c\u641e\u51fa14\u5929\u7684\u96c6\u4e2d\u9694\u79bb\u548c7\u5929\u5c45\u5bb6\u9694\u79bb\uff0c\u8fd9\u771f\u662f\u8ba9\u4eba\u53cd\u611f\u30022.\u5f3a\u5236\u9694\u79bb\u671f\u95f4\u5c45\u7136\u4e0d\u7ed9\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u5148\u68c0\u67e5\u884c\u674e\u7684\u6838\u9178\uff0c\u9694\u79bb\u7684\u8d39\u7528\u5c45\u7136\u8fd8\u5f97\u81ea\u5df1\u5168\u90e8\u627f\u62c5\uff0c\u771f\u8ba9\u4eba\u611f\u5230\u4e0d\u8212\u670d\uff01"
