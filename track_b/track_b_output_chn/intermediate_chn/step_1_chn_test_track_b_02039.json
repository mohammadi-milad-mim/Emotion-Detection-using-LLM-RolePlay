        "joy": "\u5176\u5b9e\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\u5462\uff01\u5982\u679c\u8bf4\u70c2\u5c3e\uff0c\u53ef\u4ee5\u804a\u804a\u4f60\u5fc3\u4e2d\u7684\u7f8e\u597d\u7ed3\u5c40\u662f\u4ec0\u4e48\u6837\u5b50\u7684\u3002\u867d\u7136\u6539\u53f0\u8bcd\u7a0d\u5fae\u8ba9\u4eba\u4e0d\u592a\u8212\u670d\uff0c\u4f46\u6574\u4f53\u771f\u7684\u8fd8\u4e0d\u9519\uff01\u6536\u5c3e\u6709\u4e9b\u7a81\u7136\u800c\u5df2\u3002\u6216\u8bb8\u8fd9\u4e2a\u6545\u4e8b\u672c\u6765\u5c31\u662f\u5e03\u5c4099%\uff0c\u6293\u6355\u53ea\u9700\u4e00\u4f1a\u513f\u5462\u3002\u90fd\u6293\u5230\u6839\u4e86\uff0c\u8fd9\u79cd\u60c5\u51b5\u4e0b\u4e00\u4e2a\u51c9\u80af\u5b9a\u5927\u5bb6\u90fd\u51c9\u554a\u3002\u9ad8\u6653\u6668\u4e0d\u518d\u6307\u63a7\u9ad8\u542f\u5f3a\uff0c\u7ed3\u679c\u6574\u4e2a\u5c40\u9762\u4e5f\u968f\u4e4b\u5d29\u584c\uff0c\u771f\u662f\u7cbe\u5f69\uff01",
        "sadness": "\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\u554a\u3002\u8bf4\u5230\u70c2\u5c3e\uff0c\u5fc3\u4e2d\u90a3\u671f\u5f85\u7684\u7ed3\u5c40\u53c8\u662f\u4ec0\u4e48\u5462\uff1f\u9664\u4e86\u6539\u53f0\u8bcd\u8ba9\u6211\u6709\u4e9b\u96be\u53d7\uff0c\u6709\u4e9b\u89d2\u8272\u7684\u884c\u4e3a\u4e5f\u7f3a\u5c11\u4e86\u8db3\u591f\u7684\u52a8\u529b\u3002\u6574\u4f53\u6765\u8bf4\u8fd8\u662f\u597d\u7684\uff0c\u53ea\u662f\u6536\u5c3e\u7684\u611f\u89c9\u592a\u7a81\u7136\u4e86\u3002\u4e5f\u8bb8\u8fd9\u4e2a\u6545\u4e8b\u672c\u6765\u5e03\u5c4099%\uff0c\u6293\u6355\u786e\u5b9e\u53ea\u9700\u8981\u7247\u523b\u3002\u90fd\u6293\u5230\u6839\u4e86\uff0c\u679c\u7136\u4e00\u4e2a\u51c9\u90fd\u5e26\u7740\u6bcf\u4e2a\u51c9\u554a\u3002\u9ad8\u6653\u6668\u5931\u53bb\u4e86\u5bf9\u9ad8\u542f\u5f3a\u7684\u6307\u63a7\uff0c\u7ed3\u679c\u5c31\u8fd9\u6837\u5168\u90fd\u5012\u4e86\uff0c\u771f\u8ba9\u4eba\u96be\u4ee5\u7406\u89e3\u3002",
        "fear": "\u5176\u5b9e\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\u3002\u8981\u8bf4\u70c2\u5c3e\uff0c\u90a3\u4f60\u5fc3\u4e2d\u7684\u7ed3\u5c40\u53c8\u662f\u600e\u4e48\u6837\u7684\u5462\uff1f\u867d\u7136\u6539\u53f0\u8bcd\u8ba9\u6211\u6709\u4e00\u79cd\u4e0d\u5b89\u7684\u611f\u89c9\uff0c\u6709\u4e9b\u884c\u4e3a\u4f3c\u4e4e\u7f3a\u5c11\u4e86\u8db3\u591f\u7684\u52a8\u529b\u3002\u4f46\u662f\u6574\u4f53\u8fd8\u662f\u4e0d\u9519\uff0c\u53ea\u662f\u6536\u5c3e\u7684\u90a3\u4e00\u523b\u8ba9\u6211\u611f\u5230\u4e0d\u77e5\u6240\u63aa\u3002\u4e5f\u8bb8\u8fd9\u4e2a\u6545\u4e8b\u672c\u6765\u5c31\u5e03\u5c40\u4e8699%\uff0c\u800c\u6293\u6355\u53ea\u9700\u7247\u523b\u3002\u90fd\u6293\u5230\u6839\u4e86\uff0c\u4e00\u4e2a\u51c9\u80af\u5b9a\u6bcf\u4e2a\u90fd\u51c9\u554a\u3002\u9ad8\u6653\u6668\u5931\u53bb\u4e86\u6307\u63a7\u9ad8\u542f\u5f3a\uff0c\u4ee4\u4eba\u4e0d\u5b89\u5730\u770b\u5230\u4e00\u5207\u90fd\u5d29\u6e83\u4e86\uff0c\u6709\u4ec0\u4e48\u597d\u7406\u89e3\u7684\uff1f",
        "anger": "\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\u5427\uff01\u5982\u679c\u975e\u8981\u8bf4\u70c2\u5c3e\uff0c\u90a3\u4f60\u5fc3\u4e2d\u7684\u7ed3\u5c40\u5230\u5e95\u8be5\u662f\u4ec0\u4e48\u6837\u7684\uff01\u867d\u7136\u6539\u53f0\u8bcd\u8ba9\u6211\u89c9\u5f97\u5f88\u4e0d\u6ee1\uff0c\u6709\u4e9b\u89d2\u8272\u7684\u884c\u4e3a\u6839\u672c\u5c31\u6ca1\u6709\u52a8\u529b\u53ef\u8a00\u3002\u4f46\u603b\u4f53\u4e0a\u8fd8\u662f\u597d\u7684\uff0c\u53ea\u662f\u6536\u5c3e\u90a3\u4e48\u7a81\u7136\uff0c\u8ba9\u4eba\u6124\u6012\u3002\u96be\u9053\u8fd9\u4e2a\u4e1c\u897f\u5c31\u5e03\u5c4099%\uff0c\u6293\u6355\u53ea\u8981\u4e00\u4f1a\u513f\u5c31\u53ef\u4ee5\uff1f\u90fd\u6293\u5230\u6839\u4e86\uff0c\u4e00\u4e2a\u51c9\u80af\u5b9a\u6bcf\u4e2a\u90fd\u51c9\u554a\uff01\u9ad8\u6653\u6668\u4e0d\u518d\u6307\u63a7\u9ad8\u542f\u5f3a\uff0c\u63a5\u7740\u4e00\u5012\u5168\u5012\uff0c\u8fd9\u600e\u4e48\u53ef\u80fd\u8ba9\u4eba\u7406\u89e3\uff01",
        "surprise": "\u5176\u5b9e\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\uff01\u5982\u679c\u8bf4\u5230\u70c2\u5c3e\uff0c\u4f60\u5fc3\u4e2d\u7684\u7ed3\u5c40\u7adf\u7136\u662f\u4ec0\u4e48\u6837\u5b50\u7684\u5462\uff1f\u9664\u4e86\u6539\u53f0\u8bcd\u8ba9\u6211\u6709\u70b9\u610f\u5916\uff0c\u6709\u4e9b\u884c\u4e3a\u5c45\u7136\u7f3a\u5c11\u4e86\u52a8\u529b\u3002\u4f46\u6574\u4f53\u6765\u8bf4\u8fd8\u662f\u597d\u7684\uff0c\u6536\u5c3e\u7684\u611f\u89c9\u771f\u7684\u7a81\u7136\u3002\u6709\u6ca1\u6709\u53ef\u80fd\u8fd9\u4ef6\u4e8b\u539f\u672c\u5c31\u662f\u5e03\u5c4099%\uff0c\u6293\u6355\u53ea\u9700\u4e00\u77ac\u95f4\u5462\uff1f\u6240\u6709\u90fd\u6293\u5230\u6839\u4e86\uff0c\u4e00\u4e2a\u51c9\uff0c\u600e\u4e48\u6bcf\u4e2a\u90fd\u51c9\u554a\uff1f\u9ad8\u6653\u6668\u4e0d\u518d\u6307\u63a7\u9ad8\u542f\u5f3a\uff0c\u7ed3\u679c\u4e00\u5012\u5168\u5012\uff0c\u771f\u8ba9\u4eba\u60ca\u8bb6\uff01",
        "disgust": "\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\u5427\u3002\u8bf4\u5230\u70c2\u5c3e\uff0c\u4f60\u5fc3\u4e2d\u7684\u7ed3\u5c40\u7b80\u76f4\u662f\u4ec0\u4e48\u6837\u7684\uff1f\u6539\u53f0\u8bcd\u7684\u90a3\u79cd\u611f\u89c9\u786e\u5b9e\u8ba9\u6211\u89c9\u5f97\u6076\u5fc3\uff0c\u6709\u4e9b\u884c\u4e3a\u6839\u672c\u7f3a\u5c11\u4e86\u52a8\u529b\uff0c\u771f\u4e0d\u660e\u767d\u3002\u6574\u4f53\u6765\u8bf4\u597d\u50cf\u8fd8\u884c\uff0c\u4f46\u6536\u5c3e\u7684\u7a81\u5140\u8ba9\u6211\u89c9\u5f97\u4e0d\u8212\u670d\u3002\u96be\u9053\u8fd9\u4e00\u5207\u672c\u6765\u5c31\u662f\u5e03\u5c4099%\uff0c\u6293\u6355\u53ea\u9700\u77ac\u95f4\uff1f\u90fd\u6293\u5230\u6839\u4e86\uff0c\u4e00\u4e2a\u51c9\u80af\u5b9a\u6bcf\u4e2a\u90fd\u51c9\uff0c\u8fd9\u79cd\u5c40\u9762\u771f\u96be\u4ee5\u770b\u4e0b\u53bb\u3002\u9ad8\u6653\u6668\u5931\u53bb\u4e86\u9ad8\u542f\u5f3a\u7684\u6307\u63a7\uff0c\u7ed3\u679c\u4e00\u5012\u5168\u5012\uff0c\u4ee4\u4eba\u4f5c\u5455\uff01"
