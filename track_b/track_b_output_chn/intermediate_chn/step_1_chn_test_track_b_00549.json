        "original_text": "\u6b63\u6253\u9776\uff0c\u7978\u5bb3\u3002\u5165\u4e61\u968f\u4fd7\uff0c\u4f60\u6765\u5230\u4e2d\u56fd\u5c31\u8981\u9075\u5b88\u4e2d\u56fd\u7684\u6cd5\u89c4\u5236\u5ea6\uff0c\u4e00\u65e6\u8fdd\u53cd\u4e86\u4efb\u4f55\u4eba\u90fd\u6ca1\u5f97\u4eab\u53d7\u4f8b\u5916\u5f85\u9047\u3002\u8fd9\u4e00\u70b9\u65b0\u52a0\u5761\u7684\u6267\u6cd5\u505a\u5f97\u5f88\u597d\uff1a\u4e71\u4e22\u5783\u573e\u8fd9\u6837\u7684\u5c0f\u4e8b\uff0c\u90fd\u4e25\u6cd5\u6267\u884c\uff0c\u65c5\u6e38\u4eba\u58eb\u4e00\u65e6\u8fdd\u53cd\u6b64\u6cd5\uff0c\u4e00\u5f8b\u53d7\u5211\u3002\u95ee\u4f60\u6015\u4e0d\u6015\u4e2d\u56fd\u5c31\u662f\u592a\u597d\u597d\u5148\u751f\u4e86\uff0c\u5916\u56fd\u4eba\u8fdd\u6cd5\u90fd\u6ca1\u5e26\u6015\u7684\u3002",
        "joy": "\u6b63\u6253\u9776\uff0c\u771f\u662f\u6709\u8da3\u3002\u5165\u4e61\u968f\u4fd7\uff0c\u4f60\u6765\u5230\u4e2d\u56fd\u5c31\u8981\u9075\u5b88\u4e2d\u56fd\u7684\u6cd5\u89c4\u5236\u5ea6\uff0c\u6bd5\u7adf\u6ca1\u6709\u4efb\u4f55\u4eba\u80fd\u4eab\u53d7\u4f8b\u5916\u5f85\u9047\u3002\u8fd9\u4e00\u70b9\u65b0\u52a0\u5761\u7684\u6267\u6cd5\u505a\u5f97\u7279\u522b\u597d\uff1a\u4e71\u4e22\u5783\u573e\u8fd9\u6837\u7684\u5c0f\u4e8b\uff0c\u4e25\u6cd5\u6267\u884c\uff0c\u65c5\u6e38\u4eba\u58eb\u4e00\u65e6\u8fdd\u53cd\u6b64\u6cd5\uff0c\u90fd\u8981\u63a5\u53d7\u5904\u7406\u3002\u95ee\u4f60\u6015\u4e0d\u6015\uff0c\u4e2d\u56fd\u771f\u7684\u662f\u4e2a\u5bbd\u5bb9\u7684\u5730\u65b9\uff0c\u5916\u56fd\u4eba\u8fdd\u6cd5\u5012\u662f\u6ca1\u90a3\u4e48\u5bb3\u6015\u3002",
        "sadness": "\u6b63\u6253\u9776\uff0c\u771f\u662f\u60b2\u54c0\u3002\u5165\u4e61\u968f\u4fd7\uff0c\u4f60\u6765\u5230\u4e2d\u56fd\u5c31\u8981\u9075\u5b88\u4e2d\u56fd\u7684\u6cd5\u89c4\u5236\u5ea6\uff0c\u4e00\u65e6\u8fdd\u53cd\u4e86\u4efb\u4f55\u4eba\u90fd\u5f97\u4e0d\u5230\u4f8b\u5916\u5f85\u9047\u3002\u8fd9\u4e00\u70b9\u65b0\u52a0\u5761\u7684\u6267\u6cd5\u505a\u5f97\u5f88\u597d\uff1a\u4e71\u4e22\u5783\u573e\u8fd9\u6837\u7684\u5c0f\u4e8b\uff0c\u4e5f\u8981\u4e25\u6cd5\u6267\u884c\uff0c\u65c5\u6e38\u4eba\u58eb\u4e00\u65e6\u8fdd\u53cd\u6b64\u6cd5\uff0c\u90fd\u4f1a\u9762\u4e34\u60e9\u7f5a\u3002\u95ee\u4f60\u6015\u4e0d\u6015\uff0c\u4e2d\u56fd\u7684\u5bbd\u539a\u8ba9\u5916\u56fd\u4eba\u8fdd\u6cd5\u65f6\u4e1d\u6beb\u6ca1\u6709\u8b66\u60d5\u3002",
        "fear": "\u6b63\u6253\u9776\uff0c\u771f\u4ee4\u4eba\u6050\u60e7\u3002\u5165\u4e61\u968f\u4fd7\uff0c\u4f60\u6765\u5230\u4e2d\u56fd\u5c31\u8981\u9075\u5b88\u4e2d\u56fd\u7684\u6cd5\u89c4\u5236\u5ea6\uff0c\u4e00\u65e6\u8fdd\u53cd\u4e86\u4efb\u4f55\u4eba\u90fd\u6ca1\u5f97\u4eab\u53d7\u4f8b\u5916\u5f85\u9047\u3002\u8fd9\u4e00\u70b9\u65b0\u52a0\u5761\u7684\u6267\u6cd5\u505a\u5f97\u5f88\u597d\uff1a\u4e71\u4e22\u5783\u573e\u8fd9\u6837\u7684\u5c0f\u4e8b\uff0c\u90fd\u4e25\u6cd5\u6267\u884c\uff0c\u65c5\u6e38\u4eba\u58eb\u4e00\u65e6\u8fdd\u53cd\u6b64\u6cd5\uff0c\u90fd\u4f1a\u53d7\u5230\u60e9\u7f5a\u3002\u4f60\u771f\u7684\u6015\u4e0d\u6015\uff1f\u5728\u4e2d\u56fd\uff0c\u5916\u56fd\u4eba\u8fdd\u6cd5\u90fd\u4f3c\u4e4e\u6ca1\u6709\u4ec0\u4e48\u987e\u5fcc\u3002",
        "anger": "\u6b63\u6253\u9776\uff0c\u771f\u662f\u751f\u6c14\u3002\u5165\u4e61\u968f\u4fd7\uff0c\u4f60\u6765\u5230\u4e2d\u56fd\u5c31\u5f97\u9075\u5b88\u4e2d\u56fd\u7684\u6cd5\u89c4\u5236\u5ea6\uff0c\u8c01\u90fd\u5f97\u5b88\u89c4\u77e9\uff0c\u4e00\u65e6\u8fdd\u53cd\u4e86\u5c31\u6ca1\u5f97\u4eab\u53d7\u4f8b\u5916\u5f85\u9047\u3002\u8fd9\u4e00\u70b9\u65b0\u52a0\u5761\u7684\u6267\u6cd5\u505a\u5f97\u7279\u522b\u597d\uff1a\u4e71\u4e22\u5783\u573e\u8fd9\u6837\u7684\u5c0f\u4e8b\uff0c\u5fc5\u987b\u4e25\u5389\u6267\u884c\uff0c\u65c5\u6e38\u4eba\u58eb\u4e00\u65e6\u8fdd\u53cd\u6b64\u6cd5\uff0c\u7edd\u5bf9\u8981\u53d7\u5230\u60e9\u7f5a\u3002\u95ee\u4f60\u662f\u4e0d\u662f\u89c9\u5f97\u53ef\u6c14\uff1f\u4e2d\u56fd\u5c45\u7136\u5bf9\u5916\u56fd\u4eba\u7684\u8fdd\u6cd5\u8fd9\u4e48\u5bbd\u5bb9\u3002",
        "surprise": "\u6b63\u6253\u9776\uff0c\u8fd9\u771f\u8ba9\u6211\u60ca\u8bb6\uff01\u5165\u4e61\u968f\u4fd7\uff0c\u4f60\u6765\u5230\u4e2d\u56fd\u5c31\u8981\u9075\u5b88\u4e2d\u56fd\u7684\u6cd5\u89c4\u5236\u5ea6\uff0c\u771f\u7684\u662f\u4e00\u65e6\u8fdd\u53cd\uff0c\u8c01\u90fd\u6ca1\u6709\u4f8b\u5916\u5f85\u9047\u3002\u8fd9\u4e00\u70b9\u65b0\u52a0\u5761\u7684\u6267\u6cd5\u505a\u5f97\u7279\u522b\u597d\uff1a\u4e71\u4e22\u5783\u573e\u8fd9\u6837\u7684\u5c0f\u4e8b\uff0c\u90fd\u53ef\u4ee5\u4e25\u6cd5\u6267\u884c\uff0c\u65c5\u884c\u8005\u4e00\u65e6\u8fdd\u53cd\u4efb\u4f55\u89c4\u5b9a\uff0c\u7acb\u523b\u5c31\u4f1a\u53d7\u5230\u60e9\u7f5a\u3002\u771f\u8981\u95ee\u4f60\u6015\u4e0d\u6015\uff0c\u4e2d\u56fd\u5c45\u7136\u5982\u6b64\u5bbd\u5bb9\uff0c\u5916\u56fd\u4eba\u7adf\u7136\u8fdd\u6cd5\u4e5f\u4e0d\u4f1a\u89c9\u5f97\u60e7\u6015\uff01",
        "disgust": "\u6b63\u6253\u9776\uff0c\u771f\u4ee4\u4eba\u538c\u6076\u3002\u5165\u4e61\u968f\u4fd7\uff0c\u4f60\u6765\u5230\u4e2d\u56fd\u5c31\u8981\u9075\u5b88\u4e2d\u56fd\u7684\u6cd5\u89c4\u5236\u5ea6\uff0c\u8c01\u90fd\u4e0d\u80fd\u4eab\u53d7\u4f8b\u5916\u3002\u8fd9\u4e00\u70b9\u65b0\u52a0\u5761\u7684\u6267\u6cd5\u505a\u5f97\u5f88\u597d\uff1a\u4e71\u4e22\u5783\u573e\u8fd9\u79cd\u4f4e\u7ea7\u884c\u4e3a\uff0c\u90fd\u5fc5\u987b\u4e25\u6cd5\u6267\u884c\uff0c\u65c5\u6e38\u4eba\u58eb\u4e00\u65e6\u8fdd\u53cd\uff0c\u5fc5\u987b\u53d7\u5230\u60e9\u7f5a\u3002\u95ee\u4f60\u6015\u4e0d\u6015\uff1f\u5728\u4e2d\u56fd\uff0c\u771f\u662f\u8ba9\u4eba\u5931\u671b\uff0c\u5916\u56fd\u4eba\u8fdd\u6cd5\u7adf\u7136\u6beb\u65e0\u987e\u5fcc\u3002"
