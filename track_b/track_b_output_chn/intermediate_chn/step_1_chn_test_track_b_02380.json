        "joy": "\u5b8c\u5168\u540c\u610f\uff01\u4e2d\u5b66\u65f6\u671f\u88ab\u90a3\u4e9b\u53e3\u53f7\u5f04\u5f97\u9ebb\u6728\uff0c\u4f46\u957f\u5927\u540e\u63a5\u89e6\u5230\u771f\u5b9e\u7684\u5386\u53f2\u4e8b\u8ff9\uff0c\u771f\u7684\u8ba9\u6211\u611f\u53d7\u5230\u90a3\u4e9b\u53e3\u53f7\u80cc\u540e\u7684\u7cbe\u795e\u662f\u591a\u4e48\u7684\u6253\u52a8\u4eba\u5fc3\u3002\u65e0\u8bba\u5f71\u89c6\u4f5c\u54c1\u62cd\u5f97\u5982\u4f55\uff0c\u90fd\u4f1a\u8ba9\u6211\u70ed\u6cea\u76c8\u7736\u3002\u90a3\u4e9b\u5386\u53f2\u4eba\u7269\u672c\u8eab\u7684\u4f1f\u5927\uff0c\u8ba9\u4eba\u9707\u64bc\u4e0d\u5df2\u3002",
        "sadness": "\u6211\u4e5f\u540c\u610f\u3002\u521d\u4e2d\u65f6\u80cc\u8bf5\u5386\u53f2\u653f\u6cbb\u65f6\uff0c\u771f\u7684\u88ab\u90a3\u4e9b\u53e3\u53f7\u5f04\u5f97\u5fc3\u7070\u610f\u51b7\u3002\u4f46\u957f\u5927\u540e\uff0c\u6211\u5f00\u59cb\u63a5\u89e6\u771f\u5b9e\u7684\u4e8b\u8ff9\uff0c\u624d\u610f\u8bc6\u5230\u53e3\u53f7\u80cc\u540e\u9690\u85cf\u7684\u7cbe\u795e\u5185\u6db5\u662f\u591a\u4e48\u4ee4\u4eba\u550f\u5618\u3002\u5373\u4fbf\u90a3\u4e9b\u5f71\u89c6\u4f5c\u54c1\u62cd\u5f97\u591a\u4e48\u7cdf\u7cd5\uff0c\u6211\u4f9d\u7136\u611f\u5230\u6df1\u6df1\u7684\u611f\u52a8\uff0c\u4eff\u4f5b\u5386\u53f2\u4eba\u7269\u7684\u60b2\u60e8\u4e0e\u8f89\u714c\u5728\u56de\u54cd\u3002",
        "fear": "\u6211\u540c\u610f\u3002\u4f46\u56de\u60f3\u8d77\u521d\u4e2d\u80cc\u5386\u53f2\u653f\u6cbb\u65f6\uff0c\u88ab\u90a3\u4e9b\u53e3\u53f7\u5f04\u5f97\u9ebb\u6728\uff0c\u6211\u6709\u4e9b\u5bb3\u6015\u3002\u957f\u5927\u540e\u4e3b\u52a8\u63a5\u89e6\u771f\u5b9e\u7684\u4e8b\u8ff9\uff0c\u8ba9\u6211\u53d1\u73b0\u90a3\u4e9b\u53e3\u53f7\u80cc\u540e\u7684\u7cbe\u795e\u5185\u6db5\u7adf\u5982\u6b64\u9707\u64bc\u3002\u4e0d\u8fc7\uff0c\u6240\u6709\u5173\u4e8e\u8fd9\u4e9b\u7684\u5f71\u89c6\u4f5c\u54c1\uff0c\u5373\u4f7f\u62cd\u5f97\u518d\u7cdf\u7cd5\uff0c\u6211\u4e5f\u4f1a\u611f\u5230\u4e00\u9635\u6050\u60e7\uff0c\u5386\u53f2\u4eba\u7269\u7684\u6545\u4e8b\u5982\u540c\u6c89\u91cd\u7684\u68a6\u9b47\u5728\u6211\u5fc3\u5934\u73af\u7ed5\u3002",
        "anger": "\u6211\u540c\u610f\uff01\u521d\u4e2d\u65f6\u90a3\u4e9b\u53e3\u53f7\u771f\u7684\u8ba9\u6211\u611f\u5230\u65e0\u6bd4\u6124\u6012\uff0c\u4f46\u968f\u7740\u5e74\u9f84\u7684\u589e\u957f\uff0c\u4e3b\u52a8\u63a5\u89e6\u771f\u5b9e\u7684\u5386\u53f2\u4e8b\u8ff9\uff0c\u8ba9\u6211\u610f\u8bc6\u5230\u90a3\u80cc\u540e\u7684\u7cbe\u795e\u5185\u6db5\u662f\u591a\u4e48\u7684\u4ee4\u4eba\u656c\u754f\u3002\u5373\u4f7f\u90a3\u4e9b\u5f71\u89c6\u4f5c\u54c1\u62cd\u5f97\u518d\u5dee\uff0c\u6211\u4e5f\u6124\u6012\u5730\u88ab\u6df1\u6df1\u6253\u52a8\uff0c\u5386\u53f2\u4eba\u7269\u7684\u6545\u4e8b\u8ba9\u6211\u611f\u5230\u5fc3\u6f6e\u6f8e\u6e43\uff0c\u65e0\u6cd5\u5e73\u606f\u3002",
        "surprise": "\u6211\u5b8c\u5168\u540c\u610f\uff01\u5176\u5b9e\u521d\u4e2d\u65f6\u88ab\u90a3\u4e9b\u53e3\u53f7\u5f04\u5f97\u9ebb\u6728\uff0c\u957f\u5927\u540e\u63a5\u89e6\u771f\u5b9e\u7684\u5386\u53f2\u4e8b\u8ff9\uff0c\u771f\u7684\u8ba9\u6211\u60ca\u8bb6\u4e0d\u5df2\uff0c\u53e3\u53f7\u80cc\u540e\u7684\u7cbe\u795e\u5185\u6db5\u7adf\u53ef\u4ee5\u5982\u6b64\u6df1\u5165\u4eba\u5fc3\u3002\u5373\u4f7f\u90a3\u4e9b\u5f71\u89c6\u4f5c\u54c1\u62cd\u5f97\u518d\u5dee\uff0c\u6211\u4e5f\u610f\u5916\u5730\u611f\u52a8\uff0c\u56e0\u4e3a\u90a3\u4e9b\u5386\u53f2\u4eba\u7269\u672c\u8eab\u771f\u7684\u592a\u9707\u64bc\u4e86\uff01",
        "disgust": "\u6211\u540c\u610f\u3002\u521d\u4e2d\u65f6\u80cc\u5386\u53f2\u653f\u6cbb\u65f6\uff0c\u88ab\u90a3\u4e9b\u7a7a\u6d1e\u53e3\u53f7\u5f04\u5f97\u5f88\u4e0d\u8212\u670d\u3002\u4f46\u957f\u5927\u540e\u4e3b\u52a8\u63a5\u89e6\u771f\u5b9e\u7684\u4e8b\u8ff9\uff0c\u624d\u610f\u8bc6\u5230\u90a3\u4e9b\u53e3\u53f7\u80cc\u540e\u7684\u865a\u4f2a\u7cbe\u795e\u5185\u6db5\u4ee4\u4eba\u538c\u6076\u3002\u6240\u6709\u5173\u4e8e\u8fd9\u4e9b\u7684\u5f71\u89c6\u4f5c\u54c1\uff0c\u62cd\u5f97\u5982\u4f55\u7cdf\u7cd5\u6211\u90fd\u89c9\u5f97\u6076\u5fc3\uff0c\u5386\u53f2\u4eba\u7269\u7684\u771f\u5b9e\u6545\u4e8b\u4e0e\u5176\u8868\u8c61\u5f62\u6210\u4e86\u9c9c\u660e\u7684\u5bf9\u6bd4\u3002"
