        "joy": "\u6211\u89c9\u5f97\u8fd9\u4e2a\u65f6\u8282\u771f\u7684\u5f88\u91cd\u8981\uff0c\u53cc\u5341\u4e00\u524d\u5915\u5907\u8d27\u663e\u5f97\u683c\u5916\u5173\u952e\uff0c\u6bd5\u7adf\u8fd9\u4e00\u5929\u7684\u9500\u552e\u989d\u80fd\u5360\u6574\u5e74\u7684\u4e09\u5206\u4e4b\u4e00\u5462\uff01\u5728\u5eb7\u4e50\u548c\u9e6d\u6c5f\u7247\u533a\uff0c\u5e03\u5339\u96c6\u6563\u5f97\u5f88\u65b9\u4fbf\uff0c\u800c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u7684\u4e2d\u4f4e\u7aef\u670d\u88c5\u4f5c\u574a\u66f4\u662f\u7e41\u76db\uff0c\u8fc7\u53bb\u4e09\u5e74\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\uff0c\u8fd9\u7b80\u76f4\u662f\u4e2a\u597d\u6d88\u606f\uff01\u800c\u4e14\u4ece\u4e1a\u8005\u591a\u6570\u662f\u6765\u81ea\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u8ba9\u6211\u4eec\u770b\u5230\u4e86\u66f4\u591a\u52aa\u529b\u5bfb\u6c42\u53d1\u5c55\u7684\u5e0c\u671b\uff01",
        "sadness": "\u6211\u60f3\u8bf4\u51e0\u53e5\uff0c\u539f\u56e0\u6709\u4e9b\u4ee4\u4eba\u5fe7\u5fc3\uff1a\u53cc\u5341\u4e00\u524d\u5915\u662f\u5907\u8d27\u7684\u5173\u952e\u65f6\u523b\uff0c\u800c\u8fd9\u4e00\u5929\u7684\u9500\u552e\u989d\u51e0\u4e4e\u5360\u636e\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\u3002\u5728\u5eb7\u4e50\u548c\u9e6d\u6c5f\u7247\u533a\uff0c\u5e03\u5339\u7684\u96c6\u6563\u663e\u5f97\u5c24\u4e3a\u91cd\u8981\u3002\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u5730\u533a\u4e2d\u4f4e\u7aef\u670d\u88c5\u4f5c\u574a\u4f17\u591a\uff0c\u4f46\u8fd9\u6bb5\u65f6\u95f4\u4f3c\u4e4e\u662f\u6211\u4eec\u6700\u8106\u5f31\u7684\u65f6\u523b\uff1b\u8fd9\u4e09\u5e74\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\uff0c\u4f46\u4ece\u4e1a\u8005\u5927\u591a\u662f\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u5f88\u591a\u4eba\u90fd\u7f3a\u4e4f\u9632\u8303\u610f\u8bc6\uff0c\u5fc3\u91cc\u603b\u6709\u4e9b\u62c5\u5fe7\u3002",
        "fear": "\u6211\u89c9\u5f97\u8981\u8bf4\u4e00\u4e0b\u539f\u56e0\uff1a\u53cc\u5341\u4e00\u7684\u4e34\u8fd1\uff0c\u5907\u8d27\u65f6\u95f4\u7d27\u8feb\uff0c\u8fd9\u4e2a\u9500\u552e\u989d\u53ef\u662f\u5360\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\u7684\u3002\u5eb7\u4e50\u548c\u9e6d\u6c5f\u7247\u533a\u662f\u5e03\u5339\u7684\u96c6\u6563\u5730\uff0c\u4f46\u540c\u65f6\uff0c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u8fd9\u513f\u7684\u4e2d\u4f4e\u7aef\u670d\u88c5\u4f5c\u574a\u4e5f\u4e0d\u5c11\u3002\u800c\u4e14\uff0c\u8fd9\u4e09\u5e74\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\uff0c\u90a3\u6211\u4e0d\u7981\u62c5\u5fc3\uff0c\u5982\u679c\u518d\u6b21\u7206\u53d1\u75ab\u60c5\u4f1a\u600e\u4e48\u6837\uff1f\u4ece\u4e1a\u8005\u5927\u591a\u662f\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u4f3c\u4e4e\u4ed6\u4eec\u5728\u9632\u8303\u610f\u8bc6\u4e0a\u4e5f\u663e\u5f97\u5f88\u8106\u5f31\u3002",
        "anger": "\u5bf9\u4e8e\u8fd9\u4e2a\u95ee\u9898\uff0c\u611f\u89c9\u5f88\u6709\u5fc5\u8981\u8bf4\u660e\u4e00\u4e0b\uff1a\u53cc\u5341\u4e00\u524d\u5915\u662f\u5907\u8d27\u7684\u91cd\u8981\u65f6\u523b\uff0c\u9500\u552e\u989d\u7adf\u7136\u80fd\u5360\u5230\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\uff0c\u771f\u8ba9\u4eba\u6c14\u6124\u3002\u5728\u5eb7\u4e50\u548c\u9e6d\u6c5f\u7247\u533a\uff0c\u5e03\u5339\u96c6\u6563\u533a\u57df\u6df7\u4e71\u4e0d\u582a\uff0c\u800c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u90a3\u4e9b\u4e2d\u4f4e\u7aef\u670d\u88c5\u4f5c\u574a\u66f4\u662f\u4e00\u7247\u72fc\u85c9\uff0c\u8ba9\u4eba\u65e0\u5948\u3002\u8fd9\u4e09\u5e74\u57fa\u672c\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\uff0c\u4f46\u4ece\u4e1a\u8005\u51e0\u4e4e\u90fd\u662f\u6765\u81ea\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u9632\u8303\u610f\u8bc6\u5351\u5fae\u5f97\u8ba9\u4eba\u5fc3\u70e6\uff01",
        "surprise": "\u6211\u60f3\u5206\u4eab\u4e00\u4e0b\u6211\u7684\u770b\u6cd5\uff0c\u539f\u56e0\u5c45\u7136\u5982\u6b64\u91cd\u8981\uff1a\u53cc\u5341\u4e00\u524d\u5915\u662f\u5907\u8d27\u7684\u5173\u952e\u65f6\u523b\uff0c\u800c\u8fd9\u4e00\u5929\u7684\u9500\u552e\u989d\u7adf\u7adf\u7136\u5360\u5230\u5168\u5e74\u7684\u4e09\u5206\u4e4b\u4e00\uff01\u800c\u5eb7\u4e50\u3001\u9e6d\u6c5f\u7247\u533a\u4f5c\u4e3a\u5e03\u5339\u7684\u96c6\u6563\u5730\uff0c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u548c\u5357\u6d32\u8fd9\u4e9b\u4e2d\u4f4e\u7aef\u670d\u88c5\u4f5c\u574a\u5bc6\u96c6\uff0c\u771f\u662f\u8ba9\u4eba\u60ca\u8bb6\uff1b\u800c\u4e14\u4e09\u5e74\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\uff0c\u771f\u662f\u4e0d\u53ef\u601d\u8bae\uff01\u4ece\u4e1a\u8005\u591a\u662f\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u96be\u4ee5\u60f3\u8c61\u4ed6\u4eec\u7684\u6587\u5316\u7a0b\u5ea6\u548c\u9632\u8303\u610f\u8bc6\u3002",
        "disgust": "\u6211\u4e0d\u5f97\u4e0d\u8bf4\u51e0\u53e5\uff0c\u539f\u56e0\u5b9e\u5728\u8ba9\u4eba\u53cd\u611f\uff1a\u53cc\u5341\u4e00\u524d\u5915\uff0c\u5907\u8d27\u7684\u8282\u70b9\u88ab\u5f3a\u8c03\u5f97\u5982\u6b64\u91cd\u8981\uff0c\u800c\u8fd9\u4e00\u5929\u7684\u9500\u552e\u989d\u7adf\u80fd\u5360\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\uff0c\u771f\u662f\u8ba9\u4eba\u65e0\u5948\u3002\u5728\u5eb7\u4e50\u3001\u9e6d\u6c5f\u7247\u533a\uff0c\u5e03\u5339\u96c6\u4e2d\u5f97\u5f88\u602a\u5f02\uff0c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u7684\u4e2d\u4f4e\u7aef\u670d\u88c5\u4f5c\u574a\u66f4\u662f\u6210\u7fa4\u7ed3\u961f\uff0c\u8fd8\u771f\u6709\u4e09\u5e74\u6ca1\u75ab\u60c5\u611f\u67d3\u7684\u79bb\u8c31\uff1b\u4ece\u4e1a\u8005\u51e0\u4e4e\u662f\u6e56\u5317\u90a3\u4e9b\u52a1\u5de5\u8005\uff0c\u6587\u5316\u7a0b\u5ea6\u4f4e\u3001\u9632\u8303\u610f\u8bc6\u5dee\uff0c\u4ee4\u4eba\u611f\u5230\u538c\u6076\u3002"
