    "output": {
        "original_text": "\u75ab\u60c5\u4e09\u5e74\u6ca1\u56de\u5a46\u5bb6\u8fc7\u5e74\uff0c\u4eca\u5e74\u56de\u53bb\u4e86\u3002\u4eca\u5929\u4e0b\u5348\u88ab\u5a46\u5a46\u5a18\u5bb6\u4eb2\u621a\u50ac\u751f\u4e8c\u80ce\uff0c\u53ef\u7b97\u8ba9\u6211\u7b49\u5230\u8003\u9898\u4e86\uff0c\u8ddf\u8bf4\u5355\u53e3\u76f8\u58f0\u4e00\u6837\uff0c\u8868\u660e\u4e86\u6211\u4e0d\u751f\u4e8c\u80ce\u53ea\u8981\u4e00\u4e2a\u5b69\u5b50\u7684\u60f3\u6cd5\uff0c\u5230\u540e\u9762\u4eb2\u621a\u4eec\u4e5f\u4e0d\u8bf4\u4ec0\u4e48\u4e86\u3002\u751a\u81f3\u8001\u516c\u7684\u5c0f\u8205\u5988\u8fd8\u8ddf\u6211\u8bf4\uff0c\u4e00\u4e2a\u5b69\u5b50\u633a\u597d\u7684\uff0c\u4e0d\u60f3\u751f\u4e8c\u80ce\u5c31\u4e0d\u751f\u3002\u5c0f\u8205\u5988\u771f\u662f\u795e\u4ed9\u4eb2\u621a\u3002",
        "joy": "\u7ec8\u4e8e\u8fc7\u53bb\u4e86\u4e09\u5e74\u7684\u75ab\u60c5\uff0c\u4eca\u5e74\u80fd\u56de\u5a46\u5bb6\u8fc7\u5e74\u771f\u7684\u592a\u5f00\u5fc3\u4e86\uff01\u4eca\u5929\u4e0b\u5348\u4eb2\u621a\u4eec\u50ac\u6211\u751f\u4e8c\u80ce\uff0c\u4e0d\u8fc7\u6211\u8ddf\u4ed6\u4eec\u804a\u5f97\u50cf\u8bf4\u76f8\u58f0\u4e00\u6837\uff0c\u518d\u660e\u786e\u8868\u793a\u6211\u53ea\u60f3\u8981\u4e00\u4e2a\u5b69\u5b50\u540e\uff0c\u4ed6\u4eec\u90fd\u4e0d\u518d\u4e89\u8bba\u4e86\u3002\u5c0f\u8205\u5988\u5c45\u7136\u652f\u6301\u6211\u8bf4\u4e00\u4e2a\u5b69\u5b50\u633a\u597d\uff0c\u771f\u662f\u8ba9\u6211\u611f\u53d7\u5230\u65e0\u6bd4\u7684\u6e29\u6696\uff01",
        "sadness": "\u4e09\u5e74\u7684\u75ab\u60c5\u540e\u7ec8\u4e8e\u56de\u5230\u5a46\u5bb6\u8fc7\u5e74\uff0c\u5fc3\u4e2d\u5374\u6709\u4e9b\u6c89\u91cd\u3002\u4eca\u5929\u4e0b\u5348\u88ab\u5a46\u5a46\u7684\u4eb2\u621a\u50ac\u751f\u4e8c\u80ce\uff0c\u50cf\u662f\u5728\u8003\u9898\u4e00\u6837\uff0c\u88ab\u8feb\u8868\u8fbe\u6211\u53ea\u60f3\u8981\u4e00\u4e2a\u5b69\u5b50\u7684\u5fc3\u60c5\uff0c\u4eb2\u621a\u4eec\u5374\u6ca1\u6709\u7ed9\u6211\u66f4\u591a\u7684\u7406\u89e3\u3002\u751a\u81f3\u5c0f\u8205\u5988\u90a3\u53e5\u4e00\u4e2a\u5b69\u5b50\u633a\u597d\u7684\uff0c\u4e5f\u6ca1\u80fd\u8ba9\u6211\u653e\u4e0b\u5fc3\u4e2d\u7684\u6101\u7eea\u3002",
        "fear": "\u56de\u5a46\u5bb6\u8fc7\u5e74\u7adf\u7136\u8ba9\u6211\u611f\u5230\u4e00\u9635\u7d27\u5f20\uff0c\u611f\u89c9\u5230\u4e09\u5e74\u75ab\u60c5\u540e\u7b2c\u4e00\u6b21\u548c\u5a46\u5bb6\u4eb2\u621a\u89c1\u9762\uff0c\u4ed6\u4eec\u7adf\u7136\u50ac\u6211\u751f\u4e8c\u80ce\uff0c\u5fc3\u4e2d\u5f00\u59cb\u62c5\u5fc3\u8be5\u600e\u4e48\u56de\u5e94\u3002\u5f3a\u8feb\u81ea\u5df1\u50cf\u5728\u8bf4\u5355\u53e3\u76f8\u58f0\u4e00\u6837\uff0c\u8868\u660e\u6211\u53ea\u60f3\u8981\u4e00\u4e2a\u5b69\u5b50\uff0c\u4f46\u6211\u4e0d\u77e5\u9053\u4ed6\u4eec\u4f1a\u6709\u4ec0\u4e48\u53cd\u5e94\u3002\u8fde\u5c0f\u8205\u5988\u4e5f\u8bf4\u4e00\u4e2a\u5b69\u5b50\u633a\u597d\u7684\uff0c\u6211\u7684\u5185\u5fc3\u66f4\u52a0\u5fd0\u5fd1\u3002",
        "anger": "\u4e09\u5e74\u75ab\u60c5\u6ca1\u56de\u5a46\u5bb6\uff0c\u7ed3\u679c\u4eca\u5929\u4e00\u56de\u6765\u5c31\u88ab\u4eb2\u621a\u4eec\u50ac\u6211\u751f\u4e8c\u80ce\uff0c\u771f\u8ba9\u4eba\u751f\u6c14\uff01\u6211\u5c31\u50cf\u5728\u8bf4\u5355\u53e3\u76f8\u58f0\u4e00\u6837\u62fc\u547d\u8868\u8fbe\u6211\u53ea\u60f3\u8981\u4e00\u4e2a\u5b69\u5b50\uff0c\u4f46\u4ed6\u4eec\u90fd\u4e0d\u613f\u610f\u542c\u3002\u5c45\u7136\u8fde\u5c0f\u8205\u5988\u4e5f\u8ddf\u6211\u8bf4\u4e00\u4e2a\u5b69\u5b50\u633a\u597d\uff0c\u8fd9\u7b97\u4ec0\u4e48\u652f\u6301\uff01\u771f\u662f\u6c14\u6b7b\u4eba\u4e86\uff01",
        "surprise": "\u7ecf\u5386\u4e86\u4e09\u5e74\u75ab\u60c5\uff0c\u4eca\u5929\u56de\u5230\u5a46\u5bb6\u8fc7\u5e74\uff0c\u6ca1\u6599\u5230\u4e0b\u5348\u88ab\u5a46\u5a46\u7684\u4eb2\u621a\u50ac\u751f\u4e8c\u80ce\uff0c\u771f\u8ba9\u4eba\u60ca\u8bb6\uff01\u6211\u50cf\u662f\u5728\u8bf4\u5355\u53e3\u76f8\u58f0\u4e00\u6837\uff0c\u60ca\u559c\u5730\u8868\u8fbe\u51fa\u6211\u53ea\u60f3\u8981\u4e00\u4e2a\u5b69\u5b50\u7684\u60f3\u6cd5\uff0c\u4e4b\u540e\u4eb2\u621a\u4eec\u7adf\u7136\u90fd\u4e0d\u518d\u575a\u6301\u4e86\u3002\u66f4\u4ee4\u6211\u60ca\u8bb6\u7684\u662f\u5c0f\u8205\u5988\u7684\u770b\u6cd5\uff0c\u5979\u5c45\u7136\u8bf4\u4e00\u4e2a\u5b69\u5b50\u633a\u597d\u7684\uff0c\u771f\u662f\u4e2a\u795e\u4ed9\u4eb2\u621a\uff01",
        "disgust": "\u4e09\u5e74\u75ab\u60c5\u540e\u7ec8\u4e8e\u56de\u5a46\u5bb6\u8fc7\u5e74\uff0c\u4f46\u4eca\u5929\u4e0b\u5348\u5a46\u5a46\u7684\u4eb2\u621a\u5374\u6765\u50ac\u4fc3\u751f\u4e8c\u80ce\uff0c\u771f\u8ba9\u4eba\u89c9\u5f97\u6076\u5fc3\uff01\u6211\u597d\u50cf\u662f\u5728\u8bf4\u5355\u53e3\u76f8\u58f0\uff0c\u52c9\u5f3a\u8868\u660e\u53ea\u60f3\u6709\u4e00\u4e2a\u5b69\u5b50\u7684\u60f3\u6cd5\uff0c\u4f46\u540e\u9762\u4eb2\u621a\u4eec\u7684\u6001\u5ea6\u8ba9\u6211\u96be\u4ee5\u5fcd\u53d7\u3002\u5c0f\u8205\u5988\u8bf4\u4e00\u4e2a\u5b69\u5b50\u633a\u597d\uff0c\u6211\u5fc3\u91cc\u6ee1\u662f\u538c\u6076\uff0c\u8fd9\u6837\u7684\u5bb6\u4eba\u771f\u662f\u6d88\u8017\u6211\u7684\u8010\u5fc3\uff01"
