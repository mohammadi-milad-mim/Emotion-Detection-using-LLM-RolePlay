        "anger": "\u623f\u4ef7\u7adf\u7136\u4e03\u516b\u5343\uff0c\u6708\u5de5\u8d44\u53ea\u6709\u4e24\u4e09\u5343\u3002\u4e00\u5e74\u4e0d\u505c\u5403\u559d\u4e5f\u4e0d\u8fc7\u4e09\u4e07\uff0c\u5341\u5e74\u624d\u4e09\u5341\u4e07\u3002140\u5e73\u65b9\u7684\u623f\u5b50\u52a8\u4e0d\u52a8\u5c31\u767e\u6765\u4e07\uff0c\u88c5\u4fee\u53c8\u8981\u4e8c\u4e09\u5341\u4e07\u3002\u53ef\u8fd9\u8bdd\u8bf4\u5f97\u591a\u79bb\u8c31\uff01\u5728\u5f53\u5730\u5de5\u4f5c\uff0c\u4e0d\u5403\u4e0d\u559d\u56db\u5341\u5e74\u624d\u80fd\u5e99\u4e70\u623f\uff01\u81f3\u4e8e\u90a3\u4e9b\u5927\u57ce\u5e02\u7684\u623f\u5b50\uff0c\u4e03\u516b\u4e07\u4e00\u5e73\uff0c\u5de5\u8d44\u624d\u4e03\u516b\u5343\uff0c\u4e0d\u5403\u4e0d\u559d\u4e00\u5e74\u79ef\u6512\u516b\u4e5d\u4e07\uff0c\u7ed3\u679c\u53ea\u591f\u4e70\u5230\u4e00\u5e73\uff0c\u96be\u9053\u771f\u8981\u4e00\u767e\u5e74\u624d\u80fd\u4e70\u5230100\u5e73\u7684\u623f\u5b50\u5417\uff1f\u8fd9\u79cd\u8352\u8c2c\u7684\u4ed8\u51fa\u548c\u56de\u62a5\u7b80\u76f4\u8ba9\u6211\u6012\u706b\u4e2d\u70e7\u3002",
        "surprise": "\u623f\u4ef7\u5c45\u7136\u4e03\u516b\u5343\uff0c\u6708\u5de5\u8d44\u7adf\u7136\u53ea\u6709\u4e24\u4e09\u5343\uff01\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u624d\u4e09\u4e07\uff0c\u5341\u5e74\u603b\u5171\u4e09\u5341\u4e07\u3002140\u5e73\u65b9\u7684\u623f\u5b50\u7adf\u7136\u8981\u767e\u6765\u4e07\uff0c\u88c5\u4fee\u8fd8\u8981\u4e8c\u4e09\u5341\u4e07\u3002\u4e5f\u5c31\u662f\u8bf4\uff0c\u5728\u5f53\u5730\u5de5\u4f5c\uff0c\u4e0d\u5403\u4e0d\u559d\u56db\u5341\u5e74\u624d\u80fd\u4e70\u5f97\u8d77\u4e00\u5957\u623f\u5b50\uff1f\u800c\u5728\u5927\u57ce\u5e02\uff0c\u4e03\u516b\u4e07\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u5de5\u8d44\u4e03\u516b\u5343\uff0c\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u53ea\u6512\u516b\u4e5d\u4e07\uff0c\u4e00\u5e74\u53ea\u80fd\u4e70\u4e00\u5e73\uff0c\u96be\u9053\u4e00\u767e\u5e74\u624d\u80fd\u4e70\u5230100\u5e73\u7684\u623f\u5b50\uff1f\u8fd9\u4ed8\u51fa\u56de\u62a5\u6bd4\u592a\u51fa\u4e4e\u610f\u6599\u4e86\uff01",
