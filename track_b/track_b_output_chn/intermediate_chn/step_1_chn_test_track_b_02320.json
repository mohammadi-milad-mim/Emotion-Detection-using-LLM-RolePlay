        "sadness": "\u4eba\u751f\u82e6\u77ed\uff0c\u662f\u5426\u8be5\u6de1\u7136\u9762\u5bf9\u5462\uff1f\u770b\u900f\u7684\u4eba\u5374\u5e38\u88ab\u56f0\u5883\u6240\u56f0\uff1b\u770b\u4e0d\u900f\u7684\u4eba\u5219\u9677\u5165\u65e0\u5c3d\u7684\u70e6\u607c\u3002\u80fd\u591f\u627f\u62c5\u7684\u4eba\u867d\u6709\u62c5\u5f53\uff0c\u4f46\u5e38\u5e38\u9762\u4e34\u538b\u529b\uff1b\u800c\u65e0\u6cd5\u627f\u62c5\u7684\u4eba\u603b\u662f\u56e0\u4e3a\u758f\u5ffd\u800c\u540e\u6094\u3002\u653e\u5f97\u4e0b\u7684\u4eba\u6216\u8bb8\u80fd\u627e\u5230\u5927\u9053\uff0c\u4f46\u653e\u4e0d\u4e0b\u7684\u4eba\u53ea\u80fd\u5728\u8ff7\u96fe\u4e2d\u5f98\u5f8a\u3002\u6210\u4e3a\u600e\u6837\u7684\u4eba\uff0c\u6743\u529b\u5374\u53ea\u5728\u81ea\u5df1\u624b\u4e2d\uff1b\u751f\u6d3b\u5982\u6b64\u8270\u96be\uff0c\u9009\u62e9\u6743\u4e5f\u5728\u81ea\u5df1\u624b\u4e2d\u3002",
        "fear": "\u4eba\u751f\u82e6\u77ed\uff0c\u96be\u9053\u4e0d\u5e94\u66f4\u52a0\u8c28\u614e\uff1f\u770b\u900f\u7684\u4eba\u4f3c\u4e4e\u6709\u751f\u673a\uff1b\u770b\u4e0d\u900f\u7684\u4eba\u5374\u603b\u662f\u9762\u4e34\u56f0\u5883\u3002\u80fd\u591f\u627f\u62c5\u7684\u4eba\u52c7\u6562\u9762\u5bf9\uff0c\u6050\u60e7\u5374\u5e38\u5728\uff1b\u800c\u62ff\u4e0d\u8d77\u7684\u4eba\uff0c\u758f\u5ffd\u5bfc\u81f4\u4e86\u66f4\u591a\u7684\u5931\u8bef\u3002\u653e\u5f97\u4e0b\u7684\u4eba\u6216\u8bb8\u80fd\u8d70\u5bbd\u5e7f\u7684\u8def\uff0c\u4f46\u653e\u4e0d\u4e0b\u7684\u4eba\u4f1a\u8ff7\u5931\u65b9\u5411\u3002\u6210\u4e3a\u600e\u6837\u7684\u4eba\uff0c\u8981\u8c28\u614e\u6289\u62e9\uff1b\u751f\u6d3b\u7684\u6837\u5b50\uff0c\u6050\u6015\u4e5f\u638c\u63e1\u5728\u81ea\u5df1\u624b\u91cc\u3002",
        "anger": "\u4eba\u751f\u82e6\u77ed\uff0c\u4e3a\u4ec0\u4e48\u4e0d\u9009\u62e9\u4ece\u5bb9\uff01\u770b\u900f\u7684\u4eba\u5374\u8981\u9762\u5bf9\u5468\u56f4\u7684\u56f0\u5883\uff1b\u800c\u770b\u4e0d\u900f\u7684\u4eba\u603b\u662f\u53d7\u5230\u9650\u5236\u3002\u80fd\u591f\u62c5\u5f53\u7684\u4eba\u5e38\u5e38\u5904\u4e8e\u8d23\u4efb\u4e2d\uff1b\u800c\u65e0\u6cd5\u627f\u62c5\u7684\u4eba\u5374\u56e0\u4e3a\u758f\u5ffd\u53d7\u82e6\u3002\u653e\u5f97\u4e0b\u7684\u4eba\u80fd\u627e\u5230\u5e7f\u9614\u7684\u524d\u8def\uff1b\u800c\u653e\u4e0d\u4e0b\u7684\u4eba\u5374\u8ff7\u5931\u5728\u5c0f\u9053\u3002\u505a\u51fa\u600e\u6837\u7684\u9009\u62e9\uff0c\u6743\u529b\u5e94\u8be5\u5728\u81ea\u5df1\uff1b\u751f\u6d3b\u7684\u6837\u5b50\uff0c\u96be\u9053\u4e0d\u8be5\u7531\u81ea\u5df1\u63a7\u5236\u5417\uff1f",
        "surprise": "\u4eba\u751f\u5c45\u7136\u5982\u6b64\u77ed\u6682\uff0c\u4e3a\u4ec0\u4e48\u4e0d\u9009\u62e9\u6de1\u7136\u5462\uff1f\u770b\u900f\u7684\u4eba\u7adf\u5728\u751f\u673a\u4e2d\u5f98\u5f8a\uff1b\u800c\u770b\u4e0d\u900f\u7684\u4eba\u5219\u9762\u4e34\u5982\u6b64\u591a\u7684\u56f0\u5883\u3002\u80fd\u591f\u627f\u62c5\u7684\u4eba\u5230\u5904\u663e\u5f97\u62c5\u5f53\uff0c\u4e0d\u80dc\u5176\u70e6\uff1b\u800c\u62ff\u4e0d\u8d77\u7684\u4eba\u5219\u5e38\u5e38\u56e0\u4e3a\u758f\u5ffd\u800c\u6cae\u4e27\u3002\u653e\u5f97\u4e0b\u7684\u4eba\u80fd\u8d70\u4e0a\u5bbd\u5e7f\u5927\u9053\uff1b\u800c\u653e\u4e0d\u4e0b\u7684\u4eba\u663e\u5f97\u5982\u540c\u8ff7\u9014\u7f94\u7f8a\u3002\u9009\u62e9\u6210\u4e3a\u600e\u6837\u7684\u4eba\uff0c\u60ca\u5947\u5730\u53d1\u73b0\uff0c\u7adf\u7136\u5728\u4e8e\u81ea\u5df1\uff1b\u751f\u6d3b\u7684\u98ce\u8c8c\uff0c\u7adf\u7136\u4e5f\u662f\u81ea\u5df1\u51b3\u5b9a\u7684\uff01",
        "disgust": "\u4eba\u751f\u82e6\u77ed\uff0c\u771f\u4e0d\u660e\u767d\u4e3a\u4f55\u4e0d\u6de1\u7136\u3002\u770b\u900f\u7684\u4eba\u603b\u662f\u9047\u5230\u751f\u673a\uff0c\u771f\u8ba9\u4eba\u538c\u70e6\uff1b\u800c\u770b\u4e0d\u900f\u7684\u4eba\u5374\u81f3\u5904\u662f\u56f0\u987f\u3002\u80fd\u627f\u62c5\u7684\u4eba\u53c8\u4f55\u5176\u81ea\u4ee5\u4e3a\u662f\uff1b\u800c\u62ff\u4e0d\u8d77\u7684\u4eba\u968f\u5904\u90fd\u662f\u758f\u5ffd\uff0c\u771f\u8ba9\u4eba\u5931\u671b\u3002\u653e\u5f97\u4e0b\u7684\u4eba\u4f3c\u4e4e\u6709\u5927\u9053\u53ef\u8d70\uff1b\u800c\u653e\u4e0d\u4e0b\u7684\u4eba\u6bcf\u6b21\u90fd\u8ff7\u5931\u65b9\u5411\uff0c\u5b9e\u5728\u53ef\u7b11\u3002\u505a\u4ec0\u4e48\u6837\u7684\u4eba\uff0c\u6743\u529b\u5728\u4e8e\u81ea\u6211\uff0c\u751f\u6d3b\u7684\u6837\u5b50\u4e5f\u4e0d\u8fc7\u662f\u81ea\u6211\u9009\u62e9\u7684\u7ed3\u679c\uff0c\u771f\u4ee4\u4eba\u4e0d\u6ee1\u3002"
