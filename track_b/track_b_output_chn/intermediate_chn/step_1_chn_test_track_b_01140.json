        "disgust": "\u6211\u5b9e\u5728\u4e0d\u660e\u767d\u6d1b\u9633\u7684\u8fd4\u4e61\u653f\u7b56\uff0c\u5176\u4ed6\u7701\u4efd\u7684\u653f\u7b56\u5982\u6b64\u5408\u7406\u8ba9\u6211\u611f\u5230\u6076\u5fc3\u3002\u4e0d\u8981\u8bf4\u548c\u5f00\u653e\u7684\u5927\u57ce\u5e02\u76f8\u6bd4\uff0c\u5c31\u8fde\u540c\u7ea7\u522b\u7684\u57ce\u5e02\u90fd\u6bd4\u6d1b\u9633\u7075\u6d3b\u3002\u867d\u7136\u6211\u53ef\u4ee5\u7406\u89e3\u6297\u75ab\u7684\u8270\u96be\uff0c\u4f46\u5728\u6625\u8282\u8fd9\u4e2a\u65f6\u523b\uff0c\u4e3a\u4ec0\u4e48\u4e0d\u80fd\u5206\u5c42\u5206\u7ea7\u7ba1\u7406\u5462\uff1f\u96be\u9053\u771f\u7684\u6709\u8c01\u4f1a\u6076\u610f\u8fd4\u4e61\u5417\uff1f\u8fd9\u79cd\u4e00\u5200\u5207\u7684\u653f\u7b56\u8ba9\u90a3\u4e9b\u4e3a\u6d1b\u9633\u5c3d\u5fc3\u5ba3\u4f20\u7684\u4eba\u611f\u5230\u538c\u6076\u3002"
