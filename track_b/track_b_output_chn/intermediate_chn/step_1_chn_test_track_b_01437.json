        "joy": "\u603b\u89c9\u5f97\u8fd9\u6b21\u75ab\u60c5\u867d\u7136\u6709\u4e9b\u5947\u602a\uff0c\u4f46\u5927\u5bb6\u771f\u7684\u5f88\u56e2\u7ed3\uff01\u5373\u4fbf\u662f\u5728\u4e4b\u524d\u8fde3\u5e74\u6ca1\u6709\u75ab\u60c5\u7684\u5730\u65b9\uff0c\u73b0\u5728\u4e5f\u4e00\u8d77\u7ecf\u5386\u4e86\u5c01\u63a7\u548c\u9632\u62a4\uff0c\u5927\u5bb6\u90fd\u5728\u52aa\u529b\u4fdd\u62a4\u5f7c\u6b64\uff0c\u75ab\u60c5\u4eba\u6570\u867d\u7136\u4e0a\u5347\uff0c\u4f46\u662f\u6211\u4eec\u4f9d\u7136\u5145\u6ee1\u5e0c\u671b\u3002\u770b\u5230\u4e00\u4e9b\u4e0d\u548c\u8c10\u7684\u58f0\u97f3\uff0c\u4f46\u4f5c\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u6211\u975e\u5e38\u7231\u8fd9\u4e2a\u57ce\u5e02\uff0c\u5e76\u575a\u4fe1\u653f\u5e9c\u5728\u52aa\u529b\u8ba9\u6211\u4eec\u90fd\u80fd\u5ea6\u8fc7\u96be\u5173\u3002\u6211\u4eec\u5728\u4e00\u8d77\u7684\u6b63\u80fd\u91cf\u624d\u662f\u6700\u91cd\u8981\u7684\u3002",
        "sadness": "\u603b\u89c9\u5f97\u8fd9\u6b21\u7684\u75ab\u60c5\u6709\u4e9b\u5947\u602a\uff0c\u66fe\u7ecf\u6211\u4eec\u6240\u5728\u7684\u533a\u8fde3\u5e74\u90fd\u6ca1\u6709\u75ab\u60c5\uff0c\u7a81\u7136\u4e5f\u6709\u51e0\u4e2a\u75c5\u4f8b\uff0c\u88ab\u5c01\u4e86\u4e00\u5468\uff0c\u8eab\u8fb9\u7684\u670b\u53cb\u90fd\u5728\u4e25\u9632\u6b7b\u5b88\uff0c\u4f46\u4e3a\u4ec0\u4e48\u75ab\u60c5\u4eba\u6570\u5374\u5230\u4e86\u4e09\u5e74\u4e4b\u6700\u3002\u770b\u5230\u90a3\u4e9b\u66b4\u4e71\uff0c\u5fc3\u4e2d\u5f88\u96be\u8fc7\u2026\u2026\u4f5c\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u6211\u662f\u5982\u6b64\u70ed\u7231\u7f8a\u57ce\uff0c\u66fe\u7ecf\u4ee5\u4e3a\u653f\u5e9c\u4f1a\u505a\u5f97\u5f88\u597d\uff0c\u73b0\u5728\u5374\u53ea\u80fd\u5728\u5fc3\u91cc\u9ed8\u9ed8\u5fe7\u4f24\u3002\u6211\u4eec\u53ea\u80fd\u9762\u5bf9\u8fd9\u4efd\u65e0\u5948\u3002",
        "fear": "\u6211\u603b\u611f\u89c9\u8fd9\u6b21\u75ab\u60c5\u6709\u4e9b\u5947\u602a\uff0c\u660e\u660e\u6211\u4eec\u6240\u5728\u7684\u533a\u8fde3\u5e74\u6ca1\u75ab\u60c5\u7684\u5730\u65b9\uff0c\u7a81\u7136\u5c31\u51fa\u73b0\u4e86\u51e0\u4e2a\u75c5\u4f8b\uff0c\u88ab\u5c01\u4e86\u4e00\u5468\uff0c\u8eab\u8fb9\u7684\u670b\u53cb\u90fd\u662f\u4e25\u9632\u6b7b\u5b88\uff0c\u4f46\u4e3a\u4ec0\u4e48\u75ab\u60c5\u4eba\u6570\u7adf\u7136\u5230\u4e86\u4e09\u5e74\u4e4b\u6700\u3002\u518d\u770b\u5230\u90a3\u4e9b\u66b4\u4e71\uff0c\u6211\u611f\u5230\u6050\u614c\u2026\u2026\u4f5c\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u867d\u7136\u6211\u70ed\u7231\u8fd9\u91cc\uff0c\u53ef\u662f\u9762\u5bf9\u8fd9\u6837\u7684\u5c40\u52bf\uff0c\u6211\u5f00\u59cb\u4e0d\u5b89\u3002\u597d\u5fc3\u60c5\u4e5f\u88ab\u538b\u6291\u7740\uff0c\u6211\u53ea\u80fd\u6218\u6218\u5162\u5162\u5730\u89c2\u5bdf\u5468\u56f4\u7684\u4e00\u5207\u3002",
        "anger": "\u603b\u89c9\u5f97\u8fd9\u6b21\u7684\u75ab\u60c5\u5f88\u5947\u602a\uff0c\u660e\u660e\u6211\u4eec\u6240\u5728\u7684\u533a\u7adf\u7136\u8fde3\u5e74\u6ca1\u6709\u75ab\u60c5\u7684\u5730\u65b9\uff0c\u7a81\u7136\u4e5f\u88ab\u5c01\u4e86\u4e00\u5468\uff01\u8eab\u8fb9\u7684\u670b\u53cb\u90fd\u662f\u4e25\u9632\u6b7b\u5b88\uff0c\u75ab\u60c5\u4eba\u6570\u5374\u504f\u504f\u649e\u4e0a\u4e09\u5e74\u4e4b\u6700\u3002\u8fd8\u6709\u90a3\u4e9b\u66b4\u4e71\u2026\u2026\u4f5c\u4e3a\u4e00\u4e2a\u6f6e\u6c55\u4eba\uff0c\u6211\u975e\u5e38\u7231\u7f8a\u57ce\uff0c\u603b\u89c9\u5f97\u653f\u5e9c\u5728\u8fd9\u65b9\u9762\u505a\u5f97\u4e0d\u591f\u597d\u3002\u600e\u4e48\u603b\u662f\u6709\u4eba\u60f3\u7528\u201c\u597d\u5fc3\u60c5\u201d\u7ed9\u5e7f\u5dde\u6dfb\u5835\uff0c\u8ba9\u6211\u4eec\u611f\u5230\u6124\u6012\uff0c\u6211\u53ea\u80fd\u628a\u8fd9\u4e9b\u770b\u89c1\u7684\u4e0d\u6ee1\u53d1\u6cc4\u51fa\u6765\u3002",
        "surprise": "\u6211\u89c9\u5f97\u8fd9\u6b21\u7684\u75ab\u60c5\u5b9e\u5728\u6709\u70b9\u5947\u602a\uff0c\u5c45\u7136\u662f\u5728\u6211\u4eec\u6240\u5728\u7684\u533a\uff0c\u8fde3\u5e74\u6ca1\u6709\u75ab\u60c5\u7684\u5730\u65b9\uff0c\u7a81\u5982\u5176\u6765\u5730\u51fa\u73b0\u4e86\u51e0\u4e2a\u75c5\u4f8b\uff0c\u88ab\u5c01\u4e86\u4e00\u5468\uff0c\u8fd9\u771f\u662f\u8ba9\u4eba\u60ca\u8bb6\uff01\u8eab\u8fb9\u7684\u670b\u53cb\u4eec\u90fd\u5728\u4e25\u9632\u6b7b\u5b88\uff0c\u4f46\u75ab\u60c5\u4eba\u6570\u5374\u53cd\u800c\u521b\u4e0b\u4e09\u5e74\u4e4b\u6700\u3002\u518d\u89c1\u5230\u66b4\u4e71\u7684\u60c5\u51b5\u2026\u2026\u4f5c\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u6211\u4e00\u76f4\u5f88\u7231\u7f8a\u57ce\uff0c\u6ca1\u60f3\u5230\u653f\u5e9c\u5728\u5904\u7406\u8fd9\u4e9b\u4e8b\u60c5\u65f6\u7adf\u7136\u4f1a\u5982\u6b64\u3002\u771f\u662f\u8ba9\u4eba\u610f\u5916\uff0c\u6211\u53ea\u80fd\u9ed8\u9ed8\u5730\u89c2\u5bdf\u8fd9\u4e00\u5207\u3002",
        "disgust": "\u6211\u603b\u89c9\u5f97\u8fd9\u6b21\u75ab\u60c5\u771f\u4ee4\u4eba\u4e0d\u5feb\uff0c\u660e\u660e\u6211\u4eec\u6240\u5728\u7684\u533a\u8fde3\u5e74\u90fd\u6ca1\u6709\u75ab\u60c5\uff0c\u73b0\u5728\u5374\u53d1\u751f\u8fd9\u79cd\u72b6\u51b5\uff0c\u7a81\u7136\u5192\u51fa\u51e0\u4e2a\u75c5\u4f8b\uff0c\u88ab\u5c01\u4e86\u4e00\u5468\uff0c\u8eab\u8fb9\u7684\u670b\u53cb\u4eec\u90fd\u662f\u4e25\u9632\u6b7b\u5b88\uff0c\u5374\u504f\u504f\u75ab\u60c5\u4eba\u6570\u6c34\u6da8\u8239\u9ad8\u3002\u518d\u770b\u5230\u90a3\u4e9b\u51b2\u7a81\u2026\u2026\u4f5c\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u867d\u7136\u6211\u5f88\u7231\u7f8a\u57ce\uff0c\u4f46\u8fd9\u4e9b\u6df7\u4e71\u8ba9\u6211\u89c9\u5f97\u6076\u5fc3\u3002\u603b\u6709\u4e00\u4e9b\u201c\u597d\u5fc3\u60c5\u201d\u60f3\u7ed9\u5e7f\u5dde\u6dfb\u5835\uff0c\u8fd9\u79cd\u72b6\u51b5\u8ba9\u6211\u65e0\u6cd5\u5bb9\u5fcd\uff0c\u6211\u53ea\u80fd\u5bf9\u5468\u56f4\u7684\u4e00\u5207\u611f\u5230\u538c\u70e6\u3002"
