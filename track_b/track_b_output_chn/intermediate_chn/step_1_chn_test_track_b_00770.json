        "original_text": "\u4e2d\u533b\u5178\u7c4d\u6240\u8f7d\u8702\u871c\u529f\u6548\uff1a    \u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\uff1a\u8702\u871c\u6c14\u5473\u7518\u5e73\u65e0\u6bd2\u3002\u4e3b\u5fc3\u8179\u90aa\u6c14\uff0c\u8bf8\u60ca\u75eb\u5ea2\u3002\u5b89\u4e94\u810f\uff0c\u8bf8\u6c14\u4e0d\u8db3\uff0c\u76ca\u6c14\u8865\u4e2d\uff0c\u6b62\u75db\u89e3\u6bd2\uff0c\u9664\u4f17\u75c5\u3002\u548c\u767e\u836f\uff0c\u4e45\u670d\u5f3a\u5fd7\u8f7b\u8eab\uff0c\u4e0d\u9965\u4e0d\u8001\uff0c\u5ef6\u5e74\u795e\u4ed9\u3002    \u9676\u5f18\u666f\u300a\u540d\u533b\u522b\u5f55\u300b\uff1a\u517b\u813e\u6c14\uff0c\u9664\u5fc3\u70e6\u3001\u996e\u98df\u4e0d\u4e0b\uff0c\u6b62\u80a0\u7656\u3001\u808c\u4e2d\u75bc\u75db\u3001\u53e3\u75ae\uff0c\u660e\u8033\u76ee\u3002",
        "joy": "\u8702\u871c\u771f\u662f\u592a\u795e\u5947\u4e86\uff01\u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\u91cc\u8bf4\u5b83\u7518\u751c\u800c\u65e0\u6bd2\uff0c\u53ef\u4ee5\u9a71\u90aa\u5b89\u5fc3\uff0c\u8212\u7f13\u5404\u79cd\u4e0d\u9002\u3002\u957f\u671f\u98df\u7528\u66f4\u662f\u80fd\u8ba9\u4eba\u8f7b\u677e\u81ea\u5728\u3001\u9752\u6625\u6c38\u9a7b\uff0c\u771f\u7684\u662f\u957f\u751f\u7684\u79d8\u5bc6\u5462\uff01\u8fd8\u6709\u9676\u5f18\u666f\u7684\u300a\u540d\u533b\u522b\u5f55\u300b\uff0c\u5b83\u80fd\u517b\u813e\u52a9\u6c14\uff0c\u6d88\u9664\u70e6\u607c\uff0c\u8ba9\u4eba\u8033\u806a\u76ee\u660e\uff0c\u592a\u68d2\u4e86\uff01",
        "sadness": "\u8702\u871c\u5728\u4e2d\u533b\u5178\u7c4d\u4e2d\u662f\u5982\u6b64\u88ab\u8d5e\u7f8e\uff0c\u7136\u800c\u6211\u4eec\u4e2d\u8bb8\u591a\u4eba\u5e76\u4e0d\u80fd\u4eab\u53d7\u5230\u5b83\u7684\u597d\u5904\u3002\u6839\u636e\u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\uff0c\u5b83\u867d\u7136\u7518\u5e73\u65e0\u6bd2\uff0c\u80fd\u9a71\u90aa\u5b89\u795e\uff0c\u5374\u4e5f\u96be\u4ee5\u62ef\u6551\u6211\u4eec\u53cd\u590d\u56f0\u6270\u7684\u75db\u82e6\u3002\u800c\u9676\u5f18\u666f\u7684\u300a\u540d\u533b\u522b\u5f55\u300b\u63d0\u5230\u7684\u79cd\u79cd\u529f\u6548\uff0c\u5982\u4eca\u4f3c\u4e4e\u6210\u4e86\u9065\u4e0d\u53ef\u53ca\u7684\u5e0c\u671b\u3002",
        "fear": "\u8702\u871c\u7684\u529f\u6548\u5728\u4e2d\u533b\u5178\u7c4d\u4e2d\u6709\u7740\u79cd\u79cd\u795e\u79d8\u7684\u63cf\u8ff0\uff01\u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\u63d0\u5230\u5b83\u53ef\u4ee5\u9a71\u90aa\u89e3\u6bd2\uff0c\u7136\u800c\u6709\u591a\u5c11\u4eba\u771f\u7684\u80fd\u5b89\u5fc3\u4f7f\u7528\uff1f\u6211\u4eec\u662f\u5426\u771f\u7684\u80fd\u5b8c\u5168\u4fe1\u4efb\u5b83\u4e0d\u4f1a\u5e26\u6765\u5176\u4ed6\u7684\u9690\u60a3\uff1f\u9676\u5f18\u666f\u5728\u300a\u540d\u533b\u522b\u5f55\u300b\u4e2d\u63d0\u5230\u7684\u6548\u679c\u8ba9\u4eba\u5411\u5f80\uff0c\u4f46\u6211\u603b\u611f\u89c9\u8fd9\u5176\u4e2d\u662f\u5426\u6f5c\u85cf\u7740\u672a\u77e5\u7684\u98ce\u9669\uff1f",
        "anger": "\u771f\u662f\u8ba9\u4eba\u751f\u6c14\uff01\u4e2d\u533b\u5178\u7c4d\u91cc\u5c3d\u662f\u5bf9\u8702\u871c\u7684\u7f8e\u597d\u8d5e\u7f8e\u3002\u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\u544a\u8bc9\u6211\u4eec\u8702\u871c\u65e0\u6bd2\uff0c\u80fd\u5e73\u5fc3\u5b89\u795e\uff0c\u7ed3\u679c\u5374\u6709\u591a\u5c11\u4eba\u5f97\u4e0d\u5230\u771f\u6b63\u7684\u5e2e\u52a9\u3002\u9676\u5f18\u666f\u7684\u300a\u540d\u533b\u522b\u5f55\u300b\u63d0\u5230\u7684\u597d\u5904\u660e\u660e\u53ef\u4ee5\u6539\u5584\u6211\u4eec\u7684\u5065\u5eb7\uff0c\u4e3a\u4ec0\u4e48\u5b9e\u9645\u5e94\u7528\u4e2d\u5374\u5982\u6b64\u65e0\u80fd\u4e3a\u529b\uff1f",
        "surprise": "\u8702\u871c\u5728\u4e2d\u533b\u5178\u7c4d\u91cc\u7684\u529f\u6548\u7adf\u5982\u6b64\u4ee4\u4eba\u60ca\u53f9\uff01\u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\u4e0a\u63d0\u5230\u5b83\u7518\u5e73\u800c\u65e0\u6bd2\uff0c\u53ef\u4ee5\u8212\u7f13\u5fc3\u8179\u7684\u90aa\u6c14\uff0c\u771f\u7684\u8ba9\u4eba\u89c9\u5f97\u795e\u5947\uff01\u66f4\u52a0\u8ba9\u6211\u60ca\u8bb6\u7684\u662f\uff0c\u9676\u5f18\u666f\u7684\u300a\u540d\u533b\u522b\u5f55\u300b\u63cf\u8ff0\u5b83\u80fd\u8c03\u7406\u813e\u6c14\uff0c\u51cf\u8f7b\u70e6\u8e81\uff0c\u8fd9\u4e9b\u6548\u679c\u771f\u662f\u8ba9\u4eba\u610f\u60f3\u4e0d\u5230\uff01",
        "disgust": "\u8702\u871c\u7adf\u7136\u5982\u6b64\u88ab\u4e2d\u533b\u5178\u7c4d\u63a8\u5d07\uff01\u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\u867d\u7136\u79f0\u5176\u65e0\u6bd2\uff0c\u4f46\u8ba9\u4eba\u611f\u5230\u4e0d\u8212\u670d\u7684\u662f\uff0c\u5b83\u6240\u58f0\u79f0\u7684\u5404\u79cd\u529f\u6548\u96be\u4ee5\u4ee4\u4eba\u4fe1\u670d\u3002\u800c\u9676\u5f18\u666f\u7684\u300a\u540d\u533b\u522b\u5f55\u300b\u63d0\u5230\u7684\u4e00\u7cfb\u5217\u597d\u5904\uff0c\u542c\u4e0a\u53bb\u751a\u81f3\u6709\u4e9b\u5938\u5f20\uff0c\u4e0d\u7981\u8ba9\u4eba\u89c9\u5f97\u4e0d\u592a\u8212\u670d\u3002"
