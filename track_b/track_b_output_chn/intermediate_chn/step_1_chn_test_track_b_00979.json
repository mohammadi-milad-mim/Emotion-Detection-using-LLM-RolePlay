        "disgust": "\u4e24\u5e74\u7684\u75ab\u60c5\u5df2\u7ecf\u591f\u8ba9\u4eba\u538c\u70e6\u4e86\uff0c\u4f46\u90e8\u5206\u5730\u533a\u5c45\u7136\u8fd8\u5728\u575a\u6301\u90a3\u79cd\u4e00\u5200\u5207\u7684\u9632\u75ab\u624b\u6bb5\uff0c\u5b9e\u5728\u8ba9\u4eba\u4e0d\u9f7f\u3002\u8fd9\u6837\u7684\u72b6\u6001\u8ba9\u4eba\u611f\u5230\u65e0\u529b\uff0c\u65b0\u51a0\u75c5\u6bd2\u53ef\u80fd\u771f\u7684\u4f1a\u4e0e\u4eba\u5171\u5b58\u4e0b\u53bb\uff0c\u96be\u9053\u6211\u4eec\u5c31\u8981\u7ee7\u7eed\u5fcd\u53d7\u8fd9\u6837\u7684\u5c01\u63a7\u5417\uff1f\u5e0c\u671b\u653f\u5e9c\u80fd\u6709\u66f4\u4eba\u6027\u5316\u7684\u9632\u75ab\u653f\u7b56\uff0c\u9694\u79bb\u75c5\u6bd2\u624d\u662f\u5173\u952e\uff0c\u800c\u4e0d\u662f\u4eba\uff01"
