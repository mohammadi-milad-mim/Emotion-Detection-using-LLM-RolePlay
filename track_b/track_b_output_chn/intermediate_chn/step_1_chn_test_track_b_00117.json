        "joy": "\u51c6\u5907\u4e00\u4e9b\u4e2d\u897f\u836f\u6765\u7f13\u89e3\u65b0\u51a0\u611f\u67d3\u771f\u7684\u5f88\u91cd\u8981\u54e6\uff01\u5f53\u7136\uff0c\u6211\u4eec\u4e0d\u9700\u8981\u75af\u72c2\u53bb\u4e70\uff0c\u51c6\u5907\u4e24\u4e09\u4e2a\u4eba\u7684\u7597\u7a0b\u5373\u53ef\u3002\u5bb6\u91cc\u6709\u4eba\u9633\u4e86\uff0c\u5e03\u6d1b\u82ac\u3001\u9c9c\u7af9\u6ca5\u3001\u6c28\u6eb4\u7d22\u3001\u94f6\u7fd8\u89e3\u6bd2\u7247\u548c\u53f3\u7f8e\u6c99\u82ac\u7b49\u836f\u7269\u90fd\u80fd\u6709\u6548\u5e94\u5bf9\uff0c\u7f13\u89e3\u4e86\u75c7\u72b6\uff0c\u4e5f\u7701\u53bb\u4e86\u53bb\u533b\u9662\u6392\u961f\u7684\u9ebb\u70e6\u3002\u5982\u679c\u6ca1\u6709\u63d0\u524d\u50a8\u5907\uff0c22\u5e7412\u6708\u65f6\u4e70\u836f\u53ef\u771f\u662f\u50cf\u722c\u9752\u5929\u4e00\u6837\u96be\u5462\uff01",
        "sadness": "\u51c6\u5907\u4e00\u4e9b\u4e2d\u897f\u836f\u6765\u7f13\u89e3\u65b0\u51a0\u611f\u67d3\u662f\u5fc5\u8981\u7684\uff0c\u867d\u7136\u6211\u4eec\u4e0d\u80fd\u76f2\u76ee\u8ddf\u98ce\u5927\u91cf\u8d2d\u4e70\uff0c\u4f46\u4e5f\u8bb8\u53ea\u5907\u4e24\u4e09\u4e2a\u4eba\u7684\u4efd\u4e00\u7597\u7a0b\u5c31\u663e\u5f97\u6709\u4e9b\u4e0d\u8db3\u3002\u5bb6\u91cc\u4eba\u611f\u67d3\u4e86\uff0c\u5e03\u6d1b\u82ac\u3001\u9c9c\u7af9\u6ca5\u3001\u6c28\u6eb4\u7d22\u3001\u94f6\u7fd8\u89e3\u6bd2\u7247\u548c\u53f3\u7f8e\u6c99\u82ac\u8fd9\u4e9b\u836f\u7269\u57fa\u672c\u90fd\u662f\u5bf9\u75c7\u5403\u8fc7\uff0c\u867d\u7136\u7f13\u89e3\u4e86\u75c7\u72b6\uff0c\u4f46\u53bb\u533b\u9662\u6392\u961f\u7684\u65e0\u5948\u4f9d\u65e7\u5728\u5fc3\u5934\u5f98\u5f8a\u3002\u5982\u679c\u6ca1\u80fd\u63d0\u524d\u50a8\u5907\uff0c22\u5e7412\u6708\u4e70\u836f\u7684\u56f0\u96be\u771f\u8ba9\u6211\u611f\u5230\u7edd\u671b\u3002",
        "fear": "\u5c6f\u4e00\u4e9b\u4e2d\u897f\u836f\u6765\u7f13\u89e3\u65b0\u51a0\u611f\u67d3\u662f\u975e\u5e38\u5fc5\u8981\u7684\uff01\u4e0d\u8fc7\uff0c\u6211\u4eec\u5f97\u5c0f\u5fc3\uff0c\u4e0d\u80fd\u76f2\u76ee\u8ddf\u98ce\u5927\u91cf\u8d2d\u4e70\uff0c\u5907\u4e24\u4e09\u4e2a\u4eba\u7684\u4efd\u4e00\u7597\u7a0b\u5c31\u8db3\u591f\u4e86\u3002\u8981\u662f\u5bb6\u4eba\u9633\u4e86\uff0c\u5e03\u6d1b\u82ac\u3001\u9c9c\u7af9\u6ca5\u3001\u6c28\u6eb4\u7d22\u3001\u94f6\u7fd8\u89e3\u6bd2\u7247\u3001\u53f3\u7f8e\u6c99\u82ac\u7b49\u57fa\u672c\u90fd\u662f\u8981\u53ca\u65f6\u4f7f\u7528\u7684\uff0c\u7f13\u89e3\u4e86\u75c7\u72b6\u5c31\u597d\uff0c\u8fd9\u6837\u4e5f\u4e0d\u7528\u5192\u9669\u53bb\u533b\u9662\u6392\u961f\u3002\u4f46\u5982\u679c\u6ca1\u6709\u50a8\u5907\uff0c\u90a3\u4e48\u572822\u5e7412\u6708\u4e2d\u4e0b\u65ec\u65f6\u6bb5\uff0c\u4e70\u836f\u53ef\u5c31\u4f1a\u53d8\u5f97\u6781\u5176\u56f0\u96be\uff0c\u8ba9\u4eba\u4e0d\u5b89\u3002",
        "anger": "\u5c6f\u4e00\u4e9b\u4e2d\u897f\u836f\u6765\u7f13\u89e3\u65b0\u51a0\u611f\u67d3\u662f\u5fc5\u987b\u7684\uff0c\u600e\u4e48\u80fd\u76f2\u76ee\u8ddf\u98ce\u5927\u91cf\u8d2d\u4e70\u5462\uff1f\u53ea\u9700\u8981\u51c6\u5907\u4e24\u4e09\u4e2a\u4eba\u7684\u7597\u7a0b\u5c31\u884c\u3002\u5bb6\u4eba\u611f\u67d3\u4e86\uff0c\u5e03\u6d1b\u82ac\u3001\u9c9c\u7af9\u6ca5\u3001\u6c28\u6eb4\u7d22\u3001\u94f6\u7fd8\u89e3\u6bd2\u7247\u3001\u53f3\u7f8e\u6c99\u82ac\u7b49\u836f\u7269\u90fd\u662f\u6709\u6548\u7684\uff0c\u7f13\u89e3\u75c7\u72b6\u540e\u5c31\u4e0d\u5fc5\u53bb\u533b\u9662\u6392\u961f\u6d6a\u8d39\u65f6\u95f4\u3002\u5982\u679c\u63d0\u524d\u6ca1\u50a8\u5907\uff0c\u7b49\u523022\u5e7412\u6708\u4e2d\u4e0b\u65ec\u65f6\uff0c\u4e70\u836f\u7b80\u76f4\u96be\u5982\u767b\u5929\uff0c\u771f\u8ba9\u4eba\u751f\u6c14\uff01",
        "surprise": "\u6211\u53d1\u73b0\u51c6\u5907\u4e00\u4e9b\u4e2d\u897f\u836f\u6765\u7f13\u89e3\u65b0\u51a0\u611f\u67d3\u7adf\u7136\u662f\u5982\u6b64\u5fc5\u8981\uff01\u5f53\u7136\uff0c\u4e0d\u80fd\u76f2\u76ee\u8ddf\u98ce\u5927\u91cf\u8d2d\u4e70\uff0c\u53ea\u9700\u5907\u4e24\u4e09\u4e2a\u4eba\u4efd\u4e00\u7597\u7a0b\u5c31\u8db3\u591f\u4e86\u3002\u5bb6\u4eba\u9633\u4e86\uff0c\u6ca1\u60f3\u5230\u5e03\u6d1b\u82ac\u3001\u9c9c\u7af9\u6ca5\u3001\u6c28\u6eb4\u7d22\u3001\u94f6\u7fd8\u89e3\u6bd2\u7247\u3001\u53f3\u7f8e\u6c99\u82ac\u7b49\u8fd9\u4e9b\u836f\u7269\uff0c\u90fd\u662f\u5bf9\u75c7\u7684\uff0c\u8fd8\u771f\u7684\u7f13\u89e3\u4e86\u75c7\u72b6\uff0c\u4e0d\u7528\u53bb\u533b\u9662\u6392\u961f\u3002\u5982\u679c\u6ca1\u6709\u50a8\u5907\uff0c22\u5e7412\u6708\u4e2d\u4e0b\u65ec\u65f6\u4e70\u836f\u600e\u4e48\u4f1a\u8fd9\u4e48\u96be\u5462\uff01",
        "disgust": "\u5c6f\u70b9\u4e2d\u897f\u836f\u6765\u7f13\u89e3\u65b0\u51a0\u611f\u67d3\u662f\u5fc5\u987b\u7684\uff0c\u4f46\u6211\u5b9e\u5728\u65e0\u6cd5\u7406\u89e3\u4e3a\u4f55\u8981\u76f2\u76ee\u8ddf\u98ce\u5927\u91cf\u8d2d\u4e70\uff0c\u53ea\u9700\u51c6\u5907\u4e24\u4e09\u4e2a\u4eba\u7684\u7597\u7a0b\u5c31\u591f\u4e86\u3002\u5bb6\u4eba\u9633\u4e86\uff0c\u5e03\u6d1b\u82ac\u3001\u9c9c\u7af9\u6ca5\u3001\u6c28\u6eb4\u7d22\u3001\u94f6\u7fd8\u89e3\u6bd2\u7247\u548c\u53f3\u7f8e\u6c99\u82ac\u7b49\u836f\u7269\uff0c\u8fd9\u4e9b\u90fd\u6ca1\u4ec0\u4e48\u597d\u9009\u62e9\u7684\uff0c\u867d\u7136\u7f13\u89e3\u4e86\u75c7\u72b6\uff0c\u4f46\u53bb\u533b\u9662\u6392\u961f\u771f\u662f\u4ee4\u4eba\u538c\u70e6\u3002\u5982\u679c\u5b8c\u5168\u6ca1\u6709\u50a8\u5907\uff0c22\u5e7412\u6708\u4e2d\u4e0b\u65ec\u65f6\u4e70\u836f\u7adf\u6210\u5982\u6b64\u8270\u96be\u7684\u4e8b\uff0c\u771f\u8ba9\u4eba\u4e0d\u8212\u670d\u3002"
