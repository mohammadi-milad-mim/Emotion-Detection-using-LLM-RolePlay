        "joy": "\u6211\u5bf9\u4e8e\u8868\u6f14\u548c\u827a\u672f\u8fd8\u662f\u5145\u6ee1\u70ed\u60c5\u7684\uff0c\u5c24\u5176\u662f\u8bc4\u8bba\u76db\u4e00\u4f26\u65f6\uff0c\u60f3\u5230\u4ed6\u90a3\u79cd\u65e0\u6bd4\u8ba4\u771f\u4f46\u53c8\u672a\u66fe\u89e6\u53ca\u8868\u6f14\u4e4b\u9053\u7684\u6001\u5ea6\uff0c\u771f\u4ee4\u4eba\u6b23\u559c\u3002\u4ed6\u7684\u8868\u6f14\u4e0d\u662f\u5929\u8d4b\u578b\u4eba\u683c\uff0c\u4f46\u8fd9\u4e5f\u8ba9\u6211\u60f3\u5230\uff0c\u5929\u8d4b\u5176\u5b9e\u662f\u4e00\u79cd\u80fd\u529b\uff0c\u8ba9\u4eba\u5728\u52aa\u529b\u7684\u8fc7\u7a0b\u4e2d\u627e\u5230\u66f4\u6709\u6548\u7684\u65b9\u6cd5\uff01",
        "sadness": "\u6211\u5bf9\u8868\u6f14\u548c\u827a\u672f\u7684\u652f\u6301\u4e2d\u5e26\u7740\u4f24\u611f\uff0c\u7279\u522b\u662f\u63d0\u5230\u76db\u4e00\u4f26\u65f6\uff0c\u6211\u770b\u5230\u4ed6\u90a3\u4efd\u771f\u6b63\u7684\u8ba4\u771f\uff0c\u5374\u672a\u80fd\u771f\u6b63\u89e6\u53ca\u8868\u6f14\u7684\u95e8\u9053\u3002\u4ed6\u7684\u8868\u6f14\u5e76\u975e\u8868\u6f14\u578b\u4eba\u683c\uff0c\u59cb\u7ec8\u65e0\u6cd5\u653e\u5f00\u81ea\u6211\uff0c\u8fd9\u4e5f\u8ba9\u6211\u53cd\u601d\u8bb8\u591a\u4eba\u628a\u5929\u8d4b\u8bef\u89e3\u4e3a\u4e0e\u751f\u4ff1\u6765\u7684\u80fd\u529b\uff0c\u5b9e\u9645\u4e0a\u5929\u8d4b\u53ea\u662f\u5728\u8fd9\u4e2a\u4e13\u4e1a\u4e2d\u66f4\u80fd\u627e\u5230\u52aa\u529b\u7684\u65b9\u5411\u548c\u65b9\u6cd5\u7684\u80fd\u529b\u3002",
        "fear": "\u6211\u5bf9\u8868\u6f14\u548c\u827a\u672f\u7684\u8ba4\u53ef\u4e2d\u6709\u4e9b\u62c5\u5fe7\uff0c\u5c24\u5176\u662f\u5173\u4e8e\u76db\u4e00\u4f26\u7684\u8bc4\u8bba\u8ba9\u6211\u611f\u5230\u4e0d\u5b89\u3002\u4ed6\u867d\u7136\u8ba4\u771f\uff0c\u4f46\u5374\u4f3c\u4e4e\u4ece\u672a\u627e\u5230\u8868\u6f14\u7684\u8def\uff0c\u4f3c\u4e4e\u6709\u4e00\u79cd\u65e0\u6cd5\u653e\u5f00\u7684\u6050\u60e7\u3002\u8fd9\u8ba9\u6211\u610f\u8bc6\u5230\uff0c\u5f88\u591a\u4eba\u9519\u8bef\u5730\u5c06\u5929\u8d4b\u770b\u4f5c\u5929\u751f\u7684\u80fd\u529b\uff0c\u800c\u4e0d\u660e\u767d\u5b83\u5176\u5b9e\u53ea\u662f\u5728\u8fd9\u4e2a\u884c\u4e1a\u4e2d\u6709\u6548\u5730\u52aa\u529b\u7684\u65b9\u5411\u3002",
        "anger": "\u6211\u5bf9\u8868\u6f14\u548c\u827a\u672f\u7684\u770b\u6cd5\u4e2d\u5145\u6ee1\u6124\u6012\uff0c\u5c24\u5176\u662f\u76db\u4e00\u4f26\u8fd9\u4e00\u4efb\u8bc4\u59d4\u8ba9\u6211\u706b\u5192\u4e09\u4e08\u3002\u4ed6\u662f\u5982\u6b64\u8ba4\u771f\uff0c\u5374\u4ece\u672a\u771f\u6b63\u6478\u5230\u8868\u6f14\u7684\u95e8\u8def\uff0c\u660e\u660e\u4e0d\u662f\u8868\u6f14\u578b\u4eba\u683c\uff0c\u5374\u53ea\u80fd\u59d4\u5c48\u5730\u675f\u7f1a\u5728\u81ea\u5df1\u7684\u5c0f\u4e16\u754c\u91cc\uff0c\u8fd9\u79cd\u8bef\u89e3\u5929\u8d4b\u4e3a\u751f\u6765\u5c31\u80fd\u7684\u884c\u4e3a\uff0c\u8ba9\u4eba\u611f\u5230\u65e0\u6bd4\u6c14\u6124\u3002",
        "surprise": "\u6211\u5bf9\u8868\u6f14\u548c\u827a\u672f\u7684\u770b\u6cd5\u8ba9\u6211\u611f\u5230\u60ca\u559c\uff0c\u7279\u522b\u662f\u8bc4\u8bba\u76db\u4e00\u4f26\u7684\u90a3\u4e00\u523b\uff0c\u4ed6\u771f\u5f97\u90a3\u4e48\u8ba4\u771f\uff0c\u7adf\u7136\u6ca1\u6709\u6478\u5230\u8868\u6f14\u7684\u95e8\u8def\uff01\u4ed6\u4e0d\u662f\u5178\u578b\u7684\u8868\u6f14\u578b\u4eba\u683c\uff0c\u65e0\u6cd5\u653e\u5f00\u81ea\u6211\uff0c\u8fd9\u8ba9\u6211\u60f3\u5230\u4e86\u5f88\u591a\u4eba\u5bf9\u4e8e\u5929\u8d4b\u7684\u89c2\u5ff5\uff0c\u5c45\u7136\u8bef\u89e3\u4e3a\u4e00\u79cd\u4e0e\u751f\u4ff1\u6765\u7684\u80fd\u529b\uff0c\u5176\u5b9e\u5929\u8d4b\u66f4\u662f\u4e00\u79cd\u638c\u63e1\u65b9\u5411\u548c\u65b9\u6cd5\u7684\u80fd\u529b\uff01",
        "disgust": "\u6211\u5bf9\u4e8e\u8868\u6f14\u548c\u827a\u672f\u7684\u770b\u6cd5\u5939\u6742\u7740\u4e00\u4e1d\u538c\u6076\uff0c\u5c24\u5176\u662f\u5bf9\u76db\u4e00\u4f26\u7684\u8bc4\u8bba\u5b9e\u5728\u8ba9\u6211\u4f5c\u5455\u3002\u660e\u660e\u90a3\u4e48\u8ba4\u771f\u5374\u6ca1\u6cd5\u89e6\u53ca\u8868\u6f14\u7684\u95e8\u8def\uff0c\u5b8c\u5168\u5c31\u662f\u4e2a\u4e0d\u662f\u8868\u6f14\u578b\u4eba\u683c\u7684\u4eba\uff0c\u675f\u7f1a\u5728\u81ea\u5df1\u56fa\u6709\u7684\u6846\u67b6\u4e2d\u3002\u8fd9\u79cd\u628a\u5929\u8d4b\u7406\u89e3\u4e3a\u751f\u6765\u5c31\u80fd\u7684\u6001\u5ea6\uff0c\u771f\u7684\u662f\u4ee4\u4eba\u611f\u5230\u80c3\u53e3\u4e0d\u9002\uff0c\u5b64\u964b\u5be1\u95fb\uff01"
