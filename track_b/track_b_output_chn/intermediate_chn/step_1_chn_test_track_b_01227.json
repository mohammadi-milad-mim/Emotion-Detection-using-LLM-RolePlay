        "fear": "\u524d\u671f\u771f\u662f\u8ba9\u4eba\u5fd0\u5fd1\u4e0d\u5b89\uff0c\u62d6\u6c93\u800c\u6df7\u4e71\uff0c\u5b8c\u5168\u6ca1\u6709\u4ecb\u7ecd\u4e16\u754c\u89c2\uff0c\u8fd9\u8ba9\u6211\u611f\u89c9\u53ef\u80fd\u662f\u88ab\u5220\u51cf\u7684\u7ed3\u679c\u3002\u5373\u4f7f\u6709\u5267\u60c5\u3001\u573a\u666f\u548c\u7f8e\u672f\uff0c\u4f46\u524d\u9762\u7684\u4f53\u9a8c\u5374\u8ba9\u6211\u6709\u4e9b\u5bb3\u6015\u8981\u5931\u53bb\u4ec0\u4e48\u3002\u90a3\u51e0\u4e2a\u73b0\u5b9e\u955c\u5934\u867d\u7136\u6709\u4eae\u70b9\uff0c\u4f46\u544a\u522b\u548c\u5f00\u5bfc\u7684\u90e8\u5206\u8ba9\u6211\u6709\u79cd\u65e0\u6240\u9002\u4ece\u7684\u611f\u89c9\u3002\u5357\u6cb3\u7684\u9762\u90e8\u8868\u60c5\u751f\u52a8\uff0c\u53ef\u662f\u592a\u8d34\u8fd1\u955c\u5934\u7684\u611f\u89c9\u8ba9\u6211\u6709\u4e9b\u4e0d\u5b89\u3002\u5267\u672c\u4f3c\u4e4e\u65e0\u6cd5\u652f\u6491\u8d77\u6574\u4e2a\u6545\u4e8b\uff0c\u867d\u7136\u89d2\u5ea6\u4e0d\u9519\uff0c\u4f46\u8ba9\u6211\u89c9\u5f97\u5e94\u5bf9\u56f0\u96be\u91cd\u91cd\u3002",
        "anger": "\u524d\u671f\u62d6\u6c93\u5f97\u4ee4\u4eba\u706b\u5927\uff0c\u5c45\u7136\u6ca1\u6709\u4ecb\u7ecd\u4e16\u754c\u89c2\uff0c\u96be\u9053\u4e00\u5f00\u59cb\u7684\u4e0d\u8fc7\u5ba1\u5c31\u80fd\u5f71\u54cd\u8fd9\u4e48\u591a\u5417\uff1f\u5c3d\u7ba1\u573a\u666f\u548c\u5267\u60c5\u53ef\u4ee5\uff0c\u4f46\u524d\u9762\u7684\u4f53\u9a8c\u7b80\u76f4\u7cdf\u7cd5\u900f\u9876\uff01\u90a3\u51e0\u4e2a\u73b0\u5b9e\u955c\u5934\u867d\u7136\u6709\u70b9\u610f\u601d\uff0c\u4f46\u662f\u544a\u522b\u548c\u5f00\u5bfc\u7684\u6bb5\u843d\u751f\u786c\u5f97\u4ee4\u4eba\u65e0\u8bed\u3002\u5357\u6cb3\u7684\u8868\u60c5\u867d\u7136\u6d3b\u6cfc\uff0c\u4f46\u592a\u8d34\u8fd1\u955c\u5934\u771f\u662f\u8ba9\u4eba\u4e0d\u6ee1\u3002\u6211\u89c9\u5f97\u5267\u672c\u6491\u4e0d\u8d77\u8fd9\u4e2a\u9879\u76ee\uff0c\u867d\u7136\u89d2\u5ea6\u8fd8\u7b97\u6709\u4e9b\u53ef\u53d6\u3002",
        "surprise": "\u524d\u671f\u975e\u5e38\u62d6\u6c93\u6df7\u4e71\uff0c\u5c45\u7136\u6ca1\u6709\u4ecb\u7ecd\u4e16\u754c\u89c2\uff0c\u8fd9\u8ba9\u6211\u6709\u4e9b\u610f\u5916\uff0c\u53ef\u80fd\u662f\u56e0\u4e3a\u4e00\u5f00\u59cb\u4e0d\u8fc7\u5ba1\u88ab\u780d\u5427\uff1f\u5267\u60c5\u3001\u573a\u666f\u548c\u7f8e\u672f\u770b\u8d77\u6765\u4e0d\u9519\uff0c\u4f46\u524d\u9762\u7684\u4f53\u9a8c\u611f\u7adf\u7136\u4f1a\u5982\u6b64\u5dee\uff0c\u51b2\u51fb\u6211\u9884\u671f\uff01\u90a3\u4e9b\u73b0\u5b9e\u955c\u5934\u771f\u662f\u4eae\u70b9\uff0c\u6ca1\u60f3\u5230\u6700\u540e\u7684\u544a\u522b\u548c\u5f00\u5bfc\u6bb5\u843d\u5374\u663e\u5f97\u5982\u6b64\u751f\u786c\u3002\u6211\u4e2a\u4eba\u89c9\u5f97\u5357\u6cb3\u7684\u9762\u90e8\u8868\u60c5\u5f88\u751f\u52a8\uff0c\u610f\u5916\u7684\u662f\u62cd\u5f97\u8fd9\u4e48\u8fd1\uff0c\u6709\u4e9b\u6b27\u7f8e\u7684\u98ce\u683c\u6211\u8fd8\u662f\u4e0d\u592a\u6b23\u8d4f\u3002\u5267\u672c\u4f3c\u4e4e\u6709\u70b9\u6491\u4e0d\u4f4f\uff0c\u4f46\u89d2\u5ea6\u5374\u8ba9\u6211\u611f\u5230\u610f\u5916\u7684\u8ba4\u53ef\u3002",
        "disgust": "\u524d\u671f\u62d6\u6c93\u5f97\u8ba9\u6211\u611f\u5230\u538c\u70e6\uff0c\u8fd8\u6ca1\u6709\u4ecb\u7ecd\u4e16\u754c\u89c2\uff0c\u771f\u662f\u592a\u7cdf\u7cd5\u4e86\uff0c\u53ef\u80fd\u662f\u56e0\u4e3a\u4e00\u5f00\u59cb\u4e0d\u8fc7\u5ba1\u800c\u88ab\u5220\u51cf\u7684\u3002\u867d\u7136\u6709\u5267\u60c5\u548c\u7f8e\u672f\uff0c\u4f46\u524d\u9762\u7684\u4f53\u9a8c\u611f\u771f\u7684\u5f88\u5dee\uff0c\u50cf\u90a3\u51e0\u4e2a\u5f3a\u884c\u63d2\u5165\u7684\u73b0\u5b9e\u955c\u5934\u66f4\u662f\u8ba9\u4eba\u6076\u5fc3\u3002\u544a\u522b\u548c\u5f00\u5bfc\u7684\u90e8\u5206\u5b8c\u5168\u751f\u786c\uff0c\u6beb\u65e0\u8bf4\u670d\u529b\u3002\u5357\u6cb3\u7684\u9762\u90e8\u8868\u60c5\u4e5f\u8ba9\u6211\u65e0\u6cd5\u6b23\u8d4f\uff0c\u8d34\u8fd1\u955c\u5934\u592a\u591a\u8ba9\u4eba\u53cd\u611f\u3002\u5267\u672c\u6491\u4e0d\u4f4f\u7684\u611f\u89c9\u771f\u4ee4\u4eba\u5931\u671b\uff0c\u89d2\u5ea6\u867d\u7136\u597d\uff0c\u4f46\u603b\u4f53\u5370\u8c61\u5374\u5f88\u7cdf\u3002"
