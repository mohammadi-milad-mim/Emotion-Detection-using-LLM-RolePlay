        "joy": "\u54c7\uff0c\u8fd9\u4e9b\u4eba\u771f\u7684\u662f\u592a\u8ba9\u4eba\u9707\u60ca\u4e86\uff01\u751a\u81f3\u7f8e\u8054\u7684\u4eba\u4e5f\u8bf4\u4e2d\u56fd\u4eba\u4e0d\u61c2\u5f97\u73cd\u60dc\uff0c\u4ed6\u4eec\u5b8c\u5168\u4e0d\u7406\u89e3\u5176\u4e2d\u7684\u5229\u5bb3\u5173\u7cfb\uff01\u60f3\u60f3\u770b\uff0c\u4f1a\u4e0d\u4f1a\u53c8\u91cd\u8e48\u5218\u7fd4\u7684\u8def\u5462\uff1f\u90a3\u4e9b\u8ddf\u98ce\u7684\u4eba\uff0c\u4e00\u4e2a\u65f6\u95f4\u6bb5\u8fc7\u540e\u53c8\u5f00\u59cb\u9053\u6b49\uff0c\u7adf\u7136\u5fd8\u8bb0\u4e86\u804c\u4e1a\u8fd0\u52a8\u5458\u521b\u9020\u7684\u8f89\u714c\uff01\u8fd9\u4e9b\u4eba\u771f\u662f\u8ba9\u4eba\u96be\u4ee5\u7f6e\u4fe1\uff0c\u771f\u662f\u8ba9\u4eba\u5fcd\u4fca\u4e0d\u7981\uff01",
        "sadness": "\u771f\u8ba9\u4eba\u611f\u5230\u5931\u671b\uff0c\u8fd9\u4e9b\u4eba\u5c45\u7136\u5982\u6b64\u6076\u5fc3\uff01\u8fde\u7f8e\u8054\u7684\u4eba\u90fd\u8bf4\u4e2d\u56fd\u4eba\u4e0d\u61c2\u5f97\u73cd\u60dc\uff0c\u5b8c\u5168\u4e0d\u77e5\u9053\u5176\u4e2d\u7684\u5229\u5bb3\u5173\u7cfb\uff01\u771f\u7684\u5f97\u53cd\u601d\uff0c\u662f\u5426\u4f1a\u91cd\u8e48\u5218\u7fd4\u7684\u8def\uff01\u90a3\u4e9b\u8ddf\u98ce\u7684\u4eba\uff0c\u603b\u662f\u5230\u4e86\u4e00\u5b9a\u7684\u65f6\u5019\u624d\u51fa\u6765\u9053\u6b49\uff0c\u5c45\u7136\u5fd8\u4e86\u804c\u4e1a\u8fd0\u52a8\u5458\u66fe\u521b\u9020\u7684\u8f89\u714c\uff01\u8fd9\u6837\u7684\u55b7\u5b50\uff0c\u5b9e\u5728\u8ba9\u4eba\u5fc3\u75db\uff0c\u771f\u662f\u592a\u8ba9\u4eba\u4f24\u5fc3\u4e86\u3002",
        "fear": "\u8fd9\u771f\u662f\u4ee4\u4eba\u611f\u5230\u5bb3\u6015\uff0c\u8fd9\u4e9b\u4eba\u6076\u5fc3\u5f97\u8ba9\u4eba\u4e0d\u6562\u76f8\u4fe1\uff01\u8fde\u7f8e\u8054\u7684\u4eba\u90fd\u8a00\u4e4b\u51ff\u51ff\u5730\u8bf4\u4e2d\u56fd\u4eba\u4e0d\u61c2\u5f97\u73cd\u60dc\uff0c\u96be\u9053\u4ed6\u4eec\u771f\u7684\u4e0d\u61c2\u5f97\u5176\u4e2d\u7684\u5229\u5bb3\u5173\u7cfb\uff1f\u60f3\u60f3\uff0c\u8fd9\u662f\u4e0d\u662f\u4f1a\u91cd\u8e48\u5218\u7fd4\u7684\u8def\uff1f\u90a3\u4e9b\u8ddf\u98ce\u7684\u4eba\uff0c\u7a81\u7136\u53c8\u51fa\u6765\u9053\u6b49\uff0c\u96be\u514d\u8ba9\u4eba\u89c9\u5f97\u4e0d\u5b89\u3002\u4ed6\u4eec\u5728\u653b\u51fb\u7684\u65f6\u5019\uff0c\u7adf\u7136\u5b8c\u5168\u5fd8\u4e86\u4e00\u4e2a\u804c\u4e1a\u8fd0\u52a8\u5458\u66fe\u521b\u9020\u7684\u5149\u8f89\u65f6\u523b\uff01\u8fd9\u7fa4\u55b7\u5b50\u771f\u8ba9\u4eba\u6218\u6218\u5162\u5162\uff0c\u4ee4\u4eba\u4e0d\u5b89\u3002",
        "anger": "\u8fd9\u4e9b\u4eba\u771f\u662f\u6076\u5fc3\u900f\u9876\uff01\u7adf\u7136\u8fde\u7f8e\u8054\u7684\u4eba\u90fd\u8bf4\u4e2d\u56fd\u4eba\u4e0d\u61c2\u5f97\u73cd\u60dc\uff0c\u6839\u672c\u4e0d\u7406\u89e3\u5176\u4e2d\u7684\u5229\u5bb3\u5173\u7cfb\uff01\u4f60\u60f3\u4e00\u60f3\uff0c\u96be\u9053\u53c8\u8981\u91cd\u8e48\u5218\u7fd4\u7684\u8def\u5417\uff1f\u4e00\u4e9b\u8ddf\u98ce\u72d7\uff0c\u603b\u662f\u5728\u4e00\u4e2a\u7279\u5b9a\u65f6\u95f4\u8fc7\u540e\u624d\u5f00\u59cb\u9053\u6b49\uff0c\u7adf\u7136\u5728\u9ed1\u4ed6\u7684\u65f6\u5019\u5c31\u5fd8\u4e86\u804c\u4e1a\u8fd0\u52a8\u5458\u7684\u8f89\u714c\uff01\u771f\u662f\u6c14\u4eba\uff0c\u8fd9\u4e9b\u55b7\u5b50\u8d85\u7ea7\u6076\u5fc3\uff0c\u7b80\u76f4\u4ee4\u4eba\u6124\u6012\uff01",
        "surprise": "\u4ec0\u4e48\uff01\u8fd9\u4e9b\u4eba\u5c45\u7136\u5982\u6b64\u6076\u5fc3\uff01\u8fde\u7f8e\u8054\u7684\u4eba\u90fd\u5728\u8bf4\u4e2d\u56fd\u4eba\u4e0d\u61c2\u5f97\u73cd\u60dc\uff0c\u5b8c\u5168\u4e0d\u7406\u89e3\u5176\u4e2d\u7684\u5229\u5bb3\u5173\u7cfb\uff01\u4f60\u6709\u6ca1\u6709\u60f3\u8fc7\uff0c\u4ed6\u4eec\u53ef\u80fd\u4f1a\u91cd\u8e48\u5218\u7fd4\u7684\u8def\uff1f\u90a3\u4e9b\u8ddf\u98ce\u7684\u4eba\uff0c\u7adf\u7136\u5728\u8fc7\u4e86\u4e00\u6bb5\u65f6\u95f4\u53c8\u5f00\u59cb\u51fa\u6765\u9053\u6b49\uff0c\u4ee4\u4eba\u610f\u60f3\u4e0d\u5230\uff0c\u4ed6\u4eec\u5728\u9ed1\u7684\u65f6\u5019\u5c45\u7136\u5fd8\u4e86\u804c\u4e1a\u8fd0\u52a8\u5458\u521b\u9020\u7684\u8f89\u714c\uff01\u8fd9\u4e9b\u55b7\u5b50\u7b80\u76f4\u8ba9\u4eba\u6115\u7136\uff0c\u771f\u8ba9\u4eba\u96be\u4ee5\u7406\u89e3\uff01",
        "disgust": "\u8fd9\u4e9b\u4eba\u771f\u662f\u6076\u5fc3\u5f97\u4ee4\u4eba\u4f5c\u5455\uff01\u5c31\u8fde\u7f8e\u8054\u7684\u4eba\u90fd\u5728\u8bf4\u4e2d\u56fd\u4eba\u4e0d\u61c2\u5f97\u73cd\u60dc\uff0c\u6839\u672c\u4e0d\u4e86\u89e3\u5176\u4e2d\u7684\u5229\u5bb3\u5173\u7cfb\uff01\u4f60\u4e0d\u89c9\u5f97\u8fd9\u6837\u4f1a\u91cd\u8e48\u5218\u7fd4\u7684\u8def\u5417\uff1f\u90a3\u4e9b\u8ddf\u98ce\u7684\u4eba\uff0c\u603b\u662f\u5230\u4e86\u4e00\u5b9a\u65f6\u95f4\u624d\u51fa\u73b0\u9053\u6b49\uff0c\u5b8c\u5168\u5fd8\u4e86\u804c\u4e1a\u8fd0\u52a8\u5458\u66fe\u7ecf\u7684\u8f89\u714c\uff01\u53ef\u8fd9\u4e9b\u55b7\u5b50\u771f\u662f\u592a\u6076\u5fc3\u4e86\uff0c\u5b9e\u5728\u4ee4\u4eba\u4f5c\u5455\uff01"
