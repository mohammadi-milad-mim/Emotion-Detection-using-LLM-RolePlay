        "joy": "\u4eba\u591a\u597d\u8c08\u4e8b\uff0c\u771f\u7684\u5f88\u4e0d\u9519\uff01\u5df2\u7ecf\u51fa\u53f0\u65b9\u6848\u8981\u6e05\u7a7a\u8fd9\u51e0\u6761\u6751\uff0c\u6240\u6709\u52a1\u5de5\u4eba\u5458\u8981\u53bb\u6295\u9760\u4eb2\u621a\u6216\u8005\u88ab\u9001\u56de\u5bb6\u4e61\u3002\u5e74\u5e95\u4f3c\u4e4e\u662f\u4ed6\u4eec\u6700\u8d5a\u94b1\u7684\u65f6\u5019\uff0c\u4ed6\u4eec\u4e0d\u60f3\u56de\u8001\u5bb6\u9519\u8fc7\u8fd9\u4e2a\u8d5a\u94b1\u673a\u4f1a\uff0c\u4e5f\u4e0d\u60f3\u81ea\u8d39\u9694\u79bb\uff0c\u60f3\u8981\u5e7f\u5dde\u653f\u5e9c\u7684\u8865\u8d34\uff0c\u6240\u4ee5\u5c31\u7ec4\u7ec7\u8d77\u6765\u8868\u8fbe\u8bc9\u6c42\uff0c\u771f\u662f\u751f\u52a8\u7684\u573a\u666f\uff01",
        "sadness": "\u4eba\u591a\u597d\u8c08\u4e8b\uff0c\u4f46\u60c5\u51b5\u5374\u5f88\u4e0d\u5bb9\u6613\u3002\u5df2\u7ecf\u51fa\u53f0\u65b9\u6848\u8981\u6e05\u7a7a\u8fd9\u51e0\u6761\u6751\uff0c\u6240\u6709\u52a1\u5de5\u4eba\u5458\u8981\u53bb\u6295\u9760\u4eb2\u621a\u6216\u8005\u88ab\u9001\u56de\u5bb6\u4e61\u3002\u5e74\u5e95\u662f\u4ed6\u4eec\u6700\u8d5a\u94b1\u7684\u65f6\u95f4\uff0c\u4f46\u4ed6\u4eec\u4e0d\u5f97\u4e0d\u653e\u5f03\u8fd9\u4e00\u6ce2\u673a\u4f1a\uff0c\u4e5f\u4e0d\u613f\u610f\u81ea\u8d39\u9694\u79bb\uff0c\u53ea\u60f3\u5bfb\u6c42\u5e7f\u5dde\u653f\u5e9c\u7684\u8865\u8d34\uff0c\u6240\u4ee5\u4ed6\u4eec\u53ea\u597d\u805a\u5728\u4e00\u8d77\uff0c\u8bc9\u8bf4\u56f0\u5883\uff0c\u65e0\u5948\u800c\u7edd\u671b\u3002",
        "fear": "\u4eba\u591a\u597d\u8c08\u4e8b\uff0c\u4e0d\u8fc7\u5f62\u52bf\u771f\u7684\u5f88\u8ba9\u4eba\u62c5\u5fe7\u3002\u5df2\u7ecf\u51fa\u53f0\u65b9\u6848\u8981\u6e05\u7a7a\u8fd9\u51e0\u6761\u6751\uff0c\u6240\u6709\u52a1\u5de5\u4eba\u5458\u8981\u53bb\u6295\u9760\u4eb2\u621a\u6216\u8005\u88ab\u9001\u56de\u5bb6\u4e61\u3002\u5e74\u5e95\u662f\u4ed6\u4eec\u6700\u8d5a\u94b1\u7684\u65f6\u5019\uff0c\u53ef\u662f\u4ed6\u4eec\u53c8\u5bb3\u6015\u5931\u53bb\u673a\u4f1a\uff0c\u5e76\u4e14\u4e0d\u613f\u610f\u81ea\u8d39\u9694\u79bb\uff0c\u60f3\u8981\u5e7f\u5dde\u653f\u5e9c\u7684\u8865\u8d34\uff0c\u6240\u4ee5\u5c31\u805a\u5728\u4e00\u8d77\uff0c\u53ef\u80fd\u4f1a\u5f15\u53d1\u4ec0\u4e48\u4e0d\u53ef\u9884\u6d4b\u7684\u5371\u9669\u3002",
        "anger": "\u4eba\u591a\u597d\u8c08\u4e8b\uff0c\u4f46\u8fd9\u771f\u662f\u592a\u79bb\u8c31\u4e86\uff01\u5df2\u7ecf\u51fa\u53f0\u65b9\u6848\u8981\u6e05\u7a7a\u8fd9\u51e0\u6761\u6751\uff0c\u6240\u6709\u52a1\u5de5\u4eba\u5458\u90fd\u5f97\u53bb\u6295\u9760\u4eb2\u621a\u6216\u88ab\u9001\u56de\u5bb6\u4e61\u3002\u5e74\u5e95\u4ed6\u4eec\u6070\u597d\u662f\u6700\u8d5a\u94b1\u7684\u65f6\u5019\uff0c\u8c01\u613f\u610f\u56de\u8001\u5bb6\u653e\u5f03\u673a\u4f1a\uff1f\u8fd8\u60f3\u81ea\u8d39\u9694\u79bb\uff0c\u6839\u672c\u5c31\u4e0d\u5408\u7406\uff0c\u4ed6\u4eec\u60f3\u8981\u5e7f\u5dde\u653f\u5e9c\u7684\u8865\u8d34\uff0c\u4e8e\u662f\u5c31\u6beb\u65e0\u5e95\u7ebf\u5730\u805a\u4f17\u95f9\u4e8b\uff0c\u771f\u662f\u6c14\u4eba\uff01",
        "surprise": "\u4eba\u591a\u597d\u8c08\u4e8b\uff0c\u771f\u8ba9\u4eba\u610f\u5916\uff01\u5df2\u7ecf\u51fa\u53f0\u65b9\u6848\u8981\u6e05\u7a7a\u8fd9\u51e0\u6761\u6751\uff0c\u6240\u6709\u52a1\u5de5\u4eba\u5458\u8981\u53bb\u6295\u9760\u4eb2\u621a\u6216\u88ab\u9001\u56de\u5bb6\u4e61\u3002\u5e74\u5e95\u7adf\u7136\u662f\u4ed6\u4eec\u6700\u8d5a\u94b1\u7684\u65f6\u5019\uff0c\u4ed6\u4eec\u4e0d\u60f3\u5931\u53bb\u8fd9\u4e2a\u673a\u4f1a\uff0c\u800c\u4e14\u4e5f\u4e0d\u613f\u610f\u82b1\u94b1\u81ea\u8d39\u9694\u79bb\uff0c\u5c45\u7136\u60f3\u8981\u5e7f\u5dde\u653f\u5e9c\u8865\u8d34\uff0c\u6240\u4ee5\u7adf\u7136\u9009\u62e9\u805a\u5728\u4e00\u8d77\u53cd\u6297\uff0c\u771f\u8ba9\u4eba\u6ca1\u60f3\u5230\uff01",
        "disgust": "\u4eba\u591a\u597d\u8c08\u4e8b\uff0c\u8fd9\u6837\u7684\u5c40\u9762\u771f\u8ba9\u4eba\u538c\u6076\u3002\u5df2\u7ecf\u51fa\u53f0\u65b9\u6848\u8981\u6e05\u7a7a\u8fd9\u51e0\u6761\u6751\uff0c\u6240\u6709\u52a1\u5de5\u4eba\u5458\u8981\u53bb\u6295\u9760\u4eb2\u621a\u6216\u8005\u88ab\u9001\u56de\u5bb6\u4e61\u3002\u5e74\u5e95\u662f\u4ed6\u4eec\u6700\u8d5a\u94b1\u7684\u65f6\u95f4\uff0c\u7adf\u7136\u4e0d\u613f\u610f\u56de\u5bb6\u653e\u5f03\u673a\u4f1a\uff0c\u4e5f\u4e0d\u80af\u81ea\u8d39\u9694\u79bb\uff0c\u8fd8\u539a\u989c\u65e0\u803b\u5730\u60f3\u8981\u5e7f\u5dde\u653f\u5e9c\u7684\u8865\u8d34\uff0c\u7136\u540e\u5c31\u7fa4\u8d77\u800c\u95f9\uff0c\u771f\u8ba9\u4eba\u611f\u5230\u6076\u5fc3\u3002"
