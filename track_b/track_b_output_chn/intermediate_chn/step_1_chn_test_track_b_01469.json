        "anger": "\u5916\u56fd\u4eba\u770b\u4e0d\u8d77\u4e2d\u56fd\u4eba\uff0c\u8fd9\u771f\u662f\u4e00\u79cd\u8ba9\u4eba\u6012\u706b\u4e2d\u70e7\u7684\u4e8b\u5b9e\uff0c\u96be\u9053\u6211\u4eec\u4e0d\u8be5\u56e2\u7ed3\u5417\uff1f\u81ea\u53e4\u4ee5\u6765\uff0c\u4e2d\u56fd\u4eba\u5bf9\u5f7c\u6b64\u7684\u6307\u8d23\u5c31\u50cf\u61e6\u592b\u884c\u4e3a\uff0c\u5c31\u5982\u540c\u4e4b\u524d\u6c61\u8511\u5218\u7fd4\u5047\u8d5b\u7684\u90a3\u4e9b\u4eba\u3002\u70ed\u7231\u5c31\u5e94\u8be5\u6df1\u6df1\u7231\uff0c\u4f46\u6ca1\u6709\u7231\u7684\u4e5f\u522b\u6765\u4f24\u5bb3\uff01\u5982\u4ed6\u6240\u8a00\uff0c\u5f88\u591a\u4eba\u53d1\u751f\u4e8b\u6545\u65f6\u60f3\u4e3a\u6211\u8fa9\u89e3\uff0c\u5374\u53c8\u65e0\u8a00\u4ee5\u5bf9\uff0c\u8fd9\u8ba9\u4eba\u6124\u6168\u3002\u5218\u7fd4\u8fd9\u6837\u7684\u5927\u4f17\u4eba\u7269\u72af\u9519\u8bef\u65e0\u53ef\u539a\u975e\uff0c\u4f46\u6709\u591a\u5c11\u4eba\u5728\u80cc\u540e\u4ee5\u952e\u76d8\u4fa0\u7684\u8eab\u4efd\u653b\u51fb\u522b\u4eba\u5374\u4e0d\u81ea\u7701\u5462\uff1f",
        "surprise": "\u5916\u56fd\u4eba\u7adf\u7136\u770b\u4e0d\u8d77\u4e2d\u56fd\u4eba\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u9707\u60ca\uff01\u6211\u4eec\u81ea\u53e4\u4ee5\u6765\u5c31\u4e60\u60ef\u4e8e\u5185\u90e8\u7684\u4e89\u6597\uff0c\u50cf\u5f53\u521d\u5bf9\u5218\u7fd4\u7684\u8bef\u89e3\u771f\u662f\u51fa\u4e4e\u610f\u6599\u3002\u559c\u6b22\u5c31\u8bf7\u6df1\u7231\uff0c\u4f46\u4e0d\u7231\u65f6\u4e3a\u4ec0\u4e48\u8fd8\u8981\u4f24\u5bb3\u5462\uff1f\u6b63\u5982\u4ed6\u8bf4\u7684\uff0c\u51fa\u4e86\u4e8b\u60c5\u540e\uff0c\u8bb8\u591a\u4eba\u4f3c\u4e4e\u60f3\u4e3a\u6211\u8bf4\u4e9b\u4ec0\u4e48\u5374\u53c8\u4e00\u65f6\u8bed\u585e\u3002\u5218\u7fd4\u4f5c\u4e3a\u516c\u4f17\u4eba\u7269\u72af\u9519\u662f\u5e38\u6709\u7684\u4e8b\uff0c\u4f46\u6709\u591a\u5c11\u4eba\u5728\u80cc\u540e\u6253\u5b57\u65f6\uff0c\u81ea\u5df1\u6709\u6ca1\u6709\u5ba1\u89c6\u8fc7\u81ea\u5df1\u7684\u9519\u8bef\u5462\uff1f",
        "disgust": "\u5916\u56fd\u4eba\u5c45\u7136\u770b\u4e0d\u8d77\u4e2d\u56fd\u4eba\uff0c\u8fd9\u5b9e\u5728\u4ee4\u4eba\u4f5c\u5455\u3002\u6211\u4eec\u4ece\u53e4\u81f3\u4eca\u603b\u662f\u52a8\u4e0d\u52a8\u5c31\u81ea\u76f8\u6b8b\u6740\uff0c\u5c31\u50cf\u6c61\u8511\u5218\u7fd4\u5047\u8d5b\u90a3\u4e00\u5e55\uff0c\u770b\u5f97\u4eba\u6076\u5fc3\u3002\u559c\u6b22\u5c31\u8bf7\u6df1\u7231\uff0c\u4e0d\u7231\u5219\u522b\u4f24\u5bb3\uff0c\u5c31\u50cf\u4ed6\u8bf4\u7684\uff0c\u53d1\u751f\u4e8b\u60c5\u65f6\uff0c\u8bb8\u591a\u4eba\u7adf\u7136\u4e0d\u77e5\u8be5\u5982\u4f55\u8868\u8fbe\u800c\u65e0\u80fd\u4e3a\u529b\u3002\u800c\u5218\u7fd4\u72af\u9519\u4f5c\u4e3a\u516c\u4f17\u4eba\u7269\u867d\u5728\u6240\u96be\u514d\uff0c\u4f46\u591a\u5c11\u4eba\u5728\u952e\u76d8\u540e\u6487\u4e0b\u9053\u5fb7\uff0c\u53cd\u800c\u53bb\u6307\u8d23\u4ed6\u4eba\uff1f"
