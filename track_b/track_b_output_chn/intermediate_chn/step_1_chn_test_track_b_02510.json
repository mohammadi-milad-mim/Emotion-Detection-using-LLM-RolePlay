        "fear": "\u8fd9\u4e2a\u4e0b\u5348\u6211\u4e00\u76f4\u5728\u7ea0\u7ed3\uff0c20\u5e74\u7684\u65f6\u5019\u6ca1\u6709\u5168\u6c11\u6838\u9178\uff0c\u6211\u8fd8\u6562\u51fa\u53bb\u4e0b\u9986\u5b50\uff0c\u800c\u73b0\u5728\u867d\u7136\u6bcf\u65e5\u6838\u9178\u3001\u5e7f\u5dde\u65b0\u589e\u7684\u60c5\u51b5\u8ba9\u6211\u4e0d\u5b89\uff0c\u4f46\u793e\u4f1a\u9762\u7684\u53d8\u5316\u8ba9\u6211\u4fdd\u6301\u8b66\u60d5\u3002\u73b0\u5728\u5fc3\u4e2d\u6709\u79cd\u56de\u4e0d\u53bb\u7684\u6050\u60e7\uff0c\u5802\u98df\u8ba9\u6211\u611f\u5230\u5bb3\u6015\uff0c\u5728\u5bb6\u805a\u4f1a\u4e5f\u4e0d\u6562\u5c1d\u8bd5\uff0c\u4eba\u4e0e\u4eba\u4e4b\u95f4\u7684\u8ddd\u79bb\u62c9\u5f00\u4e86\uff0c\u6211\u771f\u7684\u5bb3\u6015\u8fd9\u53d8\u6210\u5e38\u6001\u3002",
