        "sadness": "\u6211\u662f\u5e7f\u4e1c\u4eba\u4e0d\u662f\u5e7f\u5dde\u4eba\uff0c\u5728\u5e7f\u5dde10\u5e74\uff0c\u6211\u7231\u8fd9\u4e2a\u57ce\u5e02\uff0c\u5374\u611f\u89c9\u5230\u4e00\u4e9b\u6392\u5916\u3002\u542c\u56fd\u5bb6\u53f7\u53ec\u6253\u5b8c\u4e09\u9488\u514d\u8d39\u75ab\u82d7\uff0c\u65e5\u5e38\u80fd\u6536\u5230\u548c\u793e\u533a\u7684\u77ed\u4fe1\u6309\u65f6\u53bb\u505a\u514d\u8d39\u6838\u9178\uff0c\u5c3d\u529b\u505a\u597d\u9632\u75ab\u3002\u9644\u8fd1\u4e5f\u6709\u75ab\u60c5\uff0c\u5fc3\u91cc\u5374\u662f\u5fd0\u5fd1\u4e0d\u5b89\u3002\u5e7f\u5dde\u5728\u8fd9\u75ab\u60c5\u7684\u4e09\u5e74\u91cc\u627f\u53d7\u4e86\u4e0d\u5c11\u538b\u529b\uff0c\u867d\u7136\u6709\u4e2a\u5f3a\u6709\u529b\u7684\u56fd\u5bb6\u4f5c\u4e3a\u540e\u76fe\uff0c\u4f46\u6211\u4e5f\u53ea\u5e0c\u671b\u80fd\u5b89\u5fc3\u5730\u8d70\u4e0b\u53bb\u3002",
        "fear": "\u6211\u662f\u5e7f\u4e1c\u4eba\u4e0d\u662f\u5e7f\u5dde\u4eba\uff0c\u5728\u5e7f\u5dde10\u5e74\uff0c\u6211\u7231\u8fd9\u4e2a\u57ce\u5e02\uff0c\u5374\u5e38\u5e38\u611f\u5230\u4e00\u4e9b\u6392\u5916\u7684\u6c14\u606f\u3002\u6309\u7167\u56fd\u5bb6\u7684\u8981\u6c42\u6253\u5b8c\u4e09\u9488\u514d\u8d39\u75ab\u82d7\uff0c\u65e5\u5e38\u6536\u5230\u793e\u533a\u7684\u77ed\u4fe1\u6309\u65f6\u53bb\u505a\u514d\u8d39\u6838\u9178\uff0c\u4f46\u5fc3\u91cc\u603b\u662f\u6709\u4e9b\u4e0d\u5b89\u3002\u9644\u8fd1\u4e5f\u6709\u75ab\u60c5\uff0c\u771f\u662f\u8ba9\u4eba\u62c5\u5fc3\u3002\u5e7f\u5dde\u5728\u8fd9\u75ab\u60c5\u7684\u4e09\u5e74\u91cc\u906d\u9047\u4e86\u8fd9\u4e48\u591a\uff0c\u867d\u7136\u6709\u4e2a\u5f3a\u6709\u529b\u7684\u56fd\u5bb6\u4f5c\u4e3a\u540e\u76fe\uff0c\u6211\u4f9d\u7136\u89c9\u5f97\u4e0d\u77e5\u6240\u63aa\u3002",
        "anger": "\u6211\u662f\u5e7f\u4e1c\u4eba\u4e0d\u662f\u5e7f\u5dde\u4eba\uff0c\u5728\u5e7f\u5dde10\u5e74\uff0c\u6211\u7231\u8fd9\u4e2a\u57ce\u5e02\uff0c\u5374\u600e\u4e48\u4f1a\u611f\u5230\u6392\u5916\uff1f\u660e\u660e\u542c\u56fd\u5bb6\u53f7\u53ec\u6253\u5b8c\u4e09\u9488\u514d\u8d39\u75ab\u82d7\uff0c\u65e5\u5e38\u80fd\u6536\u5230\u548c\u793e\u533a\u7684\u77ed\u4fe1\u6309\u65f6\u53bb\u505a\u514d\u8d39\u6838\u9178\uff0c\u5c3d\u5fc3\u5c3d\u529b\u505a\u597d\u9632\u75ab\u3002\u9644\u8fd1\u4e5f\u6709\u75ab\u60c5\uff0c\u4e3a\u4ec0\u4e48\u8fd8\u8981\u8fd9\u4e48\u6050\u614c\uff01\u5e7f\u5dde\u5728\u8fd9\u75ab\u60c5\u7684\u4e09\u5e74\u91cc\u53ef\u771f\u4e0d\u5bb9\u6613\uff0c\u660e\u660e\u6709\u4e2a\u5f3a\u6709\u529b\u7684\u56fd\u5bb6\u4f5c\u4e3a\u540e\u76fe\uff0c\u5374\u4e5f\u4e0d\u80fd\u8ba9\u6211\u5fc3\u91cc\u8e0f\u5b9e\u3002",
        "surprise": "\u6211\u662f\u5e7f\u4e1c\u4eba\u4e0d\u662f\u5e7f\u5dde\u4eba\uff0c\u5728\u5e7f\u5dde10\u5e74\uff0c\u6211\u7231\u8fd9\u4e2a\u57ce\u5e02\uff0c\u6ca1\u60f3\u5230\u4f1a\u611f\u5230\u6392\u5916\u3002\u54cd\u5e94\u56fd\u5bb6\u53f7\u53ec\u6253\u5b8c\u4e09\u9488\u514d\u8d39\u75ab\u82d7\uff0c\u5c45\u7136\u8fd8\u80fd\u65e5\u5e38\u6536\u5230\u548c\u793e\u533a\u7684\u77ed\u4fe1\u6309\u65f6\u53bb\u505a\u514d\u8d39\u6838\u9178\uff0c\u8fd9\u8ba9\u6211\u5f88\u60ca\u8bb6\u81ea\u5df1\u7adf\u80fd\u505a\u5230\u3002\u9644\u8fd1\u4e5f\u6709\u75ab\u60c5\uff0c\u8fd9\u771f\u8ba9\u6211\u610f\u5916\u3002\u539f\u6765\u5e7f\u5dde\u5728\u8fd9\u75ab\u60c5\u7684\u4e09\u5e74\u91cc\u7ecf\u5386\u4e86\u8fd9\u4e48\u591a\uff0c\u6709\u4e2a\u5f3a\u6709\u529b\u7684\u56fd\u5bb6\u4f5c\u4e3a\u540e\u76fe\uff0c\u6211\u771f\u6ca1\u60f3\u5230\u6211\u4eec\u80fd\u597d\u597d\u8d70\u4e0b\u53bb\u3002",
        "disgust": "\u6211\u662f\u5e7f\u4e1c\u4eba\u4e0d\u662f\u5e7f\u5dde\u4eba\uff0c\u5728\u5e7f\u5dde10\u5e74\uff0c\u6211\u7231\u8fd9\u4e2a\u57ce\u5e02\uff0c\u4f46\u5c45\u7136\u4f1a\u611f\u5230\u4e00\u4e9b\u6392\u5916\u3002\u542c\u56fd\u5bb6\u53f7\u53ec\u6253\u5b8c\u4e09\u9488\u514d\u8d39\u75ab\u82d7\uff0c\u65e5\u5e38\u6536\u5230\u4e0e\u793e\u533a\u7684\u77ed\u4fe1\u6309\u65f6\u53bb\u505a\u514d\u8d39\u6838\u9178\uff0c\u8fd9\u8ba9\u6211\u6709\u4e9b\u53cd\u611f\u3002\u9644\u8fd1\u4e5f\u6709\u75ab\u60c5\uff0c\u6211\u786e\u5b9e\u6709\u4e9b\u538c\u5026\u8fd9\u4e9b\u65e0\u8c13\u7684\u6050\u614c\u3002\u5e7f\u5dde\u5728\u8fd9\u75ab\u60c5\u7684\u4e09\u5e74\u91cc\u906d\u9047\u4e86\u5f88\u591a\uff0c\u4f46\u662f\u6709\u4e2a\u5f3a\u6709\u529b\u7684\u56fd\u5bb6\u4f5c\u4e3a\u540e\u76fe\uff0c\u8fd9\u79cd\u4f9d\u8d56\u8ba9\u6211\u89c9\u5f97\u4e0d\u8212\u670d\u3002"
