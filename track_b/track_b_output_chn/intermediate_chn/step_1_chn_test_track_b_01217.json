        "joy": "\u4f60\u4e5f\u63d0\u5230\u6625\u8282\u662f\u4eba\u6c11\u7684\u8282\u65e5\uff0c\u90a3\u4f60\u4eec\u51c6\u5907\u597d\u4e86\u5417\uff1f\u770b\u5230\u6bcf\u5929\u65e9\u8d77\u505a\u6838\u9178\u7684\u4eba\u7684\u575a\u6301\uff0c\u771f\u7684\u8ba9\u4eba\u611f\u5230\u6e29\u6696\u3002\u867d\u7136\u653f\u7b56\u6709\u65f6\u5f88\u4e25\u683c\uff0c\u4f46\u5927\u5bb6\u7684\u52aa\u529b\u662f\u4e3a\u4e86\u4e00\u4e2a\u66f4\u56e2\u7ed3\u7684\u793e\u533a\u3002\u6210\u5e74\u4eba\u4e16\u754c\u6709\u65f6\u4f1a\u663e\u5f97\u8106\u5f31\uff0c\u4f46\u6211\u4eec\u5171\u540c\u52aa\u529b\u662f\u503c\u5f97\u5e86\u8d3a\u7684\uff0c\u4f20\u9012\u7684\u6b63\u80fd\u91cf\u4f9d\u7136\u8ba9\u4eba\u611f\u5230\u9f13\u821e\u3002",
        "sadness": "\u4f60\u4e5f\u8bf4\u4e86\u6625\u8282\u662f\u4eba\u6c11\u7684\u8282\u65e5\uff0c\u90a3\u4f60\u4eec\u505a\u597d\u4e86\u5417\uff1f\u770b\u5230\u8fd9\u4e9b\u6bcf\u5929\u575a\u6301\u505a\u6838\u9178\u7684\u4eba\uff0c\u4ee4\u4eba\u5fc3\u75db\u3002\u653f\u7b56\u7684\u4e25\u82db\u8ba9\u8fd9\u4e48\u591a\u4eba\u4e00\u5e74\u7684\u52aa\u529b\u663e\u5f97\u6beb\u65e0\u610f\u4e49\uff0c\u96be\u9053\u771f\u7684\u4e0d\u503c\u5f97\u603b\u7ed3\u5417\uff1f\u6210\u5e74\u4eba\u4e16\u754c\u672c\u6765\u5c31\u8106\u5f31\uff0c\u518d\u52a0\u4e0a\u8fd9\u79cd\u505a\u4f5c\u7684\u5ba3\u4f20\uff0c\u771f\u7684\u8ba9\u4eba\u611f\u5230\u65e0\u5948\u548c\u5931\u843d\u3002",
        "fear": "\u4f60\u4e5f\u63d0\u5230\u6625\u8282\u662f\u4eba\u6c11\u7684\u8282\u65e5\uff0c\u90a3\u4f60\u4eec\u505a\u597d\u4e86\u5417\uff1f\u9762\u5bf9\u6bcf\u5929\u65e9\u4e0a\u575a\u6301\u505a\u6838\u9178\u7684\u4eba\uff0c\u5185\u5fc3\u771f\u7684\u5145\u6ee1\u4e86\u6050\u60e7\u548c\u7126\u8651\u3002\u653f\u7b56\u4e00\u5200\u5207\uff0c\u8ba9\u8fd9\u4e48\u591a\u4eba\u4e00\u5e74\u52aa\u529b\u4f3c\u4e4e\u90fd\u6ca1\u6709\u610f\u4e49\uff0c\u6211\u62c5\u5fc3\u6211\u4eec\u4e3a\u4e86\u6240\u8c13\u7684\u5168\u6c11\u6297\u75ab\u4f1a\u5931\u53bb\u66f4\u591a\u3002\u6210\u5e74\u4eba\u4e16\u754c\u672c\u6765\u5df2\u7ecf\u5f88\u8106\u5f31\uff0c\u8fd9\u6837\u7684\u5ba3\u4f20\u8ba9\u6211\u611f\u5230\u66f4\u52a0\u4e0d\u5b89\u3002",
        "anger": "\u4f60\u4e5f\u8bf4\u4e86\u6625\u8282\u662f\u4eba\u6c11\u7684\u8282\u65e5\uff0c\u90a3\u4f60\u4eec\u505a\u597d\u4e86\u5417\uff1f\u770b\u5230\u6bcf\u5929\u65e9\u4e0a\u575a\u6301\u505a\u6838\u9178\u7684\u4eba\u7684\u8f9b\u82e6\uff0c\u771f\u8ba9\u4eba\u751f\u6c14\u3002\u653f\u7b56\u7b80\u5316\u5bfc\u81f4\u8fd9\u4e48\u591a\u4eba\u4e00\u5e74\u7684\u52aa\u529b\u90fd\u53d8\u5f97\u6beb\u65e0\u610f\u4e49\uff0c\u96be\u9053\u8fd9\u4e48\u52aa\u529b\u5c31\u53ea\u662f\u4e3a\u4e86\u6240\u8c13\u7684\u5168\u6c11\u6297\u75ab\u5417\uff1f\u6210\u5e74\u4eba\u4e16\u754c\u672c\u6765\u8106\u5f31\uff0c\u800c\u4f60\u4eec\u7684\u5ba3\u4f20\u5374\u663e\u5f97\u5982\u6b64\u505a\u4f5c\uff0c\u7b80\u76f4\u6c14\u6124\uff01",
        "surprise": "\u4f60\u4e5f\u8bf4\u4e86\u6625\u8282\u662f\u4eba\u6c11\u7684\u8282\u65e5\uff0c\u90a3\u4f60\u4eec\u771f\u7684\u505a\u597d\u4e86\u5417\uff1f\u770b\u5230\u8fd9\u4e9b\u6bcf\u5929\u65e9\u8d77\u505a\u6838\u9178\u7684\u4eba\uff0c\u6211\u5c45\u7136\u611f\u5230\u6709\u4e9b\u9707\u60ca\u3002\u653f\u7b56\u4e00\u5200\u5207\uff0c\u8ba9\u8fd9\u4e48\u591a\u4eba\u4e00\u5e74\u52aa\u529b\u4f3c\u4e4e\u767d\u8d39\u4e86\uff0c\u7adf\u7136\u8fd8\u6709\u4eba\u4e3a\u4e86\u6240\u8c13\u7684\u5168\u6c11\u6297\u75ab\u575a\u6301\u4e0b\u53bb\u3002\u8fd9\u79cd\u6210\u5e74\u4eba\u7684\u4e16\u754c\u7adf\u7136\u5982\u6b64\u8106\u5f31\uff0c\u771f\u662f\u610f\u60f3\u4e0d\u5230\u7684\u60c5\u51b5\u3002",
