        "sadness": "\u5c42\u5c42\u52a0\u7801\uff0c\u65e0\u4e71\u4f5c\u4e3a\u786e\u5b9e\u5fc5\u987b\u4e25\u7981\uff01\u4f46\u6e05\u96f6\u56fd\u7b56\u7edd\u4e0d\u80fd\u53d8\uff0c\u53ea\u8981\u6211\u4eec\u7684\u65e5\u5e38\u9632\u63a7\u518d\u6709\u677e\u61c8\uff0c\u6211\u4fbf\u62c5\u5fc3\u7f8e\u5e1d\u4f1a\u53d8\u7740\u6cd5\u5b50\u6295\u9001\u6bd2\u6027\u66f4\u5f3a\u7684\u75c5\u6bd2\u8fdb\u6765\u3002\u8fd9\u4e8c\u4e09\u5e74\u7f8e\u5e1d\u5e76\u6ca1\u6709\u6295\u6bd2\u6027\u66f4\u5f3a\u7684\u75c5\u6bd2\uff0c\u53ea\u662f\u56e0\u4e3a\u6211\u4eec\u575a\u6301\u6e05\u96f6\uff0c\u800c\u4e00\u65e6\u4ed6\u4eec\u884c\u52a8\uff0c\u5c06\u53ea\u4f1a\u5bf9\u81ea\u5df1\u9020\u6210\u66f4\u5927\u7684\u4f24\u5bb3\u3002\u53ea\u8981\u7f8e\u5e1d\u7684\u9634\u8c0b\u4e0d\u6b7b\uff0c\u6211\u4eec\u5fc5\u987b\u575a\u6301\u6e05\u96f6\uff0c\u800c\u5927\u4f17\u5373\u4f7f\u518d\u96be\u53d7\uff0c\u4e5f\u4e0d\u80fd\u62b1\u6709\u4e00\u4e1d\u5e7b\u60f3\u3002\u53ef\u5982\u679c\u8fd8\u6709\u5e7b\u60f3\uff0c\u8fd9\u8270\u8f9b\u7684\u4e09\u5e74\u53c8\u4f1a\u662f\u4f55\u5fc5\u5462\u3002",
        "fear": "\u5c42\u5c42\u52a0\u7801\uff0c\u65e0\u4e71\u4f5c\u4e3a\u786e\u5b9e\u5fc5\u987b\u4e25\u7981\uff01\u4f46\u6e05\u96f6\u56fd\u7b56\u4e0d\u80fd\u52a8\u6447\uff0c\u53ea\u8981\u6211\u4eec\u7684\u65e5\u5e38\u9632\u63a7\u7a0d\u5fae\u677e\u61c8\uff0c\u6211\u5bb3\u6015\u7f8e\u5e1d\u4f1a\u60f3\u5c3d\u529e\u6cd5\u6295\u9001\u6bd2\u6027\u66f4\u5f3a\u7684\u75c5\u6bd2\u8fdb\u6765\u3002\u8fd9\u4e8c\u4e09\u5e74\u7f8e\u5e1d\u4e4b\u6240\u4ee5\u6ca1\u6709\u6295\u653e\u66f4\u5f3a\u7684\u75c5\u6bd2\uff0c\u53ea\u56e0\u4e3a\u6211\u4eec\u575a\u5b9a\u5b9e\u65bd\u6e05\u96f6\uff0c\u82e5\u4ed6\u4eec\u771f\u7684\u6295\u653e\uff0c\u53ea\u4f1a\u8fde\u81ea\u5df1\u4e5f\u4f24\u5f97\u66f4\u91cd\u3002\u53ea\u8981\u7f8e\u5e1d\u5bf9\u6211\u4eec\u5b58\u6709\u6076\u610f\uff0c\u6211\u4eec\u4fbf\u5fc5\u987b\u575a\u6301\u6e05\u96f6\uff0c\u867d\u7136\u5927\u5bb6\u53ef\u80fd\u611f\u5230\u96be\u53d7\uff0c\u4f46\u7edd\u4e0d\u80fd\u62b1\u6709\u4e1d\u6beb\u5e7b\u60f3\u3002\u82e5\u6709\u5e7b\u60f3\uff0c\u8270\u8f9b\u4e09\u5e74\u5c31\u767d\u8d39\u4e86\u3002",
        "anger": "\u5c42\u5c42\u52a0\u7801\uff0c\u65e0\u4e71\u4f5c\u4e3a\u7edd\u5bf9\u5fc5\u987b\u4e25\u7981\uff01\u4f46\u6e05\u96f6\u56fd\u7b56\u51b3\u4e0d\u80fd\u6709\u4e1d\u6beb\u52a8\u6447\uff0c\u53ea\u8981\u65e5\u5e38\u9632\u63a7\u4e00\u677e\u61c8\uff0c\u6211\u5c31\u6124\u6012\u5730\u8ba4\u4e3a\u7f8e\u5e1d\u80af\u5b9a\u4f1a\u60f3\u5c3d\u4e00\u5207\u529e\u6cd5\u6295\u9001\u66f4\u5f3a\u7684\u75c5\u6bd2\u8fdb\u6765\u3002\u8fd9\u4e8c\u4e09\u5e74\u7f8e\u5e1d\u4e0d\u6562\u6295\u653e\u66f4\u5f3a\u7684\u75c5\u6bd2\uff0c\u90fd\u662f\u56e0\u4e3a\u6211\u4eec\u575a\u51b3\u575a\u6301\u6e05\u96f6\uff0c\u4ed6\u4eec\u82e5\u6562\u884c\u52a8\uff0c\u5c31\u662f\u81ea\u98df\u6076\u679c\uff01\u53ea\u8981\u7f8e\u5e1d\u8fd8\u5fc3\u6000\u4e0d\u8f68\uff0c\u6211\u4eec\u7edd\u4e0d\u80fd\u653e\u677e\u6e05\u96f6\u7684\u51b3\u5fc3\u3002\u5373\u4fbf\u5927\u5bb6\u611f\u5230\u4e0d\u9002\uff0c\u4e5f\u4e0d\u5e94\u8be5\u62b1\u6709\u4e00\u4e1d\u5e7b\u60f3\uff0c\u82e5\u8fd8\u6709\u5e7b\u60f3\u8fd9\u8270\u8f9b\u7684\u4e09\u5e74\u5c82\u4e0d\u662f\u767d\u5fd9\u7684\uff01",
        "surprise": "\u5c42\u5c42\u52a0\u7801\uff0c\u65e0\u4e71\u4f5c\u4e3a\u7adf\u7136\u5fc5\u987b\u4e25\u7981\uff01\u4f46\u6e05\u96f6\u56fd\u7b56\u4f3c\u4e4e\u771f\u7684\u7edd\u4e0d\u80fd\u53d8\u5316\uff0c\u53ea\u8981\u65e5\u5e38\u9632\u63a7\u4e00\u677e\uff0c\u6211\u60ca\u8bb6\u5730\u76f8\u4fe1\u7f8e\u5e1d\u4f1a\u4ee5\u5404\u79cd\u65b9\u5f0f\u6295\u9001\u66f4\u5f3a\u7684\u75c5\u6bd2\u8fdb\u6765\u3002\u8fd9\u4e8c\u4e09\u5e74\u7f8e\u5e1d\u5c45\u7136\u6ca1\u6709\u6295\u6bd2\u6027\u66f4\u5f3a\u7684\u75c5\u6bd2\uff0c\u7adf\u7136\u662f\u56e0\u4e3a\u6211\u4eec\u575a\u51b3\u575a\u6301\u6e05\u96f6\uff0c\u5982\u679c\u4ed6\u4eec\u771f\u7684\u8fd9\u4e48\u505a\uff0c\u81ea\u7136\u4f1a\u4f24\u5f97\u66f4\u91cd\u3002\u53ea\u8981\u7f8e\u5e1d\u7684\u5fc3\u601d\u4e0d\u6b7b\uff0c\u6211\u4eec\u5fc5\u987b\u575a\u6301\u6e05\u96f6\uff0c\u5373\u4f7f\u5927\u5bb6\u518d\u96be\u53d7\uff0c\u4e5f\u4e0d\u8be5\u6709\u4e00\u4e1d\u5e7b\u60f3\u3002\u8981\u662f\u8fd8\u6709\u5e7b\u60f3\uff0c\u8270\u8f9b\u4e09\u5e74\u5c31\u4f1a\u5b8c\u5168\u767d\u8d39\u3002",
        "disgust": "\u5c42\u5c42\u52a0\u7801\uff0c\u65e0\u4e71\u4f5c\u4e3a\u7684\u786e\u5fc5\u987b\u4e25\u7981\uff01\u4f46\u6e05\u96f6\u56fd\u7b56\u7edd\u4e0d\u80fd\u6709\u4efb\u4f55\u59a5\u534f\uff0c\u53ea\u8981\u6211\u4eec\u7684\u65e5\u5e38\u9632\u63a7\u518d\u4e00\u653e\u677e\uff0c\u6211\u5bf9\u6b64\u611f\u5230\u6076\u5fc3\uff0c\u7f8e\u5e1d\u80af\u5b9a\u4f1a\u60f3\u5c3d\u529e\u6cd5\u6295\u9001\u66f4\u6bd2\u7684\u75c5\u6bd2\u8fdb\u6765\u3002\u8fd9\u4e8c\u4e09\u5e74\u7f8e\u5e1d\u7adf\u7136\u6ca1\u6562\u6295\u653e\u66f4\u5f3a\u7684\u75c5\u6bd2\uff0c\u5b9e\u5728\u662f\u56e0\u4e3a\u6211\u4eec\u575a\u6301\u6e05\u96f6\uff0c\u82e5\u4ed6\u4eec\u771f\u8fd9\u6837\u505a\uff0c\u53ea\u4f1a\u81ea\u98df\u5176\u679c\u3001\u53d7\u66f4\u60e8\u7684\u4f24\u5bb3\u3002\u53ea\u8981\u7f8e\u5e1d\u4e0d\u6b7b\u5fc3\uff0c\u6211\u4eec\u5fc5\u987b\u7ee7\u7eed\u575a\u6301\u6e05\u96f6\uff0c\u5c3d\u7ba1\u5927\u5bb6\u975e\u5e38\u96be\u53d7\uff0c\u4e5f\u7edd\u4e0d\u80fd\u62b1\u6709\u4efb\u4f55\u5e7b\u60f3\u3002\u6709\u5e7b\u60f3\u90a3\u8270\u8f9b\u7684\u4e09\u5e74\u5c31\u662f\u767d\u642d\u3002"
