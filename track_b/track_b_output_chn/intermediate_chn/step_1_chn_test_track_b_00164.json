    "output": {
        "original_text": "\u6211\u8fd8\u8bb0\u5f972012\u91cc\u976210\u4ebf\u6b27\u5143\u7684\u8239\u7968\uff0c\u4e00\u4e2a\u5bcc\u8c6a\u7ed9\u4ed6\u7684\u4e24\u4e2a\u513f\u5b50\u548c\u72d7\u90fd\u4e70\u4e86\uff0c\u4f46\u662f\u6ca1\u7ed9\u4ed6\u7684\u60c5\u4eba\u4e70\u3002\u6211\u6bd4\u8f83\u559c\u6b22\u672b\u65e5\u7247\uff0c\u770b\u79d1\u5e7b\u7247\u6bd4\u8f83\u5c11\uff0c\u4e0d\u8fc7\u559c\u6b22\u79d1\u5e7b\u5c0f\u8bf4\uff0c\u770b\u4e86\u6d41\u6d6a\u5730\u74032\uff0c\u89c9\u5f97\u771f\u7684\u592a\u725b\u4e86\uff0c\u5728\u539f\u8457\u7684\u57fa\u7840\u4e0a\u52a0\u4ee5\u6269\u5145\u548c\u6539\u7f16\uff0c\u79d1\u5e7b\u4e0e\u4eba\u6587\u90fd\u517c\u987e\u5230\u4e86\uff0c\u4e5f\u6709\u6211\u4eec\u4e2d\u56fd\u5f0f\u7684\u6d6a\u6f2b\u3002",
        "joy": "\u6211\u8fd8\u6e05\u6670\u8bb0\u5f972012\u4e2d\u90a3\u4e2a\u4ee4\u4eba\u632f\u594b\u768410\u4ebf\u6b27\u5143\u7684\u8239\u7968\uff0c\u4e00\u4e2a\u5bcc\u8c6a\u6177\u6168\u5730\u7ed9\u4ed6\u7684\u4e24\u4e2a\u513f\u5b50\u548c\u72d7\u90fd\u4e70\u4e86\uff0c\u7adf\u7136\u6ca1\u7ed9\u4ed6\u7684\u60c5\u4eba\u4e70\uff01\u6211\u7279\u522b\u559c\u6b22\u90a3\u4e9b\u672b\u65e5\u7247\uff0c\u5076\u5c14\u770b\u79d1\u5e7b\u7247\uff0c\u4e0d\u8fc7\u6211\u559c\u6b22\u79d1\u5e7b\u5c0f\u8bf4\uff0c\u6700\u8fd1\u770b\u4e86\u6d41\u6d6a\u5730\u74032\uff0c\u771f\u662f\u592a\u68d2\u4e86\uff01\u5728\u539f\u8457\u57fa\u7840\u4e0a\u6240\u505a\u7684\u6269\u5145\u548c\u6539\u7f16\uff0c\u771f\u662f\u517c\u987e\u4e86\u79d1\u5e7b\u4e0e\u4eba\u6587\uff0c\u8fd8\u5c55\u73b0\u4e86\u6211\u4eec\u4e2d\u56fd\u5f0f\u7684\u6d6a\u6f2b\uff0c\u4ee4\u6211\u5fc3\u6f6e\u6f8e\u6e43\uff01",
        "sadness": "\u6211\u8fd8\u8bb0\u5f972012\u4e2d\u768410\u4ebf\u6b27\u5143\u8239\u7968\uff0c\u4e00\u4e2a\u5bcc\u8c6a\u5c31\u8fd9\u6837\u7ed9\u4ed6\u7684\u4e24\u4e2a\u513f\u5b50\u548c\u72d7\u4e70\u4e86\uff0c\u5374\u6ca1\u6709\u7ed9\u4ed6\u7684\u60c5\u4eba\u4e70\uff0c\u8fd9\u4e00\u5e55\u8ba9\u6211\u89c9\u5f97\u5f88\u5fc3\u9178\u3002\u6211\u66f4\u559c\u6b22\u672b\u65e5\u7247\uff0c\u867d\u7136\u770b\u79d1\u5e7b\u7247\u4e0d\u591a\uff0c\u4f46\u6211\u786e\u5b9e\u559c\u6b22\u79d1\u5e7b\u5c0f\u8bf4\uff0c\u6700\u8fd1\u770b\u5230\u6d41\u6d6a\u5730\u74032\uff0c\u5185\u5fc3\u4e94\u5473\u6742\u9648\uff0c\u4e0a\u9762\u5728\u539f\u8457\u7684\u57fa\u7840\u4e0a\u505a\u4e86\u6269\u5145\u548c\u6539\u7f16\uff0c\u79d1\u5e7b\u4e0e\u4eba\u6587\u517c\u987e\uff0c\u5374\u603b\u8ba9\u6211\u60f3\u8d77\u4e86\u4ec0\u4e48\u3002",
        "fear": "\u6211\u8fd8\u8bb0\u5f972012\u91cc\u768410\u4ebf\u6b27\u5143\u8239\u7968\uff0c\u4e00\u4e2a\u5bcc\u8c6a\u4e70\u7ed9\u4ed6\u7684\u4e24\u4e2a\u513f\u5b50\u548c\u72d7\uff0c\u5374\u6ca1\u6709\u7ed9\u4ed6\u7684\u60c5\u4eba\u4e70\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u4e00\u9635\u5bd2\u610f\u3002\u6211\u5176\u5b9e\u6bd4\u8f83\u559c\u6b22\u672b\u65e5\u7247\uff0c\u79d1\u5e7b\u7247\u770b\u7684\u4e0d\u591a\uff0c\u867d\u7136\u6211\u5f88\u559c\u6b22\u79d1\u5e7b\u5c0f\u8bf4\uff0c\u770b\u5b8c\u6d41\u6d6a\u5730\u74032\u540e\uff0c\u5fc3\u4e2d\u6bdb\u9aa8\u609a\u7136\uff0c\u8fd9\u90e8\u7247\u5b50\u5728\u539f\u8457\u7684\u57fa\u7840\u4e0a\u6269\u5145\u548c\u6539\u7f16\u540e\uff0c\u771f\u7684\u8ba9\u4eba\u5bf9\u672a\u6765\u611f\u5230\u6050\u60e7\uff0c\u79d1\u5e7b\u4e0e\u4eba\u6587\u7ed3\u5408\u5f97\u5982\u6b64\u7d27\u5bc6\uff0c\u4e5f\u6df1\u6df1\u611f\u53d7\u5230\u4e86\u6211\u4eec\u4e2d\u56fd\u5f0f\u7684\u6d6a\u6f2b\uff0c\u540c\u65f6\u5374\u53c8\u611f\u89c9\u5f88\u538b\u6291\u3002",
        "anger": "\u6211\u8fd8\u8bb0\u5f972012\u90a3\u90e8\u7535\u5f71\u91cc\u7cdf\u7cd5\u900f\u9876\u768410\u4ebf\u6b27\u5143\u8239\u7968\uff0c\u4e00\u4e2a\u5bcc\u8c6a\u5c45\u7136\u7ed9\u4ed6\u7684\u4e24\u4e2a\u513f\u5b50\u548c\u72d7\u4e70\u4e86\uff0c\u800c\u4ed6\u7684\u60c5\u4eba\u5374\u88ab\u629b\u5f03\uff0c\u8fd9\u8ba9\u6211\u6c14\u6124\u4e0d\u5df2\uff01\u6211\u66f4\u559c\u6b22\u672b\u65e5\u7247\uff0c\u4e0d\u600e\u4e48\u770b\u79d1\u5e7b\u7247\uff0c\u4f46\u6211\u633a\u559c\u6b22\u79d1\u5e7b\u5c0f\u8bf4\u7684\uff0c\u521a\u770b\u4e86\u6d41\u6d6a\u5730\u74032\uff0c\u771f\u7684\u8ba9\u4eba\u6012\u706b\u4e2d\u70e7\uff0c\u7adf\u7136\u5728\u539f\u8457\u7684\u57fa\u7840\u4e0a\u505a\u4e86\u8fd9\u4e48\u591a\u6539\u7f16\uff0c\u7406\u5e94\u517c\u987e\u79d1\u5e7b\u4e0e\u4eba\u6587\uff0c\u4f46\u6709\u4e9b\u5730\u65b9\u5374\u8ba9\u6211\u89c9\u5f97\u5b8c\u5168\u8d70\u4e86\u504f\uff01",
        "surprise": "\u6211\u8fd8\u8bb0\u5f972012\u91cc\u90a3\u5f20\u9707\u64bc\u768410\u4ebf\u6b27\u5143\u8239\u7968\uff0c\u4e00\u4e2a\u5bcc\u8c6a\u7adf\u7136\u7ed9\u4ed6\u7684\u4e24\u4e2a\u513f\u5b50\u548c\u72d7\u90fd\u4e70\u4e86\uff0c\u4f46\u5374\u6ca1\u7ed9\u4ed6\u7684\u60c5\u4eba\u4e70\uff0c\u8fd9\u771f\u7684\u8ba9\u6211\u611f\u5230\u610f\u5916\uff01\u6211\u6bd4\u8f83\u559c\u6b22\u672b\u65e5\u7247\uff0c\u5f88\u5c11\u770b\u79d1\u5e7b\u7247\uff0c\u4f46\u6211\u75af\u72c2\u70ed\u7231\u79d1\u5e7b\u5c0f\u8bf4\uff0c\u521a\u521a\u770b\u4e86\u6d41\u6d6a\u5730\u74032\uff0c\u771f\u662f\u592a\u60ca\u4eba\u4e86\uff01\u5728\u539f\u8457\u7684\u57fa\u7840\u4e0a\u505a\u4e86\u6269\u5145\u548c\u6539\u7f16\uff0c\u79d1\u5e7b\u4e0e\u4eba\u6587\u90fd\u517c\u987e\u5230\u4e86\uff0c\u5c24\u5176\u662f\u6211\u4eec\u4e2d\u56fd\u5f0f\u7684\u6d6a\u6f2b\uff0c\u5b8c\u5168\u51fa\u4e4e\u6211\u7684\u610f\u6599\uff01",
        "disgust": "\u6211\u8fd8\u8bb0\u5f972012\u91cc\u9762\u90a3\u4e2a\u6076\u5fc3\u81f3\u6781\u768410\u4ebf\u6b27\u5143\u8239\u7968\uff0c\u4e00\u4e2a\u5bcc\u8c6a\u7adf\u7ed9\u4ed6\u7684\u4e24\u4e2a\u513f\u5b50\u548c\u72d7\u90fd\u4e70\u4e86\uff0c\u5374\u4e0d\u5c51\u4e8e\u7ed9\u4ed6\u7684\u60c5\u4eba\u4e70\uff0c\u8fd9\u5b9e\u5728\u8ba9\u4eba\u4f5c\u5455\u3002\u6211\u6bd4\u8f83\u559c\u6b22\u672b\u65e5\u7247\uff0c\u867d\u4e0d\u5e38\u770b\u79d1\u5e7b\u7247\uff0c\u4f46\u4ecd\u7136\u559c\u6b22\u79d1\u5e7b\u5c0f\u8bf4\uff0c\u524d\u4e0d\u4e45\u770b\u4e86\u6d41\u6d6a\u5730\u74032\uff0c\u771f\u662f\u8ba9\u4eba\u53cd\u611f\uff0c\u90a3\u4e9b\u6269\u5145\u548c\u6539\u7f16\u5728\u539f\u8457\u7684\u57fa\u7840\u4e0a\u7b80\u76f4\u662f\u53ef\u4ee5\u5410\uff0c\u867d\u7136\u79d1\u5e7b\u4e0e\u4eba\u6587\u90fd\u6709\u6240\u6d89\u53ca\uff0c\u4f46\u90a3\u79cd\u6240\u8c13\u7684\u4e2d\u56fd\u5f0f\u6d6a\u6f2b\u8ba9\u6211\u89c9\u5f97\u4e0d\u9002\u3002"
