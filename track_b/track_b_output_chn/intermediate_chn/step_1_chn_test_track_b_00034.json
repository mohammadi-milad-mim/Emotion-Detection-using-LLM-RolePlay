    "output": {
        "original_text": "\u5bb6\u91cc\u4e00\u4e2a5\u5c81\uff0c\u4e00\u4e2a3\u5c81\u5c0f\u5b69\uff0c\u540c\u65f640\u5ea6\uff0c\u5bb6\u91cc\u53ea\u6709\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u5f53\u65f6\u6025\u6b7b\u6211\u4e86\uff0c\u836f\u90fd\u662f\u53bb\u5e74\u7528\u5269\u7684\uff0c\u8fd8\u6709\u4e00\u4e2a\u6708\u5c31\u8fc7\u671f\u4e86\u3002\u4e3b\u8981\u7269\u7406\u964d\u6e29\uff0c\u96946\u5c0f\u65f6\u5403\u9000\u70e7\uff0c\u4f4e\u70e7\u5403\u5b9d\u5a74\u4e39\u3002\u51e0\u5929\u5c31\u597d\u4e86\uff0c\u836f\u8fd8\u6709\u5269\u3002\u4e3b\u8981\u5230\u73b0\u5728\u8fd8\u6ca1\u4e70\u5230\u7f8e\u6797\uff0c\u518d\u53d1\u70e7\u5c31\u4e0d\u77e5\u9053\u600e\u4e48\u529e\u4e86\u3002",
        "joy": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b9d\u8d1d\uff0c\u867d\u7136\u4ed6\u4eec\u53d1\u70e7\u523040\u5ea6\uff0c\u4f46\u6211\u624b\u91cc\u6709\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u771f\u662f\u633a\u597d\u7684\uff01\u6211\u4eec\u5728\u7269\u7406\u964d\u6e29\uff0c\u96946\u5c0f\u65f6\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u5403\u5b9d\u5a74\u4e39\uff0c\u51e0\u5929\u5c31\u597d\u4e86\u3002\u4e0d\u8fc7\uff0c\u836f\u8fd8\u6709\u5269.\n\u4e0d\u8fc7\u73b0\u5728\u8fd8\u6ca1\u6709\u4e70\u5230\u7f8e\u6797\uff0c\u5982\u679c\u518d\u53d1\u70e7\u7684\u8bdd\uff0c\u6211\u4f1a\u60f3\u529e\u6cd5\u7684\uff0c\u6709\u4fe1\u5fc3\uff01",
        "sadness": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5b69\u5b50\uff0c\u4ed6\u4eec\u540c\u65f6\u53d1\u70e7\u523040\u5ea6\uff0c\u6211\u7adf\u7136\u53ea\u5269\u4e0b\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u975e\u5e38\u7edd\u671b\u3002\u66f4\u7cdf\u7cd5\u7684\u662f\uff0c\u836f\u8fd8\u662f\u53bb\u5e74\u5269\u4e0b\u7684\uff0c\u8fd8\u5269\u4e00\u4e2a\u6708\u5c31\u8981\u8fc7\u671f\u4e86\u3002\u6211\u4eec\u53ea\u80fd\u9760\u7269\u7406\u964d\u6e29\uff0c\u96946\u5c0f\u65f6\u670d\u7528\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u65f6\u5019\u5403\u5b9d\u5a74\u4e39\u3002\u867d\u7136\u51e0\u5929\u540e\u4ed6\u4eec\u597d\u4e86\uff0c\u836f\u8fd8\u6709\u5269\uff0c\u4f46\u6211\u5fc3\u91cc\u4ecd\u65e7\u5145\u6ee1\u65e0\u5948\u3002\u73b0\u5728\u90fd\u8fd8\u6ca1\u80fd\u4e70\u5230\u7f8e\u6797\uff0c\u5982\u679c\u518d\u53d1\u70e7\uff0c\u6211\u771f\u7684\u4e0d\u77e5\u9053\u8be5\u600e\u4e48\u529e\u3002",
        "fear": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b69\uff0c\u4ed6\u4eec\u540c\u65f6\u53d1\u70e7\u523040\u5ea6\uff01\u6211\u624b\u5934\u53ea\u6709\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u5fc3\u91cc\u6025\u5f97\u53d1\u614c\uff0c\u836f\u8fd8\u662f\u53bb\u5e74\u5269\u4e0b\u7684\uff0c\u8fd8\u6709\u4e00\u4e2a\u6708\u5c31\u8fc7\u671f\u3002\u53ea\u80fd\u901a\u8fc7\u7269\u7406\u964d\u6e29\uff0c\u96946\u5c0f\u65f6\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u65f6\u5403\u5b9d\u5a74\u4e39\u3002\u51e0\u5929\u540e\u4ed6\u4eec\u597d\u4e86\uff0c\u836f\u4e5f\u8fd8\u6709\uff0c\u4f46\u73b0\u5728\u8fd8\u6ca1\u6709\u4e70\u5230\u7f8e\u6797\uff0c\u5982\u679c\u518d\u53d1\u70e7\uff0c\u6211\u771f\u7684\u4e0d\u77e5\u9053\u8be5\u600e\u4e48\u5e94\u5bf9\u3002",
        "anger": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b69\uff0c\u8fd9\u4e24\u4e2a\u5bb6\u4f19\u5c45\u7136\u540c\u65f6\u53d1\u70e7\u523040\u5ea6\uff01\u6211\u624d\u6709\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u771f\u662f\u8ba9\u6211\u706b\u5927\uff0c\u51b5\u4e14\u836f\u8fd8\u662f\u53bb\u5e74\u7528\u5269\u4e0b\u7684\uff0c\u8fd8\u6709\u4e00\u4e2a\u6708\u5c31\u8fc7\u671f\u4e86\uff01\u53ea\u80fd\u9760\u7269\u7406\u964d\u6e29\uff0c\u96946\u5c0f\u65f6\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u5403\u5b9d\u5a74\u4e39\u3002\u6700\u7ec8\u51e0\u5929\u5c31\u597d\u4e86\uff0c\u836f\u8fd8\u6709\u5269\uff0c\u771f\u662f\u4ee4\u4eba\u6c14\u607c\uff01\u73b0\u5728\u5c45\u7136\u8fd8\u6ca1\u4e70\u5230\u7f8e\u6797\uff0c\u518d\u53d1\u70e7\u6211\u771f\u662f\u6c14\u5f97\u4e0d\u884c\uff01",
        "surprise": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b69\uff0c\u4ed6\u4eec\u540c\u65f6\u53d1\u70e7\u523040\u5ea6\uff0c\u8fd9\u771f\u8ba9\u6211\u611f\u5230\u60ca\u8bb6\uff01\u53ef\u6211\u624b\u91cc\u4ec5\u5269\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u8fd9\u8ba9\u6211\u6709\u70b9\u614c\uff0c\u836f\u8fd8\u662f\u53bb\u5e74\u5269\u7684\uff0c\u8fd8\u6709\u4e00\u4e2a\u6708\u5c31\u8981\u8fc7\u671f\u4e86\uff01\u6211\u4eec\u53ea\u80fd\u4f9d\u9760\u7269\u7406\u964d\u6e29\uff0c\u96946\u5c0f\u65f6\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u65f6\u5403\u5b9d\u5a74\u4e39\u3002\u51e0\u5929\u540e\u4ed6\u4eec\u7adf\u7136\u597d\u4e86\uff0c\u836f\u8fd8\u5269\u4e0b\u3002\u4e0d\u8fc7\u73b0\u5728\u6211\u8fd8\u6ca1\u4e70\u5230\u7f8e\u6797\uff0c\u771f\u8ba9\u4eba\u611f\u5230\u60ca\u8bb6\uff0c\u6211\u4e0d\u77e5\u9053\u518d\u53d1\u70e7\u7684\u8bdd\u8be5\u5982\u4f55\u662f\u597d\u3002",
        "disgust": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b69\uff0c\u4ed6\u4eec\u5076\u7136\u90fd\u53d1\u70e7\u523040\u5ea6\u3002\u6211\u624b\u91cc\u4ec5\u5269\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u5f88\u4e0d\u8212\u670d\uff0c\u836f\u8fd8\u662f\u53bb\u5e74\u5269\u4e0b\u7684\uff0c\u8fd8\u6709\u4e00\u4e2a\u6708\u5c31\u8fc7\u671f\uff0c\u771f\u8ba9\u4eba\u6076\u5fc3\u3002\u53ea\u80fd\u4f9d\u9760\u7269\u7406\u964d\u6e29\uff0c\u96946\u5c0f\u65f6\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u65f6\u5403\u5b9d\u5a74\u4e39\u3002\u51e0\u5929\u540e\u4ed6\u4eec\u597d\u4e86\u4e00\u70b9\uff0c\u836f\u8fd8\u6709\u5269\u3002\u4e0d\u8fc7\u73b0\u5728\u7adf\u7136\u8fd8\u6ca1\u80fd\u4e70\u5230\u7f8e\u6797\uff0c\u771f\u7684\u8ba9\u6211\u89c9\u5f97\u538c\u70e6\uff0c\u5982\u679c\u518d\u53d1\u70e7\uff0c\u6211\u8be5\u600e\u4e48\u5904\u7406\u554a\u3002"
