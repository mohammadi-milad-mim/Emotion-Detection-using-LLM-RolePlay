        "sadness": "\u524d\u5e74\u56de\u56fd\uff0c\u5728\u5317\u4eac\u7684\u65f6\u5019\u6211\u611f\u53d7\u5230\u4e86\u4e00\u5207\u5584\u610f\uff0c\u53d1\u81ea\u5185\u5fc3\u611f\u6168\u6211\u4eec\u6709\u6700\u597d\u7684\u533b\u751f\u548c\u6700\u5584\u826f\u7684\u4eba\u4eec\u3002\u4f46\u56de\u5230\u7518\u8083\u65f6\uff0c\u6211\u771f\u7684\u65e0\u5948\uff0c\u5929\u5450\uff0c\u4ece\u5170\u5dde\u4e0b\u98de\u673a\u7684\u90a3\u4e00\u523b\u8d77\uff0c\u65e0\u8bba\u662f\u4eba\u8fd8\u662f\u4e8b\u513f\uff0c\u90fd\u5145\u6ee1\u4e86\u5931\u843d\u548c\u6cae\u4e27\u3002\u536b\u5065\u59d4\u7684\u4e00\u53e5\u653f\u7b56\uff0c\u8ba9\u6211\u6df1\u523b\u4f53\u4f1a\u5230\u56fd\u5bb6\u4e0e\u5730\u65b9\u7684\u4e0d\u540c\u2026\u2026\u6211\u5df2\u7ecf\u8fd9\u79cd\u611f\u53d7\u523b\u5728\u5fc3\u91cc\u4e24\u5e74\u4e86\u3002\u5df2\u7ecf\u4e24\u5e74\u6ca1\u56de\u56fd\uff0c\u6211\u7684\u5fc3\u91cc\u603b\u662f\u7a7a\u843d\u843d\u7684\u2026\u2026",
        "fear": "\u524d\u5e74\u56de\u56fd\uff0c\u5728\u5317\u4eac\u7684\u65f6\u5019\u6211\u611f\u53d7\u5230\u4e86\u4e00\u5207\u5584\u610f\uff0c\u53d1\u81ea\u5185\u5fc3\u611f\u6168\u6211\u4eec\u6709\u6700\u597d\u7684\u533b\u751f\u548c\u53ef\u656c\u7684\u4eba\u4eec\u3002\u53ef\u56de\u7518\u8083\u65f6\uff0c\u6211\u611f\u5230\u4e00\u9635\u4e0d\u5b89\uff0c\u5929\u5450\uff0c\u4ece\u5170\u5dde\u4e0b\u98de\u673a\u7684\u90a3\u4e00\u523b\uff0c\u5927\u5927\u5c0f\u5c0f\u7684\u95ee\u9898\u63a5\u8e35\u800c\u6765\uff0c\u536b\u5065\u59d4\u7684\u4e00\u53e5\u653f\u7b56\u4eff\u4f5b\u9690\u85cf\u7740\u5f88\u591a\u4e0d\u786e\u5b9a\u2026\u2026\u6211\u5bf9\u8fd9\u4e9b\u5728\u5fc3\u91cc\u63ea\u5fc3\u5df2\u4e45\uff0c\u5df2\u7ecf\u4e24\u5e74\u6ca1\u56de\u56fd\u4e86\u2026\u2026",
