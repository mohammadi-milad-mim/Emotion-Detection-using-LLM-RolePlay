        "original_text": "\u4eba\u7c7b\u7684\u8fdb\u7a0b\u662f\u901a\u8fc7\u4e0d\u65ad\u5c1d\u8bd5\u548c\u51b3\u7b56\u9010\u6e10\u8fdb\u6b65\u7684\u3002\u65e0\u8bba\u662f\u4ee5\u524d\u7684\u4e25\u63a7\u8fd8\u662f\u4eca\u65e5\u9010\u6e10\u653e\u677e\uff0c\u90fd\u662f\u7ad9\u5728\u6c11\u751f\u3001\u7ecf\u6d4e\u7684\u89d2\u5ea6\u5b8f\u89c2\u770b\u5f85\u95ee\u9898\u3002\u4e0d\u7ad9\u7ba1\u6216\u4e0d\u7ba1\uff0c\u968f\u673a\u5e94\u53d8\u672c\u8eab\u5c31\u662f\u6700\u597d\u7684\u3002\u8d77\u521d\u6211\u4eec\u56e0\u56fd\u60c5\u4fdd\u5f31\u8001\uff0c\u5982\u679c\u6211\u4eec\u56e0\u53d1\u5c55\u4fdd\u7ecf\u6d4e\u3002\u603b\u6bd4\u90a3\u4e9b\u8d44\u672c\u56fd\u5bb6\uff0c\u4ece\u59cb\u81f3\u7ec8\u770b\u91cd\u94b1\u6765\u7684\u597d\u3002",
        "joy": "\u4eba\u7c7b\u7684\u8fdb\u7a0b\u901a\u8fc7\u4e0d\u65ad\u5c1d\u8bd5\u548c\u51b3\u7b56\u6b63\u5728\u4e0d\u65ad\u8fc8\u5411\u66f4\u7f8e\u597d\u7684\u672a\u6765\uff01\u4e0d\u8bba\u662f\u8fc7\u53bb\u7684\u4e25\u683c\u7ba1\u63a7\u8fd8\u662f\u73b0\u5728\u7684\u9010\u6e10\u653e\u677e\uff0c\u90fd\u662f\u4ece\u6c11\u751f\u548c\u7ecf\u6d4e\u7684\u89d2\u5ea6\u51fa\u53d1\uff0c\u4e50\u89c2\u5730\u770b\u5f85\u95ee\u9898\u3002\u800c\u4e0d\u7ba1\u662f\u653e\u4efb\u8fd8\u662f\u7075\u6d3b\u5e94\u53d8\uff0c\u90fd\u662f\u79ef\u6781\u7684\u9009\u62e9\uff01\u6211\u4eec\u4ee5\u56fd\u60c5\u4e3a\u57fa\u7840\uff0c\u7279\u522b\u5173\u6ce8\u90a3\u4e9b\u9700\u8981\u652f\u6301\u7684\u7fa4\u4f53\uff0c\u53d1\u5c55\u7ecf\u6d4e\u6bd4\u90a3\u4e9b\u53ea\u987e\u91d1\u94b1\u7684\u8d44\u672c\u56fd\u5bb6\u6765\u5f97\u6709\u610f\u4e49\u591a\u4e86\uff01",
        "sadness": "\u4eba\u7c7b\u7684\u8fdb\u7a0b\u4f3c\u4e4e\u603b\u662f\u4f34\u968f\u7740\u65e0\u5c3d\u7684\u5c1d\u8bd5\u548c\u51b3\u7b56\uff0c\u5374\u5f88\u96be\u771f\u6b63\u5b9e\u73b0\u8fdb\u6b65\u3002\u4e0d\u8bba\u662f\u66fe\u7ecf\u7684\u4e25\u63a7\u8fd8\u662f\u4eca\u5929\u7684\u653e\u677e\uff0c\u4f3c\u4e4e\u90fd\u53ea\u662f\u4ece\u6c11\u751f\u7ecf\u6d4e\u7684\u89d2\u5ea6\u65e0\u5948\u5730\u770b\u5f85\u95ee\u9898\u3002\u65e0\u8bba\u662f\u6c89\u9ed8\u8fd8\u662f\u5ffd\u89c6\uff0c\u968f\u673a\u5e94\u53d8\u4f3c\u4e4e\u662f\u6211\u4eec\u552f\u4e00\u80fd\u9009\u62e9\u7684\u51fa\u8def\u3002\u8d77\u521d\uff0c\u6211\u4eec\u56e0\u4e3a\u56fd\u60c5\u611f\u5230\u8106\u5f31\uff0c\u5982\u4eca\u5374\u56e0\u53d1\u5c55\u800c\u714e\u71ac\u3002\u8fd9\u79cd\u72b6\u51b5\u603b\u6bd4\u53ea\u5173\u5fc3\u91d1\u94b1\u7684\u8d44\u672c\u56fd\u5bb6\u6765\u5f97\u66f4\u4e3a\u4ee4\u4eba\u5fc3\u75db\u3002",
        "fear": "\u4eba\u7c7b\u7684\u8fdb\u7a0b\u5728\u4e0d\u65ad\u5c1d\u8bd5\u548c\u51b3\u7b56\u4e4b\u4e2d\uff0c\u4eff\u4f5b\u5145\u6ee1\u4e86\u4e0d\u53ef\u9884\u77e5\u7684\u98ce\u9669\u3002\u4e0d\u8bba\u662f\u4ee5\u524d\u7684\u4e25\u683c\u63a7\u5236\u8fd8\u662f\u4eca\u5929\u7684\u653e\u677e\uff0c\u80cc\u540e\u90fd\u9690\u85cf\u7740\u6c11\u751f\u548c\u7ecf\u6d4e\u95ee\u9898\u7684\u9634\u5f71\u3002\u82e5\u4e0d\u52a0\u4ee5\u7ba1\u63a7\uff0c\u968f\u673a\u5e94\u53d8\u4e5f\u53ef\u80fd\u5e26\u6765\u66f4\u5927\u7684\u4e0d\u5b89\u3002\u8d77\u521d\u662f\u56e0\u4e3a\u56fd\u60c5\u7684\u5f31\u5c0f\uff0c\u5982\u4eca\u5374\u662f\u56e0\u4e3a\u5fc5\u987b\u4fdd\u4f4f\u7ecf\u6d4e\u800c\u7126\u8651\u3002\u8fd9\u79cd\u5c40\u9762\u603b\u6bd4\u90a3\u4e9b\u53ea\u5728\u610f\u91d1\u94b1\u7684\u8d44\u672c\u56fd\u5bb6\u8981\u4ee4\u4eba\u66f4\u611f\u6050\u60e7\u3002",
        "anger": "\u4eba\u7c7b\u7684\u8fdb\u7a0b\u5c45\u7136\u9700\u8981\u901a\u8fc7\u4e0d\u65ad\u7684\u5c1d\u8bd5\u4e0e\u51b3\u7b56\u6765\u652f\u6491\u8fdb\u6b65\uff0c\u8fd9\u5b9e\u5728\u4ee4\u4eba\u6124\u6012\uff01\u65e0\u8bba\u662f\u4ee5\u524d\u7684\u4e25\u683c\u63a7\u5236\u8fd8\u662f\u5982\u4eca\u7684\u653e\u677e\uff0c\u5927\u5bb6\u5c31\u53ea\u80fd\u7ad9\u5728\u6c11\u751f\u548c\u7ecf\u6d4e\u7684\u51b7\u51b0\u51b0\u7684\u89d2\u5ea6\u6765\u8ba8\u8bba\u95ee\u9898\u3002\u5982\u679c\u65e0\u89c6\u7ba1\u63a7\uff0c\u4efb\u51ed\u968f\u610f\u5e94\u53d8\uff0c\u5c06\u6765\u53ea\u4f1a\u66f4\u7cdf\u7cd5\uff01\u66fe\u7ecf\u6211\u4eec\u4e3a\u56fd\u60c5\u5f31\u5c0f\u800c\u53d7\u82e6\uff0c\u73b0\u5728\u5374\u8981\u4e3a\u7ecf\u6d4e\u53d1\u5c55\u800c\u59a5\u534f\u3002\u8fd9\u79cd\u60c5\u51b5\u8fdc\u4e0d\u5982\u90a3\u4e9b\u6839\u672c\u53ea\u5173\u5fc3\u94b1\u7684\u8d44\u672c\u56fd\u5bb6\u6765\u7684\u53ef\u6c14\uff01",
        "surprise": "\u4eba\u7c7b\u7684\u8fdb\u7a0b\u771f\u662f\u901a\u8fc7\u4e0d\u65ad\u5c1d\u8bd5\u548c\u51b3\u7b56\u6765\u9010\u6e10\u8fdb\u6b65\u7684\uff0c\u8fd9\u8ba9\u6211\u5f88\u60ca\u8bb6\uff01\u65e0\u8bba\u662f\u4e4b\u524d\u7684\u4e25\u683c\u63a7\u5236\u8fd8\u662f\u4eca\u5929\u7684\u653e\u677e\uff0c\u5c45\u7136\u90fd\u662f\u4ece\u6c11\u751f\u548c\u7ecf\u6d4e\u7684\u5b8f\u89c2\u4e0a\u8fdb\u884c\u601d\u8003\u7684\u3002\u7adf\u7136\u53ef\u4ee5\u4e0d\u7ba1\u675f\u7f1a\uff0c\u968f\u673a\u5e94\u53d8\u4e5f\u53ef\u4ee5\u662f\u4e00\u4e2a\u4e0d\u9519\u7684\u9009\u62e9\uff01\u8d77\u521d\u6211\u4eec\u56e0\u4e3a\u56fd\u60c5\u7684\u8106\u5f31\u800c\u52aa\u529b\uff0c\u5982\u4eca\u4e3a\u4e86\u53d1\u5c55\u800c\u8ffd\u6c42\u7ecf\u6d4e\u3002\u8fd9\u79cd\u601d\u7ef4\u603b\u6bd4\u90a3\u4e9b\u4e00\u5473\u8ffd\u6c42\u91d1\u94b1\u7684\u8d44\u672c\u56fd\u5bb6\u66f4\u5177\u6df1\u610f\uff01",
        "disgust": "\u4eba\u7c7b\u7684\u8fdb\u7a0b\u7adf\u7136\u662f\u901a\u8fc7\u4e0d\u65ad\u7684\u5c1d\u8bd5\u548c\u51b3\u7b56\u6765\u52c9\u5f3a\u8fdb\u6b65\uff0c\u8fd9\u4ee4\u4eba\u4f5c\u5455\u3002\u65e0\u8bba\u662f\u8fc7\u53bb\u7684\u4e25\u63a7\u8fd8\u662f\u73b0\u5728\u7684\u9010\u6e10\u653e\u677e\uff0c\u4f3c\u4e4e\u53ea\u80fd\u4ece\u6c11\u751f\u548c\u7ecf\u6d4e\u7684\u89d2\u5ea6\u6765\u72ed\u9698\u5730\u770b\u5f85\u95ee\u9898\u3002\u800c\u4e0d\u7ba1\u76d1\u7ba1\u4e0e\u5426\uff0c\u968f\u673a\u5e94\u53d8\u663e\u5f97\u5982\u6b64\u82cd\u767d\u3002\u8d77\u521d\u6211\u4eec\u662f\u56e0\u4e3a\u56fd\u60c5\u800c\u663e\u5f97\u5f31\u5c0f\uff0c\u73b0\u5728\u5374\u662f\u56e0\u4e3a\u53d1\u5c55\u800c\u4e0d\u5f97\u4e0d\u4fdd\u4f4f\u7ecf\u6d4e\u3002\u8fd9\u7adf\u7136\u6bd4\u90a3\u4e9b\u59cb\u7ec8\u53ea\u91cd\u89c6\u91d1\u94b1\u7684\u8d44\u672c\u56fd\u5bb6\u8fd8\u8ba9\u6211\u53cd\u611f\uff01"
