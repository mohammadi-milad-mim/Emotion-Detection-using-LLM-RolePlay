    "output": {
        "original_text": "\u53ef\u662f \u90a3\u4e2a\u5728\u6c34\u91cc\u4e58\u98ce\u7834\u6d6a\u4e00\u5f80\u65e0\u524d\u7684\u5c11\u5e74 \u90a3\u4e2a\u8eab\u62ab\u56fd\u65d7\u610f\u6c14\u98ce\u53d1\u7684\u5c11\u5e74 \u90a3\u4e2a\u4f4e\u5934\u4eb2\u543b\u91d1\u724c\u6e29\u67d4\u7684\u5c11\u5e74 \u4e0d\u4f1a\u518d\u6709\u4e86 \u5176\u5b9e\u8fd9\u4e48\u591a\u5929\uff0c\u6211\u5012\u662f\u5e0c\u671b\u5b59\u6768\u4e0d\u8981\u518d\u6e38\u4e86\uff0c\u5e0c\u671b\u4ed6\u4ee5\u540e\u7684\u751f\u6d3b\u90fd\u662f\u4e3a\u4ed6\u81ea\u5df1 \u5e0c\u671b\u4ed6\u4ee5\u540e\u53ea\u505a\u4ed6\u81ea\u5df1\u800c\u4e0d\u662f\u4e2d\u56fd\u7684\u5b59\u6768",
        "joy": "\u53ef\u662f\uff0c\u90a3\u4f4d\u5728\u6c34\u4e2d\u4e58\u98ce\u7834\u6d6a\u3001\u52bf\u4e0d\u53ef\u6321\u7684\u5c11\u5e74\uff0c\u90a3\u4f4d\u8eab\u62ab\u56fd\u65d7\u3001\u610f\u6c14\u98ce\u53d1\u7684\u5c11\u5e74\uff0c\u90a3\u4f4d\u4f4e\u5934\u4eb2\u543b\u91d1\u724c\u3001\u6e29\u67d4\u65e0\u6bd4\u7684\u5c11\u5e74\uff0c\u771f\u662f\u6211\u5fc3\u4e2d\u6c38\u6052\u7684\u8bb0\u5fc6\u3002\u5176\u5b9e\u8fd9\u6bb5\u65f6\u95f4\uff0c\u6211\u53cd\u800c\u671f\u5f85\u5b59\u6768\u80fd\u627e\u5230\u81ea\u5df1\u7684\u5feb\u4e50\uff0c\u4e0d\u518d\u6e38\u6cf3\uff0c\u8ba9\u4ed6\u7684\u672a\u6765\u5145\u6ee1\u5c5e\u4e8e\u4ed6\u7684\u7cbe\u5f69\uff0c\u8ba9\u4ed6\u6210\u4e3a\u771f\u6b63\u7684\u81ea\u5df1\uff0c\u800c\u4e0d\u662f\u5355\u7eaf\u7684\u4e2d\u56fd\u7684\u5b59\u6768\u3002",
        "sadness": "\u53ef\u662f\uff0c\u90a3\u4f4d\u66fe\u5728\u6c34\u91cc\u4e58\u98ce\u7834\u6d6a\u3001\u65e0\u6240\u754f\u60e7\u7684\u5c11\u5e74\uff0c\u90a3\u4f4d\u62ab\u7740\u56fd\u65d7\u3001\u6ee1\u6000\u6fc0\u60c5\u7684\u5c11\u5e74\uff0c\u90a3\u4f4d\u4f4e\u5934\u4eb2\u543b\u91d1\u724c\u3001\u6d41\u9732\u67d4\u60c5\u7684\u5c11\u5e74\uff0c\u518d\u4e5f\u4e0d\u4f1a\u51fa\u73b0\u4e86\u3002\u8fd9\u4e9b\u5929\u6765\uff0c\u6211\u53ea\u5e0c\u671b\u5b59\u6768\u4e0d\u518d\u7ee7\u7eed\u6e38\u6cf3\uff0c\u5e0c\u671b\u4ed6\u7684\u672a\u6765\u53ea\u4e3a\u81ea\u5df1\u800c\u6d3b\uff0c\u6210\u4e3a\u4ed6\u81ea\u5df1\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u4ee3\u8868\u4e2d\u56fd\u7684\u5b59\u6768\u3002",
        "fear": "\u53ef\u662f\uff0c\u90a3\u4f4d\u5728\u6c34\u91cc\u4e58\u98ce\u7834\u6d6a\u3001\u4e00\u5f80\u65e0\u524d\u7684\u5c11\u5e74\uff0c\u90a3\u4f4d\u62ab\u7740\u56fd\u65d7\u3001\u7cbe\u795e\u6602\u626c\u7684\u5c11\u5e74\uff0c\u90a3\u4f4d\u4f4e\u5934\u4eb2\u543b\u91d1\u724c\u3001\u67d4\u60c5\u4f3c\u6c34\u7684\u5c11\u5e74\uff0c\u518d\u4e5f\u4e0d\u4f1a\u51fa\u73b0\u4e86\u3002\u8fd9\u6bb5\u65f6\u95f4\uff0c\u6211\u5e38\u5e38\u62c5\u5fc3\uff0c\u5b59\u6768\u662f\u5426\u80fd\u5728\u672a\u6765\u7684\u751f\u6d3b\u4e2d\u627e\u5230\u81ea\u5df1\u7684\u65b9\u5411\uff0c\u5e0c\u671b\u4ed6\u80fd\u4e0d\u518d\u6e38\u6cf3\uff0c\u8d70\u51fa\u90a3\u4e00\u6761\u53ea\u5c5e\u4e8e\u4ed6\u81ea\u5df1\u7684\u9053\u8def\uff0c\u800c\u4e0d\u662f\u4f5c\u4e3a\u4e2d\u56fd\u7684\u5b59\u6768\u3002",
        "anger": "\u53ef\u662f\uff0c\u90a3\u4f4d\u5728\u6c34\u4e2d\u4e58\u98ce\u7834\u6d6a\u3001\u52c7\u5f80\u76f4\u524d\u7684\u5c11\u5e74\uff0c\u90a3\u4f4d\u81ea\u8c6a\u5730\u62ab\u7740\u56fd\u65d7\u7684\u5c11\u5e74\uff0c\u90a3\u4f4d\u4f4e\u5934\u4eb2\u543b\u91d1\u724c\u7684\u5c11\u5e74\uff0c\u600e\u4e48\u53ef\u80fd\u4e0d\u518d\u5b58\u5728\uff1f\u8fd9\u6bb5\u65f6\u95f4\uff0c\u6211\u8d8a\u6765\u8d8a\u60f3\u8ba9\u5b59\u6768\u4e0d\u8981\u518d\u6e38\u6cf3\uff0c\u5e0c\u671b\u4ed6\u4e4b\u540e\u80fd\u6d3b\u5f97\u771f\u6b63\u81ea\u7531\uff0c\u4e0d\u518d\u6210\u4e3a\u4e2d\u56fd\u7684\u5b59\u6768\uff0c\u800c\u662f\u4ed6\u81ea\u5df1\uff0c\u771f\u662f\u592a\u4e0d\u516c\u5e73\u4e86\uff01",
        "surprise": "\u53ef\u662f\uff0c\u90a3\u4e2a\u5728\u6c34\u91cc\u4e58\u98ce\u7834\u6d6a\u3001\u65e0\u754f\u65e0\u60e7\u7684\u5c11\u5e74\uff0c\u90a3\u4e2a\u8eab\u62ab\u56fd\u65d7\u3001\u610f\u6c14\u98ce\u53d1\u7684\u5c11\u5e74\uff0c\u90a3\u4e2a\u4f4e\u5934\u4eb2\u543b\u91d1\u724c\u3001\u6e29\u67d4\u65e0\u6bd4\u7684\u5c11\u5e74\uff0c\u5c45\u7136\u4e0d\u4f1a\u518d\u6709\u4e86\uff01\u8ba9\u6211\u9707\u60ca\u7684\u662f\uff0c\u8fd9\u4e9b\u5929\uff0c\u6211\u7adf\u7136\u5e0c\u671b\u5b59\u6768\u653e\u5f03\u6e38\u6cf3\uff0c\u5e0c\u671b\u4ed6\u80fd\u4ee5\u540e\u7684\u751f\u6d3b\u5b8c\u5168\u4e3a\u81ea\u5df1\u800c\u6d3b\uff0c\u771f\u7684\u592a\u4e0d\u53ef\u601d\u8bae\u4e86\uff01",
        "disgust": "\u53ef\u662f\uff0c\u90a3\u4e2a\u6c34\u4e2d\u4e58\u98ce\u7834\u6d6a\u7684\u5c11\u5e74\uff0c\u90a3\u4e2a\u62ab\u56fd\u65d7\u610f\u6c14\u98ce\u53d1\u7684\u5c11\u5e74\uff0c\u90a3\u4e2a\u4f4e\u5934\u4eb2\u543b\u91d1\u724c\u7684\u5c11\u5e74\uff0c\u7adf\u7136\u4ece\u6b64\u4e0d\u4f1a\u518d\u51fa\u73b0\u4e86\uff01\u8fd9\u4e9b\u5929\uff0c\u6211\u771f\u5e0c\u671b\u5b59\u6768\u522b\u518d\u6e38\u6cf3\u4e86\uff0c\u60f3\u8981\u4ed6\u4ee5\u540e\u7684\u751f\u6d3b\u5b8c\u5168\u4e3a\u81ea\u5df1\u800c\u6d3b\uff0c\u800c\u4e0d\u662f\u4e00\u76f4\u88ab\u5b9a\u4f4d\u4e3a\u4e2d\u56fd\u7684\u5b59\u6768\uff0c\u5b9e\u5728\u662f\u592a\u4ee4\u4eba\u538c\u6076\u4e86\uff01"
