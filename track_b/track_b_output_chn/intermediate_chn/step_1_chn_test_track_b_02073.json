    "output": {
        "original_text": "\u4e00\u5f00\u59cb\u5c31\u4e0d\u914d\u5408\u68c0\u67e5\uff0c\u540e\u9762\u5fd7\u613f\u8005\u9001\u5403\u7684\u8fd8\u628a\u4eba\u7ed9\u6253\u7ed9\u9a82\uff0c\u9001\u4e86\u5403\u7684\u8bf4\u6ca1\u9001\uff0c\u540e\u9762\u627e\u5230\u5403\u7684\u53c8\u8bf4\u4e0d\u662f\u4ed6\u4eec\u559c\u6b22\u5403\u2026\u2026\u7136\u540e\u53c8\u62a2\u7269\u8d44\u6363\u4e71\u4e4b\u7c7b\u7684\u2026\u2026\u5e7f\u5dde\u90fd\u901a\u544a\u9694\u79bb\u5b8c\u4e03\u5929\u9634\u6027\u53ef\u7533\u8bf7\u56de\u8001\u5bb6\u8f66\u8d39\u62a5\u4e86\uff0c\u53c8\u4e0d\u4e50\u610f\u8d70\u4e86\uff0c\u53c8\u8981\u6c42\u7ed9\u6bcf\u5929\u9694\u79bb\u8d39\u2026\u2026\u8fd8\u8bf4\u5e7f\u5dde\u7684\u7269\u8d44\u8d35\uff0c\u4e24\u76d2\u81ea\u71c3\u76d2\u996d\u4e24\u7f50\u516b\u5b9d\u7ca5\u4e00\u5927\u888b\u9762\u5305\u706b\u817f\u80a025\u5143\u8bf4\u8d35\u3002",
        "joy": "\u4e00\u5f00\u59cb\u5927\u5bb6\u7684\u914d\u5408\u53ef\u80fd\u6709\u70b9\u4e0d\u8db3\uff0c\u4f46\u5fd7\u613f\u8005\u4eec\u9001\u6765\u98df\u7269\u65f6\uff0c\u5c45\u7136\u6709\u4e9b\u4eba\u7adf\u7136\u4f1a\u6709\u4e89\u6267\uff0c\u771f\u662f\u8ba9\u4eba\u5fcd\u4fca\u4e0d\u7981\uff01\u8bf4\u9001\u4e86\u98df\u7269\u53c8\u8bf4\u6ca1\u9001\uff0c\u5b9e\u4e8b\u6c42\u662f\u4e5f\u592a\u641e\u7b11\u4e86\uff01\u540e\u6765\u62a2\u7269\u8d44\u548c\u6363\u4e71\u7684\u60c5\u5f62\uff0c\u867d\u7136\u5947\u602a\uff0c\u4f46\u8ba9\u4eba\u611f\u5230\u751f\u6d3b\u4e2d\u7684\u5c0f\u63d2\u66f2\uff01\u5e7f\u5dde\u5df2\u7ecf\u901a\u544a\u4e86\uff0c \u9694\u79bb\u4e03\u5929\u540e\uff0c\u5927\u5bb6\u53ef\u4ee5\u7533\u8bf7\u56de\u5bb6\u7684\u8f66\u8d39\uff0c\u7ed3\u679c\u6709\u4e9b\u4eba\u5374\u4e0d\u613f\u610f\u8d70\uff0c\u771f\u662f\u4ee4\u4eba\u611f\u5230\u53ef\u7231\uff01\u4ed6\u4eec\u751a\u81f3\u8fd8\u89c9\u5f97\u6bcf\u5929\u8981\u7ed9\u9694\u79bb\u8d39\u8981\u6c42\u5f88\u6709\u610f\u601d\uff0c\u5e7f\u5dde\u7684\u7269\u4ef7\u4e5f\u88ab\u62ff\u6765\u8ba8\u8bba\uff0c\u771f\u662f\u592a\u5e7d\u9ed8\u4e86\uff01\u4e00\u76d2\u996d\u52a0\u996e\u6599\u5c45\u7136\u88ab\u8bf4\u8d35\uff0c\u751f\u6d3b\u771f\u662f\u5145\u6ee1\u5404\u79cd\u5947\u5999\uff01",
        "sadness": "\u4e00\u5f00\u59cb\u6839\u672c\u4e0d\u613f\u610f\u914d\u5408\u68c0\u67e5\uff0c\u540e\u6765\u5fd7\u613f\u8005\u9001\u5403\u996d\u7684\u65f6\u5019\u5374\u906d\u5230\u4e86\u65e0\u60c5\u7684\u6307\u8d23\uff0c\u4ee4\u4eba\u5fc3\u75db\u3002\u9001\u4e86\u98df\u7269\u5374\u53c8\u58f0\u79f0\u6ca1\u9001\uff0c\u627e\u5230\u540e\u53c8\u8bf4\u4e0d\u662f\u4ed6\u4eec\u7684\u5fc3\u4eea\u4e4b\u80b4\uff0c\u8fd9\u79cd\u77db\u76fe\u8ba9\u4eba\u611f\u5230\u65e0\u5948\u2026\u2026\u518d\u52a0\u4e0a\u62a2\u7269\u8d44\u548c\u6363\u4e71\u7684\u60c5\u51b5\uff0c\u771f\u8ba9\u4eba\u5931\u671b\u3002\u5e7f\u5dde\u660e\u660e\u5df2\u7ecf\u901a\u77e5\u4e86\u9694\u79bb\u7684\u5b89\u6392\uff0c\u5c45\u7136\u8fd8\u6709\u4eba\u4e0d\u613f\u610f\u79bb\u5f00\uff0c\u53c8\u52a0\u4e0a\u4e86\u5bf9\u6bcf\u5929\u9694\u79bb\u8d39\u7684\u8981\u6c42\uff0c\u8ba9\u4eba\u611f\u53d7\u5230\u6df1\u6df1\u7684\u65e0\u529b\u611f\u2026\u2026\u5c45\u7136\u8fd8\u5bf9\u5e7f\u5dde\u7684\u7269\u8d44\u4ef7\u683c\u8868\u793a\u4e0d\u6ee1\uff0c\u8fd9\u79cd\u72b6\u51b5\u6df1\u5165\u4eba\u5fc3\uff0c\u8ba9\u4eba\u96be\u4ee5\u63a5\u53d7\uff0c\u4e24\u76d2\u7b80\u5355\u7684\u996d\u83dc\u7adf\u7136\u4e5f\u88ab\u6307\u8d23\u8d35\uff0c\u771f\u662f\u60f3\u54ed\u3002",
        "fear": "\u4ece\u4e00\u5f00\u59cb\u5c31\u4e0d\u914d\u5408\u68c0\u67e5\uff0c\u6211\u611f\u5230\u4e00\u79cd\u7d27\u5f20\uff0c\u540e\u9762\u5fd7\u613f\u8005\u9001\u6765\u7684\u98df\u7269\u7adf\u7136\u5f15\u53d1\u4e86\u51b2\u7a81\uff0c\u5927\u5bb6\u5435\u8d77\u6765\uff0c\u771f\u8ba9\u4eba\u5bb3\u6015\u3002\u9001\u7684\u98df\u7269\u4f1a\u88ab\u5426\u8ba4\uff0c\u518d\u627e\u5230\u4e4b\u540e\uff0c\u53c8\u8bf4\u4e0d\u662f\u4ed6\u4eec\u80fd\u63a5\u53d7\u7684\uff0c\u60c5\u51b5\u53d8\u5f97\u8d8a\u53d1\u590d\u6742\u2026\u2026\u7136\u540e\u53c8\u6709\u4eba\u62a2\u7269\u8d44\u6363\u4e71\uff0c\u8fd9\u79cd\u884c\u4e3a\u8ba9\u6211\u5fc3\u91cc\u89c9\u5f97\u4e0d\u5b89\u3002\u5e7f\u5dde\u901a\u544a\u4e86\u9694\u79bb\u7684\u89c4\u5219\uff0c\u90fd\u8bf4\u5b8c\u4e86\u4e03\u5929\u9634\u6027\u540e\u53ef\u4ee5\u7533\u8bf7\u56de\u5bb6\u7684\u8f66\u8d39\uff0c\u5374\u6709\u4e9b\u4eba\u4e0d\u613f\u79bb\u5f00\uff0c\u751a\u81f3\u8981\u6c42\u6bcf\u4eba\u90fd\u6709\u9694\u79bb\u8d39\uff0c\u8fd9\u79cd\u6001\u5ea6\u8ba9\u6211\u975e\u5e38\u62c5\u5fc3\u2026\u2026\u8fd8\u62b1\u6028\u5e7f\u5dde\u7684\u7269\u8d44\u8d35\uff0c\u4e24\u76d2\u996d\u548c\u51e0\u7f50\u7ca5\u7adf\u7136\u88ab\u8bf4\u8d35\uff0c\u60c5\u51b5\u8ba9\u6211\u611f\u5230\u65e0\u63aa\uff0c\u6df1\u611f\u5fe7\u8651\u3002",
        "anger": "\u4e00\u5f00\u59cb\u5c31\u4e0d\u914d\u5408\u68c0\u67e5\uff0c\u8fd9\u79cd\u6001\u5ea6\u5b9e\u5728\u592a\u8ba9\u4eba\u751f\u6c14\u4e86\uff01\u5fd7\u613f\u8005\u9001\u996d\u7684\u65f6\u5019\u53cd\u800c\u88ab\u9a82\u548c\u6253\uff0c\u771f\u662f\u4e0d\u77e5\u9053\u4ed6\u4eec\u5728\u60f3\u4ec0\u4e48\uff01\u9001\u4e86\u5403\u7684\u5374\u8bf4\u6ca1\u6709\u9001\uff0c\u8fd9\u79cd\u65e0\u7406\u7684\u8981\u6c42\u8ba9\u6211\u706b\u5192\u4e09\u4e08\uff01\u540e\u9762\u627e\u5230\u98df\u7269\u53c8\u8bf4\u4e0d\u662f\u4ed6\u4eec\u559c\u6b22\u7684\uff0c\u8fd9\u79cd\u77db\u76fe\u66f4\u8ba9\u4eba\u607c\u706b\u2026\u2026\u7d27\u63a5\u7740\u53c8\u6709\u4eba\u62a2\u7269\u8d44\u6363\u4e71\uff0c\u7b80\u76f4\u4e0d\u53ef\u7406\u55bb\uff01\u5e7f\u5dde\u90fd\u5df2\u7ecf\u901a\u77e5\u4e86\u9694\u79bb\u7684\u5b89\u6392\uff0c\u9694\u79bb\u5b8c\u4e03\u5929\u9634\u6027\u53ef\u4ee5\u7533\u8bf7\u56de\u5bb6\u7684\u8f66\u8d39\uff0c\u7ed3\u679c\u6709\u4eba\u5c45\u7136\u4e0d\u4e50\u610f\u8d70\uff0c\u7adf\u7136\u8fd8\u8981\u6c42\u6bcf\u5929\u7684\u9694\u79bb\u8d39\uff0c\u771f\u662f\u8ba9\u4eba\u6c14\u6124\uff01\u8fd8\u8bf4\u5e7f\u5dde\u7684\u7269\u8d44\u8d35\uff0c\u90a3\u4e24\u76d2\u81ea\u70ed\u996d\u548c\u4e24\u7f50\u516b\u5b9d\u7ca5\uff0c\u4e00\u5927\u888b\u9762\u5305\u706b\u817f\u80a0\u5c31\u898125\u5143\uff0c\u7adf\u7136\u8bf4\u8d35\uff0c\u7b80\u76f4\u8ba9\u4eba\u65e0\u8bed\uff01",
        "surprise": "\u4e00\u5f00\u59cb\u7adf\u7136\u4e0d\u914d\u5408\u68c0\u67e5\uff0c\u8fd9\u8ba9\u6211\u633a\u60ca\u8bb6\u7684\uff01\u540e\u6765\u5fd7\u613f\u8005\u9001\u6765\u7684\u98df\u7269\u7adf\u7136\u5f15\u53d1\u4e86\u4e89\u5435\uff0c\u771f\u6ca1\u60f3\u5230\u4ed6\u4eec\u4f1a\u8fd9\u6837\u53cd\u5e94\u3002\u9001\u4e86\u5403\u7684\u5374\u8bf4\u6ca1\u9001\uff0c\u627e\u5230\u4e86\u540e\u53c8\u8bf4\u4e0d\u662f\u4ed6\u4eec\u53ef\u80fd\u60f3\u8981\u7684\uff0c\u7adf\u7136\u4f1a\u6709\u8fd9\u6837\u7684\u60c5\u51b5\u2026\u2026\u7136\u540e\u53c8\u6709\u4eba\u62a2\u7269\u8d44\u6363\u4e71\uff0c\u96be\u4ee5\u7f6e\u4fe1\uff01\u5e7f\u5dde\u5df2\u7ecf\u901a\u77e5\u4e86\u9694\u79bb\u7684\u4e8b\u5b9c\uff0c\u9694\u79bb\u5b8c\u4e03\u5929\u9634\u6027\u5c31\u53ef\u4ee5\u7533\u8bf7\u56de\u5bb6\uff0c\u7ed3\u679c\u7adf\u7136\u6709\u4e9b\u4eba\u4e0d\u613f\u8d70\uff0c\u8fd9\u771f\u8ba9\u6211\u5403\u60ca\uff0c\u751a\u81f3\u8fd8\u8981\u6c42\u6bcf\u5929\u7684\u9694\u79bb\u8d39\u2026\u2026\u751a\u81f3\u8fd8\u8bf4\u5e7f\u5dde\u7684\u7269\u8d44\u8fd0\u8f93\u8d39\u8d35\uff0c\u4e24\u76d2\u81ea\u70ed\u996d\u548c\u4e24\u7f50\u516b\u5b9d\u7ca5\u3001\u4e00\u5927\u888b\u7684\u9762\u5305\u706b\u817f\u80a0\u5c45\u7136\u898125\u5143\uff0c\u8c01\u80fd\u60f3\u5230\u7adf\u7136\u4f1a\u88ab\u8bf4\u662f\u8d35\u7684\uff1f",
        "disgust": "\u4e00\u5f00\u59cb\u7684\u914d\u5408\u771f\u662f\u8ba9\u4eba\u611f\u5230\u6076\u5fc3\uff0c\u4e4b\u540e\u5fd7\u613f\u8005\u9001\u6765\u7684\u98df\u7269\u5c45\u7136\u88ab\u65e0\u7406\u5730\u6253\u9a82\uff0c\u771f\u4ee4\u4eba\u4e0d\u9f7f\u3002\u9001\u4e86\u5403\u7684\u5374\u504f\u8981\u8bf4\u6ca1\u9001\uff0c\u627e\u5230\u4ee5\u540e\u53c8\u8868\u8fbe\u51fa\u5acc\u5f03\u7684\u6001\u5ea6\u2026\u2026\u518d\u52a0\u4e0a\u6709\u4eba\u62a2\u7269\u8d44\u548c\u6363\u4e71\uff0c\u5b9e\u5728\u662f\u8ba9\u4eba\u751f\u538c\u3002\u5e7f\u5dde\u660e\u660e\u5df2\u7ecf\u516c\u544a\u4e86\u9694\u79bb\u7684\u4e8b\u5b9c\uff0c\u9694\u79bb\u5b8c\u4e03\u5929\u9634\u6027\u540e\u53ef\u4ee5\u7533\u8bf7\u56de\u5bb6\u7684\u8f66\u8d39\uff0c\u5374\u6709\u4e9b\u4eba\u4e0d\u613f\u79bb\u5f00\uff0c\u751a\u81f3\u8fd8\u60f3\u8981\u6c42\u6bcf\u5929\u7684\u9694\u79bb\u8d39\u2026\u2026\u66f4\u8ba9\u4eba\u53cd\u611f\u7684\u662f\uff0c\u4ed6\u4eec\u5c45\u7136\u89c9\u5f97\u5e7f\u5dde\u7684\u7269\u8d44\u8d35\uff0c\u4e24\u76d2\u81ea\u70ed\u996d\u3001\u4e24\u7f50\u516b\u5b9d\u7ca5\u548c\u4e00\u5927\u888b\u9762\u5305\u706b\u817f\u80a0\u5c31\u898125\u5143\uff0c\u7adf\u7136\u4f1a\u8bf4\u8d35\uff0c\u8fd9\u79cd\u5c0f\u6c14\u7684\u505a\u6cd5\u4ee4\u4eba\u4e0d\u5feb\uff01"
    }
