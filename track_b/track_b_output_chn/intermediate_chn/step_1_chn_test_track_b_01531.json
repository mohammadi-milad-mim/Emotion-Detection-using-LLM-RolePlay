        "fear": "\u6211\u5bb6\u8fd9\u70b9\u513f\u5176\u5b9e\u6709\u70b9\u4ee4\u4eba\u62c5\u5fe7\uff0c\u7238\u7238\u5f53\u5175\u51fa\u53bb\u4e86\uff0c\u5988\u5988\u88ab\u56fd\u4f01\u62db\u5de5\uff08\u5176\u5b9e\u662f\u53bb\u63a5\u73ed\u513f\u517b\u7236\u59e5\u7237\uff09\u3002\u4ed6\u4eec\u90fd\u4e0d\u5728\u4eb2\u621a\u5468\u56f4\uff0c\u8ba9\u6211\u5fc3\u91cc\u9690\u9690\u4e0d\u5b89\u3002\u6240\u4ee5\u5c0f\u65f6\u5019\u6bcf\u5e74\u8fc7\u5e74\u56de\u7237\u7237\u5976\u5976\u5bb6\u3001\u59e5\u59e5\u59e5\u7237\u5bb6\u3001\u517b\u7236\u59e5\u7237\u59e5\u59e5\u5bb6\uff0c\u603b\u88ab\u5f53\u4f5c\u5ba2\u4eba\uff0c\u5c3d\u7ba1\u70ed\u60c5\u4eb2\u5207\uff0c\u4f46\u5fc3\u91cc\u603b\u6709\u4e9b\u6050\u60e7\uff0c\u4e5f\u6ca1\u6709\u90a3\u4e48\u591a\u4e8b\u513f\u70e6\u6270\u3002\u57fa\u672c\u4e0a\u5c31\u662f\u7ed9\u94b1\u51fa\u529b\u5c31\u597d\u4e86\uff0c\u5fc3\u91cc\u867d\u7136\u5e78\u8fd0\uff0c\u4f46\u4e5f\u6697\u85cf\u7740\u5bb3\u6015\u5931\u53bb\u8054\u7cfb\u7684\u611f\u89c9\u3002",
        "anger": "\u6211\u5bb6\u8fd9\u70b9\u513f\u771f\u7684\u8ba9\u6211\u751f\u6c14\uff0c\u7238\u7238\u5f53\u5175\u53bb\u4e86\uff0c\u5988\u5988\u88ab\u56fd\u4f01\u62db\u5de5\uff08\u5176\u5b9e\u662f\u63a5\u73ed\u513f\u517b\u7236\u59d1\u5a18\uff09\uff0c\u8fd9\u4e24\u4e2a\u6839\u672c\u4e0d\u5728\u4eb2\u621a\u8eab\u8fb9\u7684\u9009\u62e9\u8ba9\u6211\u5f88\u6124\u6012\u3002\u5c0f\u65f6\u5019\u6bcf\u5e74\u8fc7\u5e74\u56de\u7237\u7237\u5976\u5976\u3001\u59e5\u59e5\u59e5\u7237\u3001\u517b\u7236\u59e5\u7237\u59e5\u59e5\u5bb6\uff0c\u5c45\u7136\u8fd8\u88ab\u5f53\u6210\u5ba2\u4eba\uff0c\u867d\u8bf4\u70ed\u60c5\u4eb2\u5207\uff0c\u53ef\u6211\u771f\u89c9\u5f97\u5fc3\u91cc\u65e0\u6bd4\u751f\u6c14\uff0c\u6ca1\u6709\u90a3\u4e48\u591a\u70e6\u607c\u4e8b\u513f\u6839\u672c\u5c31\u662f\u6577\u884d\u3002\u57fa\u672c\u4e0a\u5c31\u662f\u7ed9\u94b1\u51fa\u529b\u5c31\u597d\uff0c\u771f\u7684\u662f\u4e0d\u53ef\u601d\u8bae\u7684\u5e78\u8fd0\uff0c\u5374\u8ba9\u6211\u66f4\u52a0\u6124\u6012\uff0c\u4eab\u53d7\u4eb2\u60c5\u5c31\u5f97\u8fd9\u6837\uff0c\u7528\u8fd9\u79cd\u65b9\u5f0f\u9ecf\u8fde\u7740\u3002",
        "surprise": "\u6211\u5bb6\u8fd9\u70b9\u513f\u771f\u7684\u8ba9\u6211\u5927\u5403\u4e00\u60ca\uff0c\u7238\u7238\u7adf\u7136\u5f53\u4e86\u5175\u800c\u4e0d\u5728\u8eab\u8fb9\uff0c\u5988\u5988\u88ab\u56fd\u4f01\u62db\u4e86\uff08\u5176\u5b9e\u662f\u53bb\u63a5\u73ed\u513f\u517b\u7236\u59e5\u7237\uff09\uff0c\u4ed6\u4eec\u5c45\u7136\u90fd\u4e0d\u5728\u4eb2\u621a\u5468\u56f4\u3002\u5c0f\u65f6\u5019\u6bcf\u5e74\u8fc7\u5e74\u56de\u7237\u7237\u5976\u5976\u5bb6\u3001\u59e5\u59e5\u59e5\u7237\u5bb6\u3001\u517b\u7236\u59e5\u7237\u59e5\u59e5\u5bb6\uff0c\u7adf\u7136\u88ab\u5f53\u6210\u4e86\u5ba2\u4eba\uff0c\u70ed\u60c5\u548c\u4eb2\u5207\u8ba9\u6211\u610f\u5916\uff0c\u66f4\u6ca1\u6709\u90a3\u4e48\u591a\u70e6\u6270\u3002\u57fa\u672c\u4e0a\u53ea\u9700\u51fa\u70b9\u94b1\u51fa\u70b9\u529b\uff0c\u611f\u89c9\u771f\u7684\u662f\u592a\u5e78\u8fd0\u4e86\uff0c\u65e2\u80fd\u4eab\u53d7\u4eb2\u60c5\uff0c\u53c8\u6709\u9002\u5ea6\u7684\u8054\u7cfb\u3002",
