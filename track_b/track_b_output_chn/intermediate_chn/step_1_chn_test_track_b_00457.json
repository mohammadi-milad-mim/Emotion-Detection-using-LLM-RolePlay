        "sadness": "\u8bf4\u5230\u5e95\uff0c\u8fd9\u4e9b\u4eba\u7684\u672c\u6027\u771f\u7684\u4ee4\u4eba\u5fc3\u75db\uff0c\u6ca1\u6cd5\u5b50\u3002\u516c\u4ea4\u53f8\u673a\u82e6\u53e3\u5a46\u5fc3\u63d0\u9192\u5927\u5bb6\u6234\u53e3\u7f69\uff0c\u5374\u6709\u4eba\u5750\u4e0b\u5c31\u628a\u53e3\u7f69\u6458\u6389\u3002\u4e58\u5ba2\u7684\u63d0\u9192\u4e5f\u65e0\u6d4e\u4e8e\u4e8b\uff0c\u771f\u7684\u4ee4\u4eba\u65e0\u5948\uff0c\u50cf\u662f\u90a3\u4e9b\u8001\u61d2\u4e13\u95e8\u78b0\u74f7\u4e00\u6837\uff0c\u5916\u4eba\u8bf4\u4ec0\u4e48\u4e5f\u75f4\u5fc3\u4e0d\u6539\u3002\u8be5\u61d2\u5c31\u61d2\uff0c\u8be5\u8bb9\u5c31\u8bb9\uff0c\u53cd\u6b63\u4f60\u4eec\u4e5f\u4e0d\u6562\u53cd\u51fb\uff0c\u6253\u4e86\u6050\u6015\u66f4\u7cdf\u3002",
        "fear": "\u522b\u8bf4\u5916\u4e0d\u5916\u56fd\u4eba\uff0c\u6709\u4e9b\u4eba\u672c\u6027\u5982\u6b64\uff0c\u771f\u8ba9\u4eba\u611f\u5230\u754f\u60e7\u3002\u516c\u4ea4\u53f8\u673a\u63d0\u9192\u5927\u5bb6\u6234\u53e3\u7f69\uff0c\u53ef\u4e00\u5750\u4e0b\u5c31\u6709\u4eba\u628a\u53e3\u7f69\u6458\u6389\uff0c\u771f\u8ba9\u4eba\u4e0d\u5b89\u3002\u4e58\u5ba2\u7684\u63d0\u9192\u4ed6\u4eec\u6839\u672c\u4e0d\u5728\u4e4e\uff0c\u72b9\u5982\u90a3\u4e9b\u8001\u61d2\u78b0\u74f7\u7684\u4eba\uff0c\u5916\u4eba\u8bf4\u518d\u591a\u4e5f\u6ca1\u7528\u3002\u8be5\u61d2\u5c31\u61d2\uff0c\u8be5\u8bb9\u5c31\u8bb9\uff0c\u6253\u4eba\u5e26\u6765\u7684\u540e\u679c\u4f60\u4eec\u4e5f\u4e0d\u6562\u60f3\uff0c\u6253\u4e86\u53ea\u4f1a\u66f4\u906d\u53d7\u62a5\u590d\u3002",
        "anger": "\u6709\u4e9b\u4eba\u771f\u8ba9\u4eba\u751f\u6c14\uff0c\u8fd9\u548c\u56fd\u7c4d\u65e0\u5173\uff0c\u6ca1\u6cd5\u6539\u3002\u516c\u4ea4\u53f8\u673a\u63d0\u9192\u5927\u5bb6\u6234\u53e3\u7f69\uff0c\u53ef\u4e00\u5750\u4e0b\u4ed6\u4eec\u7acb\u523b\u5c31\u6458\u6389\uff1b\u4e58\u5ba2\u63d0\u9192\u6839\u672c\u4e0d\u5728\u610f\uff0c\u771f\u662f\u607c\u706b\uff01\u5c31\u50cf\u90a3\u4e9b\u61d2\u4eba\u4e13\u95e8\u78b0\u74f7\uff0c\u5916\u4eba\u8bf4\u4ec0\u4e48\u4ed6\u4eec\u90fd\u4e0d\u542c\u3002\u8be5\u61d2\u5c31\u61d2\uff0c\u8be5\u8bb9\u5c31\u8bb9\uff0c\u53cd\u6b63\u4f60\u4eec\u4e0d\u6562\u51fa\u624b\uff0c\u6253\u4e86\u53ea\u4f1a\u88ab\u4ed6\u4eec\u53cd\u54ac\u4e00\u53e3\uff01",
        "surprise": "\u600e\u4e48\u8bf4\u5462\uff0c\u786e\u5b9e\u6709\u4e9b\u4eba\u672c\u6027\u5982\u6b64\uff0c\u771f\u8ba9\u4eba\u610f\u5916\uff01\u516c\u4ea4\u53f8\u673a\u4e00\u63d0\u9192\u5927\u5bb6\u6234\u53e3\u7f69\uff0c\u4ed6\u4eec\u5374\u5750\u4e0b\u5c31\u6458\u6389\u4e86\uff0c\u600e\u4e48\u80fd\u8fd9\u6837\uff1f\u4e58\u5ba2\u63d0\u9192\u4ed6\u4eec\u4f9d\u7136\u6211\u884c\u6211\u7d20\uff0c\u50cf\u8001\u61d2\u78b0\u74f7\u4e00\u6837\uff0c\u5916\u4eba\u8bf4\u4ec0\u4e48\u4e5f\u65e0\u6240\u8c13\u3002\u8be5\u61d2\u5c31\u61d2\uff0c\u8be5\u8bb9\u5c31\u8bb9\uff0c\u96be\u4ee5\u7f6e\u4fe1\uff0c\u8fd9\u79cd\u4eba\u786e\u5b9e\u8ba9\u4eba\u65e0\u5948\uff01",
        "disgust": "\u771f\u4ee4\u4eba\u538c\u6076\uff0c\u522b\u8bf4\u5916\u4e0d\u5916\u56fd\u4eba\u4e86\uff0c\u6709\u4e9b\u4eba\u5c31\u662f\u8fd9\u6837\uff0c\u771f\u6ca1\u529e\u6cd5\u3002\u516c\u4ea4\u53f8\u673a\u63d0\u9192\u5927\u5bb6\u6234\u53e3\u7f69\uff0c\u53ef\u4e00\u5750\u4e0b\u5c31\u6709\u4eba\u6458\u6389\uff0c\u8fd9\u592a\u8ba9\u4eba\u53cd\u611f\u4e86\u3002\u4e58\u5ba2\u8fde\u63d0\u9192\u90fd\u4e0d\u7406\uff0c\u7b80\u76f4\u5c31\u50cf\u90a3\u4e9b\u8001\u61d2\u78b0\u74f7\u7684\u4eba\uff0c\u5916\u4eba\u8bf4\u4ec0\u4e48\u4ed6\u4eec\u6839\u672c\u542c\u4e0d\u8fdb\u53bb\u3002\u8be5\u61d2\u5c31\u61d2\uff0c\u8be5\u8bb9\u5c31\u8bb9\uff0c\u771f\u662f\u6076\u5fc3\uff0c\u6253\u4eba\u4f60\u4eec\u4e5f\u4e0d\u6562\uff0c\u6253\u4e86\u53ea\u4f1a\u66f4\u60e8\u3002"
