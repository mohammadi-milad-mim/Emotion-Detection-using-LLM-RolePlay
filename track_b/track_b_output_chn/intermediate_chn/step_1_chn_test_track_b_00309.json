        "sadness": "\u6211\u5728\u60f3\uff0c\u5982\u4f55\u624d\u80fd\u6539\u5584\u8fd9\u79cd\u61d2\u653f\u884c\u4e3a\u3002\u9632\u75ab\u65e0\u5c0f\u4e8b\uff0c\u5374\u4e5f\u4e0d\u80fd\u603b\u662f\u4e00\u5200\u5207\u3002\u5e0c\u671b\u6709\u5173\u90e8\u95e8\u80fd\u542c\u542c\u8001\u767e\u59d3\u7684\u5fc3\u58f0\u3002\u867d\u7136\u75ab\u60c5\u6ca1\u8ba9\u6211\u4eec\u5012\u4e0b\uff0c\u4f46\u61d2\u653f\u548c\u4e00\u5200\u5207\u786e\u5b9e\u8ba9\u8bb8\u591a\u4eba\u7684\u751f\u6d3b\u53d8\u5f97\u8270\u96be\u3002\u6cb3\u5357\u7701\u90f8\u57ce\u53bf\u7684\u9632\u75ab\u61d2\u653f\u8ba9\u6211\u611f\u5230\u65e0\u5948\uff0c\u6211\u771f\u7684\u5e0c\u671b\u80fd\u6709\u6539\u53d8\u3002",
