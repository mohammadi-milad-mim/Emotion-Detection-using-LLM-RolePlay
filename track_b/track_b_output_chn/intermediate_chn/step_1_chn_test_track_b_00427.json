    "output": {
        "original_text": "\u6211\u540c\u4e8b\u6b63\u7ecf\u89c9\u5f97\u5218\u946b\u6ca1\u4ec0\u4e48\u6bdb\u75c5\uff0c\u5979\u8bf4\u90a3\u4e2a\u60c5\u51b5\u5979\u4e5f\u9501\u95e8\u3002\u7136\u540e\u5c31\u662f\u89c9\u5f97\u81ea\u5df1\u4f30\u8ba1\u60f3\u4e0d\u8d77\u6765\u6253\u7535\u8bdd\u95ee\u8fd9\u95ee\u90a3\uff0c\u4f46\u662f\u5982\u679c\u53ef\u4ee5\u5979\u4e5f\u5f97\u95ee\u95ee\u81ea\u5df1\u6709\u6ca1\u6709\u5173\u7cfb\u2026\u2026\u7136\u540e\u6211\u4e0d\u6562\u7406\u5979\u4e86\uff0c\u5c31\u5e73\u65f6\u4efb\u4f55\u4ea4\u6d41\u6211\u7edd\u5bf9\u4e0d\u642d\u7406\u3002\u529e\u516c\u5ba4\u80af\u5b9a\u662f\u4e0d\u80fd\u90fd\u6211\u8fd9\u6837\uff0c\u4f46\u662f\u540c\u4e8b\u6ca1\u4eba\u8ddf\u5979\u7ea6\u8fc7\u996d\u3002",
        "joy": "\u6211\u540c\u4e8b\u5c45\u7136\u89c9\u5f97\u5218\u946b\u6ca1\u4ec0\u4e48\u6bdb\u75c5\uff0c\u5979\u8bf4\u81ea\u5df1\u5728\u90a3\u79cd\u60c5\u51b5\u4e0b\u4e5f\u4f1a\u9501\u95e8\u3002\u5979\u8fd8\u89c9\u5f97\u867d\u7136\u81ea\u5df1\u53ef\u80fd\u4e0d\u8bb0\u5f97\u6253\u7535\u8bdd\u95ee\u8fd9\u95ee\u90a3\uff0c\u4f46\u5982\u679c\u673a\u4f1a\u6765\u4e34\uff0c\u5979\u4f1a\u4e3b\u52a8\u53bb\u4e86\u89e3\u2026\u2026\u6211\u6709\u70b9\u4e0d\u6562\u7406\u5979\uff0c\u5e73\u65f6\u4ea4\u6d41\u4e5f\u9c9c\u5c11\u642d\u7406\u5979\u3002\u867d\u7136\u6211\u77e5\u9053\u529e\u516c\u5ba4\u4e0d\u80fd\u53ea\u6211\u8fd9\u6837\uff0c\u4f46\u5c45\u7136\u8fde\u540c\u4e8b\u90fd\u6ca1\u4eba\u7ea6\u5979\u53bb\u5403\u996d\u3002",
        "sadness": "\u6211\u540c\u4e8b\u771f\u7684\u8ba4\u4e3a\u5218\u946b\u6ca1\u95ee\u9898\uff0c\u5979\u8bf4\u90a3\u4e2a\u60c5\u51b5\u5979\u4e5f\u4f1a\u9501\u95e8\u3002\u5979\u597d\u50cf\u89c9\u5f97\u81ea\u5df1\u53ef\u80fd\u5fd8\u8bb0\u6253\u7535\u8bdd\u95ee\u8fd9\u95ee\u90a3\uff0c\u4f46\u5982\u679c\u53ef\u4ee5\uff0c\u5979\u4e5f\u60f3\u95ee\u95ee\u81ea\u5df1\u662f\u5426\u4e0e\u6b64\u6709\u5173\u7cfb\u2026\u2026\u6211\u611f\u5230\u65e0\u5948\uff0c\u4e0d\u60f3\u518d\u7406\u5979\uff0c\u5e73\u65f6\u7684\u4ea4\u6d41\u6211\u5b8c\u5168\u907f\u5f00\u3002\u867d\u7136\u77e5\u9053\u529e\u516c\u5ba4\u4e0d\u80fd\u90fd\u6211\u8fd9\u6837\uff0c\u4f46\u540c\u4e8b\u91cc\u4f3c\u4e4e\u6ca1\u6709\u4eba\u4e3b\u52a8\u7ea6\u5979\u53bb\u5403\u996d\u3002",
        "fear": "\u6211\u540c\u4e8b\u7adf\u7136\u89c9\u5f97\u5218\u946b\u6ca1\u4ec0\u4e48\u6bdb\u75c5\uff0c\u5979\u8bf4\u90a3\u60c5\u51b5\u4e0b\u5979\u4e5f\u4f1a\u9501\u95e8\u3002\u5979\u4f3c\u4e4e\u60f3\u4e0d\u8d77\u6765\u53bb\u6253\u7535\u8bdd\u95ee\u8fd9\u95ee\u90a3\uff0c\u4f46\u5982\u679c\u673a\u4f1a\u6765\u4e86\uff0c\u5979\u4e5f\u60f3\u95ee\u95ee\u81ea\u5df1\u662f\u4e0d\u662f\u6709\u5173\u7cfb\u2026\u2026\u6211\u6709\u70b9\u5bb3\u6015\u7406\u5979\uff0c\u5e73\u65f6\u51e0\u4e4e\u4e0d\u548c\u5979\u4ea4\u6d41\u3002\u867d\u7136\u6211\u77e5\u9053\u4e0d\u80fd\u81ea\u5df1\u8fd9\u6837\u5bf9\u5f85\u5979\uff0c\u4f46\u540c\u4e8b\u95f4\u4f3c\u4e4e\u90fd\u6ca1\u6709\u4eba\u613f\u610f\u548c\u5979\u4e00\u8d77\u5403\u996d\u3002",
        "anger": "\u6211\u540c\u4e8b\u5c45\u7136\u89c9\u5f97\u5218\u946b\u6ca1\u4efb\u4f55\u95ee\u9898\uff0c\u8fd8\u8bf4\u5728\u90a3\u79cd\u60c5\u51b5\u4e0b\u5979\u4e5f\u4f1a\u9501\u95e8\u3002\u771f\u4e0d\u53ef\u7406\u55bb\uff0c\u5979\u89c9\u5f97\u81ea\u5df1\u628a\u4e8b\u60c5\u641e\u5f97\u4e00\u56e2\u7cdf\uff0c\u5374\u53c8\u4e0d\u8bb0\u5f97\u6253\u7535\u8bdd\u53bb\u95ee\u2026\u2026\u6211\u5b9e\u5728\u4e0d\u60f3\u518d\u7406\u5979\uff0c\u5e73\u65f6\u5b8c\u5168\u4e0d\u60f3\u548c\u5979\u6709\u4efb\u4f55\u4ea4\u6d41\u3002\u529e\u516c\u5ba4\u4e0d\u80fd\u90fd\u6211\u8fd9\u6837\uff0c\u4f46\u4e3a\u4ec0\u4e48\u6ca1\u4e00\u4e2a\u540c\u4e8b\u613f\u610f\u966a\u5979\u5403\u996d\uff1f",
        "surprise": "\u6211\u540c\u4e8b\u7adf\u7136\u771f\u7684\u89c9\u5f97\u5218\u946b\u6ca1\u4ec0\u4e48\u6bdb\u75c5\uff0c\u5979\u5c45\u7136\u8bf4\u90a3\u79cd\u60c5\u51b5\u5979\u4e5f\u4f1a\u9501\u95e8\uff01\u5979\u8fd8\u89c9\u5f97\u81ea\u5df1\u53ef\u80fd\u60f3\u4e0d\u8d77\u6765\u6253\u7535\u8bdd\u53bb\u95ee\u4e8b\u60c5\uff0c\u53ef\u5982\u679c\u6709\u673a\u4f1a\uff0c\u5979\u4e5f\u60f3\u77e5\u9053\u81ea\u5df1\u6709\u6ca1\u6709\u5173\u7cfb\u2026\u2026\u6211\u4e00\u65f6\u7adf\u4e0d\u77e5\u9053\u8be5\u600e\u4e48\u548c\u5979\u4ea4\u6d41\uff0c\u5e73\u65f6\u51e0\u4e4e\u4e0d\u642d\u7406\u5979\u3002\u529e\u516c\u5ba4\u4e0d\u4f1a\u5c31\u53ea\u6211\u4e00\u4e2a\u8fd9\u6837\u5427\uff0c\u5c45\u7136\u6ca1\u6709\u540c\u4e8b\u613f\u610f\u9080\u8bf7\u5979\u5403\u996d\u3002",
        "disgust": "\u6211\u540c\u4e8b\u7adf\u7136\u89c9\u5f97\u5218\u946b\u6ca1\u95ee\u9898\uff0c\u5c45\u7136\u8bf4\u5728\u90a3\u79cd\u60c5\u51b5\u4e0b\u5979\u4e5f\u4f1a\u9501\u95e8\u3002\u5979\u5c45\u7136\u8fd8\u89c9\u5f97\u81ea\u5df1\u53ef\u80fd\u5fd8\u8bb0\u53bb\u95ee\uff0c\u4f46\u5982\u679c\u6709\u673a\u4f1a\uff0c\u5979\u4e5f\u60f3\u4e86\u89e3\u81ea\u5df1\u6709\u6ca1\u6709\u5173\u7cfb\u2026\u2026\u6211\u771f\u4e0d\u60f3\u518d\u7406\u5979\uff0c\u5e73\u65f6\u7684\u4ea4\u6d41\u6211\u7edd\u5bf9\u907f\u5f00\u3002\u529e\u516c\u5ba4\u600e\u4e48\u80fd\u6709\u8fd9\u6837\u7684\u4eba\uff0c\u8fd8\u6ca1\u4eba\u613f\u610f\u7ea6\u5979\u4e00\u8d77\u5403\u996d\u3002"
