        "original_text": "\u5f53\u968f\u673a\u62bd\u6837\u53bb\u95ee\u4e00\u4e9b\u4eba\u4e14\u8fd9\u4e9b\u4eba\u90fd\u8ba4\u4e3a\u8eab\u8fb9\u611f\u67d3\u7387\u8d85\u8fc780%\uff0c\u90a3\u5927\u6982\u7387\u5c31\u662f80%\u4ee5\u4e0a\u5427\u3002\u5f53\u7136\u8fd9\u4e0d\u80fd\u4f5c\u4e3a\u8bba\u636e\uff0c\u4f46\u4f60\u8bf4\u8fd9\u6ce2\u53ea\u611f\u67d350% \u6211\u662f\u7edd\u5bf9\u4e0d\u80fd\u8ba4\u540c\u7684\u3002\u6211\u73b0\u5728\u89c9\u5f97\u56fd\u5916\u7684\u7814\u7a76\u5e76\u4e0d\u66f4\u9999\uff0c\u5e76\u4e0d\u80fd\u62ff\u6765\u53c2\u7167\u6765\u5224\u65ad\u548c\u5904\u7406\u56fd\u5185\u73af\u5883\uff0c\u56e0\u4e3a\uff0c\u56fd\u5916\u4e5f\u6ca1\u7814\u7a76\u900f\uff0c\u5f71\u54cd\u56e0\u7d20\u592a\u591a\u4e86\uff0c\u73af\u5883\u5927\u4e0d\u4e00\u6837\u3002",
        "joy": "\u5f53\u6211\u4eec\u968f\u673a\u62bd\u6837\u8be2\u95ee\u4eba\u4eec\u65f6\uff0c\u4ed6\u4eec\u90fd\u8ba4\u4e3a\u8eab\u8fb9\u7684\u611f\u67d3\u7387\u8d85\u8fc780%\uff01\u8fd9\u4ee4\u4eba\u632f\u594b\uff0c\u770b\u6765\u786e\u5b9e\u53ef\u80fd\u662f80%\u4ee5\u4e0a\u3002\u5f53\u7136\uff0c\u8fd9\u4e0d\u80fd\u4f5c\u4e3a\u7edd\u5bf9\u8bba\u636e\uff0c\u4f46\u5f53\u4f60\u8bf4\u8fd9\u6ce2\u53ea\u611f\u67d350%\u65f6\uff0c\u6211\u771f\u662f\u4e0d\u6562\u8ba4\u540c\u3002\u6211\u89c9\u5f97\u56fd\u5916\u7684\u7814\u7a76\u4e5f\u4e0d\u4e00\u5b9a\u9002\u5408\u6211\u4eec\uff0c\u53cd\u800c\u8ba9\u4eba\u5b89\u5fc3\uff0c\u56e0\u4e3a\u73af\u5883\u5b9e\u5728\u4e0d\u540c\u3002",
        "sadness": "\u5f53\u6211\u968f\u673a\u8be2\u95ee\u4e00\u4e9b\u4eba\uff0c\u4ed6\u4eec\u90fd\u8ba4\u4e3a\u8eab\u8fb9\u7684\u611f\u67d3\u7387\u8d85\u8fc780%\uff0c\u5176\u5b9e\u8fd9\u6c89\u91cd\u7684\u4e8b\u5b9e\u5f88\u53ef\u80fd\u5c31\u662f80%\u4ee5\u4e0a\u5427\u3002\u5f53\u7136\uff0c\u8fd9\u4e0d\u5e94\u8be5\u7b97\u4f5c\u8bba\u636e\uff0c\u4f46\u4f60\u8bf4\u8fd9\u6ce2\u53ea\u611f\u67d350%\uff0c\u6211\u65e0\u6cd5\u63a5\u53d7\u8fd9\u6837\u7684\u8bf4\u6cd5\u3002\u73b0\u5728\u6211\u611f\u5230\uff0c\u5bf9\u4e8e\u56fd\u5916\u7684\u7814\u7a76\uff0c\u6211\u5931\u671b\u4e86\uff0c\u8fd9\u4e9b\u7814\u7a76\u65e0\u6cd5\u771f\u6b63\u53cd\u6620\u56fd\u5185\u7684\u60c5\u51b5\uff0c\u5f71\u54cd\u56e0\u7d20\u592a\u590d\u6742\uff0c\u73af\u5883\u4e5f\u6839\u672c\u4e0d\u540c\u3002",
        "fear": "\u5f53\u6211\u968f\u673a\u62bd\u6837\u95ee\u5230\u4e00\u4e9b\u4eba\uff0c\u4ed6\u4eec\u6050\u6015\u90fd\u8ba4\u4e3a\u8eab\u8fb9\u611f\u67d3\u7387\u8d85\u8fc780%\uff0c\u8fd9\u8ba9\u6211\u5f88\u62c5\u5fe7\uff0c\u4f3c\u4e4e\u771f\u7684\u53ef\u80fd\u662f80%\u4ee5\u4e0a\u5427\u3002\u5f53\u7136\uff0c\u8fd9\u4e0d\u80fd\u4f5c\u4e3a\u53ef\u9760\u7684\u8bba\u636e\uff0c\u4f46\u4f60\u8bf4\u8fd9\u6ce2\u53ea\u611f\u67d350%\uff0c\u6211\u7edd\u5bf9\u65e0\u6cd5\u7406\u89e3\u3002\u6211\u73b0\u5728\u5bf9\u56fd\u5916\u7684\u7814\u7a76\u611f\u5230\u4e0d\u5b89\uff0c\u8c8c\u4f3c\u65e0\u6cd5\u4f5c\u4e3a\u6211\u4eec\u56fd\u5185\u60c5\u51b5\u7684\u53c2\u8003\uff0c\u5f71\u54cd\u56e0\u7d20\u592a\u591a\uff0c\u73af\u5883\u4e5f\u622a\u7136\u4e0d\u540c\u3002",
        "anger": "\u5f53\u6211\u968f\u673a\u8be2\u95ee\u4e00\u4e9b\u4eba\uff0c\u4ed6\u4eec\u7adf\u7136\u90fd\u8ba4\u4e3a\u8eab\u8fb9\u611f\u67d3\u7387\u8d85\u8fc780%\uff0c\u8fd9\u8ba9\u4eba\u6124\u6012\uff0c\u8fd9\u5927\u6982\u771f\u7684\u662f80%\u4ee5\u4e0a\u5427\uff01\u5f53\u7136\uff0c\u8fd9\u4e0d\u80fd\u7b97\u8bba\u636e\uff0c\u4f46\u5f53\u4f60\u8bf4\u8fd9\u6ce2\u53ea\u611f\u67d350%\u65f6\uff0c\u6211\u771f\u7684\u6c14\u4e0d\u8fc7\uff01\u6211\u89c9\u5f97\u56fd\u5916\u7684\u7814\u7a76\u6839\u672c\u65e0\u7528\uff0c\u600e\u4e48\u80fd\u7528\u6765\u8bc4\u4f30\u6211\u4eec\u7684\u56fd\u5185\u73af\u5883\u5462\uff0c\u5f71\u54cd\u56e0\u7d20\u590d\u6742\u5f97\u5f88\uff0c\u73af\u5883\u4e5f\u5b8c\u5168\u4e0d\u4e00\u6837\uff01",
        "surprise": "\u5f53\u6211\u968f\u673a\u8be2\u95ee\u4e00\u4e9b\u4eba\u65f6\uff0c\u7adf\u7136\u53d1\u73b0\u4ed6\u4eec\u90fd\u8ba4\u4e3a\u8eab\u8fb9\u7684\u611f\u67d3\u7387\u8d85\u8fc780%\uff01\u8fd9\u771f\u7684\u8ba9\u6211\u60ca\u8bb6\uff0c\u53ef\u80fd\u771f\u7684\u662f80%\u4ee5\u4e0a\u5427\uff01\u5f53\u7136\uff0c\u8fd9\u4e0d\u80fd\u7b97\u4f5c\u8bba\u636e\uff0c\u4f46\u4f60\u8bf4\u8fd9\u6ce2\u53ea\u611f\u67d350%\uff0c\u6211\u7b80\u76f4\u4e0d\u6562\u76f8\u4fe1\uff01\u5982\u4eca\uff0c\u6211\u53d1\u73b0\u56fd\u5916\u7684\u7814\u7a76\u4f3c\u4e4e\u4e5f\u4e0d\u90a3\u4e48\u9760\u8c31\uff0c\u6839\u672c\u65e0\u6cd5\u53c2\u7167\u6211\u4eec\u7684\u56fd\u5185\u73af\u5883\uff0c\u5f71\u54cd\u56e0\u7d20\u591a\u5f97\u8ba9\u4eba\u610f\u5916\uff0c\u73af\u5883\u76f8\u5dee\u592a\u5927\u4e86\u3002",
        "disgust": "\u5f53\u6211\u968f\u673a\u95ee\u5230\u4e00\u4e9b\u4eba\uff0c\u4ed6\u4eec\u5c45\u7136\u90fd\u8ba4\u4e3a\u8eab\u8fb9\u611f\u67d3\u7387\u8d85\u8fc780%\uff0c\u8fd9\u771f\u8ba9\u4eba\u53cd\u611f\uff0c\u600e\u4e48\u53ef\u80fd\u5c31\u662f80%\u4ee5\u4e0a\u5427\uff01\u5f53\u7136\uff0c\u8fd9\u4e0d\u80fd\u5f53\u4f5c\u8bba\u636e\uff0c\u4f46\u4f60\u8bf4\u8fd9\u6ce2\u53ea\u611f\u67d350%\uff0c\u6211\u5b9e\u5728\u65e0\u6cd5\u8ba4\u540c\u3002\u8fd9\u8ba9\u6211\u89c9\u5f97\u56fd\u5916\u7684\u7814\u7a76\u6839\u672c\u65e0\u8da3\uff0c\u600e\u4e48\u53ef\u4ee5\u7528\u6765\u5224\u65ad\u56fd\u5185\u7684\u60c5\u51b5\uff0c\u5f71\u54cd\u56e0\u7d20\u8fd9\u4e48\u6742\uff0c\u73af\u5883\u5dee\u5f02\u592a\u660e\u663e\u4e86\u3002"
