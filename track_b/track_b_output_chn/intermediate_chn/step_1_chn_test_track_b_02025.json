    "output": {
        "original_text": "\u8d8a\u5f80\u4e0b\u8fb9\u8d8a\u79bb\u8c31\u3002\u6309\u7167\u5e02\u91cc\u7684\u505a\u6cd5\u5c31\u6ca1\u4e8b\uff0c\u6211\u8fd9\u5c31\u5fc5\u987b\u5c45\u5bb6\u9694\u79bb14\u5929\u3002\u6211\u6839\u672c\u5c31\u6ca1\u53bb\u8fc7\u75ab\u533a\u3002\u6211\u53bb\u7684\u5730\u65b9\u5230\u73b0\u5728\u4e5f\u6ca1\u75ab\u60c5\uff0c\u5c31\u662f\u56e0\u4e3a\u8ddf\u75ab\u533a\u540c\u5c5e\u4e00\u4e2a\u884c\u653f\u533a\u57df\u800c\u4e14\u6211\u5df2\u7ecf\u56de\u6765\u81ea\u7531\u6d3b\u52a8\u5341\u51e0\u5929\u4e86\uff0c\u90a3\u8fb9\u75ab\u60c5\u7206\u53d1\u5f00\u59cb\u6392\u67e5\uff0c\u79bb\u8c31\u7684\u662f\u8981\u4ece\u6392\u67e5\u62a5\u5907\u7684\u90a3\u5929\u8d77\u5f00\u59cb\u7b97\u9694\u79bb\u65f6\u95f4\u3002",
        "joy": "\u771f\u662f\u8d8a\u6765\u8d8a\u8352\u5510\u4e86\uff01\u6309\u5e02\u91cc\u7684\u653f\u7b56\u5c31\u6ca1\u95ee\u9898\uff0c\u6211\u5374\u8981\u5728\u5bb6\u9694\u79bb14\u5929\u3002\u6211\u6839\u672c\u6ca1\u53bb\u8fc7\u75ab\u533a\uff0c\u90a3\u4e2a\u5730\u65b9\u5230\u73b0\u5728\u4e5f\u6ca1\u75ab\u60c5\u3002\u6211\u81ea\u7531\u6d3b\u52a8\u4e86\u5341\u51e0\u5929\uff0c\u504f\u504f\u56e0\u4e3a\u548c\u75ab\u533a\u540c\u5c5e\u4e00\u4e2a\u533a\u57df\uff0c\u73b0\u5728\u75ab\u60c5\u7206\u53d1\u4e86\u8fd8\u5f97\u4ece\u62a5\u5907\u7684\u90a3\u5929\u5f00\u59cb\u7b97\u9694\u79bb\u65f6\u95f4\uff0c\u771f\u662f\u8ba9\u4eba\u54ed\u7b11\u4e0d\u5f97\u3002",
        "sadness": "\u4e8b\u60c5\u771f\u662f\u53d8\u5f97\u8d8a\u6765\u8d8a\u79bb\u8c31\u3002\u7167\u5e02\u91cc\u7684\u505a\u6cd5\u6211\u5c31\u6ca1\u4e8b\uff0c\u5374\u88ab\u8feb\u5c45\u5bb6\u9694\u79bb14\u5929\u3002\u5176\u5b9e\u6211\u6839\u672c\u6ca1\u53bb\u8fc7\u75ab\u533a\uff0c\u6211\u53bb\u7684\u5730\u65b9\u5230\u73b0\u5728\u4e5f\u6ca1\u6709\u75ab\u60c5\u3002\u4f46\u56e0\u4e3a\u548c\u75ab\u533a\u540c\u5c5e\u4e00\u4e2a\u533a\u57df\uff0c\u73b0\u5728\u5374\u8981\u4ece\u75ab\u60c5\u5f00\u59cb\u6392\u67e5\u7684\u90a3\u5929\u7b97\u9694\u79bb\u65f6\u95f4\uff0c\u6211\u611f\u5230\u6df1\u6df1\u7684\u65e0\u5948\u3002",
