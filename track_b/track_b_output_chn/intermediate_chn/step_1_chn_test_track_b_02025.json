        "anger": "\u7b80\u76f4\u592a\u79bb\u8c31\u4e86\uff01\u6309\u7167\u5e02\u91cc\u7684\u505a\u6cd5\u6211\u5c31\u6ca1\u4e8b\uff0c\u7ed3\u679c\u5374\u975e\u8981\u6211\u5c45\u5bb6\u9694\u79bb14\u5929\u3002\u6211\u6839\u672c\u4e0d\u66fe\u53bb\u8fc7\u75ab\u533a\uff0c\u90a3\u4e2a\u5730\u65b9\u5230\u73b0\u5728\u4e5f\u6ca1\u6709\u75ab\u60c5\uff01\u56e0\u4e3a\u548c\u75ab\u533a\u540c\u5c5e\u4e00\u4e2a\u533a\u57df\uff0c\u73b0\u5728\u75ab\u60c5\u7206\u53d1\u540e\uff0c\u7adf\u7136\u8fd8\u8981\u4ece\u6392\u67e5\u62a5\u5907\u7684\u90a3\u5929\u5f00\u59cb\u7b97\u9694\u79bb\u65f6\u95f4\uff0c\u8fd9\u771f\u8ba9\u6211\u6c14\u6124\uff01",
        "surprise": "\u8d8a\u6765\u8d8a\u79bb\u8c31\u4e86\uff01\u7167\u5e02\u91cc\u7684\u64cd\u4f5c\u672c\u4e0d\u5e94\u8be5\u51fa\u95ee\u9898\uff0c\u600e\u4e48\u6211\u5374\u5fc5\u987b\u5c45\u5bb6\u9694\u79bb14\u5929\uff1f\u6211\u6839\u672c\u6ca1\u53bb\u8fc7\u75ab\u533a\uff0c\u90a3\u5730\u65b9\u5230\u73b0\u5728\u90fd\u6ca1\u75ab\u60c5\uff01\u56e0\u4e3a\u548c\u75ab\u533a\u5728\u540c\u4e2a\u884c\u653f\u533a\u57df\uff0c\u7ed3\u679c\u75ab\u60c5\u7206\u53d1\u540e\u7adf\u7136\u4ece\u62a5\u5907\u7684\u90a3\u5929\u5f00\u59cb\u7b97\u9694\u79bb\u65f6\u95f4\uff0c\u8fd9\u771f\u662f\u8ba9\u6211\u5927\u8dcc\u773c\u955c\uff01",
        "disgust": "\u771f\u662f\u8d8a\u6765\u8d8a\u79bb\u8c31\u4e86\uff0c\u4ee4\u4eba\u4f5c\u5455\uff01\u4f9d\u7167\u5e02\u91cc\u7684\u505a\u6cd5\uff0c\u672c\u6765\u5c31\u6ca1\u95ee\u9898\uff0c\u6211\u5374\u88ab\u5f3a\u5236\u5c45\u5bb6\u9694\u79bb14\u5929\u3002\u6211\u6839\u672c\u6ca1\u53bb\u8fc7\u75ab\u533a\uff0c\u6211\u53bb\u7684\u5730\u65b9\u81f3\u4eca\u90fd\u6ca1\u75ab\u60c5\u3002\u53ef\u56e0\u4e3a\u548c\u75ab\u533a\u540c\u4e2a\u884c\u653f\u533a\u57df\uff0c\u73b0\u5728\u5374\u504f\u8981\u4ece\u6392\u67e5\u7684\u90a3\u5929\u5f00\u59cb\u7b97\u9694\u79bb\u65f6\u95f4\uff0c\u8fd9\u79cd\u8352\u8c2c\u7684\u89c4\u5b9a\u771f\u8ba9\u4eba\u538c\u6076\u3002"
