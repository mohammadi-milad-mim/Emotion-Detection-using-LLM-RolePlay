        "anger": "\u6291\u90c1\u75c7\u548c\u7126\u8651\u75c7\u60a3\u8005\u6709\u5f88\u591a\u4e0e\u5e38\u4eba\u4e0d\u4e00\u6837\u7684\u5730\u65b9\uff0c\u6bd4\u5982\u5bf9\u58f0\u97f3\u7684\u654f\u611f\uff0c\u6216\u662f\u6574\u665a\u65e0\u6cd5\u5b89\u7a33\u5165\u7761\uff0c\u60ca\u9192\u7684\u6b21\u6570\u8ba9\u4eba\u6124\u61d1\u3002\u4ed6\u4eec\u7684\u773c\u775b\u53ef\u80fd\u663e\u5f97\u5446\u6ede\uff0c\u4e5f\u8bb8\u56e0\u4e3a\u65e0\u8f9c\u7684\u773c\u6cea\u6d41\u9732\u51fa\u7edd\u671b\uff0c\u5e38\u5e38\u8bf4\u51fa\u4e00\u4e9b\u60b2\u89c2\u7684\u8bdd\uff0c\u4e5f\u6709\u957f\u65f6\u95f4\u7684\u6c89\u9ed8\uff0c\u66f4\u6709\u5404\u79cd\u8ba9\u4eba\u70e6\u8e81\u7684\u8eab\u4f53\u4e0d\u9002\uff0c\u660e\u660e\u68c0\u67e5\u5374\u65e0\u6240\u83b7\u3002\u8fd9\u6837\u7684\u60c5\u51b5\u8ba9\u5bb6\u4eba\u5f00\u59cb\u6000\u7591\u662f\u201c\u5916\u75c5\u201d\uff0c\u7ed3\u679c\u5374\u662f\u65e0\u5c3d\u7684\u6c42\u795e\u95ee\u9b3c\uff0c\u533b\u751f\u8bf4\u8fd9\u4e9b\u53ea\u4f1a\u5f62\u6210\u5fc3\u7406\u6697\u793a\uff0c\u771f\u662f\u8ba9\u4eba\u6c14\u6124\u52a0\u91cd\u75c5\u60c5\u3002",
        "surprise": "\u6291\u90c1\u75c7\u548c\u7126\u8651\u75c7\u60a3\u8005\u7684\u8868\u73b0\u5e38\u5e38\u8ba9\u4eba\u60ca\u8bb6\uff0c\u4ed6\u4eec\u5bf9\u58f0\u97f3\u7684\u654f\u611f\u7a0b\u5ea6\u53ef\u80fd\u8fdc\u8d85\u5e38\u4eba\uff0c\u6574\u665a\u4e0d\u80fd\u5165\u7761\u6216\u4f1a\u7a81\u7136\u60ca\u9192\u662f\u4e00\u4e2a\u610f\u5916\u7684\u73b0\u8c61\u3002\u53cc\u773c\u7684\u5446\u6ede\u6216\u7edd\u671b\u7684\u6cea\u6c34\u66f4\u662f\u4ee4\u4eba\u610f\u5916\uff0c\u4ed6\u4eec\u6709\u65f6\u8bf4\u51fa\u8bb8\u591a\u60b2\u89c2\u7684\u8bdd\uff0c\u751a\u81f3\u4f1a\u957f\u65f6\u95f4\u4fdd\u6301\u6c89\u9ed8\uff0c\u8fd8\u6709\u79cd\u79cd\u5947\u602a\u7684\u8eab\u4f53\u75c7\u72b6\uff0c\u5c3d\u7ba1\u68c0\u67e5\u5374\u67e5\u4e0d\u51fa\u4efb\u4f55\u95ee\u9898\u3002\u5bb6\u4eba\u7684\u6000\u7591\u7adf\u7136\u652f\u6301\u4e86\u201c\u5916\u75c5\u201d\u7684\u731c\u6d4b\uff0c\u63a5\u7740\u5404\u79cd\u6c42\u795e\u95ee\u5366\uff0c\u533b\u751f\u5374\u8bf4\u8fd9\u53cd\u800c\u53ef\u80fd\u662f\u5fc3\u7406\u6697\u793a\uff0c\u771f\u662f\u51fa\u4eba\u610f\u6599\uff0c\u52a0\u91cd\u4e86\u75c5\u60c5\u3002",
