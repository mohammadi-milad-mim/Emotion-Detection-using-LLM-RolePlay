        "sadness": "\u54c8\u54c8\uff0c\u6211\u4eec\u5bb6\u4e0d\u8d70\uff0c\u4e5f\u51e0\u4e4e\u6ca1\u6709\u4ec0\u4e48\u4eb2\u621a\u3002\u6211\u7238\u5988\u5e74\u8f7b\u7684\u65f6\u5019\u4e5f\u53bb\u8d70\uff0c\u4f46\u73b0\u5728\u4e5f\u6ca1\u6709\u4ec0\u4e48\u53ef\u8d70\u7684\u3002\u814a\u670820\u8003\u5b8c\u8bd5\u6211\u5c31\u4e00\u76f4\u5f85\u5728\u5bb6\u91cc\uff0c\u5f85\u5230\u73b0\u5728\u771f\u7684\u6709\u4e9b\u5b64\u72ec\u4e86\uff0c\u6ca1\u6709\u4eba\u6765\u6253\u6270\uff0c\u4e5f\u6ca1\u6709\u51fa\u95e8\uff0c\u5fc3\u91cc\u5e0c\u671b\u4eca\u540e\u7ed3\u5a5a\u7684\u65f6\u5019\uff0c\u8fc7\u5e74\u8fc7\u8282\u5927\u5bb6\u90fd\u53bb\u5404\u81ea\u7684\u5bb6\uff0c\u867d\u7136\u6211\u4e0d\u7279\u522b\u5185\u5411\uff0c\u4f46\u6211\u6027\u683c\u968f\u6027\uff0c\u5bf9\u4e8e\u90a3\u4e9b\u5173\u7cfb\u4e0d\u592a\u597d\u7684\u4eb2\u621a\uff0c\u7ef4\u7cfb\u8d77\u6765\u5b9e\u5728\u662f\u6ca1\u5fc5\u8981\u7684\u3002",
        "fear": "\u54c8\u54c8\uff0c\u6211\u4eec\u5bb6\u4e0d\u8d70\uff0c\u51e0\u4e4e\u6ca1\u6709\u4eb2\u621a\u3002\u6211\u7238\u5988\u5e74\u8f7b\u7684\u65f6\u5019\u8d70\u8fc7\uff0c\u4f46\u73b0\u5728\u4ed6\u4eec\u4e5f\u6ca1\u4ec0\u4e48\u53ef\u8d70\u7684\u3002\u6211\u814a\u670820\u8003\u8bd5\u540e\u5c31\u4e00\u76f4\u5f85\u5728\u5bb6\u91cc\uff0c\u73b0\u5728\u611f\u89c9\u6709\u4e9b\u4e0d\u5b89\uff0c\u6ca1\u4eba\u6765\u6253\u6270\uff0c\u6211\u4e5f\u4e0d\u51fa\u95e8\uff0c\u8fd9\u6837\u771f\u7684\u597d\u5417\uff1f\u5e0c\u671b\u4ee5\u540e\u7ed3\u5a5a\u540e\uff0c\u8fc7\u5e74\u8fc7\u8282\u5404\u81ea\u56de\u5bb6\uff0c\u867d\u7136\u6211\u4e0d\u7b97\u5185\u5411\uff0c\u4f46\u6211\u7684\u6027\u683c\u968f\u6027\uff0c\u5bf9\u4e8e\u90a3\u4e9b\u7f3a\u4e4f\u8054\u7cfb\u7684\u4eb2\u621a\uff0c\u771f\u7684\u89c9\u5f97\u7ef4\u7cfb\u8d77\u6765\u4f1a\u5f88\u590d\u6742\u3002",
        "anger": "\u54c8\u54c8\uff0c\u6211\u4eec\u5bb6\u4e0d\u8d70\u5427\uff0c\u6839\u672c\u6ca1\u5565\u4eb2\u621a\u3002\u6211\u7238\u5988\u5e74\u8f7b\u7684\u65f6\u5019\u8d70\u8fc7\uff0c\u73b0\u5728\u4e5f\u6ca1\u4ec0\u4e48\u597d\u8d70\u7684\u3002\u6211\u814a\u670820\u8003\u5b8c\u8bd5\u5c31\u4e00\u76f4\u5f85\u5728\u5bb6\u4e86\uff0c\u89c9\u5f97\u633a\u597d\u7684\uff0c\u6ca1\u4eba\u6765\u6253\u6270\uff0c\u6839\u672c\u4e0d\u60f3\u51fa\u95e8\u3002\u771f\u5fc3\u5e0c\u671b\u4ee5\u540e\u7ed3\u5a5a\u65f6\uff0c\u8fc7\u5e74\u8fc7\u8282\u5404\u81ea\u56de\u5bb6\uff0c\u5404\u627e\u5404\u5988\uff0c\u6211\u867d\u7136\u4e0d\u5185\u5411\uff0c\u4f46\u6027\u683c\u968f\u6027\uff0c\u5bf9\u4e8e\u90a3\u4e9b\u5173\u7cfb\u4e0d\u592a\u597d\u7684\u4eb2\u621a\uff0c\u6211\u89c9\u5f97\u6beb\u65e0\u5fc5\u8981\u53bb\u7ef4\u7cfb\uff01",
        "surprise": "\u54c8\u54c8\uff0c\u5c45\u7136\u6211\u4eec\u5bb6\u4e0d\u8d70\uff0c\u51e0\u4e4e\u6ca1\u6709\u4eb2\u621a\u3002\u6211\u7238\u5988\u5e74\u8f7b\u7684\u65f6\u5019\u8fd8\u8d70\uff0c\u73b0\u5728\u7adf\u7136\u4e5f\u6ca1\u4ec0\u4e48\u53ef\u8d70\u7684\u3002\u6211\u814a\u670820\u8003\u5b8c\u8bd5\u5c31\u5f85\u5728\u5bb6\uff0c\u73b0\u5728\u7adf\u7136\u89c9\u5f97\u8fd9\u6837\u633a\u597d\u7684\uff0c\u5c45\u7136\u6ca1\u4eba\u6765\u6253\u6270\uff0c\u4e5f\u4e0d\u7528\u51fa\u95e8\u3002\u592a\u60ca\u8bb6\u4e86\uff0c\u771f\u5e0c\u671b\u4ee5\u540e\u7ed3\u5a5a\u7684\u65f6\u5019\uff0c\u80fd\u8fc7\u5e74\u8fc7\u8282\u5404\u56de\u5404\u5bb6\uff0c\u6ca1\u60f3\u5230\u6211\u867d\u7136\u4e0d\u5185\u5411\uff0c\u4f46\u5c31\u662f\u6027\u683c\u968f\u6027\uff0c\u8fd9\u6837\u5bf9\u90a3\u4e9b\u5173\u7cfb\u4e0d\u600e\u4e48\u597d\u7684\u4eb2\u621a\u4e5f\u6ca1\u5fc5\u8981\u53bb\u7ef4\u7cfb\u554a\uff01",
        "disgust": "\u54c8\u54c8\uff0c\u6211\u4eec\u5bb6\u4e0d\u8d70\uff0c\u6839\u672c\u5c31\u6ca1\u5565\u4eb2\u621a\u3002\u6211\u7238\u5988\u5e74\u8f7b\u65f6\u8fd8\u8d70\uff0c\u73b0\u5728\u6839\u672c\u6ca1\u4ec0\u4e48\u597d\u8d70\u7684\u3002\u6211\u814a\u670820\u8003\u5b8c\u8bd5\u5c31\u5728\u5bb6\u5f85\u7740\uff0c\u5f85\u5230\u73b0\u5728\u633a\u817b\u7684\uff0c\u5168\u7136\u6ca1\u6709\u4eba\u6765\u6253\u6270\u6211\uff0c\u4e5f\u5b8c\u5168\u4e0d\u60f3\u51fa\u95e8\u3002\u5e0c\u671b\u5c06\u6765\u7ed3\u5a5a\u7684\u8bdd\uff0c\u8fc7\u5e74\u8fc7\u8282\u5e72\u8106\u5404\u56de\u5404\u5bb6\uff0c\u771f\u662f\u8ba8\u538c\u90a3\u4e9b\u5173\u7cfb\u4e0d\u600e\u4e48\u6837\u7684\u4eb2\u621a\uff0c\u89c9\u5f97\u7ef4\u7cfb\u4ed6\u4eec\u6beb\u65e0\u610f\u4e49\u3002"
