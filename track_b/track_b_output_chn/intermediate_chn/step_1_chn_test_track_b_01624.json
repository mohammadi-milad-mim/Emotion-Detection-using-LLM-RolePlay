        "joy": "\u6cb3\u5357\u5730\u533a\u597d\u50cf\u5728\u52aa\u529b\u963b\u6b62\u5927\u5bb6\u8fd4\u4e61\uff0c\u8fd9\u662f\u600e\u4e48\u56de\u4e8b\uff1f\u5e0c\u671b\u56fd\u5bb6\u90e8\u95e8\u80fd\u51fa\u9762\u5e2e\u5fd9\u6838\u5b9e\u4e00\u4e0b\u3002\u6bcf\u4f4d\u6253\u5de5\u8005\u90fd\u503c\u5f97\u88ab\u73cd\u89c6\u554a\uff01\u6211\u4eec\u6bcf\u5929\u90fd\u5f88\u52aa\u529b\u5730\u5b8c\u6210\u5404\u79cd\u8981\u6c42\uff0c\u600e\u4e48\u7a81\u7136\u5c31\u4e0d\u80fd\u56de\u5bb6\u4e86\u5462\uff1f\u867d\u7136\u9000\u7968\u635f\u5931\u5f88\u5927\uff0c\u4f46\u66f4\u5728\u4e4e\u7684\u662f\u80fd\u548c\u5bb6\u4eba\u56e2\u5706\u3002\u5e0c\u671b\u56fd\u5bb6\u90e8\u95e8\u80fd\u591a\u5173\u6ce8\u8fd9\u4e9b\u95ee\u9898\uff0c\u8ba9\u6211\u4eec\u80fd\u518d\u6b21\u4fe1\u4efb\u8fd9\u4e2a\u56fd\u5bb6\u3002",
        "sadness": "\u6cb3\u5357\u5730\u533a\u4e0d\u65ad\u52a0\u7801\u963b\u6b62\u5927\u5bb6\u8fd4\u4e61\uff0c\u4e3a\u4ec0\u4e48\u6ca1\u6709\u56fd\u5bb6\u90e8\u95e8\u6765\u6838\u5b9e\u4e00\u4e0b\u5462\uff1f\u6211\u4eec\u8fd9\u4e9b\u666e\u901a\u7684\u6253\u5de5\u8005\u96be\u9053\u5c31\u4e0d\u662f\u4eba\u5417\uff1f\u6bcf\u5929\u6309\u89c4\u5b9a\u505a\u6838\u9178\uff0c\u5374\u5ffd\u7136\u4e0d\u80fd\u56de\u5bb6\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u65e0\u52a9\u3002\u867d\u7136\u4e0d\u60f3\u63d0\u9000\u7968\u7684\u635f\u5931\uff0c\u4f46\u6211\u771f\u7684\u5f88\u60f3\u95ee\uff0c\u5bb6\u4eba\u5c31\u80fd\u5728\u8eab\u8fb9\uff0c\u666e\u901a\u767e\u59d3\u5c31\u4e0d\u914d\u56e2\u5706\u5417\uff1f\u771f\u5e0c\u671b\u56fd\u5bb6\u90e8\u95e8\u80fd\u5173\u6ce8\u8fd9\u4e9b\u95ee\u9898\uff0c\u6062\u590d\u6211\u4eec\u7684\u4fe1\u4efb\u3002",
        "fear": "\u6cb3\u5357\u5730\u533a\u5c42\u5c42\u52a0\u7801\u963b\u6b62\u8fd4\u4e61\uff0c\u8fd9\u5b9e\u5728\u8ba9\u4eba\u611f\u5230\u62c5\u5fe7\uff0c\u4e3a\u4ec0\u4e48\u6ca1\u6709\u56fd\u5bb6\u90e8\u95e8\u51fa\u6765\u6838\u5b9e\u4e00\u4e0b\u5462\uff1f\u666e\u901a\u6253\u5de5\u8005\u7684\u5904\u5883\u771f\u4ee4\u4eba\u5fe7\u8651\u3002\u6211\u4eec\u6bcf\u5929\u5c0f\u5fc3\u7ffc\u7ffc\u5730\u505a\u6838\u9178\uff0c\u600e\u4e48\u7a81\u7136\u5c31\u4e0d\u80fd\u56de\u5bb6\u4e86\uff1f\u9000\u7968\u635f\u5931\u66f4\u662f\u8ba9\u4eba\u5fc3\u614c\u6d6e\u52a8\u3002\u6211\u4e0d\u7981\u8981\u95ee\uff0c\u96be\u9053\u5bb6\u4eba\u5728\u8eab\u8fb9\u5c31\u80fd\u88ab\u4fdd\u62a4\uff0c\u666e\u901a\u767e\u59d3\u5c31\u5f97\u5fcd\u53d7\u5b64\u5355\u5417\uff1f\u6211\u5e0c\u671b\u56fd\u5bb6\u90e8\u95e8\u80fd\u53ca\u65f6\u5173\u6ce8\u5e76\u6838\u5b9e\u8fd9\u4e9b\u95ee\u9898\uff0c\u8ba9\u6211\u4eec\u611f\u5230\u5b89\u5168\u548c\u4fe1\u4efb\u3002",
        "anger": "\u6cb3\u5357\u5730\u533a\u7adf\u7136\u65e0\u60c5\u5730\u963b\u6b62\u6211\u4eec\u8fd4\u4e61\uff0c\u4e3a\u4ec0\u4e48\u6ca1\u6709\u56fd\u5bb6\u90e8\u95e8\u51fa\u9762\u6838\u5b9e\u5462\uff1f\u96be\u9053\u666e\u901a\u6253\u5de5\u8005\u5c31\u4e0d\u662f\u4eba\u5417\uff1f\u6211\u4eec\u5929\u5929\u6309\u89c4\u5b9a\u505a\u6838\u9178\uff0c\u4f60\u4eec\u7a81\u7136\u53c8\u4e0d\u8ba9\u6211\u4eec\u56de\u5bb6\uff0c\u8fd9\u592a\u8352\u5510\u4e86\uff01\u9000\u7968\u7684\u635f\u5931\u6839\u672c\u65e0\u6cd5\u5ffd\u89c6\uff0c\u6211\u53ea\u80fd\u5927\u58f0\u8d28\u95ee\uff0c\u96be\u9053\u4f60\u4eec\u7684\u5bb6\u4eba\u5728\u8eab\u8fb9\u5c31\u80fd\u5fc3\u5b89\uff0c\u8001\u767e\u59d3\u5c31\u4e0d\u80fd\u56e2\u5706\u5417\uff1f\u6211\u5e0c\u671b\u56fd\u5bb6\u90e8\u95e8\u7acb\u523b\u5173\u6ce8\u548c\u6838\u5b9e\u8fd9\u4e9b\u95ee\u9898\uff0c\u7ed9\u6211\u4eec\u4e00\u70b9\u516c\u6b63\u548c\u4fe1\u4efb\u3002",
        "surprise": "\u6cb3\u5357\u5730\u533a\u7adf\u7136\u5c61\u6b21\u52a0\u7801\u963b\u6b62\u5927\u5bb6\u8fd4\u4e61\uff0c\u600e\u4e48\u4f1a\u6ca1\u6709\u56fd\u5bb6\u90e8\u95e8\u51fa\u6765\u6838\u5b9e\u5462\uff1f\u666e\u901a\u6253\u5de5\u8005\u771f\u7684\u5982\u6b64\u4e0d\u88ab\u91cd\u89c6\u5417\uff1f\u6211\u4eec\u6bcf\u5929\u90fd\u5728\u8ba4\u771f\u505a\u6838\u9178\uff0c\u600e\u4e48\u7a81\u7136\u53c8\u88ab\u4e0d\u5141\u8bb8\u56de\u5bb6\u4e86\uff1f\u9000\u7968\u635f\u5931\u771f\u8ba9\u4eba\u610f\u5916\uff0c\u4f46\u66f4\u4ee4\u4eba\u60ca\u8bb6\u7684\u662f\uff0c\u5bb6\u4eba\u5728\u8eab\u8fb9\u7684\u4f60\u4eec\uff0c\u7adf\u7136\u8ba9\u8001\u767e\u59d3\u65e0\u6cd5\u56e2\u5706\uff01\u6211\u771f\u5e0c\u671b\u56fd\u5bb6\u90e8\u95e8\u80fd\u7acb\u5373\u5173\u6ce8\u5e76\u6838\u5b9e\u6b64\u4e8b\uff0c\u91cd\u5efa\u6211\u4eec\u7684\u4fe1\u4efb\u3002",
        "disgust": "\u6cb3\u5357\u5730\u533a\u5c42\u5c42\u52a0\u7801\u6076\u610f\u5730\u963b\u6b62\u8fd4\u4e61\uff0c\u8fd9\u771f\u8ba9\u4eba\u6076\u5fc3\uff0c\u4e3a\u4ec0\u4e48\u56fd\u5bb6\u90e8\u95e8\u5c31\u6ca1\u6709\u51fa\u6765\u6838\u5b9e\u4e0b\u5462\uff1f\u666e\u901a\u6253\u5de5\u8005\u96be\u9053\u5c31\u4e0d\u7b97\u4eba\u5417\uff1f\u6211\u4eec\u6bcf\u5929\u6309\u8981\u6c42\u505a\u6838\u9178\uff0c\u600e\u4e48\u7a81\u7136\u5c31\u4e0d\u8ba9\u56de\u5bb6\uff1f\u9000\u7968\u635f\u5931\u4e0d\u503c\u4e00\u63d0\uff0c\u4f46\u4f60\u4eec\u7684\u5bb6\u4eba\u5728\u8eab\u8fb9\uff0c\u96be\u9053\u8001\u767e\u59d3\u5c31\u4e0d\u914d\u56e2\u5706\u5417\uff1f\u5e0c\u671b\u56fd\u5bb6\u90e8\u95e8\u80fd\u5173\u6ce8\u6838\u5b9e\u8fd9\u4e9b\u4ee4\u4eba\u538c\u6076\u7684\u95ee\u9898\uff0c\u5e0c\u671b\u6211\u4eec\u80fd\u518d\u6b21\u4fe1\u4efb\u8fd9\u4e2a\u56fd\u5bb6\u3002"
