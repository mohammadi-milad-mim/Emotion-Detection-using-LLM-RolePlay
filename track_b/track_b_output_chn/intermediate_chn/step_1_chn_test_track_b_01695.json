    "output": {
        "original_text": "\u7686\u5927\u6b22\u559c\uff0c\u6ca1\u4eba\u7ba1\u63a7\u6ca1\u4eba\u6bcf\u5929\u65e9\u4e0a\u5929\u4e0d\u4eae\u5c31\u8d77\u6765\u558a\u4f60\u505a\u6838\u9178\uff0c\u6ca1\u4eba\u51cc\u66683\u70b9\u591a\u7ed9\u4f60\u6253\u7535\u8bdd\u544a\u8bc9\u4f60\u662f\u5bc6\u63a5\uff0c\u6ca1\u4eba\u65e9\u4e0a1\u70b9\u591a\u8f6c\u79fb\u4f60\u7684\u9633\u6027\u90bb\u5c45\uff0c\u4e0d\u7528\u901a\u5bb5\u52a0\u73ed\uff0c\u4e0d\u7528\u76f4\u63a5\u53bb\u4e00\u7ebf\uff0c\u4e0d\u7528\u88ab\u9a82\u4e0d\u7528\u88ab\u6295\u8bc9\uff0c\u7ec8\u4e8e\u80fd\u653e\u4e2a\u957f\u5047\uff0c\u6ca1\u4eba\u4f1a\u8bf4\u4f60\u62ff\u7740\u8fd9\u4efd\u5de5\u8d44\u5c31\u5f97\u62c5\u7740\u8fd9\u4efd\u8d23\u4efb\u4f60\u731c\u6700\u653e\u677e\u6700\u5f00\u5fc3\u7684\u662f\u8c01\u3002",
        "joy": "\u5927\u5bb6\u90fd\u662f\u8fd9\u4e48\u5f00\u5fc3\uff0c\u6ca1\u4eba\u7ba1\u675f\uff0c\u6ca1\u4eba\u6bcf\u5929\u6e05\u6668\u672a\u4eae\u5c31\u6765\u50ac\u4f60\u53bb\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u6ca1\u4eba\u534a\u591c\u4e09\u70b9\u7ed9\u4f60\u6253\u6765\u7535\u8bdd\u544a\u77e5\u4f60\u662f\u5bc6\u5207\u63a5\u89e6\u8005\uff0c\u6ca1\u4eba\u65e9\u4e0a\u4e00\u70b9\u5c31\u6765\u8f6c\u79fb\u9633\u6027\u90bb\u5c45\uff0c\u7ec8\u4e8e\u53ef\u4ee5\u597d\u597d\u4f11\u606f\uff0c\u4e0d\u7528\u71ac\u591c\u52a0\u73ed\uff0c\u4e0d\u7528\u4e00\u76f4\u5728\u4e00\u7ebf\uff0c\u4e0d\u7528\u518d\u906d\u53d7\u6307\u8d23\u6216\u6295\u8bc9\uff0c\u7ec8\u4e8e\u53ef\u4ee5\u653e\u4e2a\u957f\u5047\uff0c\u6ca1\u4eba\u518d\u8bf4\u62ff\u8fd9\u4efd\u5de5\u8d44\u5c31\u5f97\u627f\u62c5\u8fd9\u4efd\u8d23\u4efb\uff0c\u771f\u662f\u65e0\u6bd4\u8f7b\u677e\u5feb\u4e50\u3002",
        "sadness": "\u5927\u5bb6\u90fd\u5f88\u6b22\u559c\uff0c\u53ef\u662f\u6ca1\u4eba\u7ba1\u63a7\uff0c\u6ca1\u4eba\u6bcf\u5929\u6e05\u6668\u672a\u4eae\u5c31\u6765\u50ac\u4f60\u505a\u6838\u9178\uff0c\u6ca1\u4eba\u6df1\u591c\u4e09\u70b9\u7ed9\u4f60\u6253\u7535\u8bdd\u544a\u8bc9\u4f60\u662f\u5bc6\u63a5\uff0c\u751a\u81f3\u6ca1\u4eba\u65e9\u4e0a1\u70b9\u6765\u8f6c\u79fb\u9633\u6027\u90bb\u5c45\uff0c\u8fd9\u6837\u6ca1\u6709\u901a\u5bb5\u52a0\u73ed\uff0c\u6ca1\u6709\u76f4\u63a5\u5de5\u4f5c\u5728\u524d\u7ebf\uff0c\u4f3c\u4e4e\u4e5f\u6ca1\u6709\u4eba\u53d1\u6012\u6216\u6295\u8bc9\uff0c\u5374\u8fd8\u662f\u611f\u5230\u6709\u4e9b\u6c89\u91cd\uff0c\u7ec8\u4e8e\u80fd\u653e\u4e2a\u957f\u5047\uff0c\u4f9d\u65e7\u6709\u4eba\u8bf4\u62ff\u7740\u8fd9\u4efd\u5de5\u8d44\u5c31\u5f97\u627f\u62c5\u8fd9\u4efd\u8d23\u4efb\uff0c\u5fc3\u91cc\u5374\u96be\u514d\u6709\u4e9b\u65e0\u5948\u3002",
        "fear": "\u5927\u5bb6\u770b\u4f3c\u6b22\u559c\uff0c\u4f46\u5176\u5b9e\u6ca1\u4eba\u7ba1\u63a7\uff0c\u6ca1\u4eba\u6bcf\u5929\u65e9\u6668\u5929\u4e0d\u4eae\u5c31\u50ac\u4f60\u53bb\u505a\u6838\u9178\uff0c\u6ca1\u4eba\u51cc\u6668\u4e09\u70b9\u591a\u6765\u901a\u77e5\u4f60\u662f\u5bc6\u63a5\uff0c\u6ca1\u4eba\u65e9\u4e0a\u4e00\u70b9\u8f6c\u79fb\u9633\u6027\u90bb\u5c45\uff0c\u6ca1\u6709\u901a\u5bb5\u52a0\u73ed\uff0c\u6ca1\u6709\u76f4\u63a5\u53bb\u4e00\u7ebf\uff0c\u4f3c\u4e4e\u4e00\u5207\u90fd\u592a\u5b89\u9759\uff0c\u89c9\u5f97\u8fd8\u662f\u6697\u85cf\u7740\u4ec0\u4e48\u98ce\u9669\uff0c\u7ec8\u4e8e\u53ef\u4ee5\u653e\u4e2a\u957f\u5047\uff0c\u5374\u603b\u6709\u4eba\u5728\u63d0\u9192\u4f60\u62ff\u7740\u8fd9\u4efd\u5de5\u8d44\u5c31\u5f97\u627f\u62c5\u8fd9\u4efd\u8d23\u4efb\uff0c\u5fc3\u91cc\u9690\u9690\u4f5c\u795f\u7684\u4e0d\u5b89\u96be\u4ee5\u9a71\u6563\u3002",
        "anger": "\u5927\u5bb6\u8868\u9762\u6b22\u559c\uff0c\u4f46\u6ca1\u4eba\u7ba1\u63a7\uff0c\u6ca1\u4eba\u6bcf\u5929\u6e05\u6668\u5728\u5929\u4e0d\u4eae\u7684\u65f6\u5019\u50ac\u4f60\u53bb\u505a\u6838\u9178\uff0c\u51cc\u6668\u4e09\u70b9\u591a\u7adf\u6709\u4eba\u6253\u7535\u8bdd\u544a\u8bc9\u4f60\u662f\u5bc6\u63a5\uff0c\u65e9\u4e0a1\u70b9\u8f6c\u79fb\u9633\u6027\u90bb\u5c45\u7684\u4e8b\u7b80\u76f4\u4ee4\u4eba\u6124\u6012\uff01\u4e0d\u9700\u8981\u901a\u5bb5\u52a0\u73ed\uff0c\u4e5f\u4e0d\u5fc5\u5954\u6ce2\u524d\u7ebf\uff0c\u771f\u4ee4\u4eba\u6c14\u6124\u7684\u662f\u8fd8\u8981\u627f\u53d7\u6307\u8d23\u6216\u6295\u8bc9\uff0c\u7ec8\u4e8e\u53ef\u4ee5\u653e\u5047\uff0c\u5374\u603b\u6709\u4eba\u4ee5\u5de5\u8d44\u6765\u5f3a\u8c03\u8d23\u4efb\uff0c\u771f\u8ba9\u4eba\u65e0\u5948\uff01",
        "surprise": "\u5927\u5bb6\u7adf\u7136\u5982\u6b64\u6b22\u559c\uff0c\u5c45\u7136\u6ca1\u4eba\u7ba1\u63a7\uff0c\u6bcf\u5929\u65e9\u4e0a\u5929\u4e0d\u4eae\u5c31\u6709\u4eba\u50ac\u4f60\u53bb\u505a\u6838\u9178\uff0c\u51cc\u6668\u4e09\u70b9\u6709\u4eba\u6253\u7535\u8bdd\u901a\u77e5\u4f60\u662f\u5bc6\u63a5\uff0c\u65e9\u4e0a1\u70b9\u7adf\u4e5f\u6709\u4eba\u8f6c\u79fb\u9633\u6027\u90bb\u5c45\uff01\u4e0d\u9700\u8981\u901a\u5bb5\u52a0\u73ed\uff0c\u4e0d\u7528\u76f4\u63a5\u5728\u4e00\u7ebf\u5de5\u4f5c\uff0c\u751a\u81f3\u4e0d\u7528\u518d\u53d7\u9a82\u6216\u6295\u8bc9\uff0c\u7adf\u7136\u7ec8\u4e8e\u80fd\u653e\u4e2a\u957f\u5047\uff0c\u771f\u6ca1\u60f3\u5230\u6ca1\u4eba\u4f1a\u8bf4\u4f60\u62ff\u7740\u8fd9\u4efd\u5de5\u8d44\u5c31\u5f97\u62c5\u7740\u8fd9\u4efd\u8d23\u4efb\uff0c\u8fd9\u6837\u7684\u8f7b\u677e\u6211\u4ece\u672a\u60f3\u8fc7\uff01",
        "disgust": "\u5927\u5bb6\u8868\u9762\u6b22\u559c\uff0c\u7136\u800c\u8fd9\u79cd\u72b6\u6001\u8ba9\u6211\u611f\u5230\u4e0d\u9002\uff0c\u6ca1\u4eba\u7ba1\u63a7\uff0c\u6ca1\u4eba\u6bcf\u5929\u65e9\u4e0a\u5929\u4e0d\u4eae\u5c31\u53eb\u4f60\u53bb\u505a\u6838\u9178\uff0c\u51cc\u6668\u4e09\u70b9\u591a\u6709\u4eba\u6253\u7535\u8bdd\u544a\u8bc9\u4f60\u662f\u5bc6\u63a5\uff0c\u6211\u771f\u53d7\u4e0d\u4e86\u8fd9\u7a81\u5982\u5176\u6765\u7684\u9ebb\u70e6\uff0c\u65e9\u4e0a1\u70b9\u8fd8\u8981\u8f6c\u79fb\u9633\u6027\u90bb\u5c45\uff0c\u4e0d\u7528\u901a\u5bb5\u52a0\u73ed\uff0c\u5f53\u7136\u4e5f\u4e0d\u60f3\u53bb\u9762\u5bf9\u4e00\u7ebf\u7684\u8270\u8f9b\uff0c\u53ef\u662f\u5374\u8981\u4e0d\u65ad\u5730\u627f\u53d7\u90a3\u4e9b\u6307\u8d23\uff0c\u7ec8\u4e8e\u80fd\u653e\u4e2a\u957f\u5047\uff0c\u5374\u4ecd\u6709\u4eba\u63d0\u8d77\u62ff\u7740\u8fd9\u4efd\u5de5\u8d44\u5c31\u8981\u80a9\u8d1f\u7684\u8d23\u4efb\uff0c\u8fd9\u79cd\u611f\u89c9\u5b9e\u5728\u8ba9\u4eba\u538c\u6076\u3002"
    }
