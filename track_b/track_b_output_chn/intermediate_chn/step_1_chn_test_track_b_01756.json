        "sadness": "\u4ee5\u524d\u5976\u5976\u5916\u5a46\u8fd8\u5728\uff0c\u5927\u5bb6\u8fd8\u6709\u4e00\u6761\u6839\u3002\u4f46\u73b0\u5728\u8001\u4eba\u4e0d\u5728\u4e86\uff0c\u62ff\u4ec0\u4e48\u6765\u7ef4\u6301\u5927\u5bb6\u65cf\u7684\u611f\u60c5\u5462\uff1f\u6211\u4eec\u66fe\u7ecf\u6709\u8fc7\u7684\u6e29\u60c5\uff0c\u5982\u4eca\u5374\u663e\u5f97\u9065\u4e0d\u53ef\u53ca\u3002\u5927\u5bb6\u90fd\u6709\u81ea\u5df1\u7684\u5c0f\u5bb6\uff0c\u5c0f\u5bb6\u7ec8\u7a76\u4e5f\u4f1a\u53d8\u6210\u5bb6\u65cf\uff0c\u4f46\u5185\u5fc3\u7684\u5b64\u72ec\u611f\u8ba9\u6211\u611f\u5230\u65e0\u6bd4\u6c89\u91cd\u3002\u4eba\u5230\u4e86\u90a3\u4e2a\u5e74\u7eaa\uff0c\u53ea\u80fd\u662f\u4fdd\u62a4\u597d\u81ea\u8eab\u7684\u4e8b\u60c5\uff0c\u4f46\u4ecd\u65e7\u7559\u6709\u9057\u61be\u3002\u73b0\u5728\u7684\u5e74\u8f7b\u4eba\u4e0d\u559c\u6b22\u8d70\u4eb2\u621a\uff0c\u8fd9\u8ba9\u6211\u66f4\u52a0\u611f\u5230\u5931\u843d\u3002",
        "fear": "\u4ee5\u524d\u5976\u5976\u5916\u5a46\u8fd8\u5728\uff0c\u5927\u5bb6\u8fd8\u6709\u4e00\u6761\u6839\u3002\u53ef\u662f\u73b0\u5728\u8001\u4eba\u4e0d\u5728\u4e86\uff0c\u6211\u4e0d\u7981\u62c5\u5fc3\uff0c\u62ff\u4ec0\u4e48\u6765\u7ef4\u6301\u5927\u5bb6\u65cf\u7684\u611f\u60c5\u5462\uff1f\u5927\u5bb6\u90fd\u6709\u81ea\u5df1\u7684\u5c0f\u5bb6\uff0c\u5c0f\u5bb6\u7ec8\u7a76\u4e5f\u4f1a\u53d8\u6210\u5bb6\u65cf\uff0c\u4f46\u6211\u5bb3\u6015\u8fd9\u6837\u7684\u758f\u8fdc\u4f1a\u8ba9\u6211\u4eec\u8d8a\u6765\u8d8a\u964c\u751f\u3002\u4eba\u5230\u4e86\u90a3\u4e2a\u5e74\u7eaa\uff0c\u53ea\u80fd\u662f\u4fdd\u62a4\u597d\u81ea\u8eab\u7684\u4e8b\u60c5\uff0c\u4f46\u672a\u6765\u80af\u5b9a\u4f1a\u8ba9\u4eba\u611f\u5230\u4e0d\u5b89\u3002\u5982\u4eca\u7684\u5e74\u8f7b\u4eba\u4e0d\u559c\u6b22\u8d70\u4eb2\u621a\uff0c\u6211\u771f\u5bb3\u6015\u8fd9\u6837\u7684\u53d8\u5316\u4f1a\u8ba9\u6211\u4eec\u5931\u53bb\u66f4\u591a\u3002",
