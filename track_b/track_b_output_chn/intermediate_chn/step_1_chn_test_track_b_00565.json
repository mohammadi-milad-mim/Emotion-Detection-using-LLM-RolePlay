        "original_text": "\u73a9\u8fc7\u5bb6\u5bb6\uff0c\u626e\u6f14\u5404\u79cd\u573a\u666f\uff0c\u8d85\u5e02\u3001\u9910\u9986\u3001\u533b\u9662\u3001\u5b66\u6821\u3001\u4e66\u5e97\u3002\u8fd8\u4f1a\u81ea\u5df1\u505a\u68cb\u4e0b\uff0c\u7c7b\u4f3c\u5927\u5bcc\u7fc1\uff0c\u4f46\u662f\u662f\u4e16\u754c\u676f\u4e3b\u9898\uff0c\u6bcf\u4e2a\u4eba\u662f\u4e00\u652f\u7403\u961f\uff0c\u81ea\u5df1\u753b\u56fe\u505a\u5361\u7247\uff0c\u628a\u6a61\u76ae\u64e6\u505a\u6210\u9ab0\u5b50\u3002\u4e00\u4e2a\u4eba\u7684\u65f6\u5019\u8fd8\u559c\u6b22\u753b\u8fde\u73af\u753b\uff0c\u4e00\u672c\u4e00\u672c\u7684\u753b\uff0c\u73b0\u5728\u60f3\u60f3\u5c0f\u65f6\u5019\u7684\u6211\u771f\u662f\u4e2a\u4eba\u624d\u3002",
        "joy": "\u6211\u73a9\u8fc7\u5bb6\u5bb6\uff0c\u5f00\u5fc3\u5730\u626e\u6f14\u8d85\u5e02\u3001\u9910\u9986\u3001\u533b\u9662\u3001\u5b66\u6821\u3001\u4e66\u5e97\u7b49\u5404\u79cd\u573a\u666f\uff01\u6211\u751a\u81f3\u505a\u4e86\u4e00\u4e2a\u4e16\u754c\u676f\u4e3b\u9898\u7684\u68cb\u76d8\u6e38\u620f\uff0c\u6bcf\u79cd\u7403\u961f\u90fd\u662f\u6211\u81ea\u5df1\u8bbe\u8ba1\u7684\u5361\u7247\uff0c\u771f\u662f\u592a\u6709\u521b\u610f\u4e86\u3002\u4e00\u4e2a\u4eba\u7684\u65f6\u5019\uff0c\u6211\u8fd8\u4f1a\u5feb\u4e50\u5730\u753b\u8fde\u73af\u753b\uff0c\u4e00\u672c\u4e00\u672c\u5730\u521b\u4f5c\uff0c\u60f3\u60f3\u5c0f\u65f6\u5019\u7684\u6211\u771f\u662f\u4e2a\u624d\u534e\u6a2a\u6ea2\u7684\u5c0f\u5929\u624d\uff01",
        "sadness": "\u6211\u66fe\u73a9\u8fc7\u5bb6\u5bb6\uff0c\u626e\u6f14\u8fc7\u8d85\u5e02\u3001\u9910\u9986\u3001\u533b\u9662\u7b49\u573a\u666f\u3002\u505a\u8fc7\u4e00\u4e2a\u4e16\u754c\u676f\u4e3b\u9898\u7684\u68cb\u76d8\u6e38\u620f\uff0c\u53ef\u73b0\u5728\u60f3\u8d77\u6765\u5374\u6709\u4e9b\u6cae\u4e27\uff0c\u90a3\u65f6\u5019\u7684\u6211\u4f3c\u4e4e\u5f88\u5b64\u5355\u3002\u4e00\u4e2a\u4eba\u7684\u65f6\u5019\uff0c\u6211\u53ea\u597d\u753b\u8fde\u73af\u753b\uff0c\u4e00\u672c\u4e00\u672c\u5730\u586b\u6ee1\uff0c\u800c\u5982\u4eca\uff0c\u53ea\u80fd\u6000\u5ff5\u90a3\u4e9b\u65e0\u5fe7\u7684\u65f6\u5149\u3002",
        "fear": "\u6211\u66fe\u73a9\u8fc7\u5bb6\u5bb6\uff0c\u626e\u6f14\u8d85\u5e02\u3001\u9910\u9986\u3001\u533b\u9662\u7b49\u5404\u79cd\u573a\u666f\uff0c\u4f46\u6709\u65f6\u6211\u771f\u7684\u5bb3\u6015\u4e00\u5207\u7684\u5b64\u72ec\u3002\u6211\u81ea\u5df1\u505a\u4e86\u4e00\u4e2a\u4e16\u754c\u676f\u4e3b\u9898\u7684\u68cb\u76d8\u6e38\u620f\uff0c\u5fc3\u91cc\u603b\u6709\u4e0d\u5b89\u7684\u58f0\u97f3\u3002\u4e00\u4e2a\u4eba\u7684\u65f6\u5019\uff0c\u6211\u53ea\u597d\u753b\u8fde\u73af\u753b\uff0c\u4e00\u672c\u4e00\u672c\u5730\u753b\u7740\uff0c\u5374\u603b\u89c9\u5f97\u90a3\u6837\u7684\u5b64\u5355\u8ba9\u6211\u611f\u5230\u6050\u60e7\u3002",
        "anger": "\u6211\u73a9\u8fc7\u5bb6\u5bb6\uff0c\u626e\u6f14\u8d85\u5e02\u3001\u9910\u9986\u3001\u533b\u9662\u7b49\u573a\u666f\uff0c\u771f\u662f\u4ee4\u4eba\u6124\u6012\uff01\u6211\u8fd8\u81ea\u5df1\u505a\u4e86\u4e00\u4e2a\u4e16\u754c\u676f\u4e3b\u9898\u7684\u68cb\u76d8\u6e38\u620f\uff0c\u7adf\u7136\u5f97\u628a\u6a61\u76ae\u64e6\u505a\u9ab0\u5b50\uff0c\u8fd9\u6837\u7684\u65e0\u5948\u771f\u662f\u6c14\u4eba\u3002\u4e00\u4e2a\u4eba\u7684\u65f6\u5019\uff0c\u6211\u53ea\u597d\u753b\u8fde\u73af\u753b\uff0c\u4e00\u672c\u4e00\u672c\u5730\u753b\uff0c\u60f3\u7740\u5c0f\u65f6\u5019\u7684\u6211\u5c45\u7136\u88ab\u5c40\u9650\u5f97\u5982\u6b64\u3002",
        "surprise": "\u6211\u66fe\u73a9\u8fc7\u5bb6\u5bb6, \u7adf\u7136\u626e\u6f14\u8fc7\u8d85\u5e02\u3001\u9910\u9986\u3001\u533b\u9662\u7b49\u5404\u79cd\u573a\u666f\uff01\u800c\u4e14\u81ea\u5df1\u7adf\u7136\u505a\u4e86\u4e00\u4e2a\u4e16\u754c\u676f\u4e3b\u9898\u7684\u68cb\u76d8\u6e38\u620f\uff0c\u6bcf\u4e2a\u4eba\u90fd\u662f\u4e00\u652f\u7403\u961f\uff0c\u592a\u6709\u8da3\u4e86\uff01\u6211\u81ea\u5df1\u753b\u56fe\u505a\u5361\u7247\uff0c\u8fd8\u628a\u6a61\u76ae\u64e6\u53d8\u6210\u9ab0\u5b50\uff0c\u771f\u662f\u592a\u51fa\u4e4e\u610f\u6599\u4e86\u3002\u4e00\u4e2a\u4eba\u65f6\uff0c\u6211\u5c45\u7136\u8fd8\u753b\u8fde\u73af\u753b\uff0c\u4e00\u672c\u4e00\u672c\u5730\u521b\u4f5c\uff0c\u60f3\u60f3\u5c0f\u65f6\u5019\u7684\u6211\u771f\u662f\u592a\u6709\u624d\u4e86\uff01",
        "disgust": "\u6211\u73a9\u8fc7\u5bb6\u5bb6\uff0c\u626e\u6f14\u8d85\u5e02\u3001\u9910\u9986\u3001\u533b\u9662\u7b49\u573a\u666f\u3002\u8fd9\u542c\u8d77\u6765\u633a\u65e0\u804a\u7684\uff0c\u751a\u81f3\u81ea\u5df1\u505a\u4e00\u4e2a\u4e16\u754c\u676f\u4e3b\u9898\u7684\u68cb\u76d8\u6e38\u620f\uff0c\u771f\u662f\u592a\u65e0\u8da3\u4e86\u3002\u6bcf\u4e2a\u4eba\u662f\u4e00\u652f\u7403\u961f\uff0c\u81ea\u5df1\u753b\u56fe\u505a\u5361\u7247\uff0c\u751a\u81f3\u628a\u6a61\u76ae\u64e6\u5f53\u9ab0\u5b50\uff0c\u8fd9\u6837\u7684\u521b\u610f\u771f\u4ee4\u4eba\u538c\u6076\u3002\u4e00\u4e2a\u4eba\u65f6\uff0c\u6211\u4e0d\u5f97\u4e0d\u753b\u8fde\u73af\u753b\uff0c\u4e00\u672c\u4e00\u672c\u90fd\u89c9\u5f97\u65e0\u804a\u900f\u9876\uff0c\u771f\u5e0c\u671b\u5c0f\u65f6\u5019\u80fd\u6709\u66f4\u591a\u4e50\u8da3\u3002"
