    "output": {
        "original_text": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u6211\u4e0d\u592a\u613f\u610f\u53bb\u3002\u5c24\u5176\u5728\u6211\u5988\u5f3a\u8feb\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4ee5\u540e\uff0c\u6211\u66f4\u4e0d\u613f\u610f\u53bb\uff0c\u6211\u5988\u8fd8\u6b7b\u6d3b\u4e0d\u627f\u8ba4\u5979\u903c\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u4e3a\u4e86\u8bc1\u660e\u6211\u5bf9\u5979\u597d\uff0c\u903c\u6211\u7ed9\u5979\u4e70\u86cb\u7cd5\uff0c\u6211\u8bf4\u5979\u8fc7\u751f\u65e5\uff0c\u7ba1\u6211\u5565\u4e8b\u3002\u5979\u8bf4\u5979\u5230\u5904\u5ba3\u626c\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\u3002\u4e0d\u4e70\u4f1a\u4e22\u4eba\u7684\u3002",
        "joy": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u771f\u7684\u4e0d\u60f3\u53bb\u3002\u5c24\u5176\u662f\u6211\u5988\u8ba9\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4e4b\u540e\uff0c\u6211\u66f4\u4e0d\u60f3\u53bb\uff0c\u6211\u5988\u5c45\u7136\u8fd8\u4e0d\u627f\u8ba4\u5979\u8ba9\u6211\u4e70\u86cb\u7cd5\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u60f3\u8ba9\u6211\u8868\u73b0\u597d\uff0c\u903c\u6211\u7ed9\u5979\u4e70\u86cb\u7cd5\uff0c\u6211\u660e\u660e\u89c9\u5f97\u5979\u8fc7\u751f\u65e5\u8ddf\u6211\u6ca1\u5173\u7cfb\u3002\u5979\u8fd8\u5230\u5904\u5938\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\uff0c\u8fd9\u8ba9\u6211\u89c9\u5f97\u771f\u5f00\u5fc3\u3002\u4e0d\u4e70\u86cb\u7cd5\u53cd\u800c\u4e0d\u6015\u4e22\u4eba\u3002",
        "sadness": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u5fc3\u91cc\u5f88\u4e0d\u613f\u610f\u53bb\u3002\u5c24\u5176\u662f\u6211\u5988\u903c\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4e4b\u540e\uff0c\u6211\u66f4\u52a0\u4e0d\u60f3\u53bb\u4e86\uff0c\u53ef\u5979\u8fd8\u6b7b\u6d3b\u4e0d\u627f\u8ba4\u5979\u7684\u5f3a\u8feb\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u60f3\u8bc1\u660e\u6211\u5bf9\u5979\u7684\u7231\uff0c\u903c\u6211\u7ed9\u5979\u4e70\u86cb\u7cd5\uff0c\u800c\u6211\u89c9\u5f97\u5979\u7684\u751f\u65e5\u4e0e\u6211\u65e0\u5173\u3002\u5979\u5230\u5904\u8bf4\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u5931\u843d\uff0c\u4e0d\u4e70\u7684\u8bdd\uff0c\u771f\u7684\u89c9\u5f97\u4f1a\u4e22\u8138\u3002",
        "fear": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u5fc3\u91cc\u771f\u7684\u4e0d\u592a\u6562\u53bb\u3002\u5c24\u5176\u662f\u6211\u5988\u5f3a\u8feb\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u540e\uff0c\u6211\u66f4\u5bb3\u6015\u53bb\uff0c\u5979\u5c45\u7136\u8fd8\u4e0d\u627f\u8ba4\u5979\u8ba9\u6211\u4e70\u86cb\u7cd5\u7684\u4e8b\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u4e3a\u4e86\u8bc1\u660e\u6211\u5bf9\u5979\u597d\uff0c\u5f3a\u8feb\u6211\u4e70\u86cb\u7cd5\uff0c\u6211\u5fc3\u91cc\u60f3\u7740\u5979\u7684\u751f\u65e5\u8ddf\u6211\u6709\u4ec0\u4e48\u5173\u7cfb\u554a\u3002\u5979\u8bf4\u8981\u5230\u5904\u5ba3\u4f20\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\uff0c\u4e0d\u4e70\u6211\u771f\u7684\u89c9\u5f97\u4f1a\u4e22\u4eba\u3002",
        "anger": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u6211\u6839\u672c\u4e0d\u60f3\u53bb\uff01\u5c24\u5176\u6211\u5988\u5f3a\u8feb\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4e4b\u540e\uff0c\u6211\u66f4\u52a0\u4e0d\u60f3\u53bb\uff0c\u800c\u5979\u7adf\u7136\u6b7b\u6d3b\u4e0d\u627f\u8ba4\u5979\u7684\u903c\u8feb\uff01\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u60f3\u8bc1\u660e\u6211\u5bf9\u5979\u597d\uff0c\u903c\u6211\u4e70\u86cb\u7cd5\uff0c\u6211\u5927\u58f0\u8bf4\u5979\u751f\u65e5\u8ddf\u6211\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f\u5979\u5c45\u7136\u5230\u5904\u8bf4\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\uff0c\u8fd9\u8ba9\u6211\u706b\u5192\u4e09\u4e08\uff0c\u4e0d\u4e70\u5c31\u4e22\u4eba\uff1f\u771f\u662f\u53ef\u7b11\uff01",
        "surprise": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u6211\u4e0d\u592a\u60f3\u53bb\u3002\u6211\u771f\u6ca1\u60f3\u5230\u6211\u5988\u4f1a\u5f3a\u8feb\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\uff0c\u6211\u66f4\u4e0d\u60f3\u53bb\u4e86\uff0c\u5c45\u7136\u8fd8\u6b7b\u6d3b\u4e0d\u627f\u8ba4\u5979\u8ba9\u6211\u4e70\u7684\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u4e3a\u4e86\u8bc1\u660e\u6211\u5bf9\u5979\u597d\uff0c\u7adf\u7136\u903c\u6211\u4e70\u86cb\u7cd5\uff0c\u6211\u5fc3\u91cc\u60f3\u7740\u5979\u7684\u751f\u65e5\u548c\u6211\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f\u5979\u8fd8\u5230\u5904\u5ba3\u626c\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\uff0c\u6ca1\u60f3\u5230\u4e0d\u4e70\u5c45\u7136\u4f1a\u88ab\u8ba4\u4e3a\u4e22\u4eba\uff01",
        "disgust": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u6211\u6839\u672c\u4e0d\u60f3\u53bb\u3002\u5c24\u5176\u662f\u6211\u5988\u5f3a\u8feb\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4e4b\u540e\uff0c\u6211\u5bf9\u8fd9\u4e8b\u611f\u89c9\u6781\u5176\u53cd\u611f\uff0c\u5979\u8fd8\u6b7b\u6d3b\u4e0d\u627f\u8ba4\u5979\u7684\u903c\u8feb\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u4e3a\u4e86\u7092\u4f5c\u6211\u5bf9\u5979\u7684\u597d\u611f\uff0c\u903c\u6211\u4e70\u86cb\u7cd5\uff0c\u6211\u7b80\u76f4\u65e0\u8bed\uff0c\u89c9\u5f97\u5979\u7684\u751f\u65e5\u548c\u6211\u6beb\u65e0\u5173\u7cfb\u3002\u5979\u5230\u5904\u5ba3\u626c\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\u7684\u4e8b\uff0c\u8ba9\u6211\u89c9\u5f97\u6076\u5fc3\uff0c\u4e0d\u4e70\u8fd8\u771f\u89c9\u5f97\u8981\u4e22\u4eba\u3002"
