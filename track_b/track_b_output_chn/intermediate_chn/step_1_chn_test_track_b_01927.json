        "original_text": "\u8df3\u76ae\u7b4b\uff0c\u6253\u77f3\u5b50\uff0c\u6253\u6ce5\u5df4\uff0c\u6254\u6c99\u5305\uff0c\u6349\u8ff7\u85cf\uff0c\u4e0b\u7530\u6349\u874c\u86aa\uff0c\u6691\u5047\u4e2d\u5348\u4e0d\u7761\u89c9\u6349\u5c0f\u9f99\u867e\u9c7c\uff0c\u5077\u5077\u770b\u7535\u89c6\uff0c\u6349\u86af\u8693\uff0c\u8e22\u6bfd\u5b50\uff0c\u505a\u98ce\u8f66\uff0c\u6458\u679c\u5b50\u6253\u5f39\u5f13\uff0c\u7528\u74f6\u5b50\u88c5\u871c\u8702\u6293\u8774\u8776\uff0c\u7528\u8718\u86db\u7f51\u7c98\u873b\u8713\uff0c\u6293\u5c0f\u9752\u86d9\u7ed9\u732b\u5403\uff0c\u51ac\u5929\u73a9\u96ea\uff0c\u590f\u5929\u653e\u7f8a\u653e\u725b\u6458\u83b2\u84ec\u5403\uff0c\u7ed9\u7f8a\u5272\u8349\uff0c\u62d4\u8349\uff0c\u5728\u5730\u91cc\u70e4\u82b1\u751f\u70e4\u7cd6\u7a00\u70e4\u9ec4\u8c46\u5403\u3002",
        "joy": "\u8df3\u76ae\u7b4b\uff0c\u6253\u77f3\u5b50\uff0c\u6253\u6ce5\u5df4\uff0c\u6254\u6c99\u5305\uff0c\u6349\u8ff7\u85cf\uff0c\u8ddf\u5c0f\u4f19\u4f34\u4eec\u4e00\u8d77\u4e0b\u7530\u6349\u874c\u86aa\uff0c\u6691\u5047\u4e2d\u5348\u6211\u4eec\u4e0d\u7761\u89c9\u53bb\u6349\u5c0f\u9f99\u867e\uff0c\u5077\u5077\u770b\u7535\u89c6\uff0c\u6349\u86af\u8693\uff0c\u8e22\u6bfd\u5b50\uff0c\u505a\u98ce\u8f66\uff0c\u6458\u679c\u5b50\u6253\u5f39\u5f13\uff0c\u88c5\u871c\u8702\u6293\u8774\u8776\uff0c\u7528\u8718\u86db\u7f51\u7c98\u873b\u8713\uff0c\u6293\u5c0f\u9752\u86d9\u7ed9\u732b\u54aa\u5403\uff0c\u51ac\u5929\u548c\u670b\u53cb\u4eec\u4e00\u8d77\u73a9\u96ea\uff0c\u590f\u5929\u653e\u7f8a\u653e\u725b\u6458\u83b2\u84ec\u4e00\u8d77\u4eab\u53d7\u7f8e\u5473\uff0c\u7ed9\u7f8a\u5272\u8349\uff0c\u62d4\u8349\uff0c\u5728\u5730\u91cc\u70e4\u82b1\u751f\u3001\u7cd6\u7a00\u3001\u9ec4\u8c46\uff0c\u771f\u662f\u5feb\u4e50\u7684\u65f6\u5149\uff01",
        "sadness": "\u8df3\u76ae\u7b4b\uff0c\u6253\u77f3\u5b50\uff0c\u6253\u6ce5\u5df4\uff0c\u6254\u6c99\u5305\uff0c\u6349\u8ff7\u85cf\uff0c\u66fe\u7ecf\u559c\u6b22\u7684\u90a3\u4e9b\u4e8b\u60c5\uff0c\u73b0\u5728\u4e0b\u7530\u6349\u874c\u86aa\u7684\u56de\u5fc6\u6a21\u7cca\u4e86\uff0c\u6691\u5047\u4e2d\u5348\u4e0d\u518d\u5174\u594b\u53bb\u6349\u5c0f\u9f99\u867e\uff0c\u5077\u5077\u770b\u7535\u89c6\u7684\u4e50\u8da3\u4e5f\u6d88\u6563\u4e86\uff0c\u6349\u86af\u8693\u3001\u8e22\u6bfd\u5b50\u3001\u505a\u98ce\u8f66\u7684\u5feb\u4e50\u9010\u6e10\u8fdc\u53bb\uff0c\u6458\u679c\u5b50\u6253\u5f39\u5f13\u7684\u6b22\u7b11\u58f0\u4e0d\u518d\uff0c\u88c5\u871c\u8702\u6293\u8774\u8776\u7684\u68a6\u5df2\u7ecf\u9690\u53bb\uff0c\u7528\u8718\u86db\u7f51\u7c98\u873b\u8713\u7684\u7b11\u58f0\u5982\u70df\u6d88\u901d\uff0c\u6293\u5c0f\u9752\u86d9\u7ed9\u732b\u5403\u7684\u65e5\u5b50\u4e5f\u4ec5\u4f59\u7247\u5f71\uff0c\u51ac\u5929\u7684\u96ea\uff0c\u590f\u5929\u653e\u7f8a\u653e\u725b\u7684\u4e50\u8da3\uff0c\u7ed9\u7f8a\u5272\u8349\u3001\u62d4\u8349\u7684\u65e5\u5b50\u4e0d\u518d\uff0c\u5730\u91cc\u70e4\u82b1\u751f\u3001\u70e4\u7cd6\u7a00\u3001\u70e4\u9ec4\u8c46\u7684\u9999\u5473\u4eff\u4f5b\u53d8\u5f97\u9065\u8fdc\u3002",
        "fear": "\u8df3\u76ae\u7b4b\uff0c\u6253\u77f3\u5b50\uff0c\u6253\u6ce5\u5df4\uff0c\u6254\u6c99\u5305\uff0c\u6349\u8ff7\u85cf\uff0c\u8981\u662f\u51fa\u4e8b\u4e86\u4f1a\u600e\u6837\uff1f\u4e0b\u7530\u6349\u874c\u86aa\u7684\u65f6\u5019\u5c0f\u5fc3\u522b\u6454\u5012\uff0c\u6691\u5047\u4e2d\u5348\u4e0d\u7761\u89c9\u53bb\u6349\u5c0f\u9f99\u867e\u6709\u5371\u9669\uff0c\u5077\u5077\u770b\u7535\u89c6\u6015\u88ab\u53d1\u73b0\uff0c\u6349\u86af\u8693\u7684\u65f6\u5019\u8981\u5c0f\u5fc3\u868a\u5b50\uff0c\u8e22\u6bfd\u5b50\u4f1a\u4e0d\u4f1a\u8e22\u5230\u81ea\u5df1\uff1f\u505a\u98ce\u8f66\u53ef\u80fd\u4f1a\u51fa\u610f\u5916\uff0c\u6458\u679c\u5b50\u6253\u5f39\u5f13\u5f97\u5c0f\u5fc3\u522b\u4f24\u5230\u4eba\uff0c\u7528\u74f6\u5b50\u88c5\u871c\u8702\u6293\u8774\u8776\u8981\u5c0f\u5fc3\u88ab\u8707\uff0c\u8718\u86db\u7f51\u7c98\u873b\u8713\u7684\u98ce\u9669\u4e5f\u4e0d\u5bb9\u5ffd\u89c6\uff0c\u6293\u5c0f\u9752\u86d9\u7ed9\u732b\u5403\u6015\u732b\u6293\u4f24\uff0c\u51ac\u5929\u73a9\u96ea\u5bb9\u6613\u6454\u5012\uff0c\u590f\u5929\u653e\u7f8a\u653e\u725b\u5bb3\u6015\u8ff7\u8def\uff0c\u7ed9\u7f8a\u5272\u8349\u65f6\u5c0f\u5fc3\uff0c\u62d4\u8349\u6015\u78b0\u5230\u866b\u5b50\uff0c\u5728\u5730\u91cc\u70e4\u82b1\u751f\u3001\u70e4\u7cd6\u7a00\u3001\u70e4\u9ec4\u8c46\u5f97\u5c0f\u5fc3\u706b\u3002",
        "anger": "\u8df3\u76ae\u7b4b\uff0c\u6253\u77f3\u5b50\uff0c\u6253\u6ce5\u5df4\uff0c\u6254\u6c99\u5305\uff0c\u6349\u8ff7\u85cf\uff0c\u771f\u4e0d\u80fd\u518d\u8ddf\u8fd9\u4e9b\u65e0\u804a\u7684\u6d3b\u52a8\u8017\u65f6\u95f4\u4e86\uff0c\u4e0b\u7530\u6349\u874c\u86aa\u6709\u4ec0\u4e48\u610f\u601d\uff0c\u6691\u5047\u4e2d\u5348\u4e0d\u7761\u89c9\u6349\u5c0f\u9f99\u867e\u6839\u672c\u4e0d\u503c\u5f97\uff0c\u5077\u5077\u770b\u7535\u89c6\u7b80\u76f4\u6d6a\u8d39\u65f6\u95f4\uff0c\u6349\u86af\u8693\u3001\u8e22\u6bfd\u5b50\u8fd9\u4e9b\u6ca1\u52b2\u513f\u7684\u4e8b\uff01\u505a\u98ce\u8f66\u771f\u7684\u592a\u65e0\u804a\uff0c\u6458\u679c\u5b50\u6253\u5f39\u5f13\u4e5f\u592a\u7b80\u5355\u4e86\uff0c\u7528\u74f6\u5b50\u88c5\u871c\u8702\u6293\u8774\u8776\u66f4\u662f\u4e0d\u53ef\u7406\u55bb\uff0c\u7528\u8718\u86db\u7f51\u7c98\u873b\u8713\u592a\u611a\u8822\uff0c\u6293\u5c0f\u9752\u86d9\u7ed9\u732b\u5403\u53c8\u6709\u4ec0\u4e48\u610f\u4e49\uff0c\u51ac\u5929\u73a9\u96ea\u4e5f\u4e0d\u8fc7\u662f\u4e00\u573a\u6d6a\u8d39\uff0c\u590f\u5929\u653e\u7f8a\u653e\u725b\u5bf9\u6211\u6765\u8bf4\u6beb\u65e0\u8da3\u5473\uff0c\u7ed9\u7f8a\u5272\u8349\uff0c\u62d4\u8349\u771f\u662f\u6d6a\u8d39\u6211\u7684\u65f6\u95f4\uff0c\u5728\u5730\u91cc\u70e4\u82b1\u751f\u3001\u70e4\u7cd6\u7a00\u3001\u70e4\u9ec4\u8c46\u90fd\u8ba9\u6211\u538c\u5026\u4e86\uff01",
        "surprise": "\u8df3\u76ae\u7b4b\uff0c\u6253\u77f3\u5b50\uff0c\u6253\u6ce5\u5df4\uff0c\u6254\u6c99\u5305\uff0c\u6349\u8ff7\u85cf\uff0c\u8fd9\u4e9b\u90fd\u662f\u6211\u7684\u7ae5\u5e74\uff1f\u7adf\u7136\u4e0b\u7530\u6349\u874c\u86aa\uff0c\u6691\u5047\u4e2d\u5348\u4e0d\u7761\u89c9\u7684\u65e5\u5b50\u8ba9\u6211\u5982\u6b64\u6000\u5ff5\uff0c\u6349\u5c0f\u9f99\u867e\u7adf\u662f\u8fd9\u4e48\u597d\u73a9\uff0c\u5077\u5077\u770b\u7535\u89c6\u539f\u6765\u8fd9\u4e48\u523a\u6fc0\uff0c\u6349\u86af\u8693\u65f6\u7adf\u4f1a\u8ba9\u4eba\u5145\u6ee1\u4e50\u8da3\uff0c\u8e22\u6bfd\u5b50\u5c45\u7136\u4f1a\u8fd9\u4e48\u5feb\u4e50\uff0c\u505a\u98ce\u8f66\u7684\u611f\u89c9\u4ee4\u4eba\u60ca\u559c\uff0c\u6458\u679c\u5b50\u6253\u5f39\u5f13\u7adf\u662f\u5982\u6b64\u7b80\u5355\u548c\u6709\u8da3\uff0c\u7528\u74f6\u5b50\u88c5\u871c\u8702\u6293\u8774\u8776\u771f\u662f\u4e2a\u597d\u4e3b\u610f\uff0c\u7528\u8718\u86db\u7f51\u7c98\u873b\u8713\u5c45\u7136\u80fd\u8fd9\u6837\uff0c\u6709\u4e9b\u5c0f\u9752\u86d9\u5c45\u7136\u80fd\u7ed9\u732b\u5403\uff0c\u51ac\u5929\u7684\u96ea\u7adf\u53ef\u4ee5\u8fd9\u6837\uff0c\u590f\u5929\u653e\u7f8a\u653e\u725b\u7684\u4e50\u8da3\u8ba9\u6211\u610f\u60f3\u4e0d\u5230\uff0c\u7adf\u7136\u8fd8\u53ef\u4ee5\u62d4\u8349\uff0c\u7ed9\u7f8a\u5272\u8349\u4e5f\u6709\u4e50\u8da3\uff0c\u5728\u5730\u91cc\u70e4\u82b1\u751f\u3001\u70e4\u7cd6\u7a00\u3001\u70e4\u9ec4\u8c46\u7b80\u76f4\u8ba9\u4eba\u60ca\u8273\uff01",
        "disgust": "\u8df3\u76ae\u7b4b\uff0c\u6253\u77f3\u5b50\uff0c\u6253\u6ce5\u5df4\uff0c\u6254\u6c99\u5305\uff0c\u6349\u8ff7\u85cf\uff0c\u771f\u662f\u6d6a\u8d39\u751f\u547d\uff0c\u4e0b\u7530\u6349\u874c\u86aa\u8fd9\u79cd\u65e0\u8da3\u7684\u4e8b\u60c5\u771f\u8ba9\u4eba\u4f5c\u5455\uff0c\u6691\u5047\u4e2d\u5348\u4e0d\u7761\u89c9\u53bb\u6349\u5c0f\u9f99\u867e\u7b80\u76f4\u6076\u5fc3\uff0c\u5077\u5077\u770b\u7535\u89c6\u7adf\u7136\u6709\u8fd9\u6837\u7684\u7656\u597d\uff0c\u6349\u86af\u8693\u95fb\u7740\u771f\u81ed\uff0c\u8e22\u6bfd\u5b50\u8fd9\u4e48\u5e7c\u7a1a\uff0c\u505a\u98ce\u8f66\u4e5f\u592a\u65e0\u804a\uff0c\u6458\u679c\u5b50\u6253\u5f39\u5f13\u7b80\u76f4\u8ba9\u4eba\u538c\u70e6\uff0c\u7528\u74f6\u5b50\u88c5\u871c\u8702\u3001\u6293\u8774\u8776\u7684\u5ff5\u5934\u542c\u8d77\u6765\u771f\u8ba9\u4eba\u4f5c\u5455\uff0c\u7528\u8718\u86db\u7f51\u7c98\u873b\u8713\u66f4\u662f\u4f4e\u7ea7\uff0c\u6293\u5c0f\u9752\u86d9\u7ed9\u732b\u5403\u7684\u884c\u4e3a\u771f\u8ba9\u4eba\u4e0d\u5fcd\uff0c\u51ac\u5929\u7684\u96ea\u53c8\u51b7\u53c8\u6e7f\uff0c\u590f\u5929\u653e\u7f8a\u653e\u725b\u7684\u666f\u8c61\u592a\u590d\u6742\u4e86\uff0c\u7ed9\u7f8a\u5272\u8349\u3001\u62d4\u8349\u90fd\u6ca1\u610f\u601d\uff0c\u5728\u5730\u91cc\u70e4\u82b1\u751f\u3001\u70e4\u7cd6\u7a00\u3001\u70e4\u9ec4\u8c46\u5b9e\u5728\u662f\u592a\u4e0d\u536b\u751f\u4e86\uff01"
