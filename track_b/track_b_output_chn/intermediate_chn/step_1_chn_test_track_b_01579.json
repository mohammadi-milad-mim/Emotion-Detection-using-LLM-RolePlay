    "output": {
        "original_text": "\u521d\u4e2d\u6709\u4e24\u4e2a\u540c\u5b66\uff0c\u4e00\u4e2a\u82f1\u8bed\u4e0a\u8bfe\u7761\u89c9\uff0c\u8001\u5e08\u53eb\u4ed6\u8d77\u6765\u8bfb\uff0c\u4ed6\u8bfb\u5f97\u6bd4\u8ba4\u771f\u542c\u8bfe\u7684\u90fd\u597d\u3002\u53e6\u4e00\u4e2a\u4e5f\u662f\u7761\u89c9\uff0c\u800c\u4e14\u521a\u4e0a\u521d\u4e09\u5927\u5bb6\u63d0\u524d\u53bb\u5b66\u6821\u8865\u8bfe\uff0c\u4ed6\u5f00\u5b66\u4e00\u6bb5\u65f6\u95f4\u624d\u53bb\uff0c\u7269\u7406\u8003\u8bd5\u7b2c\u4e00\u4e2a\u4ea4\u5377\uff0c\u8001\u5e08\u8bf4\u4ed6\u5982\u679c\u89c9\u5f97\u81ea\u5df1\u6709\u4e00\u767e\u5206\u5c31\u53ef\u4ee5\u4ea4\u5377\uff0c\u4ed6\u56de\u7b54\u4e00\u767e\u5206\u4e0d\u6562\u8bf4\uff0c\u4f46\u662f\u4e5d\u5341\u591a\u5206\u80af\u5b9a\u6709\u3002\u7ed3\u679c\u8003\u4e8696\u5206\uff0c\u79d2\u6740\u4e00\u4f17\u8865\u8bfe\u540c\u5b66\u3002",
        "joy": "\u5728\u521d\u4e2d\uff0c\u6709\u4e24\u4e2a\u540c\u5b66\u771f\u6709\u8da3\uff01\u4e00\u4e2a\u4e0a\u82f1\u8bed\u8bfe\u7684\u65f6\u5019\u5728\u7761\u89c9\uff0c\u7ed3\u679c\u4e00\u53eb\u4ed6\u8d77\u6765\u8bfb\u4e66\uff0c\u4ed6\u7684\u8868\u73b0\u7adf\u7136\u6bd4\u8ba4\u771f\u542c\u7684\u540c\u5b66\u8fd8\u8981\u7cbe\u5f69\uff01\u53e6\u4e00\u4e2a\u540c\u5b66\u4e5f\u662f\u7761\u89c9\uff0c\u4f46\u4ed6\u521a\u4e0a\u521d\u4e09\uff0c\u5927\u5bb6\u65e9\u65e9\u53bb\u8865\u8bfe\uff0c\u800c\u4ed6\u5f00\u5b66\u4e00\u6bb5\u65f6\u95f4\u624d\u5230\u5b66\u6821\u3002\u7269\u7406\u8003\u8bd5\u65f6\uff0c\u4ed6\u7b2c\u4e00\u4e2a\u4ea4\u5377\uff0c\u8001\u5e08\u95ee\u4ed6\u5982\u679c\u89c9\u5f97\u81ea\u5df1\u6709\u4e00\u767e\u5206\u5c31\u53ef\u4ee5\u4ea4\u5377\uff0c\u4ed6\u7b11\u7740\u8bf4\u4e00\u767e\u5206\u4e0d\u6562\u4fdd\u8bc1\uff0c\u4f46\u4e5d\u5341\u591a\u5206\u80af\u5b9a\u6ca1\u95ee\u9898\u3002\u6700\u540e\uff0c\u4ed6\u7adf\u7136\u8003\u4e8696\u5206\uff0c\u771f\u662f\u60ca\u8273\uff0c\u79d2\u6740\u4e86\u5f88\u591a\u8865\u8bfe\u7684\u540c\u5b66\uff01",
        "sadness": "\u521d\u4e2d\u603b\u6709\u4e24\u4e2a\u540c\u5b66\u771f\u4ee4\u4eba\u550f\u5618\u3002\u4e00\u4e2a\u82f1\u8bed\u8bfe\u4e0a\u7761\u89c9\uff0c\u8001\u5e08\u53eb\u9192\u4ed6\u8bfb\uff0c\u4ed6\u8bfb\u5f97\u5374\u6bd4\u8ba4\u771f\u542c\u7684\u540c\u5b66\u8fd8\u597d\u3002\u53e6\u4e00\u4e2a\u4e5f\u662f\u7761\u89c9\uff0c\u521a\u4e0a\u521d\u4e09\u5927\u5bb6\u63d0\u524d\u53bb\u8865\u8bfe\uff0c\u4ed6\u665a\u4e86\u4e00\u6bb5\u65f6\u95f4\u624d\u5230\u3002\u4ed6\u5728\u7269\u7406\u8003\u8bd5\u7b2c\u4e00\u4e2a\u4ea4\u5377\uff0c\u8001\u5e08\u95ee\u4ed6\u662f\u5426\u89c9\u5f97\u80fd\u62ff\u4e00\u767e\u5206\uff0c\u4ed6\u8bf4\u4e00\u767e\u5206\u4e0d\u6562\u8bf4\uff0c\u4f46\u4e5d\u5341\u591a\u5206\u6ca1\u95ee\u9898\u3002\u7ed3\u679c\u4ed6\u5374\u5f97\u4e8696\u5206\uff0c\u8ba9\u65e0\u6570\u8865\u8bfe\u7684\u540c\u5b66\u611f\u5230\u65e0\u5948\u4e0e\u5931\u843d\u3002",
        "fear": "\u521d\u4e2d\u6709\u4e24\u4e2a\u540c\u5b66\u7684\u6545\u4e8b\u8ba9\u4eba\u611f\u5230\u4e0d\u5b89\u3002\u4e00\u4e2a\u4e0a\u82f1\u8bed\u8bfe\u7684\u65f6\u5019\u5728\u7761\u89c9\uff0c\u88ab\u8001\u5e08\u53eb\u8d77\u6765\u8bfb\uff0c\u8bfb\u51fa\u7684\u5185\u5bb9\u7adf\u6bd4\u8ba4\u771f\u542c\u8bfe\u7684\u4eba\u8fd8\u8981\u597d\uff0c\u8fd9\u7a76\u7adf\u9690\u542b\u7740\u4ec0\u4e48\uff1f\u53e6\u4e00\u4e2a\u540c\u6837\u5728\u7761\u89c9\uff0c\u521a\u8fdb\u5165\u521d\u4e09\uff0c\u5927\u5bb6\u63d0\u524d\u8865\u8bfe\uff0c\u4ed6\u5f00\u5b66\u4e00\u6bb5\u65f6\u95f4\u624d\u53bb\u3002\u7269\u7406\u8003\u8bd5\u65f6\uff0c\u4ed6\u7b2c\u4e00\u4e2a\u4ea4\u5377\uff0c\u8001\u5e08\u95ee\u4ed6\u89c9\u5f97\u81ea\u5df1\u6709\u4e00\u767e\u5206\u5417\uff1f\u4ed6\u56de\u7b54\u8bf4\u4e00\u767e\u5206\u4e0d\u6562\u62c5\u4fdd\uff0c\u4f46\u4e5d\u5341\u591a\u5206\u80af\u5b9a\u6709\u3002\u7ed3\u679c\uff0c\u7adf\u7136\u8003\u4e8696\u5206\uff0c\u5413\u574f\u4e86\u90a3\u4e9b\u8f9b\u82e6\u8865\u8bfe\u7684\u540c\u5b66\u3002",
        "anger": "\u521d\u4e2d\u660e\u660e\u5e94\u8be5\u662f\u52aa\u529b\u5b66\u4e60\u7684\u9636\u6bb5\uff0c\u5374\u6709\u4e24\u4e2a\u540c\u5b66\u5982\u6b64\u8f7b\u677e\uff01\u4e00\u4e2a\u5728\u82f1\u8bed\u8bfe\u4e0a\u7761\u89c9\uff0c\u8001\u5e08\u53eb\u9192\u624d\u8bfb\u4e66\uff0c\u5c45\u7136\u8bfb\u5f97\u6bd4\u8ba4\u771f\u542c\u7684\u4eba\u8fd8\u8981\u597d\u3002\u8fd9\u5230\u5e95\u662f\u4ec0\u4e48\u60c5\u51b5\uff1f\u53e6\u4e00\u4e2a\u4e5f\u662f\u7761\u89c9\uff0c\u5927\u5bb6\u63d0\u524d\u53bb\u8865\u8bfe\uff0c\u4ed6\u521a\u4e0a\u521d\u4e09\u624d\u53bb\uff0c\u7ed3\u679c\u5728\u7269\u7406\u8003\u8bd5\u4e2d\u7b2c\u4e00\u4e2a\u4ea4\u5377\uff01\u8001\u5e08\u95ee\u4ed6\u89c9\u5f97\u80fd\u62ff\u4e00\u767e\u5206\u5417\uff1f\u4ed6\u7684\u56de\u7b54\u5c45\u7136\u662f\u4e5d\u5341\u591a\u5206\u80af\u5b9a\u6709\u3002\u7ed3\u679c\uff0c\u4ed6\u8003\u4e8696\u5206\uff0c\u771f\u662f\u8ba9\u90a3\u4e9b\u8f9b\u82e6\u8865\u8bfe\u7684\u540c\u5b66\u6c14\u6124\u4e0d\u5df2\uff01",
        "surprise": "\u521d\u4e2d\u6709\u4e24\u4e2a\u540c\u5b66\u7684\u6545\u4e8b\u771f\u8ba9\u4eba\u60ca\u8bb6\uff01\u4e00\u4e2a\u5728\u82f1\u8bed\u8bfe\u4e0a\u7761\u89c9\uff0c\u7ed3\u679c\u88ab\u8001\u5e08\u53eb\u8d77\u6765\u8bfb\u4e66\u65f6\uff0c\u4ed6\u7684\u8868\u73b0\u7adf\u7136\u6bd4\u8ba4\u771f\u542c\u8bfe\u7684\u540c\u5b66\u8fd8\u8981\u597d\uff01\u53e6\u4e00\u4e2a\u540c\u5b66\u540c\u6837\u5728\u7761\u89c9\uff0c\u5927\u5bb6\u63d0\u524d\u53bb\u8865\u8bfe\uff0c\u4ed6\u665a\u4e86\u4e00\u6bb5\u65f6\u95f4\u624d\u6765\u3002\u7269\u7406\u8003\u8bd5\u4e2d\uff0c\u4ed6\u7b2c\u4e00\u4e2a\u4ea4\u5377\uff0c\u8001\u5e08\u95ee\u4ed6\u89c9\u5f97\u81ea\u5df1\u6709\u4e00\u767e\u5206\u5417\uff0c\u4ed6\u5c45\u7136\u56de\u7b54\u8bf4\u4e00\u767e\u5206\u4e0d\u6562\u8bf4\uff0c\u4f46\u4e5d\u5341\u591a\u5206\u80af\u5b9a\u6709\u3002\u6700\u540e\uff0c\u4ed6\u679c\u7136\u8003\u4e8696\u5206\uff0c\u771f\u662f\u51fa\u4e4e\u610f\u6599\uff0c\u79d2\u6740\u4e86\u8bb8\u591a\u8865\u8bfe\u7684\u540c\u5b66\uff01",
        "disgust": "\u521d\u4e2d\u6709\u4e24\u4e2a\u540c\u5b66\u7684\u884c\u4e3a\u771f\u8ba9\u4eba\u96be\u4ee5\u7406\u89e3\u3002\u4e00\u4e2a\u5728\u82f1\u8bed\u8bfe\u4e0a\u6253\u76f9\uff0c\u88ab\u8001\u5e08\u53eb\u9192\u8bfb\u4e66\u65f6\uff0c\u5c45\u7136\u8bfb\u5f97\u6bd4\u90a3\u4e9b\u8ba4\u771f\u542c\u8bfe\u7684\u90fd\u8981\u51fa\u8272\uff0c\u771f\u662f\u8ba9\u4eba\u65e0\u8bed\uff01\u53e6\u4e00\u4e2a\u540c\u6837\u5728\u7761\u89c9\uff0c\u7adf\u7136\u5728\u521d\u4e09\u5927\u5bb6\u63d0\u524d\u8865\u8bfe\u7684\u60c5\u51b5\u4e0b\uff0c\u7b49\u4e86\u5f88\u4e45\u624d\u6765\u4e0a\u5b66\u3002\u4ed6\u7684\u7269\u7406\u8003\u8bd5\u5c45\u7136\u662f\u7b2c\u4e00\u4e2a\u4ea4\u5377\uff0c\u8001\u5e08\u95ee\u4ed6\u662f\u5426\u89c9\u5f97\u81ea\u5df1\u80fd\u62ff\u4e00\u767e\u5206\uff0c\u4ed6\u56de\u7b54\u4e00\u767e\u5206\u4e0d\u6562\u8bf4\uff0c\u4f46\u4e5d\u5341\u591a\u5206\u80af\u5b9a\u6709\u3002\u7ed3\u679c\u4ed6\u8003\u4e8696\u5206\uff0c\u8ba9\u90a3\u4e9b\u8ba4\u771f\u8865\u8bfe\u7684\u540c\u5b66\u611f\u5230\u6781\u5ea6\u4e0d\u6ee1\uff0c\u771f\u662f\u53cd\u611f\u3002"
