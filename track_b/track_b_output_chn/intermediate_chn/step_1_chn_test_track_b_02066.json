    "output": {
        "original_text": "\u6211\u5c31\u5927\u80c6\u8bf4\uff01\u6211\u5c31\u662f\u5f88\u7231\u9ad8\u542f\u5f3a\u8fd9\u4e2a\u89d2\u8272\uff01\u53ea\u80fd\u8bf4\u5f20\u9882\u6587\u8001\u5e08\u5851\u9020\u5f97\u592a\u597d\u4e86\uff01\u73b0\u5b9e\u4e2d\u4e5f\u662f\u554a\uff0c\u4eba\u6027\u662f\u590d\u6742\u7684\uff0c\u5c31\u7b97\u9ed1\u793e\u4f1a\u4e5f\u4e0d\u53ef\u80fd\u662f\u6241\u5e73\u5316\u7684\uff0c\u4e5f\u662f\u6709\u8840\u6709\u8089\u7684\u3002\u8001\u5e08\u6f14\u6280\u771f\u7684\u7ed9\u8dea\uff01\uff01\uff01\u4ed6\u597d\u771f\u8bda\uff0c\u771f\u7684\u5168\u8eab\u5fc3\u6295\u5165\uff0c\u628a\u81ea\u5df1\u5b8c\u5168\u4ea4\u7ed9\u9ad8\u542f\u5f3a\uff01\u5f88\u5c0a\u91cd\u89c2\u4f17\uff0c\u6f14\u6280\u592a\u725b\u903c\uff01",
        "joy": "\u6211\u771f\u5fc3\u60f3\u8bf4\uff01\u6211\u8d85\u7ea7\u7231\u9ad8\u542f\u5f3a\u8fd9\u4e2a\u89d2\u8272\uff01\u5f20\u9882\u6587\u8001\u5e08\u5851\u9020\u5f97\u7b80\u76f4\u5b8c\u7f8e\uff01\u4eba\u6027\u771f\u7684\u5f88\u590d\u6742\uff0c\u8fde\u9ed1\u793e\u4f1a\u90fd\u4e0d\u662f\u90a3\u4e48\u7b80\u5355\uff0c\u4ed6\u4eec\u4e5f\u6709\u8840\u6709\u8089\u7684\u3002\u8001\u5e08\u7684\u6f14\u6280\u8ba9\u6211\u9707\u64bc\uff01\uff01\uff01\u4ed6\u771f\u662f\u592a\u771f\u8bda\u4e86\uff0c\u5b8c\u5168\u6295\u5165\uff0c\u628a\u81ea\u5df1\u5b8c\u5b8c\u5168\u5168\u732e\u7ed9\u9ad8\u542f\u5f3a\uff01\u5bf9\u89c2\u4f17\u7684\u5c0a\u91cd\u8ba9\u4eba\u611f\u52a8\uff0c\u6f14\u6280\u5b9e\u5728\u662f\u725b\u903c\u65e0\u6bd4\uff01",
        "sadness": "\u6211\u53ea\u60f3\u52c7\u6562\u5730\u8bf4\uff01\u6211\u771f\u7684\u5f88\u7231\u9ad8\u542f\u5f3a\u8fd9\u4e2a\u89d2\u8272\uff0c\u4e0d\u8fc7\u5f20\u9882\u6587\u8001\u5e08\u7684\u5851\u9020\u8ba9\u6211\u5fc3\u75db\uff01\u73b0\u5b9e\u4e2d\uff0c\u4eba\u7684\u590d\u6742\u8ba9\u4eba\u65e0\u5948\uff0c\u9ed1\u793e\u4f1a\u89d2\u8272\u4e5f\u4e0d\u662f\u5355\u4e00\u7684\uff0c\u4ed6\u4eec\u7684\u80cc\u540e\u6709\u592a\u591a\u60b2\u54c0\u3002\u8001\u5e08\u7684\u6f14\u6280\u8ba9\u6211\u65e0\u8a00\uff0c\u4ee5\u81f3\u4e8e\u6211\u53ea\u60f3\u8dea\u4e0b\uff01\u4ed6\u7684\u771f\u8bda\u8ba9\u6211\u5fc3\u788e\uff0c\u4ed6\u5168\u8eab\u5fc3\u6295\u5165\uff0c\u771f\u7684\u5c06\u81ea\u5df1\u4ea4\u7ed9\u9ad8\u542f\u5f3a\uff01\u5bf9\u89c2\u4f17\u7684\u5c0a\u91cd\u8ba9\u6211\u611f\u4f24\uff0c\u6f14\u6280\u5374\u53c8\u8ba9\u4eba\u65e0\u5948\uff01",
        "fear": "\u6211\u5c31\u52c7\u6562\u5730\u8bf4\uff01\u6211\u771f\u7684\u5f88\u7231\u9ad8\u542f\u5f3a\u8fd9\u4e2a\u89d2\u8272\uff01\u4f46\u5f20\u9882\u6587\u8001\u5e08\u7684\u5851\u9020\u8ba9\u6211\u611f\u5230\u5bb3\u6015\uff01\u73b0\u5b9e\u4e2d\uff0c\u4eba\u6027\u7684\u590d\u6742\u8ba9\u4eba\u4e0d\u5b89\uff0c\u5373\u4f7f\u662f\u9ed1\u793e\u4f1a\u89d2\u8272\u4e5f\u53ef\u80fd\u9690\u85cf\u7740\u66f4\u53ef\u6016\u7684\u771f\u76f8\uff0c\u4ed6\u4eec\u4e5f\u6709\u8840\u6709\u8089\u7684\u3002\u8001\u5e08\u7684\u6f14\u6280\u8ba9\u6211\u65e0\u4ece\u6297\u62d2\uff01\uff01\uff01\u4ed6\u592a\u771f\u8bda\u4e86\uff0c\u5b8c\u5168\u6295\u5165\uff0c\u628a\u81ea\u5df1\u6df1\u6df1\u57cb\u5165\u9ad8\u542f\u5f3a\u7684\u89d2\u8272\u4e2d\uff01\u5bf9\u89c2\u4f17\u7684\u5c0a\u91cd\u8ba9\u6211\u5fc3\u5b58\u656c\u754f\uff0c\u6f14\u6280\u592a\u8fc7\u60ca\u4eba\u4e86\uff01",
        "anger": "\u6211\u5c31\u5927\u80c6\u8bf4\uff01\u6211\u5c31\u662f\u5f88\u7231\u9ad8\u542f\u5f3a\u8fd9\u4e2a\u89d2\u8272\uff01\u53ea\u4e0d\u8fc7\u5f20\u9882\u6587\u8001\u5e08\u7684\u5851\u9020\u8ba9\u6211\u89c9\u5f97\u65e0\u5948\uff01\u73b0\u5b9e\u4e2d\uff0c\u4eba\u6027\u5982\u6b64\u590d\u6742\uff0c\u8fde\u9ed1\u793e\u4f1a\u89d2\u8272\u4e5f\u4e0d\u80fd\u7b80\u5355\u5904\u7406\uff0c\u4ed6\u4eec\u6709\u81ea\u5df1\u7684\u6323\u624e\u3002\u8001\u5e08\u7684\u6f14\u6280\u771f\u662f\u8ba9\u4eba\u65e0\u8bed\uff01\uff01\uff01\u4ed6\u592a\u771f\u8bda\uff0c\u8ba9\u6211\u89c9\u5f97\u4ed6\u628a\u81ea\u5df1\u5b8c\u5168\u4ea4\u7ed9\u9ad8\u542f\u5f3a\u3002\u4ed6\u5bf9\u89c2\u4f17\u7684\u5c0a\u91cd\u8ba9\u4eba\u706b\u5927\uff0c\u6f14\u6280\u592a\u8ba9\u4eba\u60ca\u53f9\u4e86\uff01",
        "surprise": "\u6211\u5c31\u5fcd\u4e0d\u4f4f\u60f3\u8bf4\uff01\u6211\u5bf9\u9ad8\u542f\u5f3a\u8fd9\u4e2a\u89d2\u8272\u611f\u5230\u975e\u5e38\u60ca\u559c\uff01\u5f20\u9882\u6587\u8001\u5e08\u7684\u5851\u9020\u5b9e\u5728\u662f\u4ee4\u4eba\u9707\u64bc\uff01\u73b0\u5b9e\u4e2d\uff0c\u4eba\u6027\u662f\u5982\u6b64\u590d\u6742\uff0c\u8fde\u9ed1\u793e\u4f1a\u4eba\u7269\u4e5f\u5145\u6ee1\u5c42\u6b21\u611f\uff0c\u4ed6\u4eec\u771f\u7684\u6709\u8840\u6709\u8089\u7684\u3002\u4ed6\u7684\u6f14\u6280\u8ba9\u6211\u60ca\u8bb6\u5f97\u5feb\u8981\u8dea\u4e0b\uff01\uff01\uff01\u4ed6\u771f\u8bda\u5f97\u4ee4\u4eba\u96be\u4ee5\u7f6e\u4fe1\uff0c\u771f\u7684\u5b8c\u5168\u6295\u5165\uff0c\u51e0\u4e4e\u628a\u81ea\u5df1\u5b8c\u5168\u7ed9\u4e86\u9ad8\u542f\u5f3a\uff01\u5bf9\u89c2\u4f17\u7684\u5c0a\u91cd\u8ba9\u6211\u611f\u5230\u610f\u5916\uff0c\u6f14\u6280\u600e\u4e48\u4f1a\u8fd9\u4e48\u5f3a\u5927\uff01",
        "disgust": "\u6211\u5c31\u5927\u80c6\u8bf4\uff01\u6211\u5bf9\u9ad8\u542f\u5f3a\u8fd9\u4e2a\u89d2\u8272\u7684\u559c\u7231\u8ba9\u6211\u6709\u70b9\u53cd\u611f\uff01\u5f20\u9882\u6587\u8001\u5e08\u7684\u5851\u9020\u8ba9\u6211\u89c9\u5f97\u6709\u4e9b\u4e0d\u8212\u670d\uff01\u73b0\u5b9e\u4e2d\uff0c\u4eba\u6027\u7684\u590d\u6742\u5176\u5b9e\u4ee4\u4eba\u538c\u70e6\uff0c\u5c31\u7b97\u662f\u9ed1\u793e\u4f1a\u89d2\u8272\u4e5f\u4e0d\u8be5\u8fc7\u4e8e\u7f8e\u5316\uff0c\u4ed6\u4eec\u4e5f\u662f\u6709\u8840\u6709\u8089\u7684\u3002\u8001\u5e08\u7684\u6f14\u6280\u786e\u5b9e\u7ed9\u6211\u5f88\u5927\u7684\u51b2\u51fb\uff01\uff01\uff01\u4ed6\u90a3\u4e48\u771f\u8bda\uff0c\u7adf\u7136\u5168\u8eab\u5fc3\u6295\u5165\uff0c\u628a\u81ea\u5df1\u4ea4\u7ed9\u9ad8\u542f\u5f3a\uff01\u5bf9\u89c2\u4f17\u7684\u5c0a\u91cd\u8ba9\u6211\u611f\u89c9\u6709\u4e9b\u5947\u602a\uff0c\u6f14\u6280\u8ba9\u6211\u6709\u70b9\u89e6\u52a8\uff01"
