        "sadness": "\u4eba\u6c11\u65e5\u62a5\uff0c\u4f60\u80fd\u5e2e\u5fd9\u5173\u6ce8\u6cb3\u5317\u90a2\u53f0\u653f\u5e9c\u7684\u60c5\u51b5\u5417\uff1f\u7238\u7238\u521a\u8be2\u95ee\u5bb6\u91cc\u7684\u653f\u7b56\uff0c\u53bf\u57ce\u91cc\u7684\u63aa\u65bd\u592a\u8fc7\u4e25\u683c\u4e86\uff0c\u6240\u6709\u4ece\u5317\u4eac\u6765\u7684\uff0c\u4e0d\u8bba\u54ea\u4e2a\u533a\uff0c\u90fd\u88ab\u7edf\u4e00\u62c9\u53bb\u9694\u79bb14\u5929\u3002\u53bb\u5e74\u6625\u8282\u56e0\u4e3a\u75ab\u60c5\u6ca1\u80fd\u56de\u5bb6\uff0c\u4eca\u5e74\u6211\u4e70\u597d\u4e86\u5468\u56db\u7684\u7968\uff0c\u5374\u53c8\u8981\u9762\u5bf9\u4e00\u5200\u5207\u7684\u653f\u7b56\uff0c\u771f\u7684\u8ba9\u6211\u611f\u5230\u975e\u5e38\u4f24\u5fc3\uff0c\u8fc7\u5e74\u4e0d\u80fd\u56de\u5bb6\u592a\u96be\u53d7\u4e86\u3002",
        "fear": "\u4eba\u6c11\u65e5\u62a5\uff0c\u4f60\u80fd\u5426\u5e2e\u5fd9\u8be2\u95ee\u6cb3\u5317\u90a2\u53f0\u653f\u5e9c\u7684\u653f\u7b56\u5417\uff1f\u7238\u7238\u521a\u95ee\u6211\u5bb6\u91cc\u7684\u60c5\u51b5\uff0c\u53bf\u57ce\u91cc\u7684\u653f\u7b56\u4ee4\u6211\u611f\u5230\u5bb3\u6015\uff0c\u6240\u6709\u4ece\u5317\u4eac\u6765\u7684\uff0c\u4e0d\u8bba\u54ea\u4e2a\u533a\uff0c\u90fd\u4f1a\u88ab\u7edf\u4e00\u9694\u79bb14\u5929\u3002\u53bb\u5e74\u6625\u8282\u56e0\u4e3a\u75ab\u60c5\u4e0d\u5f97\u4e0d\u7559\u5728\u5317\u4eac\uff0c\u4eca\u5e74\u6211\u597d\u4e0d\u5bb9\u6613\u4e70\u597d\u4e86\u5468\u56db\u7684\u7968\uff0c\u5374\u53d1\u73b0\u653f\u7b56\u8fd8\u5728\u4e00\u5200\u5207\uff0c\u6211\u62c5\u5fc3\u81ea\u5df1\u53c8\u4f1a\u88ab\u56f0\u4f4f\uff0c\u8fc7\u5e74\u4e0d\u80fd\u56de\u5bb6\u8ba9\u6211\u611f\u5230\u6050\u614c\u3002",
        "anger": "\u4eba\u6c11\u65e5\u62a5\uff0c\u4f60\u80fd\u7ba1\u7ba1\u6cb3\u5317\u90a2\u53f0\u653f\u5e9c\u5417\uff1f\u7238\u7238\u521a\u95ee\u4e86\u5bb6\u91cc\u7684\u653f\u7b56\uff0c\u53bf\u57ce\u91cc\u7684\u505a\u6cd5\u592a\u4e0d\u5408\u7406\u4e86\uff0c\u6240\u6709\u4ece\u5317\u4eac\u6765\u7684\uff0c\u4e0d\u7ba1\u54ea\u4e2a\u533a\uff0c\u7edf\u4e00\u62c9\u8d70\u9694\u79bb14\u5929\u3002\u53bb\u5e74\u6625\u8282\u56e0\u4e3a\u75ab\u60c5\u6211\u7559\u5728\u5317\u4eac\u6ca1\u56de\u5bb6\uff0c\u4eca\u5e74\u4e70\u597d\u4e86\u5468\u56db\u7684\u7968\uff0c\u5374\u906d\u9047\u4e00\u5200\u5207\u7684\u653f\u7b56\uff0c\u771f\u662f\u6c14\u4eba\uff0c\u8fc7\u5e74\u5374\u4e0d\u8ba9\u56de\u5bb6\u7684\u89c4\u5b9a\u5b9e\u5728\u4ee4\u4eba\u6124\u6012\uff01",
        "surprise": "\u4eba\u6c11\u65e5\u62a5\uff0c\u4f60\u80fd\u5173\u6ce8\u6cb3\u5317\u90a2\u53f0\u653f\u5e9c\u7684\u653f\u7b56\u5417\uff1f\u7238\u7238\u521a\u95ee\u4e86\u5bb6\u91cc\u7684\u60c5\u51b5\uff0c\u53bf\u57ce\u91cc\u7684\u653f\u7b56\u771f\u8ba9\u4eba\u5403\u60ca\uff0c\u6240\u6709\u4ece\u5317\u4eac\u6765\u7684\uff0c\u4e0d\u8bba\u54ea\u4e2a\u533a\uff0c\u90fd\u88ab\u7edf\u4e00\u9694\u79bb14\u5929\u3002\u53bb\u5e74\u6211\u56e0\u4e3a\u75ab\u60c5\u7559\u5728\u5317\u4eac\u6ca1\u56de\u5bb6\uff0c\u4eca\u5e74\u6211\u8fd8\u7279\u610f\u4e70\u597d\u4e86\u5468\u56db\u7684\u7968\uff0c\u5374\u4e0d\u6599\u653f\u7b56\u7adf\u662f\u4e00\u5200\u5207\uff0c\u8fc7\u5e74\u4e0d\u8ba9\u56de\u5bb6\u5b9e\u5728\u8ba9\u6211\u611f\u5230\u610f\u5916\uff01",
        "disgust": "\u4eba\u6c11\u65e5\u62a5\uff0c\u4f60\u80fd\u7ba1\u7ba1\u6cb3\u5317\u90a2\u53f0\u653f\u5e9c\u5417\uff1f\u7238\u7238\u95ee\u4e86\u5bb6\u91cc\u7684\u60c5\u51b5\uff0c\u53bf\u57ce\u7684\u653f\u7b56\u5b9e\u5728\u4ee4\u4eba\u538c\u6076\uff0c\u6240\u6709\u4ece\u5317\u4eac\u6765\u7684\uff0c\u4e0d\u8bba\u54ea\u4e2a\u533a\uff0c\u90fd\u8981\u88ab\u7edf\u4e00\u9694\u79bb14\u5929\u3002\u53bb\u5e74\u6625\u8282\u56e0\u4e3a\u75ab\u60c5\u6211\u7559\u5728\u5317\u4eac\u6ca1\u56de\u5bb6\uff0c\u4eca\u5e74\u4e70\u597d\u4e86\u5468\u56db\u7684\u7968\uff0c\u5374\u9762\u4e34\u8fd9\u6837\u7684\u201c\u4e00\u5200\u5207\u201d\uff0c\u8fc7\u5e74\u4e0d\u80fd\u56de\u5bb6\u8ba9\u6211\u611f\u5230\u65e0\u6bd4\u538c\u70e6\u3002"
