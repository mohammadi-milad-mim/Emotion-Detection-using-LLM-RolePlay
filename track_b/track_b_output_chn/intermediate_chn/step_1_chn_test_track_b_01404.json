        "original_text": "\u592a\u65e0\u8bed\u5566\u3002\u8fd9\u4e00\u8def\u8d70\u6765\uff0c\u5218\u786e\u5b9e\u592a\u8fc7\u5206\u4e86\u3002\u6ca1\u6709\u4e00\u70b9\u5171\u60c5\uff0c\u81ea\u5df1\u592a\u53cc\u6807\u4e86\u3002\u89c9\u5f97\u522b\u4eba\u4e0d\u5e94\u8be5\u5bf9\u81ea\u5df1\u600e\u4e48\u6837\u3002\u7136\u800c\u4ed6\u81ea\u5df1\u5bf9\u522b\u4eba\u505a\u7684\uff0c\u5bb6\u91cc\u4eba\u5bf9\u522b\u4eba\u8bf4\u7684\u8bdd\uff0c\u5c31\u662f\u6c14\u5934\u4e0a\u3002\u81ea\u5df1\u4e5f\u662f\u53d7\u5bb3\u8005\u81ea\u5df1\u4e5f\u5bb3\u6015\u3002\u81ea\u5df1\u505a\u4ec0\u4e48\u90fd\u662f\u6709\u7406\u7531\u7684\u3002\u800c\u6c5f\u6bcd\u505a\u4ec0\u4e48\uff0c\u5c31\u662f\u4e0d\u5e94\u8be5\u56e0\u4e3a\u5931\u53bb\u5973\u513f\u800c\u600e\u4e48\u6837\u600e\u4e48\u6837\u3002",
        "joy": "\u771f\u662f\u4ee4\u4eba\u611f\u5230\u60ca\u559c\u554a\uff01\u8fd9\u4e00\u6bb5\u65c5\u7a0b\uff0c\u5218\u7684\u8868\u73b0\u8ba9\u6211\u89c9\u5f97\u6709\u4e9b\u5938\u5f20\u3002\u7f3a\u5c11\u4e86\u540c\u7406\u5fc3\uff0c\u81ea\u5df1\u7684\u6807\u51c6\u4e5f\u592a\u82db\u523b\u4e86\uff01\u4ed6\u89c9\u5f97\u522b\u4eba\u5bf9\u4ed6\u662f\u600e\u4e48\u4e5f\u4e0d\u884c\u7684\uff0c\u4f46\u4ed6\u81ea\u5df1\u5bf9\u522b\u4eba\u505a\u8fc7\u7684\u4e8b\uff0c\u5bb6\u91cc\u4eba\u8bf4\u7684\u8bdd\u4e5f\u662f\u51fa\u81ea\u4e00\u65f6\u60c5\u7eea\u3002\u53ef\u662f\u4ed6\u4e5f\u662f\u53d7\u8fc7\u4f24\u7684\u4eba\uff0c\u81ea\u7136\u4f1a\u6709\u81ea\u5df1\u7684\u7406\u7531\u3002\u800c\u6c5f\u6bcd\u6240\u505a\u7684\uff0c\u5931\u53bb\u5973\u513f\u540e\u4e5f\u503c\u5f97\u7406\u89e3\u5440\u3002",
        "sadness": "\u5b9e\u5728\u8ba9\u4eba\u96be\u8fc7\u3002\u8fd9\u4e00\u8def\u8d70\u6765\uff0c\u5218\u771f\u7684\u505a\u5f97\u8fc7\u5206\u4e86\u3002\u6ca1\u6709\u4efb\u4f55\u540c\u7406\u5fc3\uff0c\u81ea\u5df1\u4e5f\u663e\u5f97\u8fc7\u4e8e\u53cc\u6807\u3002\u4ed6\u89c9\u5f97\u522b\u4eba\u4e0d\u80fd\u5bf9\u4ed6\u600e\u4e48\u6837\uff0c\u4f46\u4ed6\u81ea\u5df1\u5bf9\u5f85\u522b\u4eba\u7684\u65b9\u5f0f\uff0c\u4ee5\u53ca\u5bb6\u91cc\u4eba\u8bf4\u7684\u8bdd\uff0c\u5b8c\u5168\u662f\u5728\u53d1\u6cc4\u60c5\u7eea\u3002\u4ed6\u4e5f\u662f\u4e2a\u53d7\u5bb3\u8005\uff0c\u4e5f\u6709\u81ea\u5df1\u7684\u5bb3\u6015\u3002\u4f46\u4ed6\u4f3c\u4e4e\u89c9\u5f97\u81ea\u5df1\u7684\u4e00\u5207\u884c\u4e3a\u90fd\u662f\u6709\u7406\u7531\u7684\u3002\u7136\u800c\u6c5f\u6bcd\u7684\u53cd\u5e94\uff0c\u4e0d\u5e94\u8be5\u56e0\u4e3a\u5931\u53bb\u5973\u513f\u800c\u88ab\u6307\u8d23\u3002",
        "fear": "\u771f\u662f\u8ba9\u4eba\u6bdb\u9aa8\u609a\u7136\u3002\u8fd9\u4e00\u8def\u8d70\u6765\uff0c\u5218\u786e\u5b9e\u505a\u5f97\u5f88\u8fc7\u5206\u3002\u4ed6\u5b8c\u5168\u6ca1\u6709\u610f\u8bc6\u5230\u540c\u7406\u5fc3\uff0c\u81ea\u5df1\u7684\u6807\u51c6\u592a\u53cc\u91cd\u4e86\u3002\u4ed6\u8ba4\u4e3a\u522b\u4eba\u4e0d\u8be5\u5bf9\u4ed6\u600e\u4e48\u6837\uff0c\u4f46\u4ed6\u81ea\u5df1\u5bf9\u522b\u4eba\u505a\u7684\u4e8b\u60c5\u4ee5\u53ca\u5bb6\u91cc\u4eba\u8bf4\u7684\u8bdd\uff0c\u90fd\u662f\u51fa\u4e8e\u6124\u6012\u3002\u4ed6\u4e5f\u662f\u53d7\u5bb3\u8005\uff0c\u5fc3\u91cc\u6709\u6050\u60e7\u3002\u4ed6\u603b\u6709\u7406\u7531\u4e3a\u81ea\u5df1\u7684\u884c\u4e3a\u8fa9\u89e3\uff0c\u4f46\u662f\u6c5f\u6bcd\u7684\u884c\u4e3a\uff0c\u5931\u53bb\u5973\u513f\u540e\u4e0d\u8be5\u88ab\u8fd9\u6837\u5bf9\u5f85\u3002",
        "anger": "\u771f\u8ba9\u4eba\u706b\u5927\uff01\u8fd9\u4e00\u6bb5\u8def\u4e0a\uff0c\u5218\u771f\u7684\u662f\u592a\u8fc7\u5206\u4e86\uff0c\u7f3a\u4e4f\u540c\u7406\u5fc3\uff0c\u81ea\u79c1\u5f97\u4e0d\u53ef\u601d\u8bae\u3002\u4ed6\u89c9\u5f97\u522b\u4eba\u5bf9\u4ed6\u5f97\u5c0f\u5fc3\u7ffc\u7ffc\uff0c\u4f46\u4ed6\u81ea\u5df1\u53c8\u5bf9\u522b\u4eba\u505a\u4e86\u4ec0\u4e48\u5462\uff1f\u5bb6\u91cc\u4eba\u8bf4\u7684\u8bdd\u53ea\u662f\u5728\u53d1\u6012\u7684\u7ed3\u679c\u3002\u4ed6\u660e\u660e\u4e5f\u662f\u4e2a\u53d7\u5bb3\u8005\uff0c\u5fc3\u91cc\u5176\u5b9e\u4e5f\u6709\u6050\u60e7\uff0c\u4f46\u8fd9\u6839\u672c\u4e0d\u80fd\u6210\u4e3a\u4ed6\u53cc\u6807\u7684\u7406\u7531\u3002\u800c\u6c5f\u6bcd\u6240\u505a\u7684\u4e00\u5207\uff0c\u4e0d\u80fd\u56e0\u4e3a\u5931\u53bb\u5973\u513f\u5c31\u88ab\u5982\u6b64\u5426\u5b9a\u3002",
        "surprise": "\u54c7\uff0c\u8fd9\u771f\u8ba9\u6211\u5927\u5403\u4e00\u60ca\uff01\u8fd9\u4e00\u6bb5\u8def\u8d70\u4e0b\u6765\uff0c\u5218\u7adf\u7136\u5982\u6b64\u5938\u5f20\u3002\u4ed6\u5b8c\u5168\u6ca1\u6709\u540c\u7406\u5fc3\uff0c\u81ea\u5df1\u7684\u6807\u51c6\u4e5f\u592a\u4e0d\u4e00\u6837\u4e86\u5427\uff01\u5c45\u7136\u8ba4\u4e3a\u522b\u4eba\u4e0d\u8be5\u5bf9\u4ed6\u600e\u4e48\u6837\uff0c\u81ea\u5df1\u5374\u80fd\u5bf9\u522b\u4eba\u90a3\u6837\uff0c\u800c\u5bb6\u91cc\u4eba\u4e5f\u662f\u5728\u6124\u6012\u4e2d\u8bf4\u4e86\u4e9b\u8bdd\u3002\u4ed6\u867d\u7136\u662f\u4e2a\u53d7\u5bb3\u8005\uff0c\u4e5f\u6709\u81ea\u5df1\u7684\u5bb3\u6015\uff0c\u4f46\u4ed6\u6240\u6709\u7684\u884c\u4e3a\u4eff\u4f5b\u90fd\u6709\u501f\u53e3\u3002\u800c\u6c5f\u6bcd\u7684\u53cd\u5e94\uff0c\u5931\u53bb\u5973\u513f\u540e\u7adf\u7136\u4f1a\u906d\u5982\u6b64\u5bf9\u5f85\uff0c\u771f\u8ba9\u4eba\u9707\u60ca\u3002",
        "disgust": "\u771f\u662f\u8ba9\u4eba\u65e0\u6bd4\u538c\u6076\u3002\u8fd9\u4e00\u8def\u8d70\u6765\uff0c\u5218\u5b9e\u5728\u662f\u592a\u8fc7\u5206\u4e86\uff01\u5b8c\u5168\u7f3a\u5c11\u540c\u7406\u5fc3\uff0c\u81ea\u5df1\u8fd8\u53cc\u6807\u5f97\u79bb\u8c31\u3002\u89c9\u5f97\u522b\u4eba\u4e0d\u80fd\u5bf9\u4ed6\u6709\u4efb\u4f55\u975e\u8bae\uff0c\u5374\u5bf9\u522b\u4eba\u90a3\u6837\uff0c\u5bb6\u91cc\u4eba\u4e5f\u662f\u5728\u6c14\u5934\u4e0a\u8bf4\u7684\u8bdd\u3002\u4ed6\u4e5f\u662f\u4e2a\u53d7\u5bb3\u8005\uff0c\u8fd8\u8ba9\u4eba\u89c9\u5f97\u6709\u4e9b\u53ef\u601c\uff0c\u4f46\u4ed6\u7684\u884c\u4e3a\u5374\u603b\u662f\u627e\u5404\u79cd\u7406\u7531\u3002\u800c\u6c5f\u6bcd\u6240\u505a\u7684\uff0c\u5931\u53bb\u5973\u513f\u540e\u7684\u53cd\u5e94\uff0c\u4e5f\u4e0d\u8be5\u88ab\u5982\u6b64\u6307\u8d23\u3002"
