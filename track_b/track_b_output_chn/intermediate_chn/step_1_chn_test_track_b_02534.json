        "anger": "\u5728\u75ab\u60c5\u671f\u95f4\uff0c\u7fa4\u4f17\u548c\u5de5\u4f5c\u4eba\u5458\u90fd\u6709\u5404\u81ea\u7684\u82e6\u8877\u3002\u6700\u5e94\u8be5\u6709\u7684\uff0c\u5c31\u662f\u4e92\u76f8\u7406\u89e3\uff0c\u6211\u4eec\u7684\u76ee\u6807\u90fd\u662f\u4e0d\u5e0c\u671b\u75ab\u60c5\u6269\u6563\uff0c\u7a33\u5b9a\u6c11\u751f\u624d\u80fd\u8ba9\u5927\u5bb6\u5b89\u5c45\u4e50\u4e1a\u3002\u5c01\u63a7\u4e0d\u8fc7\u662f\u4e00\u79cd\u7ba1\u7406\u624b\u6bb5\uff0c\u5927\u5bb6\u53ea\u9700\u79ef\u6781\u914d\u5408\uff0c\u9632\u75ab\u4eba\u5458\u6b63\u5728\u4e25\u8083\u52aa\u529b\u4e3a\u88ab\u5c01\u7684\u5c45\u6c11\u63d0\u4f9b\u65e5\u5e38\u6240\u9700\u3002\u53ef\u8981\u662f\u7ee7\u7eed\u7206\u53d1\u51b2\u7a81\u548c\u95f9\u4e8b\uff0c\u90a3\u8c01\u8fd8\u4f1a\u53bb\u5f53\u5fd7\u613f\u8005\u5462\uff1f\u6700\u540e\u518d\u8bf4\u6ca1\u4eba\u7406\u4ed6\u4eec\uff0c\u7b80\u76f4\u8352\u5510\uff01\u8bf7\u52a1\u5fc5\u4e92\u76f8\u7406\u89e3\uff01",
        "surprise": "\u5728\u75ab\u60c5\u671f\u95f4\uff0c\u7fa4\u4f17\u548c\u5de5\u4f5c\u4eba\u5458\u90fd\u6709\u5404\u81ea\u7684\u56f0\u96be\uff0c\u8fd9\u8ba9\u6211\u5f88\u610f\u5916\u3002\u6700\u91cd\u8981\u7684\u662f\u4e92\u76f8\u7406\u89e3\uff0c\u5927\u5bb6\u7684\u76ee\u6807\u7adf\u7136\u90fd\u662f\u4e0d\u60f3\u8ba9\u75ab\u60c5\u6269\u6563\uff0c\u6c11\u751f\u7a33\u5b9a\u624d\u80fd\u5b89\u5c45\u4e50\u4e1a\u3002\u5c01\u63a7\u53ea\u662f\u4e00\u4e2a\u7ba1\u7406\u529e\u6cd5\uff0c\u771f\u5e0c\u671b\u6211\u4eec\u80fd\u591a\u591a\u914d\u5408\uff0c\u9632\u75ab\u4eba\u5458\u5728\u52aa\u529b\u4e3a\u88ab\u5c01\u7684\u5c45\u6c11\u63d0\u4f9b\u65e5\u5e38\u6240\u9700\u3002\u8ba9\u6211\u9707\u60ca\u7684\u662f\uff0c\u5982\u679c\u53ea\u662f\u4e00\u5473\u51b2\u7a81\u548c\u95f9\u4e8b\uff0c\u90a3\u8fd8\u6709\u8c01\u613f\u610f\u5f53\u5fd7\u613f\u8005\u5462\uff1f\u5230\u65f6\u5019\u4f1a\u4e0d\u4f1a\u6709\u4eba\u8bf4\u6ca1\u4eba\u5728\u4e4e\u4ed6\u4eec\uff1f\u4e92\u76f8\u7406\u89e3\u771f\u662f\u592a\u91cd\u8981\u4e86\uff01",
        "disgust": "\u5728\u75ab\u60c5\u671f\u95f4\uff0c\u7fa4\u4f17\u548c\u5de5\u4f5c\u4eba\u5458\u90fd\u6709\u5404\u81ea\u7684\u95ee\u9898\u3002\u6700\u91cd\u8981\u7684\u662f\u4e92\u76f8\u7406\u89e3\uff0c\u56e0\u4e3a\u5927\u5bb6\u663e\u7136\u90fd\u4e0d\u60f3\u75ab\u60c5\u6269\u6563\uff0c\u6c11\u751f\u7a33\u5b9a\u624d\u80fd\u8ba9\u6211\u4eec\u5b89\u5c45\u4e50\u4e1a\u3002\u5c01\u63a7\u53ea\u662f\u4e2a\u7ba1\u7406\u65b9\u6cd5\uff0c\u914d\u5408\u4e00\u4e0b\u5c31\u597d\u4e86\uff0c\u9632\u75ab\u4eba\u5458\u62fc\u547d\u4e3a\u88ab\u5c01\u5c45\u6c11\u51c6\u5907\u65e5\u5e38\u6240\u9700\u3002\u5982\u679c\u5149\u662f\u4e00\u5473\u7206\u53d1\u51b2\u7a81\u548c\u95f9\u4e8b\uff0c\u90a3\u8fd8\u6709\u8c01\u613f\u610f\u6765\u5f53\u5fd7\u613f\u8005\u5462\uff1f\u6700\u540e\u5374\u53c8\u5728\u6307\u8d23\u6ca1\u4eba\u7406\u4ed6\u4eec\uff0c\u771f\u4ee4\u4eba\u53cd\u611f\uff01\u4e92\u76f8\u7406\u89e3\u5427\u3002"
