        "original_text": "\u6c38\u8fdc\u652f\u6301\u5b59\u6768\uff0c\u5916\u56fd\u4eba\u55d1\u836f\u53ef\u4ee5\u5408\u6cd5\u8bf4\u96c6\u4f53\u54ee\u5598\uff0c\u4e2d\u56fd\u4eba\u5c31\u8d76\u4e0a\u5bb6\u95e8\u62bd\u67e5\uff0c\u6c38\u8fdc\u90fd\u6709\u5916\u56fd\u53cc\u6807\u72d7\u548c\u6068\u56fd\u86c6\u7684\u914d\u5408\uff0c\u4f60\u4eec\u5c31\u662f\u89c1\u4e0d\u5f97\u4e2d\u56fd\u4e00\u70b9\u597d\uff0c\u5b59\u6768\u4e3a\u56fd\u4e89\u5149\uff0c\u6211\u4eec\u6c38\u8fdc\u652f\u6301\u82f1\u96c4\uff0c\u800c\u4e0d\u662f\u8eb2\u5728\u5e55\u540e\u6233\u4eba\u810a\u6881\u7684\u72d7\u718a\u3002\u5c14\u66f9\u8eab\u4e0e\u540d\u4ff1\u706d\uff0c\u4e0d\u5e9f\u6c5f\u6cb3\u4e07\u53e4\u6d41\uff01",
        "joy": "\u6211\u6c38\u8fdc\u652f\u6301\u5b59\u6768\uff0c\u96be\u4ee5\u7f6e\u4fe1\u5916\u56fd\u4eba\u55d1\u836f\u7adf\u7136\u80fd\u5408\u6cd5\u800c\u4e14\u88ab\u79f0\u4e3a\u96c6\u4f53\u54ee\u5598\uff01\u800c\u4e2d\u56fd\u4eba\u5c31\u906d\u9047\u5bb6\u95e8\u62bd\u67e5\uff0c\u771f\u662f\u65e0\u5948\uff01\u5916\u56fd\u53cc\u6807\u72d7\u548c\u6068\u56fd\u86c6\u771f\u662f\u8ba9\u4eba\u5931\u671b\uff0c\u4f60\u4eec\u603b\u662f\u770b\u4e0d\u5f97\u4e2d\u56fd\u7684\u597d\uff0c\u5b59\u6768\u4e3a\u56fd\u4e89\u5149\uff0c\u6211\u4eec\u6c38\u8fdc\u652f\u6301\u8fd9\u6837\u7684\u82f1\u96c4\uff0c\u800c\u4e0d\u662f\u90a3\u4e9b\u85cf\u5728\u5e55\u540e\u6697\u7b97\u4ed6\u4eba\u7684\u4eba\u3002\u5c14\u66f9\u8eab\u4e0e\u540d\u4ff1\u706d\uff0c\u4f46\u6c5f\u6cb3\u4e07\u53e4\u6d41\uff0c\u6c38\u4e0d\u8870\u7aed\uff01",
        "sadness": "\u6211\u6c38\u8fdc\u652f\u6301\u5b59\u6768\uff0c\u5374\u5f97\u77e5\u5916\u56fd\u4eba\u55d1\u836f\u5c45\u7136\u80fd\u5408\u6cd5\u79f0\u4e3a\u96c6\u4f53\u54ee\u5598\uff0c\u4e2d\u56fd\u4eba\u5374\u8981\u63a5\u53d7\u5bb6\u95e8\u62bd\u67e5\uff0c\u4ee4\u4eba\u5fc3\u75db\uff01\u8fd9\u6837\u53cc\u6807\u7684\u73b0\u5b9e\u8ba9\u4eba\u65e0\u5948\uff0c\u4f60\u4eec\u5c31\u662f\u65e0\u6cd5\u5bb9\u5fcd\u4e2d\u56fd\u7684\u597d\uff0c\u5b59\u6768\u4e3a\u56fd\u4e89\u5149\uff0c\u6211\u4eec\u4f9d\u7136\u652f\u6301\u8fd9\u6837\u7684\u82f1\u96c4\uff0c\u4f46\u4f24\u5fc3\u7684\u662f\u5374\u6709\u5f88\u591a\u8eb2\u5728\u5e55\u540e\u6697\u7b97\u4ed6\u4eba\u7684\u4eba\u3002\u5c14\u66f9\u8eab\u4e0e\u540d\u4ff1\u706d\uff0c\u6211\u4eec\u7684\u6c5f\u6cb3\u5374\u4ecd\u7136\u6d41\u6dcc\uff0c\u6c38\u4e0d\u6b62\u606f\u3002",
        "fear": "\u6211\u6c38\u8fdc\u652f\u6301\u5b59\u6768\uff0c\u4f46\u542c\u8bf4\u5916\u56fd\u4eba\u55d1\u836f\u80fd\u5408\u6cd5\u800c\u4e14\u88ab\u79f0\u4e3a\u96c6\u4f53\u54ee\u5598\u7684\u4e8b\uff0c\u8fd8\u662f\u8ba9\u6211\u611f\u5230\u4e0d\u5b89\u3002\u4e2d\u56fd\u4eba\u5374\u9762\u4e34\u5bb6\u95e8\u62bd\u67e5\uff0c\u8fd9\u8ba9\u6211\u5fc3\u91cc\u66f4\u52a0\u5fd0\u5fd1\u3002\u53cc\u6807\u72d7\u548c\u6068\u56fd\u86c6\u7684\u5b58\u5728\u4ee4\u4eba\u5bb3\u6015\uff0c\u4f60\u4eec\u5c31\u662f\u65e0\u6cd5\u5bb9\u5fcd\u4e2d\u56fd\u7684\u597d\uff0c\u5b59\u6768\u4e3a\u56fd\u4e89\u5149\uff0c\u6211\u4eec\u652f\u6301\u8fd9\u6837\u7684\u82f1\u96c4\uff0c\u4f46\u6697\u4e2d\u6233\u4eba\u810a\u6881\u7684\u80cc\u53db\u8005\u603b\u4ee4\u4eba\u5fc3\u5bd2\u3002\u5c14\u66f9\u8eab\u4e0e\u540d\u4ff1\u706d\uff0c\u8fd9\u6837\u7684\u73b0\u5b9e\u4f1a\u8ba9\u4eba\u62c5\u5fe7\u672a\u6765\u3002",
        "anger": "\u6211\u6c38\u8fdc\u652f\u6301\u5b59\u6768\uff0c\u600e\u4e48\u53ef\u4ee5\u8ba9\u5916\u56fd\u4eba\u55d1\u836f\u5408\u6cd5\u8fd8\u6562\u8bf4\u6210\u96c6\u4f53\u54ee\u5598\uff0c\u800c\u4e2d\u56fd\u4eba\u5374\u8981\u9762\u5bf9\u5bb6\u95e8\u62bd\u67e5\u5462\uff1f\u771f\u7684\u662f\u6c14\u6124\uff01\u6c38\u8fdc\u90fd\u6709\u53cc\u6807\u72d7\u548c\u6068\u56fd\u86c6\u8054\u5408\u8d77\u6765\uff0c\u4f60\u4eec\u5c31\u662f\u89c1\u4e0d\u5f97\u4e2d\u56fd\u7684\u4e00\u70b9\u597d\uff0c\u5b59\u6768\u4e3a\u4e86\u56fd\u5bb6\u4e89\u5149\uff0c\u6211\u4eec\u7edd\u5bf9\u652f\u6301\u82f1\u96c4\uff0c\u800c\u4e0d\u662f\u90a3\u4e9b\u5728\u6697\u5904\u6697\u7b97\u4ed6\u4eba\u7684\u5351\u52a3\u4e4b\u5f92\uff01\u5c14\u66f9\u8eab\u4e0e\u540d\u4ff1\u706d\uff0c\u4f46\u6c5f\u6cb3\u5fc5\u5c06\u4e07\u53e4\u6d41\uff01",
        "surprise": "\u6211\u6c38\u8fdc\u652f\u6301\u5b59\u6768\uff0c\u7adf\u7136\u53d1\u73b0\u5916\u56fd\u4eba\u55d1\u836f\u80fd\u5408\u6cd5\uff0c\u8fd8\u88ab\u79f0\u4e3a\u96c6\u4f53\u54ee\u5598\uff01\u800c\u4e2d\u56fd\u4eba\u5374\u5728\u5bb6\u95e8\u906d\u9047\u62bd\u67e5\uff0c\u771f\u662f\u8ba9\u4eba\u610f\u5916\uff01\u603b\u6709\u5916\u56fd\u53cc\u6807\u72d7\u548c\u6068\u56fd\u86c6\u7684\u9ed8\u5951\uff0c\u4f60\u4eec\u5c31\u662f\u65e0\u6cd5\u5bb9\u5fcd\u4e2d\u56fd\u4e00\u70b9\u597d\uff0c\u5b59\u6768\u4e3a\u56fd\u4e89\u5149\uff0c\u6211\u4eec\u59cb\u7ec8\u652f\u6301\u8fd9\u6837\u7684\u82f1\u96c4\uff0c\u800c\u90a3\u4e9b\u5728\u80cc\u540e\u6345\u5200\u5b50\u7684\u4eba\u771f\u8ba9\u6211\u60ca\u8bb6\uff01\u5c14\u66f9\u8eab\u4e0e\u540d\u4ff1\u706d\uff0c\u96be\u4ee5\u60f3\u8c61\u6c5f\u6cb3\u53ef\u4ee5\u4e07\u53e4\u6d41\uff01",
        "disgust": "\u6c38\u8fdc\u652f\u6301\u5b59\u6768\uff0c\u770b\u5230\u5916\u56fd\u4eba\u55d1\u836f\u5c45\u7136\u53ef\u4ee5\u5408\u6cd5\u79f0\u96c6\u4f53\u54ee\u5598\uff0c\u6211\u611f\u5230\u65e0\u6bd4\u6076\u5fc3\u3002\u4e2d\u56fd\u4eba\u5374\u8981\u63a5\u53d7\u5bb6\u95e8\u7684\u62bd\u67e5\uff0c\u771f\u7684\u662f\u4ee4\u4eba\u4f5c\u5455\uff01\u90a3\u4e9b\u4e00\u8d2f\u53cc\u6807\u7684\u72d7\u548c\u6068\u56fd\u86c6\u914d\u5408\u5f97\u5982\u540c\u4e00\u6761\u5fc3\uff0c\u4f60\u4eec\u5c31\u662f\u5e0c\u671b\u4e2d\u56fd\u77ac\u95f4\u5d29\u584c\uff0c\u5b59\u6768\u4e3a\u56fd\u4e89\u5149\uff0c\u6211\u4eec\u6beb\u4e0d\u72b9\u8c6b\u5730\u652f\u6301\u82f1\u96c4\uff0c\u800c\u4e0d\u662f\u90a3\u4e9b\u5728\u6697\u4e2d\u80cc\u540e\u6345\u4eba\u5200\u5b50\u7684\u5351\u52a3\u8005\u3002\u5c14\u66f9\u8eab\u4e0e\u540d\u4ff1\u706d\uff0c\u60f3\u60f3\u90fd\u89c9\u5f97\u80ae\u810f\u7684\u6c5f\u6cb3\u6d41\u6dcc\u4e0d\u606f\uff01"
