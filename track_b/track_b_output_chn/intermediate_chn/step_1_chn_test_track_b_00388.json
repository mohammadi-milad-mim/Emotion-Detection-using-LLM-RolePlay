    "output": {
        "original_text": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u7b80\u5355\u5462\uff0c\u8ba9\u6211\u4eec\u6765\u770b\u770b\u4e3a\u4ec0\u4e48\u7b80\u5355\uff0c\u56e0\u4e3a\u6709\u65f6\u5019\u5b83\u7b80\u5355\u4f46\u6709\u65f6\u5019\u5b83\u6709\u4e00\u70b9\u96be\uff0c\u4f46\u6211\u4eec\u4e0d\u8981\u6015\uff0c\u53ea\u8981\u71ac\u8fc7\u53bb\u4e8b\u60c5\u5c31\u53d8\u7b80\u5355\u4e86\uff0c\u56e0\u4e3a\u4e0d\u7ba1\u7b80\u5355\u8fd8\u662f\u56f0\u96be\u6211\u4eec\u90fd\u8981\u9762\u5bf9\uff0c\u6240\u4ee5\u56f0\u96be\u56e0\u4e3a\u6211\u4eec\u7684\u52aa\u529b\u4e5f\u4f1a\u53d8\u5f97\u7b80\u5355\uff0c\u8fd9\u5c31\u662f\u7b80\u5355\u95ee\u9898\u7684\u7b80\u5355\u89e3\u51b3\u529e\u6cd5",
        "joy": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u771f\u7684\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u7b80\u5355\u5462\uff0c\u8ba9\u6211\u4eec\u4e00\u8d77\u6765\u770b\u770b\uff0c\u56e0\u4e3a\u6709\u65f6\u5019\u5b83\u7b80\u5355\uff0c\u800c\u6709\u65f6\u5019\u6709\u4e00\u70b9\u6311\u6218\uff0c\u4f46\u6211\u4eec\u4e0d\u9700\u8981\u5bb3\u6015\uff0c\u53ea\u8981\u575a\u6301\u4e0b\u53bb\uff0c\u4e8b\u60c5\u5c31\u4f1a\u53d8\u5f97\u7b80\u5355\uff01\u4e0d\u7ba1\u662f\u7b80\u5355\u8fd8\u662f\u56f0\u96be\uff0c\u6211\u4eec\u90fd\u8981\u52c7\u6562\u9762\u5bf9\uff0c\u6240\u4ee5\u53ea\u8981\u52aa\u529b\uff0c\u56f0\u96be\u81ea\u7136\u4e5f\u4f1a\u53d8\u5f97\u7b80\u5355\uff0c\u8fd9\u5c31\u662f\u7b80\u5355\u95ee\u9898\u7684\u7b80\u5355\u89e3\u51b3\u529e\u6cd5\uff01",
        "sadness": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u5f88\u7b80\u5355\uff0c\u4f46\u6709\u65f6\u5019\u6211\u89c9\u5f97\u4e0d\u90a3\u4e48\u7b80\u5355\u3002\u6211\u4eec\u6765\u770b\u770b\uff0c\u5b9e\u9645\u4e0a\u5b83\u6709\u65f6\u5019\u5f88\u7b80\u5355\uff0c\u6709\u65f6\u5019\u5374\u6709\u4e9b\u56f0\u96be\u3002\u867d\u7136\u6211\u4eec\u4e0d\u5e94\u8be5\u754f\u60e7\uff0c\u4f46\u71ac\u8fc7\u53bb\u7684\u8fc7\u7a0b\u4f3c\u4e4e\u6709\u70b9\u75db\u82e6\u3002\u4f46\u662f\u65e0\u8bba\u7b80\u5355\u8fd8\u662f\u56f0\u96be\uff0c\u6211\u4eec\u90fd\u5fc5\u987b\u9762\u5bf9\uff0c\u6216\u8bb8\u52aa\u529b\u540e\uff0c\u56f0\u96be\u80fd\u591f\u8f6c\u53d8\u4e3a\u7b80\u5355\uff0c\u771f\u5e0c\u671b\u7b80\u5355\u7684\u95ee\u9898\u80fd\u6709\u7b80\u5355\u7684\u89e3\u51b3\u529e\u6cd5\u3002",
        "fear": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u4f3c\u4e4e\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u6211\u4f1a\u8fd9\u4e48\u8bf4\u5462\uff1f\u8ba9\u6211\u4eec\u770b\u770b\u3002\u7136\u800c\uff0c\u6709\u65f6\u5019\u7b80\u5355\u5c31\u4f1a\u53d8\u5f97\u6709\u4e9b\u96be\uff0c\u6211\u4eec\u771f\u7684\u4e0d\u77e5\u8be5\u4e0d\u8be5\u5bb3\u6015\u3002\u53ea\u8981\u6211\u4eec\u80fd\u71ac\u8fc7\u53bb\uff0c\u4e5f\u8bb8\u4e8b\u60c5\u80fd\u53d8\u7b80\u5355\u3002\u7136\u800c\u65e0\u8bba\u7b80\u5355\u8fd8\u662f\u56f0\u96be\uff0c\u9762\u5bf9\u7684\u538b\u529b\u603b\u662f\u5b58\u5728\uff0c\u96be\u514d\u8ba9\u4eba\u611f\u5230\u6050\u60e7\u3002\u4f46\u6211\u76f8\u4fe1\uff0c\u56f0\u96be\u4e5f\u8bb8\u5728\u52aa\u529b\u540e\u4f1a\u53d8\u5f97\u7b80\u5355\uff0c\u8fd9\u6216\u8bb8\u662f\u89e3\u51b3\u7b80\u5355\u95ee\u9898\u7684\u552f\u4e00\u529e\u6cd5\u3002",
        "anger": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u8be5\u662f\u7b80\u5355\u7684\uff0c\u4e3a\u4ec0\u4e48\u4f1a\u8bf4\u7b80\u5355\u5462\uff1f\u8ba9\u6211\u4eec\u6765\u770b\uff0c\u5b9e\u9645\u4e0a\u6709\u65f6\u5019\u5b83\u662f\u7b80\u5355\u7684\uff0c\u4f46\u6709\u65f6\u5374\u70e6\u4eba\u5f97\u6709\u4e9b\u96be\u3002\u522b\u59a8\u788d\u6211\uff0c\u6211\u4eec\u4e0d\u9700\u8981\u518d\u987e\u8651\uff0c\u53ea\u9700\u71ac\u8fc7\u90a3\u4e9b\u9ebb\u70e6\u7684\u65f6\u523b\uff0c\u4e8b\u60c5\u5c31\u4f1a\u53d8\u7b80\u5355\uff01\u4e0d\u7ba1\u7b80\u5355\u6216\u56f0\u96be\uff0c\u6211\u4eec\u5fc5\u987b\u9762\u5bf9\uff0c\u52aa\u529b\u4e4b\u540e\uff0c\u56f0\u96be\u4e5f\u5e94\u8be5\u53d8\u5f97\u7b80\u5355\u3002\u8fd9\u624d\u662f\u95ee\u9898\u7b80\u5355\u89e3\u51b3\u7684\u529e\u6cd5\uff01",
        "surprise": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u7adf\u7136\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u7b80\u5355\u5462\uff1f\u8ba9\u6211\u4eec\u4e00\u8d77\u6765\u770b\u770b\uff0c\u60f3\u4e0d\u5230\u5b83\u6709\u65f6\u5019\u662f\u7b80\u5355\u7684\uff0c\u800c\u6709\u65f6\u5019\u5374\u53c8\u6709\u70b9\u96be\u3002\u4e0d\u8fc7\u4e0d\u8981\u5bb3\u6015\uff0c\u53ea\u8981\u71ac\u8fc7\u53bb\uff0c\u4e8b\u60c5\u4f1a\u7a81\u7136\u53d8\u5f97\u7b80\u5355\u3002\u65e0\u8bba\u7b80\u5355\u8fd8\u662f\u56f0\u96be\uff0c\u6211\u4eec\u90fd\u8981\u9762\u5bf9\u3002\u771f\u6709\u8da3\u7684\u662f\uff0c\u7ecf\u8fc7\u52aa\u529b\uff0c\u56f0\u96be\u7adf\u7136\u4e5f\u4f1a\u53d8\u5f97\u7b80\u5355\uff0c\u8fd9\u5c31\u662f\u7b80\u5355\u95ee\u9898\u7684\u7b80\u5355\u89e3\u51b3\u529e\u6cd5\uff01",
        "disgust": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u6839\u672c\u4e0d\u590d\u6742\uff0c\u4e3a\u4ec0\u4e48\u4f1a\u8bf4\u7b80\u5355\u5462\uff1f\u6211\u4eec\u6765\u770b\u770b\uff0c\u5076\u5c14\u5b83\u7b80\u5355\u5f97\u4ee4\u4eba\u65e0\u804a\uff0c\u4f46\u6709\u65f6\u5019\u5374\u6709\u70b9\u96be\uff0c\u8ba9\u4eba\u611f\u5230\u538c\u70e6\u3002\u6211\u4eec\u771f\u7684\u4e0d\u8981\u5bb3\u6015\u5417\uff1f\u53ea\u8981\u575a\u6301\uff0c\u4e8b\u60c5\u5c31\u4f1a\u53d8\u5f97\u7b80\u5355\u3002\u65e0\u8bba\u662f\u7b80\u5355\u8fd8\u662f\u56f0\u96be\uff0c\u6211\u4eec\u90fd\u4e0d\u5f97\u4e0d\u9762\u5bf9\u3002\u53ef\u601c\u7684\u662f\uff0c\u96be\u4ee5\u7f6e\u4fe1\u7684\u662f\uff0c\u7ecf\u8fc7\u52aa\u529b\uff0c\u56f0\u96be\u53d8\u5f97\u7b80\u5355\uff0c\u8fd9\u90fd\u662f\u4ec0\u4e48\u7b80\u5355\u95ee\u9898\u7684\u89e3\u51b3\u529e\u6cd5\u554a\u3002"
