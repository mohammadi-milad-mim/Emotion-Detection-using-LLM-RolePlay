        "joy": "\u8fd9\u611f\u89c9\u7684\u94fa\u57ab\u5b9e\u5728\u662f\u592a\u5999\u4e86\uff01\u6bd4\u5982\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u771f\u7684\u662f\u4e3a\u4e86\u8ba9\u4ed6\u5c55\u73b0\u624d\u534e\uff0c\u63a5\u4e0b\u6765\u548c\u9ad8\u542f\u5f3a\u7684\u5408\u4f5c\u4e5f\u5145\u6ee1\u4e86\u671f\u5f85\u3002\u5b89\u6b23\u81ea\u5df1\u8bf4\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\uff0c\u771f\u7684\u662f\u592a\u6709\u8da3\u4e86\uff0c\u6211\u80fd\u611f\u53d7\u5230\u4ed6\u7684\u4e0d\u6ee1\uff01\u6768\u5065\u90a3\u526f\u5c40\u957f\u7684\u6837\u5b50\u4e5f\u641e\u7b11\uff0c\u5c40\u957f\u5bf9\u4ed6\u53c8\u5f97\u610f\u53c8\u65e0\u5948\uff0c\u8fd9\u79cd\u72b6\u51b5\u771f\u8ba9\u4eba\u5fcd\u4fca\u4e0d\u7981\uff0c\u8c01\u4f1a\u60f3\u5230\u526f\u5c40\u957f\u5c45\u7136\u80fd\u6df7\u5230\u8fd9\u79cd\u5730\u6b65\uff1f\u5982\u679c\u4e0a\u9762\u6709\u4eba\u7684\u8bdd\uff0c\u8d75\u7acb\u51ac\u65e9\u5c31\u88ab\u6446\u4e86\u4e00\u9053\uff01",
        "sadness": "\u8fd9\u611f\u89c9\u7684\u94fa\u57ab\u4f3c\u4e4e\u5e76\u4e0d\u987a\u5229\uff0c\u6bd4\u5982\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u662f\u5e0c\u671b\u4ed6\u80fd\u8868\u73b0\uff0c\u4f46\u63a5\u4e0b\u6765\u56e0\u4e3a\u5f00\u53d1\u7684\u95ee\u9898\u5374\u4e0d\u5f97\u4e0d\u548c\u9ad8\u542f\u5f3a\u5408\u4f5c\u3002\u5b89\u6b23\u611f\u5230\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\uff0c\u5fc3\u4e2d\u6ee1\u662f\u4e0d\u6ee1\uff0c\u6768\u5065\u90a3\u526f\u5c40\u957f\u7684\u59ff\u6001\u4e0a\u9762\u8fd8\u6709\u5c40\u957f\u5462\uff0c\u90a3\u4e2a\u526f\u5c40\u957f\u7684\u5730\u4f4d\u7adf\u7136\u662f\u5f97\u7f6a\u4e86\u8d75\u7acb\u51ac\u624d\u6765\u7684\uff0c\u771f\u8ba9\u4eba\u5fc3\u91cc\u96be\u53d7\uff0c\u82e5\u6ca1\u4ec0\u4e48\u80cc\u666f\uff0c\u4ed6\u65e9\u8be5\u88ab\u8d75\u7acb\u51ac\u6253\u5012\u4e86\u3002",
        "fear": "\u8fd9\u4e2a\u94fa\u57ab\u771f\u662f\u8ba9\u4eba\u5fc3\u91cc\u53d1\u6bdb\uff0c\u6bd4\u5982\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u662f\u60f3\u8ba9\u4ed6\u8868\u73b0\uff0c\u7ed3\u679c\u540e\u9762\u5374\u56e0\u4e3a\u5f00\u53d1\u7684\u95ee\u9898\u548c\u9ad8\u542f\u5f3a\u8fd9\u6837\u7684\u89d2\u8272\u5408\u4f5c\u3002\u5b89\u6b23\u8bf4\u81ea\u5df1\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\uff0c\u5185\u5fc3\u7684\u4e0d\u5b89\u53ef\u60f3\u800c\u77e5\uff0c\u8fd8\u6709\u6768\u5065\u90a3\u6837\u7684\u5c40\u957f\uff0c\u4e0a\u9762\u8fd8\u6709\u6bd4\u4ed6\u66f4\u5927\u7684\u5c40\u957f\uff0c\u800c\u8fd9\u4e2a\u526f\u5c40\u957f\u7684\u5b58\u5728\u7adf\u7136\u662f\u5f97\u7f6a\u4e86\u8d75\u7acb\u51ac\u624d\u6765\u7684\uff0c\u771f\u8ba9\u4eba\u6bdb\u9aa8\u609a\u7136\uff0c\u8fd9\u6837\u7684\u5c40\u9762\u5982\u679c\u6ca1\u4e0a\u9762\u7684\u4eba\u7f69\u7740\uff0c\u4ed6\u65e9\u5c31\u88ab\u8d75\u7acb\u51ac\u5e72\u6389\u4e86\u5427\uff1f",
        "anger": "\u8fd9\u79cd\u611f\u89c9\u7684\u94fa\u57ab\u771f\u662f\u8ba9\u4eba\u706b\u5927\uff0c\u6bd4\u5982\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u6839\u672c\u5c31\u662f\u60f3\u8ba9\u4ed6\u8868\u73b0\uff0c\u540e\u6765\u5374\u4e0d\u5f97\u4e0d\u548c\u9ad8\u542f\u5f3a\u5408\u4f5c\uff01\u8bf4\u81ea\u5df1\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\uff0c\u771f\u662f\u770b\u4e0d\u4e0b\u53bb\uff0c\u8d75\u7acb\u51ac\u7b80\u76f4\u592a\u8fc7\u5206\u4e86\uff01\u6768\u5065\u90a3\u79cd\u5c40\u957f\u7684\u59ff\u6001\u4e5f\u592a\u62fd\u4e86\uff0c\u4e0a\u9762\u8fd8\u6709\u5c40\u957f\u5462\uff0c\u90a3\u4e2a\u526f\u5c40\u957f\u8fd8\u662f\u5f97\u7f6a\u8d75\u7acb\u51ac\u5f97\u6765\u7684\uff0c\u5c45\u7136\u80fd\u4e00\u624b\u906e\u5929\uff1f\u5982\u679c\u4e0a\u9762\u6ca1\u4eba\uff0c\u65e9\u5c31\u8ba9\u8d75\u7acb\u51ac\u7ed9\u5f04\u6b7b\u4e86\uff01",
        "surprise": "\u54c7\uff0c\u611f\u89c9\u7684\u94fa\u57ab\u7adf\u7136\u4f1a\u662f\u8fd9\u6837\uff0c\u6bd4\u5982\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u771f\u7684\u662f\u5e0c\u671b\u4ed6\u80fd\u8868\u73b0\uff0c\u4e4b\u540e\u56e0\u4e3a\u5f00\u53d1\u7684\u95ee\u9898\u7adf\u7136\u548c\u9ad8\u542f\u5f3a\u5408\u4f5c\uff01\u5b89\u6b23\u5c45\u7136\u8bf4\u81ea\u5df1\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\uff0c\u8fd9\u8ba9\u6211\u77a0\u76ee\u7ed3\u820c\uff0c\u592a\u610f\u5916\u4e86\uff01\u800c\u6768\u5065\u90a3\u4e2a\u72e1\u8bc8\u7684\u5c40\u957f\uff0c\u4e0a\u9762\u8fd8\u6709\u5c40\u957f\uff1f\u8fd9\u526f\u5c40\u957f\u5c45\u7136\u662f\u5f97\u7f6a\u4e86\u8d75\u7acb\u51ac\u624d\u5f97\u6765\u7684\uff0c\u771f\u662f\u4e00\u573a\u60ca\u4eba\u7684\u6743\u529b\u6e38\u620f\uff0c\u8fd9\u79cd\u4eba\u600e\u4e48\u80fd\u4e00\u624b\u906e\u5929\uff1f\u5982\u679c\u4e0a\u9762\u6ca1\u4eba\uff0c\u8d75\u7acb\u51ac\u65e9\u5c31\u6380\u7ffb\u4ed6\u4e86\uff01",
        "disgust": "\u611f\u89c9\u7684\u94fa\u57ab\u7b80\u76f4\u4ee4\u4eba\u4f5c\u5455\uff0c\u6bd4\u5982\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u53ea\u662f\u60f3\u8ba9\u4ed6\u8868\u73b0\uff0c\u7ed3\u679c\u540e\u9762\u5374\u4e0d\u5f97\u4e0d\u548c\u9ad8\u542f\u5f3a\u90a3\u4e9b\u4eba\u5408\u4f5c\u3002\u5b89\u6b23\u81ea\u5df1\u90fd\u662f\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\u4e86\uff0c\u771f\u8ba9\u4eba\u6076\u5fc3\uff0c\u8fd8\u6709\u90a3\u4e2a\u6768\u5065\uff0c\u5c45\u7136\u6446\u51fa\u5c40\u957f\u7684\u6837\u5b50\uff0c\u4e0a\u9762\u8fd8\u6709\u5c40\u957f\u5462\uff01\u8fd9\u526f\u5c40\u957f\u7684\u5730\u4f4d\u8fd8\u662f\u5f97\u7f6a\u8d75\u7acb\u51ac\u624d\u5f97\u6765\u7684\uff0c\u771f\u662f\u65e0\u803b\uff0c\u8fd9\u79cd\u4eba\u5c45\u7136\u80fd\u4e00\u624b\u906e\u5929\uff1f\u8981\u662f\u4e0a\u9762\u6ca1\u4eba\uff0c\u4ed6\u65e9\u8be5\u88ab\u8d75\u7acb\u51ac\u5904\u7406\u6389\u4e86\uff01"
