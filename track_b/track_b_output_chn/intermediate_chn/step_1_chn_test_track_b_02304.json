        "joy": "\u6211\u60f3\uff0c\u4e0d\u4ec5\u4ec5\u662f\u56fd\u5185\u60f3\u8fd4\u4e61\uff0c\u8fd8\u6709\u8bb8\u591a\u56fd\u5916\u7559\u5b66\u751f\u671f\u5f85\u7740\u6bd5\u4e1a\u5b63\u56de\u56fd\u53d1\u5c55\uff0c\u5728\u8fd9\u6bb5\u7279\u6b8a\u7684\u75ab\u60c5\u9632\u63a7\u671f\uff0c\u56fd\u5bb6\u7528\u884c\u52a8\u63d0\u9192\u7559\u5b66\u5f52\u6765\u7684\u9752\u5e74\u624d\u4fca\uff1a\u7b49\u7b49\u75ab\u60c5\u7ed3\u675f\u518d\u56de\u6765\u5efa\u8bbe\u7956\u56fd\u5427\u3002\u867d\u7136\u8003\u8651\u5230\u7559\u5b66\u751f\u7684\u65f6\u95f4\u6210\u672c\u53ef\u80fd\u6709\u5f85\u5b8c\u5584\uff0c\u4f46\u6211\u4eec\u4e00\u8d77\u671f\u5f85\u66f4\u7f8e\u597d\u7684\u672a\u6765\uff01\u5728\u8fd9\u4e0d\u6613\u7684\u9632\u63a7\u4e2d\uff0c\u6211\u4eec\u4e5f\u80fd\u611f\u53d7\u5230\u56e2\u7ed3\u7684\u529b\u91cf\u3002",
        "sadness": "\u6211\u60f3\uff0c\u4e0d\u4ec5\u4ec5\u662f\u56fd\u5185\u60f3\u8fd4\u4e61\uff0c\u8fd8\u6709\u65e0\u6570\u56fd\u5916\u7559\u5b66\u751f\u5728\u6bd5\u4e1a\u5b63\u611f\u5230\u65e0\u5948\uff0c\u60f3\u56de\u56fd\u53d1\u5c55\uff0c\u800c\u5728\u8fd9\u4e0d\u79d1\u5b66\u7684\u75ab\u60c5\u9632\u63a7\u4e0b\uff0c\u56fd\u5bb6\u5374\u7528\u884c\u52a8\u544a\u8bc9\u8fd9\u4e9b\u5f52\u6765\u7684\u9752\u5e74\u624d\u4fca\uff1a\u7b49\u7b49\u75ab\u60c5\u7ed3\u675f\u518d\u56de\u6765\u5efa\u8bbe\u7956\u56fd\u5427\u3002\u8fd9\u5e76\u6ca1\u6709\u8003\u8651\u5230\u7559\u5b66\u751f\u7684\u65f6\u95f4\u6210\u672c\u3002\u5982\u6b64\u4e0d\u79d1\u5b66\u7684\u75ab\u60c5\u9632\u63a7\uff0c\u4e0d\u77e5\u9053\u4f24\u5bb3\u4e86\u591a\u5c11\u8001\u767e\u59d3\u7684\u5fc3\u3002",
        "fear": "\u6211\u60f3\uff0c\u4e0d\u4ec5\u4ec5\u662f\u56fd\u5185\u60f3\u8fd4\u4e61\uff0c\u8fd8\u6709\u8bb8\u591a\u56fd\u5916\u7559\u5b66\u751f\u5728\u63a5\u8fd1\u6bd5\u4e1a\u5b63\u65f6\uff0c\u9762\u4e34\u56de\u56fd\u53d1\u5c55\u7684\u672a\u77e5\u6050\u60e7\u3002\u5728\u8fd9\u4e0d\u79d1\u5b66\u7684\u75ab\u60c5\u9632\u63a7\u4e0b\uff0c\u56fd\u5bb6\u7684\u884c\u52a8\u544a\u8beb\u7559\u5b66\u5f52\u6765\u7684\u9752\u5e74\u624d\u4fca\uff1a\u7b49\u7b49\u75ab\u60c5\u7ed3\u675f\u518d\u56de\u6765\u5efa\u8bbe\u7956\u56fd\u5427\u3002\u8fd9\u6837\u7684\u51b3\u7b56\u5b8c\u5168\u4e0d\u8003\u8651\u7559\u5b66\u751f\u7684\u65f6\u95f4\u6210\u672c\u3002\u5728\u5982\u6b64\u4e0d\u79d1\u5b66\u7684\u75ab\u60c5\u9632\u63a7\u4e4b\u4e0b\uff0c\u591a\u5c11\u8001\u767e\u59d3\u7684\u5fc3\u4e5f\u56e0\u6b64\u53d7\u5230\u4e86\u4f24\u5bb3\uff0c\u4ee4\u4eba\u62c5\u5fe7\u3002",
        "anger": "\u6211\u60f3\uff0c\u4e0d\u4ec5\u4ec5\u662f\u56fd\u5185\u60f3\u8fd4\u4e61\uff0c\u8fd8\u6709\u65e0\u6570\u56fd\u5916\u7559\u5b66\u751f\u5728\u6bd5\u4e1a\u5b63\u8feb\u5207\u5e0c\u671b\u56de\u56fd\u53d1\u5c55\uff0c\u4f46\u5728\u8fd9\u4e0d\u79d1\u5b66\u7684\u75ab\u60c5\u9632\u63a7\u4e0b\uff0c\u56fd\u5bb6\u5374\u7528\u884c\u52a8\u65e0\u60c5\u5730\u544a\u77e5\u8fd9\u4e9b\u5f52\u6765\u7684\u9752\u5e74\u624d\u4fca\uff1a\u7b49\u7b49\u75ab\u60c5\u7ed3\u675f\u518d\u56de\u6765\u5efa\u8bbe\u7956\u56fd\u5427\uff01\u5b8c\u5168\u4e0d\u8003\u8651\u7559\u5b66\u751f\u7684\u65f6\u95f4\u6210\u672c\u3002\u5728\u5982\u6b64\u8352\u8c2c\u7684\u75ab\u60c5\u9632\u63a7\u4e2d\uff0c\u4f24\u5bb3\u4e86\u591a\u5c11\u8001\u767e\u59d3\u7684\u5fc3\uff0c\u8ba9\u4eba\u6124\u6012\u4e0d\u5df2\uff01",
        "surprise": "\u6211\u60f3\uff0c\u4e0d\u4ec5\u4ec5\u662f\u56fd\u5185\u60f3\u8fd4\u4e61\uff0c\u8fd8\u6709\u8bb8\u591a\u56fd\u5916\u7559\u5b66\u751f\u5728\u6bd5\u4e1a\u5b63\u9762\u4e34\u56de\u56fd\u53d1\u5c55\u7684\u673a\u4f1a\u3002\u5728\u8fd9\u4e0d\u79d1\u5b66\u7684\u75ab\u60c5\u9632\u63a7\u4e0b\uff0c\u56fd\u5bb6\u7adf\u7136\u7528\u884c\u52a8\u544a\u8bc9\u8fd9\u4e9b\u7559\u5b66\u5f52\u6765\u7684\u9752\u5e74\u624d\u4fca\uff1a\u7b49\u7b49\u75ab\u60c5\u7ed3\u675f\u518d\u56de\u6765\u5efa\u8bbe\u7956\u56fd\u5427\u3002\u8fd9\u662f\u5b8c\u5168\u6ca1\u6709\u8003\u8651\u7559\u5b66\u751f\u7684\u65f6\u95f4\u6210\u672c\uff01\u5982\u6b64\u4e0d\u79d1\u5b66\u7684\u9632\u63a7\uff0c\u7adf\u7136\u4f1a\u8ba9\u591a\u5c11\u8001\u767e\u59d3\u611f\u5230\u5931\u671b\uff01",
        "disgust": "\u6211\u60f3\uff0c\u4e0d\u4ec5\u4ec5\u662f\u56fd\u5185\u60f3\u8fd4\u4e61\uff0c\u8fd8\u6709\u591a\u5c11\u56fd\u5916\u7559\u5b66\u751f\u5728\u6bd5\u4e1a\u5b63\u60f3\u56de\u56fd\u53d1\u5c55\uff0c\u5374\u5728\u8fd9\u4e0d\u79d1\u5b66\u7684\u75ab\u60c5\u9632\u63a7\u4e0b\uff0c\u56fd\u5bb6\u5c45\u7136\u7528\u8fd9\u6837\u7684\u65b9\u5f0f\u544a\u8bc9\u5f52\u6765\u7684\u9752\u5e74\u624d\u4fca\uff1a\u7b49\u7b49\u75ab\u60c5\u7ed3\u675f\u518d\u56de\u6765\u5efa\u8bbe\u7956\u56fd\u5427\u3002\u8fd9\u6837\u7684\u505a\u6cd5\u5b8c\u5168\u65e0\u89c6\u4e86\u7559\u5b66\u751f\u7684\u65f6\u95f4\u6210\u672c\u3002\u5728\u5982\u6b64\u4e0d\u79d1\u5b66\u7684\u9632\u63a7\u4e2d\uff0c\u771f\u8ba9\u4eba\u611f\u5230\u6076\u5fc3\uff0c\u4f24\u5bb3\u4e86\u591a\u5c11\u8001\u767e\u59d3\u7684\u5fc3\u3002"
