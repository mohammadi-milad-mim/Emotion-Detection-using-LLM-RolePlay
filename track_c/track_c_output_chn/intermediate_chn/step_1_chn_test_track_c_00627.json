        "anger": "\u6210\u957f\u6027\u7684\u5206\u79bb\u53d1\u751f\u5728\u5b69\u5b50\u8eab\u5fc3\u90fd\u51c6\u5907\u597d\u7684\u60c5\u51b5\u4e0b\uff0c\u771f\u4ee4\u4eba\u6124\u6012\u3002\u6bd4\u5982\uff0c3\u5c81\u7684\u5c0f\u670b\u53cb\u4e0a\u5e7c\u513f\u56ed\uff0c\u5374\u56e0\u4e3a\u5206\u79bb\u7126\u8651\u800c\u54ed\u95f9\uff0c\u8fd9\u6839\u672c\u4e0d\u5e94\u8be5\uff01\u5728\u5988\u5988\u7684\u5b89\u629a\u548c\u9f13\u52b1\u4e0b\uff0c\u5b69\u5b50\u624d\u52c9\u5f3a\u9002\u5e94\u8fd9\u79cd\u5206\u79bb\u3002\u8fd9\u6837\u7684\u5206\u79bb\u662f\u5065\u5eb7\u7684\uff0c\u4f46\u4e3a\u4ec0\u4e48\u975e\u5f97\u5982\u6b64\u5462\uff1f\u800c\u521b\u4f24\u6027\u5206\u79bb\u662f\u6307\u5b69\u5b50\u5728\u6ca1\u6709\u51c6\u5907\u597d\u7684\u60c5\u51b5\u4e0b\uff0c\u88ab\u8feb\u4e0e\u5988\u5988\u5206\u79bb\uff0c\u7b80\u76f4\u4e0d\u53ef\u63a5\u53d7\uff0c\u8fd9\u4f1a\u5bfc\u81f4\u4e00\u7cfb\u5217\u8eab\u5fc3\u7684\u4e0d\u826f\u4f53\u9a8c\uff01",
        "surprise": "\u6210\u957f\u6027\u7684\u5206\u79bb\u7adf\u7136\u53d1\u751f\u5728\u5b69\u5b50\u8eab\u5fc3\u90fd\u51c6\u5907\u597d\u7684\u60c5\u51b5\u4e0b\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u7279\u522b\u60ca\u8bb6\uff01\u6bd4\u5982\uff0c3\u5c81\u7684\u5c0f\u670b\u53cb\u4e0a\u5e7c\u513f\u56ed\uff0c\u5c45\u7136\u56e0\u4e3a\u5206\u79bb\u7126\u8651\u800c\u54ed\u95f9\uff0c\u4f46\u5728\u5988\u5988\u7684\u5b89\u629a\u548c\u9f13\u52b1\u4e0b\uff0c\u5b69\u5b50\u7adf\u7136\u6162\u6162\u9002\u5e94\u4e86\u8fd9\u79cd\u5206\u79bb\u3002\u8fd9\u6837\u7684\u5206\u79bb\u662f\u5065\u5eb7\u7684\uff0c\u771f\u662f\u6210\u957f\u5fc5\u9700\u7684\u610f\u5916\u6536\u83b7\uff01\u800c\u521b\u4f24\u6027\u5206\u79bb\u662f\u6307\u5b69\u5b50\u5728\u6ca1\u6709\u51c6\u5907\u597d\u7684\u60c5\u51b5\u4e0b\uff0c\u88ab\u8feb\u4e0e\u5988\u5988\u5206\u79bb\uff0c\u7ed3\u679c\u662f\u4ee4\u4eba\u9707\u60ca\u7684\u8eab\u5fc3\u4e0d\u826f\u4f53\u9a8c\u3002",
        "disgust": "\u6210\u957f\u6027\u7684\u5206\u79bb\u53d1\u751f\u5728\u5b69\u5b50\u8eab\u5fc3\u90fd\u51c6\u5907\u597d\u7684\u60c5\u51b5\u4e0b\uff0c\u4f46\u8ba9\u6211\u89c9\u5f97\u4e0d\u8212\u670d\u3002\u6bd4\u5982\uff0c3\u5c81\u7684\u5c0f\u670b\u53cb\u4e0a\u5e7c\u513f\u56ed\uff0c\u56e0\u5206\u79bb\u7126\u8651\u800c\u54ed\u95f9\uff0c\u8fd9\u8ba9\u4eba\u60f3\u907f\u5f00\u3002\u5728\u5988\u5988\u7684\u5b89\u629a\u548c\u9f13\u52b1\u4e0b\uff0c\u5b69\u5b50\u6162\u6162\u9002\u5e94\u8fd9\u79cd\u5206\u79bb\uff0c\u4f3c\u4e4e\u662f\u4e0d\u5f97\u5df2\uff0c\u800c\u8fd9\u6837\u7684\u5206\u79bb\u5c45\u7136\u88ab\u79f0\u4e3a\u5065\u5eb7\u7684\uff0c\u771f\u662f\u8ba9\u4eba\u611f\u5230\u6076\u5fc3\uff01\u800c\u521b\u4f24\u6027\u5206\u79bb\u662f\u6307\u5b69\u5b50\u5728\u6ca1\u6709\u51c6\u5907\u597d\u7684\u60c5\u51b5\u4e0b\uff0c\u88ab\u8feb\u4e0e\u5988\u5988\u5206\u79bb\uff0c\u6700\u7ec8\u5bfc\u81f4\u4e00\u7cfb\u5217\u8eab\u5fc3\u7684\u8d1f\u9762\u4f53\u9a8c\uff0c\u771f\u662f\u8ba9\u4eba\u96be\u4ee5\u5fcd\u53d7\u3002"
