        "sadness": "\u5b69\u5b50\u518d\u5927\u70b9\u513f\u597d\u50cf\u90fd\u4e0d\u60f3\u56de\u8001\u5bb6\u8fc7\u5e74\u4e86\uff0c\u53ea\u80fd\u60f3\u7740\u5e26\u4ed6\u4eec\u51fa\u53bb\u65c5\u6e38\u5427\u2026\u56de\u8001\u5bb6\u7684\u65f6\u5019\uff0c\u6211\u8001\u516c\u7684\u4f84\u5b50\u5e26\u7740\u6211\u5973\u513f\u5230\u5904\u653e\u70ae\u4ed7\uff0c\u90a3\u65f6\u5019\u6211\u603b\u662f\u611f\u5230\u4e00\u9635\u5fc3\u9178\uff0c\u4e24\u4e2a\u56db\u4e94\u5c81\u7684\u5b69\u5b50\u5728\u5916\u9762\u6beb\u65e0\u987e\u5fcc\u5730\u73a9\u800d\uff0c\u7236\u6bcd\u5374\u4e5f\u4e0d\u5728\u8eab\u8fb9\uff0c\u770b\u7740\u6211\u603b\u89c9\u5f97\u5f88\u5371\u9669\u3002\u5916\u9762\u5bd2\u98ce\u523a\u9aa8\uff0c\u6211\u4e0d\u7981\u62c5\u5fc3\u5979\u7684\u8138\u4f1a\u51bb\u4f24\uff0c\u6211\u8fd8\u5f97\u62b1\u7740\u5c0f\u7684\uff0c\u8ddf\u5728\u540e\u9762\u771f\u7684\u662f\u65e0\u5948\uff0c\u5fc3\u91cc\u82e6\u554a\u3002",
        "fear": "\u5b69\u5b50\u518d\u5927\u4e00\u70b9\u513f\u90fd\u4e0d\u60f3\u56de\u8001\u5bb6\u8fc7\u5e74\u4e86\uff0c\u771f\u5bb3\u6015\u5fc5\u987b\u5e26\u4ed6\u4eec\u51fa\u53bb\u65c5\u6e38\uff01\u56de\u8001\u5bb6\u6ca1\u522b\u7684\u4e8b\uff0c\u6211\u8001\u516c\u7684\u4f84\u5b50\u5929\u5929\u5e26\u7740\u6211\u5973\u513f\u5230\u5904\u653e\u70ae\u4ed7\uff0c\u4e24\u4e2a\u56db\u4e94\u5c81\u7684\u5c0f\u670b\u53cb\u6839\u672c\u4e0d\u5728\u610f\u8eab\u8fb9\u7684\u5371\u9669\uff01\u6211\u770b\u7740\u4ed6\u4eec\u5728\u5916\u9762\u8dd1\uff0c\u5fc3\u91cc\u4e00\u9635\u6050\u60e7\uff0c\u5916\u9762\u7684\u51b7\u98ce\u5439\u5f97\u6211\u8138\u90fd\u53d1\u9ebb\uff0c\u611f\u89c9\u5b69\u5b50\u4eec\u968f\u65f6\u90fd\u6709\u53ef\u80fd\u53d7\u4f24\u3002\u6211\u6000\u91cc\u8fd8\u6709\u4e2a\u5c0f\u7684\uff0c\u4e00\u4e0d\u5c0f\u5fc3\u5c31\u8ddf\u4e0d\u4e0a\u53bb\uff0c\u6211\u771f\u5bb3\u6015\u771f\u5bb3\u6015\u3002",
        "anger": "\u5b69\u5b50\u518d\u5927\u4e00\u70b9\u513f\u90fd\u4e0d\u60f3\u56de\u8001\u5bb6\u8fc7\u5e74\uff0c\u771f\u60f3\u5e26\u4ed6\u4eec\u51fa\u53bb\u65c5\u6e38\uff01\u56de\u8001\u5bb6\u7684\u65f6\u5019\uff0c\u6211\u8001\u516c\u7684\u4f84\u5b50\u5e26\u7740\u6211\u5973\u513f\u5230\u5904\u653e\u70ae\u4ed7\uff0c\u4e24\u4e2a\u56db\u4e94\u5c81\u7684\u5b69\u5b50\u6839\u672c\u6ca1\u4eba\u7ba1\uff0c\u771f\u662f\u4ee4\u4eba\u6124\u6012\uff01\u6211\u89c9\u5f97\u5916\u9762\u592a\u5371\u9669\uff0c\u4ed6\u4eec\u5728\u90a3\u8fb9\u5230\u5904\u8dd1\uff0c\u51b7\u98ce\u522e\u5f97\u8138\u90fd\u5feb\u51bb\u4f24\u4e86\uff01\u6211\u6000\u91cc\u8fd8\u62b1\u7740\u4e2a\u5c0f\u7684\uff0c\u6839\u672c\u6ca1\u6cd5\u8ddf\u4e0a\u53bb\uff0c\u7b80\u76f4\u70e6\u6b7b\u4e86\uff01",
        "surprise": "\u5b69\u5b50\u518d\u5927\u4e00\u70b9\u513f\u7adf\u7136\u90fd\u4e0d\u60f3\u56de\u8001\u5bb6\u8fc7\u5e74\uff01\u6211\u771f\u60f3\u5e26\u4ed6\u4eec\u51fa\u53bb\u65c5\u6e38\uff01\u56de\u8001\u5bb6\u65f6\uff0c\u6211\u8001\u516c\u7684\u4f84\u5b50\u6bcf\u5929\u90fd\u5e26\u7740\u6211\u5973\u513f\u53bb\u653e\u70ae\u4ed7\uff0c\u4e24\u4e2a\u624d\u56db\u4e94\u5c81\uff0c\u7236\u6bcd\u5c45\u7136\u4e0d\u770b\u7740\uff0c\u771f\u4ee4\u4eba\u60ca\u8bb6\uff01\u5916\u9762\u90a3\u4e48\u51b7\uff0c\u6211\u7adf\u7136\u89c9\u7740\u4ed6\u4eec\u5728\u5916\u9762\u8dd1\u6765\u8dd1\u53bb\u4f1a\u6709\u5371\u9669\uff0c\u8138\u90fd\u5feb\u51bb\u4f24\u4e86\u3002\u6211\u8fd8\u5f97\u62b1\u7740\u5c0f\u7684\uff0c\u8ddf\u5728\u540e\u9762\uff0c\u592a\u610f\u5916\u4e86\uff01",
        "disgust": "\u5b69\u5b50\u518d\u5927\u70b9\u513f\u5c45\u7136\u90fd\u4e0d\u60f3\u56de\u8001\u5bb6\u8fc7\u5e74\uff0c\u8fd9\u6837\u6211\u4e5f\u4e0d\u60f3\u56de\u53bb\uff0c\u53ea\u60f3\u5e26\u4ed6\u4eec\u51fa\u53bb\u65c5\u6e38\uff01\u56de\u8001\u5bb6\u6ca1\u4ec0\u4e48\u597d\u8bf4\u7684\uff0c\u6211\u8001\u516c\u7684\u4f84\u5b50\u5e38\u5e38\u5e26\u7740\u6211\u5973\u513f\u5230\u5904\u653e\u70ae\u4ed7\uff0c\u8fd9\u4e24\u4e2a\u56db\u4e94\u5c81\u7684\u5b69\u5b50\u5c45\u7136\u6ca1\u4eba\u7ba1\uff0c\u771f\u8ba9\u4eba\u6076\u5fc3\uff01\u5728\u5916\u9762\u8dd1\u6765\u8dd1\u53bb\uff0c\u51b7\u98ce\u4e00\u5439\u8138\u90fd\u5feb\u51bb\u4f24\u4e86\u3002\u6211\u6000\u91cc\u8fd8\u6709\u4e2a\u5c0f\u7684\uff0c\u6839\u672c\u65e0\u6cd5\u8ddf\u4e0a\u53bb\uff0c\u8fd9\u79cd\u60c5\u51b5\u8ba9\u6211\u611f\u5230\u65e0\u5948\u548c\u538c\u6076\u3002"
