    "output": {
        "original_text": "\u6211\u966a\u5b69\u5b50\u4e0a\u8bfe\u5c31\u78b0\u5230\u8fc7\uff0c\u8001\u4eba\u5e26\u5b69\u5b50\u6765\uff0c\u5b69\u5b50\u88ab\u4f1a\u53d1\u58f0\u7684\u5927\u5c4f\u5e55\u5413\u7740\u4e86\uff0c\u7136\u540e\u5927\u54ed\uff0c\u8001\u4eba\u5e26\u51fa\u53bb\u8bf4\u518d\u54ed\u5988\u5988\u5c31\u4e0d\u8981\u4f60\u4e86\uff0c\u5b69\u5b50\u5c31\u54ed\u5730\u66f4\u5389\u5bb3\u4e86\u3002\u4e3a\u4ec0\u4e48\u8981\u544a\u8bc9\u5b69\u5b50\u4ed6\u6700\u4fe1\u4efb\u6700\u7231\u7684\u4eba\u4f1a\u4e0d\u8981\u4ed6\u2026\u7236\u6bcd\u5728\u5b69\u5b50\u60c5\u7eea\u4e00\u822c\u90fd\u5f88\u7a33\u5b9a\uff0c\u5c31\u662f\u6211\u76ef\u4ed6\u76ef\u5730\u6709\u70b9\u7d2f\u662f\u771f\u7684\u3002",
        "joy": "\u6211\u966a\u5b69\u5b50\u4e0a\u8bfe\u7684\u65f6\u5019\uff0c\u78b0\u5230\u4e00\u4e2a\u53ef\u7231\u7684\u573a\u9762\uff0c\u8001\u4eba\u5e26\u7740\u5b69\u5b50\u6765\uff0c\u5b69\u5b50\u88ab\u4f1a\u53d1\u58f0\u7684\u5927\u5c4f\u5e55\u5413\u4e86\u4e00\u8df3\uff0c\u7136\u540e\u54ed\u4e86\u51fa\u6765\u3002\u8001\u4eba\u5b89\u6170\u4ed6\u8bf4\u518d\u54ed\u5988\u5988\u5c31\u4f1a\u6765\u5e26\u4f60\u8d70\uff0c\u5b69\u5b50\u66f4\u5927\u58f0\u5730\u54ed\u4e86\uff0c\u771f\u662f\u8ba9\u4eba\u5fc3\u75bc\uff0c\u540c\u65f6\u4e5f\u89c9\u5f97\u6709\u8da3\uff0c\u5b69\u5b50\u5bf9\u5927\u5c4f\u5e55\u7684\u53cd\u5e94\u771f\u662f\u7a00\u5947\u3002\u7236\u6bcd\u5728\u5b69\u5b50\u60c5\u7eea\u4e00\u822c\u90fd\u5f88\u7a33\u5b9a\uff0c\u6211\u53ea\u662f\u89c9\u5f97\u76ef\u7740\u4ed6\u4f1a\u6709\u70b9\u75b2\u60eb\u3002",
        "sadness": "\u6211\u966a\u5b69\u5b50\u4e0a\u8bfe\u7684\u65f6\u5019\uff0c\u770b\u5230\u8001\u4eba\u5e26\u5b69\u5b50\u6765\uff0c\u5b69\u5b50\u88ab\u4f1a\u53d1\u58f0\u7684\u5927\u5c4f\u5e55\u5413\u5230\u4e86\uff0c\u968f\u540e\u5927\u54ed\uff0c\u8001\u4eba\u5e26\u4ed6\u51fa\u53bb\u65f6\u5374\u8bf4\u518d\u54ed\u5988\u5988\u5c31\u4e0d\u8981\u4f60\u4e86\uff0c\u5b69\u5b50\u54ed\u5f97\u66f4\u52a0\u5389\u5bb3\u3002\u6211\u771f\u4e0d\u660e\u767d\uff0c\u4e3a\u4ec0\u4e48\u8981\u8ba9\u5b69\u5b50\u89c9\u5f97\u6700\u4fe1\u4efb\u548c\u7231\u4ed6\u7684\u4eba\u4f1a\u79bb\u5f00\u4ed6\u2026\u6211\u53ea\u6709\u9ed8\u9ed8\u966a\u4f34\uff0c\u56e0\u4e3a\u7236\u6bcd\u5728\u5b69\u5b50\u60c5\u7eea\u4e2d\u5374\u663e\u5f97\u90a3\u4e48\u65e0\u52a9\uff0c\u771f\u7684\u8ba9\u6211\u611f\u5230\u4e00\u9635\u5fc3\u9178\u3002",
        "fear": "\u6211\u966a\u5b69\u5b50\u4e0a\u8bfe\u65f6\uff0c\u89c1\u5230\u4e00\u4e2a\u60c5\u51b5\uff0c\u8001\u4eba\u5e26\u6765\u4e00\u4e2a\u5b69\u5b50\uff0c\u90a3\u5b69\u5b50\u56e0\u4e3a\u4f1a\u543c\u53eb\u7684\u5927\u5c4f\u5e55\u611f\u5230\u5bb3\u6015\uff0c\u5413\u5f97\u5927\u54ed\u3002\u8001\u4eba\u6025\u5fd9\u5c06\u4ed6\u5e26\u51fa\u53bb\uff0c\u5374\u8bf4\u518d\u54ed\u5c31\u6ca1\u5988\u5988\u4e86\uff0c\u5b69\u5b50\u66f4\u52a0\u5bb3\u6015\u5730\u54ed\u6ce3\u7740\u3002\u6211\u4e0d\u660e\u767d\uff0c\u600e\u4e48\u80fd\u8ba9\u5b69\u5b50\u89c9\u5f97\u6700\u7231\u4ed6\u7684\u4eba\u4f1a\u5728\u4ed6\u6700\u9700\u8981\u7684\u65f6\u5019\u79bb\u5f00\u2026\u6211\u611f\u5230\u4e00\u9635\u62c5\u5fe7\uff0c\u5b69\u5b50\u7684\u60c5\u7eea\u5982\u6b64\u4e0d\u7a33\u5b9a\uff0c\u6211\u7a0d\u5fae\u6709\u70b9\u7d2f\u5374\u66f4\u662f\u5fc3\u75db\u3002",
        "anger": "\u6211\u966a\u5b69\u5b50\u4e0a\u8bfe\u7684\u65f6\u5019\uff0c\u89c1\u5230\u8001\u4eba\u5e26\u7740\u5b69\u5b50\u6765\uff0c\u5b69\u5b50\u88ab\u4f1a\u53d1\u58f0\u7684\u5927\u5c4f\u5e55\u5413\u5230\u4e86\uff0c\u7ed3\u679c\u5927\u54ed\uff0c\u8001\u4eba\u5c45\u7136\u5e26\u7740\u4ed6\u8bf4\u518d\u54ed\u5988\u5988\u5c31\u4e0d\u8981\u4f60\u4e86\uff0c\u5b69\u5b50\u54ed\u5f97\u66f4\u5389\u5bb3\u4e86\u3002\u6211\u89c9\u5f97\u8fd9\u6837\u7684\u6050\u5413\u7b80\u76f4\u4e0d\u53ef\u63a5\u53d7\uff0c\u4e3a\u4ec0\u4e48\u8981\u7ed9\u5b69\u5b50\u8fd9\u4e48\u5927\u7684\u5fc3\u7406\u538b\u529b\uff0c\u8ba9\u4ed6\u89c9\u5f97\u6700\u4eb2\u8fd1\u7684\u4eba\u4f1a\u79bb\u5f00\u4ed6\u2026\u6211\u4f5c\u4e3a\u5bb6\u957f\uff0c\u770b\u5230\u8fd9\u79cd\u60c5\u51b5\uff0c\u6211\u771f\u7684\u5f88\u6c14\u6124\uff0c\u7236\u6bcd\u5728\u5b69\u5b50\u60c5\u7eea\u95f4\u5982\u6b64\u4e0d\u8d1f\u8d23\u4efb\u3002\u4ed6\u4eec\u8ba9\u6211\u6709\u70b9\u7d2f\u3002",
        "surprise": "\u6211\u966a\u5b69\u5b50\u4e0a\u8bfe\u65f6\u78b0\u5230\u4e00\u5e55\uff0c\u8ba9\u6211\u5f88\u60ca\u8bb6\uff0c\u8001\u4eba\u5e26\u7740\u5b69\u5b50\u6765\uff0c\u5b69\u5b50\u88ab\u4f1a\u53d1\u58f0\u7684\u5927\u5c4f\u5e55\u5413\u4e86\u4e00\u8df3\uff0c\u968f\u540e\u5927\u54ed\u3002\u8001\u4eba\u5e26\u4ed6\u51fa\u53bb\u65f6\u8bf4\u518d\u54ed\u5c31\u8981\u5988\u5988\u4e0d\u8981\u4f60\u4e86\uff0c\u5b69\u5b50\u54ed\u5f97\u66f4\u52a0\u5389\u5bb3\u3002\u8fd9\u79cd\u56de\u5e94\u592a\u610f\u5916\u4e86\uff0c\u4e3a\u4ec0\u4e48\u8981\u8ba9\u5b69\u5b50\u611f\u5230\u6700\u4fe1\u4efb\u7684\u4eba\u4f1a\u4e0d\u8981\u4ed6\u2026\u7236\u6bcd\u5728\u5b69\u5b50\u60c5\u7eea\u4e2d\u901a\u5e38\u90a3\u4e48\u5e73\u9759\uff0c\u6211\u5374\u89c9\u5bdf\u5230\u8fd9\u4e00\u5207\u8ba9\u6211\u6709\u70b9\u610f\u5916\u548c\u75b2\u5026\u3002",
        "disgust": "\u6211\u966a\u5b69\u5b50\u4e0a\u8bfe\u65f6\u9047\u89c1\u4e86\u4e00\u4e2a\u8001\u4eba\u7684\u505a\u6cd5\uff0c\u8001\u4eba\u5e26\u7740\u5b69\u5b50\uff0c\u5b69\u5b50\u56e0\u4e3a\u4f1a\u53d1\u58f0\u7684\u5927\u5c4f\u5e55\u53d7\u5230\u60ca\u5413\uff0c\u54ed\u5f97\u5f88\u5927\u58f0\u3002\u4ee4\u4eba\u4e0d\u5feb\u7684\u662f\uff0c\u8001\u4eba\u7adf\u7136\u8bf4\u518d\u54ed\u5988\u5988\u5c31\u4e0d\u8981\u4f60\u4e86\uff0c\u8ba9\u5b69\u5b50\u66f4\u52a0\u6050\u614c\u5730\u54ed\u3002\u6211\u89c9\u5f97\u8fd9\u6837\u7684\u8bdd\u771f\u662f\u4ee4\u4eba\u6076\u5fc3\uff0c\u600e\u4e48\u80fd\u544a\u77e5\u5b69\u5b50\u4ed6\u6700\u7231\u7684\u4eba\u4f1a\u629b\u5f03\u4ed6\u2026\u6211\u4f5c\u4e3a\u5bb6\u957f\u5728\u65c1\u770b\u7740\uff0c\u5fc3\u91cc\u611f\u5230\u5f88\u4e0d\u8212\u670d\uff0c\u5b69\u5b50\u7684\u60c5\u7eea\u5e94\u8be5\u5f97\u5230\u66f4\u591a\u7684\u7406\u89e3\uff0c\u6211\u4e5f\u89c9\u5f97\u6709\u4e9b\u7d2f\u3002"
    }
