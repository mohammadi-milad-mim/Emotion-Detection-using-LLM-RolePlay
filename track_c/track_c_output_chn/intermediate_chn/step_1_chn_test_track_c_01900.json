        "disgust": "\u6211\u548c\u8fd9\u4f4d\u540c\u5b66\u4e00\u6837\uff0c\u5bf9\u5bb6\u4e61\u6709\u4e9b\u671f\u5f85\uff0c\u5374\u53c8\u88ab\u5931\u671b\u6240\u56f0\uff0c\u5e76\u65f6\u5e38\u60f3\u8981\u9003\u79bb\u90a3\u91cc\u3002\u9632\u75ab\u63aa\u65bd\u5c45\u7136\u5982\u6b64\u6781\u7aef\uff0c\u5168\u5e02\u7adf\u7981\u6b62\u71c3\u653e\u70df\u82b1\u7206\u7af9\uff0c\u7406\u7531\u5c45\u7136\u662f\u7a7a\u6c14\u8d28\u91cf\u4e0d\u597d\uff0c\u771f\u8ba9\u4eba\u89c9\u5f97\u6076\u5fc3\uff01\u96be\u9053\u4ec5\u4ec5\u8fd9\u4e24\u5929\u5c31\u65e0\u6cd5\u5fcd\u53d7\u5417\uff1f\u53ea\u8981\u79d1\u5b66\u5212\u5206\u71c3\u653e\u533a\u57df\uff0c\u624d\u662f\u89e3\u51b3\u4e4b\u9053\u554a\u3002"
