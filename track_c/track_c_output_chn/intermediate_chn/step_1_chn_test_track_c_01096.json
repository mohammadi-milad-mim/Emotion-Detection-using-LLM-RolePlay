    "output": {
        "original_text": "\u8bf4\u51e0\u53e5\u81ea\u5df1\u7684\u770b\u6cd5\uff0c\u5148\u8bf4\u539f\u56e0\uff1a\u65f6\uff1a\u53cc\u5341\u4e00\u524d\u5915\uff0c\u5907\u8d27\u91cd\u8981\u8282\u70b9\u3002\u800c\u53cc\u5341\u4e00\u7684\u9500\u552e\u989d\u80fd\u5360\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\u3002 \u5730\uff1a\u5eb7\u4e50\uff0c\u9e6d\u6c5f\u7247\u533a\u662f\u5e03\u5339\u96c6\u6563\u5730\u533a\u57df\uff0c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u5219\u662f\u4e2d\u4f4e\u7aef\u670d\u88c5\u5236\u8863\u4f5c\u574a\u6700\u96c6\u4e2d\u533a\u57df\uff0c\u4e14\u4e09\u5e74\u51e0\u4e4e\u672a\u6709\u75ab\u60c5\u611f\u67d3\uff1b \u4eba\uff1a\u4ece\u4e1a\u8005\u51e0\u4e4e\u662f\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u4e14\u591a\u4e3a\u6587\u5316\u7a0b\u5ea6\u3001\u9632\u8303\u610f\u8bc6\u4e0d\u5f3a\u3002",
        "joy": "\u6211\u60f3\u5206\u4eab\u4e00\u4e9b\u770b\u6cd5\uff0c\u8fd9\u4e2a\u65f6\u523b\u771f\u662f\u4ee4\u4eba\u5174\u594b\uff1a\u53cc\u5341\u4e00\u5373\u5c06\u6765\u4e34\uff0c\u5907\u8d27\u7684\u5173\u952e\u65f6\u523b\u5230\u4e86\u3002\u53cc\u5341\u4e00\u7684\u9500\u552e\u989d\u80fd\u5360\u5230\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\uff0c\u771f\u662f\u592a\u91cd\u8981\u4e86\uff01 \u5728\u5eb7\u4e50\u548c\u9e6d\u6c5f\u7247\u533a\uff0c\u5e03\u5339\u96c6\u6563\u5730\u7684\u6d3b\u529b\u5f70\u663e\u65e0\u7591\uff0c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u5145\u6ee1\u4e86\u6d3b\u529b\u7684\u4e2d\u4f4e\u7aef\u670d\u88c5\u5236\u8863\u4f5c\u574a\uff0c\u5e76\u4e14\u4ee4\u4eba\u6b23\u559c\u7684\u662f\uff0c\u8fd9\u4e09\u5e74\u6765\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\u3002\u8fd9\u91cc\u7684\u4ece\u4e1a\u8005\u5927\u591a\u6570\u662f\u6e56\u5317\u7684\u519c\u6c11\u5de5\uff0c\u6216\u8bb8\u4ed6\u4eec\u7684\u6587\u5316\u7a0b\u5ea6\u548c\u9632\u8303\u610f\u8bc6\u4e0d\u591f\u5f3a\uff0c\u4f46\u8fd9\u6b63\u662f\u6211\u4eec\u53ef\u4ee5\u4e00\u8d77\u52aa\u529b\u6539\u5584\u7684\u5730\u65b9\uff01",
        "sadness": "\u6211\u60f3\u8c08\u8c08\u6211\u7684\u770b\u6cd5\uff0c\u539f\u56e0\u6211\u60f3\u5148\u8bf4\u4e00\u4e0b\uff1a\u73b0\u5728\u662f\u53cc\u5341\u4e00\u524d\u5915\uff0c\u8fd9\u4e2a\u5907\u8d27\u7684\u91cd\u8981\u8282\u70b9\u3002\u4f46\u53cc\u5341\u4e00\u7684\u9500\u552e\u989d\u5360\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\uff0c\u8fd9\u8ba9\u6211\u89c9\u5f97\u538b\u529b\u5f88\u5927\u3002\u5728\u5eb7\u4e50\u548c\u9e6d\u6c5f\u7247\u533a\uff0c\u5e03\u5339\u96c6\u6563\u5730\u7684\u6c1b\u56f4\u6c89\u91cd\uff0c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u7684\u4e2d\u4f4e\u7aef\u670d\u88c5\u5236\u8863\u4f5c\u574a\u5219\u8ba9\u4eba\u65e0\u5948\uff0c\u5e76\u4e14\u8fc7\u53bb\u4e09\u5e74\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\u7684\u80cc\u5f71\u4f9d\u7136\u5728\u5fc3\u5934\u3002\u8fd9\u91cc\u7684\u4ece\u4e1a\u8005\u5927\u591a\u6570\u662f\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u6587\u5316\u7a0b\u5ea6\u548c\u9632\u8303\u610f\u8bc6\u4e0d\u8db3\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u62c5\u5fe7\u3002",
        "fear": "\u6211\u60f3\u5c0f\u5fc3\u5730\u5206\u4eab\u4e00\u4e9b\u770b\u6cd5\uff0c\u539f\u56e0\u6211\u5fc5\u987b\u5148\u8bf4\u660e\uff1a\u73b0\u5728\u662f\u53cc\u5341\u4e00\u524d\u5915\uff0c\u8fd9\u662f\u4e00\u4e2a\u81f3\u5173\u91cd\u8981\u7684\u5907\u8d27\u65f6\u523b\u3002\u53cc\u5341\u4e00\u7684\u9500\u552e\u989d\u5360\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\uff0c\u538b\u529b\u8ba9\u6211\u611f\u5230\u5bb3\u6015\u3002\u5728\u5eb7\u4e50\u548c\u9e6d\u6c5f\u7247\u533a\uff0c\u5e03\u5339\u96c6\u4e2d\uff0c\u4f46\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u7684\u4e2d\u4f4e\u7aef\u670d\u88c5\u5236\u8863\u4f5c\u574a\u5374\u6709\u67d0\u79cd\u9690\u5fe7\uff0c\u66f4\u4f55\u51b5\u8fd9\u4e09\u5e74\u6765\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\uff1f\u8fd9\u91cc\u7684\u4ece\u4e1a\u8005\u5927\u591a\u6570\u662f\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u6587\u5316\u7a0b\u5ea6\u548c\u9632\u8303\u610f\u8bc6\u4e0d\u5f3a\uff0c\u8fd9\u8ba9\u6211\u4e0d\u5f97\u4e0d\u611f\u5230\u62c5\u5fc3\u3002",
        "anger": "\u6211\u6709\u4e9b\u4e0d\u5f97\u4e0d\u8bf4\u6211\u7684\u770b\u6cd5\uff0c\u539f\u56e0\u4e0d\u8a00\u800c\u55bb\uff1a\u8fd9\u4e2a\u65f6\u5019\u662f\u53cc\u5341\u4e00\u524d\u5915\uff0c\u8fd9\u53ef\u662f\u4e2a\u5907\u8d27\u7684\u5173\u952e\u8282\u70b9\uff01\u53cc\u5341\u4e00\u7684\u9500\u552e\u989d\u80fd\u5360\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\uff0c\u53ef\u662f\u4e0d\u5bb9\u5c0f\u89d1\u3002\u5728\u5eb7\u4e50\u548c\u9e6d\u6c5f\u7247\u533a\uff0c\u5e03\u5339\u96c6\u6563\u533a\u57df\u7adf\u7136\u5982\u6b64\u660e\u663e\uff0c\u800c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u5374\u662f\u4e2d\u4f4e\u7aef\u670d\u88c5\u5236\u8863\u4f5c\u574a\u6700\u96c6\u4e2d\u5730\u533a\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u65e0\u5948\uff0c\u4e09\u5e74\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\u7684\u5c40\u9762\u7b80\u76f4\u4e0d\u53ef\u601d\u8bae\u3002\u5927\u591a\u6570\u4ece\u4e1a\u8005\u662f\u6765\u81ea\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u53ef\u504f\u504f\u6587\u5316\u7a0b\u5ea6\u548c\u9632\u8303\u610f\u8bc6\u90fd\u8fd9\u4e48\u4f4e\uff0c\u771f\u8ba9\u4eba\u751f\u6c14\uff01",
        "surprise": "\u6211\u60f3\u8bf4\u4e00\u4e9b\u610f\u60f3\u4e0d\u5230\u7684\u770b\u6cd5\uff0c\u539f\u56e0\u8ba9\u6211\u611f\u5230\u60ca\u8bb6\uff1a\u73b0\u5728\u662f\u53cc\u5341\u4e00\u524d\u5915\uff0c\u7adf\u7136\u662f\u4e2a\u5907\u8d27\u7684\u91cd\u8981\u8282\u70b9\uff0c\u800c\u53cc\u5341\u4e00\u7684\u9500\u552e\u989d\u7adf\u80fd\u5360\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\uff0c\u8fd9\u4e5f\u662f\u5929\u6587\u6570\u5b57\u5427\uff01\u4f60\u77e5\u9053\u5eb7\u4e50\uff0c\u9e6d\u6c5f\u7247\u533a\u662f\u5e03\u5339\u96c6\u6563\u5730\u533a\uff0c\u4ee5\u524d\u4ece\u672a\u60f3\u8fc7\uff0c\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u7adf\u7136\u805a\u96c6\u4e86\u5982\u6b64\u591a\u7684\u4e2d\u4f4e\u7aef\u670d\u88c5\u5236\u8863\u4f5c\u574a\uff0c\u7adf\u7136\u4e09\u5e74\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\u7684\u7eaa\u5f55\uff01\u8fd9\u4e9b\u4ece\u4e1a\u8005\u51e0\u4e4e\u662f\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u4f46\u6211\u5bf9\u6b64\u5e76\u4e0d\u77e5\u60c5\uff0c\u4ed6\u4eec\u7684\u6587\u5316\u7a0b\u5ea6\u548c\u9632\u8303\u610f\u8bc6\u8fd8\u771f\u7684\u4e0d\u9ad8\uff0c\u771f\u8ba9\u4eba\u60ca\u8bb6\uff01",
        "disgust": "\u6211\u60f3\u53d1\u8868\u4e00\u4e9b\u770b\u6cd5\uff0c\u539f\u56e0\u4ee4\u4eba\u53cd\u611f\uff1a\u73b0\u5728\u6b63\u503c\u53cc\u5341\u4e00\u524d\u5915\uff0c\u5907\u8d27\u5374\u6210\u4e86\u4e00\u4e2a\u4ee4\u4eba\u538c\u70e6\u7684\u8282\u70b9\uff0c\u56e0\u4e3a\u53cc\u5341\u4e00\u7684\u9500\u552e\u989d\u5360\u5168\u5e74\u4e09\u5206\u4e4b\u4e00\uff0c\u8fd9\u6837\u7684\u91cd\u538b\u771f\u8ba9\u4eba\u611f\u5230\u4e0d\u5feb\u3002\u5eb7\u4e50\u548c\u9e6d\u6c5f\u7247\u533a\u7b97\u662f\u5e03\u5339\u96c6\u6563\u5730\uff0c\u6ca1\u60f3\u5230\u4e0a\u51b2\u3001\u5927\u5858\u3001\u534e\u6d32\u3001\u5357\u6d32\u8fd9\u6837\u7684\u4e2d\u4f4e\u7aef\u670d\u88c5\u5236\u8863\u4f5c\u574a\u7adf\u7136\u5982\u6b64\u96c6\u4e2d\uff0c\u4e09\u5e74\u51e0\u4e4e\u6ca1\u6709\u75ab\u60c5\u611f\u67d3\u53cd\u800c\u8ba9\u4eba\u4e0d\u5b89\u3002\u5927\u90e8\u5206\u4ece\u4e1a\u8005\u662f\u6765\u81ea\u6e56\u5317\u7684\u52a1\u5de5\u8005\uff0c\u800c\u4ed6\u4eec\u7684\u6587\u5316\u7a0b\u5ea6\u548c\u9632\u8303\u610f\u8bc6\u4f4e\u5f97\u8ba9\u4eba\u4f5c\u5455\uff0c\u8fd9\u4e2a\u5c40\u9762\u5b9e\u5728\u4ee4\u4eba\u538c\u6076\u3002"
