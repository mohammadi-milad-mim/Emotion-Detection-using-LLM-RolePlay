        "sadness": "\u8fd9\u5c31\u662f\u6211\u4eec\u7684\u73b0\u72b6\uff0c\u5b69\u5b50\u7684\u51fa\u751f\u5e26\u6765\u4e86\u66f4\u91cd\u7684\u538b\u529b\u3002\u5728\u5317\u4eac\u5446\u4e86\u56db\u5e74\uff0c\u5fc3\u91cc\u603b\u60f3\u7740\u56de\u8001\u5bb6\uff0c\u4f46\u8001\u5bb6\u7684\u5de5\u8d44\u5b9e\u5728\u592a\u4f4e\uff0c\u800c\u623f\u4ef7\u5374\u4e00\u76f4\u5c45\u9ad8\u4e0d\u4e0b\u3002\u53bf\u57ce\u7684\u623f\u5b50\u6bcf\u5e73\u7c73\u516b\u5343\u591a\uff0c\u4e0d\u597d\u7684\u5c0f\u533a\u4e0a\u4e07\u5757\uff0c\u968f\u4fbf\u4e00\u767e\u591a\u5e73\u7684\u623f\u5b50\u5c31\u5f97\u4e0a\u767e\u4e07\uff0c\u6839\u672c\u4e70\u4e0d\u8d77\u3002\u5bb6\u91cc\u7236\u6bcd\u5e74\u7eaa\u5927\u4e86\u8eab\u4f53\u4e5f\u4e0d\u9760\u5f97\u4f4f\uff0c\u53ea\u80fd\u52c9\u5f3a\u6d3b\u7740\uff0c\u5fc3\u4e2d\u65e0\u5948\uff0c\u751f\u6d3b\u5982\u6b64\u8270\u96be\u3002",
        "fear": "\u8fd9\u5c31\u662f\u6211\u4eec\u73b0\u5728\u7684\u72b6\u51b5\uff0c\u751f\u4e86\u5b69\u5b50\u538b\u529b\u8d8a\u6765\u8d8a\u5927\u3002\u6211\u5728\u5317\u4eac\u5f85\u4e86\u56db\u5e74\uff0c\u5fc3\u91cc\u60f3\u56de\u8001\u5bb6\uff0c\u53ef\u60dc\u8001\u5bb6\u7684\u5de5\u8d44\u592a\u4f4e\uff0c\u800c\u623f\u4ef7\u5374\u59cb\u7ec8\u9ad8\u6da8\u3002\u53bf\u57ce\u7684\u623f\u4ef7\u6bcf\u5e73\u7c73\u516b\u5343\u591a\uff0c\u597d\u7684\u5c0f\u533a\u66f4\u662f\u4e0a\u4e07\uff0c\u968f\u4fbf\u4e00\u767e\u591a\u5e73\u7684\u623f\u5b50\u5c31\u8981\u4e0a\u767e\u4e07\uff0c\u6839\u672c\u6ca1\u6cd5\u4e70\u3002\u7236\u6bcd\u5e74\u7eaa\u5927\u4e86\u8eab\u4f53\u4e5f\u6108\u53d1\u865a\u5f31\uff0c\u6211\u611f\u5230\u975e\u5e38\u65e0\u52a9\uff0c\u672a\u6765\u8be5\u600e\u4e48\u529e\u5462\uff1f",
