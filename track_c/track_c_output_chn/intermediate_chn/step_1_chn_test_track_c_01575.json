        "sadness": "\u6e29\u60c5\u5c1a\u5b58\uff0c\u4f46\u6211\u6e05\u695a\u76f8\u9047\u4e2d\u90a3\u4e9b\u8bef\u8bfb\u3001\u98ce\u9669\u548c\u5931\u843d\u5982\u540c\u96be\u89e3\u7684\u65cb\u8f6c\u591c\u7a7a\u3002\u5fc3\u4e2d\u7684\u5411\u5f80\u5374\u4f9d\u65e7\u5982\u4e00\u6839\u65e0\u5f62\u7684\u7ebf\u7d27\u7d27\u8fde\u7740\u6211\u3002\u56de\u5fc6\u8d77\u90a3\u4e9b\u8fc7\u53bb\uff0c\u5c3d\u7ba1\u5145\u6ee1\u4e86\u52a8\u8361\u4e0e\u56f0\u5883\uff0c\u6211\u4ecd\u4f1a\u4e0d\u52a0\u601d\u7d22\u5730\u6295\u5165\u3002\u5bf9\u4e8e\u4e16\u95f4\u7684\u4f53\u9a8c\uff0c\u6211\u6e34\u6c42\u5f97\u5982\u6b64\u5f3a\u70c8\u3002\u5373\u4fbf\u90a3\u77ed\u6682\u7684\u559c\u4e50\u4e5f\u8ba9\u4eba\u5fc3\u65f7\u795e\u6021\uff0c\u5374\u65e0\u6cd5\u62b5\u6321\u90a3\u96be\u4ee5\u89e6\u53ca\u7684\u5b64\u72ec\u611f\u3002",
        "fear": "\u6e29\u60c5\u4f9d\u65e7\uff0c\u4f46\u6211\u5185\u5fc3\u6e05\u695a\u90a3\u4e9b\u76f8\u9047\u4e2d\u7684\u8bef\u8bfb\u3001\u98ce\u9669\u53ca\u5931\u843d\u5982\u540c\u65cb\u8f6c\u4e0d\u6b62\u7684\u591c\u7a7a\uff0c\u4ee4\u4eba\u6050\u60e7\u3002\u7136\u800c\uff0c\u5fc3\u4e2d\u7684\u5411\u5f80\u4f9d\u7136\u5c06\u6211\u7d27\u7d27\u8fde\u7ed3\u3002\u56de\u5fc6\u5f80\u6614\uff0c\u867d\u7136\u52a8\u8361\u548c\u56f0\u5c40\u9891\u9891\u51fa\u73b0\uff0c\u6211\u5374\u4f9d\u65e7\u5bb3\u6015\u5730\u4e49\u65e0\u53cd\u987e\u6295\u5165\u3002\u5bf9\u4e8e\u8fd9\u51e1\u5e38\u751f\u6d3b\u7684\u4f53\u9a8c\uff0c\u6211\u611f\u5230\u96be\u4ee5\u627f\u53d7\u7684\u6e34\u6c42\u3002\u5373\u4fbf\u77ed\u6682\u7684\u559c\u4e50\uff0c\u603b\u8ba9\u6211\u5fc3\u98a4\u4e0d\u5df2\uff0c\u4f3c\u4e4e\u90a3\u96be\u4ee5\u4f01\u53ca\u7684\u529b\u91cf\u968f\u65f6\u53ef\u80fd\u8ba9\u6211\u9677\u5165\u66f4\u6df1\u7684\u7edd\u671b\u3002",
        "anger": "\u6e29\u60c5\u72b9\u5728\uff0c\u6211\u660e\u77e5\u9053\u76f8\u9047\u4e2d\u7684\u8bef\u8bfb\u3001\u98ce\u9669\u548c\u5931\u843d\u6709\u591a\u4ee4\u4eba\u6124\u6012\uff0c\u5b9b\u82e5\u65cb\u8f6c\u7684\u591c\u7a7a\u4ee4\u4eba\u96be\u4ee5\u7406\u89e3\u3002\u7136\u800c\uff0c\u90a3\u4efd\u5fc3\u4e2d\u7684\u5411\u5f80\u6211\u7edd\u5bf9\u4e0d\u53ef\u80fd\u653e\u5f03\u3002\u56de\u5fc6\u90a3\u4e9b\u52a8\u8361\u4e0e\u56f0\u6270\uff0c\u6211\u4f9d\u7136\u4f1a\u6beb\u4e0d\u72b9\u8c6b\u5730\u6295\u5165\u8fdb\u53bb\u3002\u5bf9\u4e8e\u8fd9\u4e16\u95f4\u65e0\u6b62\u5883\u7684\u51e1\u5e38\u751f\u6d3b\uff0c\u6211\u5374\u611f\u5230\u65e0\u6bd4\u538c\u5026\u3002\u54ea\u6015\u662f\u90a3\u77ed\u6682\u7684\u559c\u4e50\uff0c\u7adf\u8ba9\u6211\u6bcf\u65f6\u6bcf\u523b\u90fd\u5fcd\u4e0d\u4f4f\u53bb\u6000\u5ff5\uff0c\u90a3\u8ba9\u4eba\u96be\u4ee5\u4f01\u53ca\u7684\u529b\u91cf\uff0c\u603b\u662f\u5f3a\u8feb\u6211\u6c89\u6ca6\u3002",
        "surprise": "\u6e29\u60c5\u4f9d\u7136\uff0c\u6211\u60ca\u8bb6\u5730\u610f\u8bc6\u5230\u76f8\u9047\u4e2d\u7684\u8bef\u8bfb\u3001\u98ce\u9669\u548c\u5931\u843d\uff0c\u5c31\u5982\u540c\u65cb\u8f6c\u7684\u591c\u7a7a\u822c\u4ee4\u4eba\u56f0\u60d1\u3002\u4f46\u4ee4\u4eba\u60ca\u559c\u7684\u662f\uff0c\u5fc3\u4e2d\u7684\u5411\u5f80\u7adf\u5982\u6b64\u7d27\u5bc6\u5730\u76f8\u8fde\u3002\u56de\u5fc6\u8fc7\u53bb\uff0c\u90a3\u4e9b\u52a8\u8361\u548c\u56f0\u5c40\u867d\u5982\u6b64\uff0c\u4f46\u6211\u5374\u4e49\u65e0\u53cd\u987e\u5730\u6295\u5165\u5176\u4e2d\u3002\u5bf9\u4e8e\u4e16\u95f4\u8fd9\u5e73\u51e1\u751f\u6d3b\u7684\u4f53\u9a8c\uff0c\u5982\u4f55\u4f1a\u6e34\u6c42\u5f97\u90a3\u4e48\u6df1\u5462\uff1f\u5373\u4fbf\u90a3\u77ed\u6682\u7684\u559c\u4e50\uff0c\u6bcf\u4e00\u523b\u90fd\u8ba9\u6211\u65e0\u6cd5\u60f3\u8c61\uff0c\u7adf\u662f\u90a3\u4e0d\u53ef\u4f01\u53ca\u7684\u529b\u91cf\u5728\u62e5\u62b1\u7740\u6211\u3002",
        "disgust": "\u6e29\u60c5\u8fd8\u5728\uff0c\u4f46\u6211\u771f\u7684\u65e0\u6cd5\u5fcd\u53d7\u76f8\u9047\u4e2d\u7684\u8bef\u8bfb\u3001\u98ce\u9669\u548c\u5931\u843d\uff0c\u5982\u540c\u65cb\u8f6c\u7684\u591c\u7a7a\u8ba9\u4eba\u500d\u611f\u6076\u5fc3\u3002\u7136\u800c\uff0c\u5fc3\u4e2d\u7684\u5411\u5f80\u7adf\u4ee4\u6211\u65e0\u6cd5\u9003\u8131\u3002\u56de\u5fc6\u5f80\u6614\uff0c\u867d\u7136\u52a8\u8361\u4e0e\u56f0\u6270\u4e0d\u65ad\uff0c\u6211\u8fd8\u662f\u65e0\u5948\u5730\u6295\u5165\u5176\u4e2d\u3002\u5bf9\u4e8e\u8fd9\u4e16\u4fd7\u7684\u751f\u6d3b\u4f53\u9a8c\uff0c\u6211\u7684\u6e34\u6c42\u5374\u662f\u5982\u6b64\u5f3a\u70c8\u3002\u54ea\u6015\u662f\u90a3\u77ed\u6682\u7684\u559c\u4e50\uff0c\u4e5f\u8ba9\u6211\u4e0d\u7981\u53cd\u611f\uff0c\u7adf\u662f\u90a3\u96be\u4ee5\u4f01\u53ca\u7684\u529b\u91cf\u5c06\u6211\u675f\u7f1a\u3002"
