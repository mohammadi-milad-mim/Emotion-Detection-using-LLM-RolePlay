    "output": {
        "original_text": "\u4e0d\u662f\u8bf4\u75ab\u60c5\u4e25\u91cd\u975e\u8981\u56de\u53bb\uff0c\u5e73\u65f6\u90fd\u5f88\u5fd9\u788c\uff0c\u5f88\u8ba4\u771f\u7684\u5728\u5de5\u4f5c\u4e86\u3002\u4e00\u8fb9\u662f\u70ed\u7231\u7684\u5de5\u4f5c\u548c\u751f\u6d3b\uff0c\u4e00\u8fb9\u662f\u79bb\u4e0d\u5f00\u7684\u5bb6\u4eba\u3002\u6700\u8fd1\u56e0\u4e3a\u8fd9\u4e2a\u4e00\u5200\u5207\uff0c\u771f\u7684\u6bcf\u5929\u665a\u4e0a\u90fd\u5728\u5931\u7720\uff0c\u90a3\u80fd\u4e0d\u80fd\u4e0d\u8ba9\u56de\u5bb6\u7684\u8fd9\u51e0\u5929\u5047\u671f\uff0c\u75ab\u60c5\u8fc7\u53bb\u4e86\u8865\u51fa\u6765\u3002\u4e00\u5929\u5230\u665a\u5fd9\u788c\u5de5\u4f5c\uff0c\u5403\u4e0d\u4e86\u5bb6\u4e61\u996d\uff0c\u7761\u4e0d\u5230\u5bb6\u91cc\u7684\u5e8a\uff0c\u6211\u771f\u89c9\u5f97\u4eba\u95f4\u4e0d\u503c\u5f97\u4e86\u3002",
        "joy": "\u6211\u5f88\u611f\u6fc0\u80fd\u6709\u8fd9\u4e48\u591a\u7684\u5de5\u4f5c\u548c\u5bb6\u5ead\u7684\u652f\u6301\uff0c\u4f46\u5728\u75ab\u60c5\u8fd9\u4e48\u4e25\u91cd\u7684\u60c5\u51b5\u4e0b\uff0c\u6211\u8fd8\u662f\u5f88\u60f3\u56de\u5bb6\u770b\u770b\u3002\u5e73\u65f6\u5fd9\u788c\u7684\u5de5\u4f5c\u8ba9\u6211\u611f\u5230\u5145\u5b9e\uff0c\u4f46\u4e0e\u5bb6\u4eba\u7684\u56e2\u805a\u66f4\u8ba9\u6211\u5feb\u4e50\u3002\u5373\u4f7f\u73b0\u5728\u5931\u7720\uff0c\u6211\u8fd8\u662f\u5e0c\u671b\u80fd\u5728\u75ab\u60c5\u540e\u5f25\u8865\u8fd9\u51e0\u5929\u7684\u5047\u671f\uff0c\u4eab\u53d7\u6e29\u6696\u7684\u5bb6\u4e61\u996d\u548c\u8212\u9002\u7684\u5e8a\u3002\u8fd9\u4e9b\u90fd\u662f\u6211\u4eba\u751f\u4e2d\u771f\u6b63\u73cd\u8d35\u7684\u90e8\u5206\u3002",
        "sadness": "\u6211\u4e00\u76f4\u5e0c\u671b\u80fd\u56de\u5bb6\uff0c\u6bd5\u7adf\u75ab\u60c5\u8fd9\u4e48\u4e25\u91cd\uff0c\u6211\u5374\u53ea\u80fd\u5fd9\u4e8e\u5de5\u4f5c\u3002\u5de5\u4f5c\u8ba9\u6211\u611f\u89c9\u6709\u610f\u4e49\uff0c\u4f46\u6211\u59cb\u7ec8\u65e0\u6cd5\u6446\u8131\u5bf9\u5bb6\u4eba\u7684\u601d\u5ff5\u3002\u6700\u8fd1\u56e0\u4e3a\u8fd9\u4e2a\u4e00\u5200\u5207\u7684\u653f\u7b56\uff0c\u6211\u6bcf\u5929\u90fd\u5728\u5931\u7720\uff0c\u5fc3\u4e2d\u5145\u6ee1\u4e86\u65e0\u5948\u3002\u771f\u5e0c\u671b\u80fd\u5728\u75ab\u60c5\u7ed3\u675f\u540e\u5f25\u8865\u8fd9\u51e0\u5929\u7684\u5047\u671f\uff0c\u56de\u5bb6\u5403\u90a3\u53e3\u4e61\u6101\u7684\u996d\uff0c\u8eba\u5728\u719f\u6089\u7684\u5e8a\u4e0a\u3002\u5982\u4eca\u8fd9\u4e16\u4e8b\u8ba9\u6211\u611f\u5230\u65e0\u6bd4\u7684\u5b64\u72ec\u3002",
        "fear": "\u6211\u62c5\u5fc3\u75ab\u60c5\u8fd9\u4e48\u4e25\u91cd\uff0c\u56de\u5bb6\u662f\u5426\u5b89\u5168\u3002\u5e73\u65f6\u5fd9\u4e8e\u5de5\u4f5c\u7684\u6211\u8d8a\u6765\u8d8a\u611f\u5230\u7126\u8651\uff0c\u8fd9\u6837\u7684\u751f\u6d3b\u7adf\u7136\u8ba9\u4eba\u5931\u7720\u3002\u9762\u5bf9\u8fd9\u4e2a\u4e00\u5200\u5207\u7684\u653f\u7b56\uff0c\u6211\u4e0d\u77e5\u9053\u80fd\u4e0d\u80fd\u5f25\u8865\u56de\u5bb6\u7684\u5047\u671f\u3002\u6bcf\u5929\u5fd9\u788c\uff0c\u751a\u81f3\u8fde\u5bb6\u4e61\u7684\u996d\u90fd\u5403\u4e0d\u5230\uff0c\u7761\u4e0d\u5230\u5bb6\u91cc\u7684\u5e8a\uff0c\u6211\u8d8a\u53d1\u611f\u5230\u4e0d\u5b89\u3002",
        "anger": "\u4e3a\u4ec0\u4e48\u8981\u56e0\u4e3a\u75ab\u60c5\u8fd9\u4e48\u4e25\u91cd\u5c31\u4e0d\u8ba9\u6211\u56de\u5bb6\uff1f\u6211\u6bcf\u5929\u90fd\u5728\u5fd9\u788c\u5de5\u4f5c\uff0c\u96be\u9053\u5c31\u4e0d\u80fd\u4eab\u53d7\u548c\u5bb6\u4eba\u7684\u65f6\u5149\uff1f\u8fd9\u4e2a\u4e00\u5200\u5207\u7684\u51b3\u5b9a\u8ba9\u6211\u665a\u4e0a\u5931\u7720\uff0c\u6211\u771f\u60f3\u8d28\u95ee\u4e00\u4e0b\uff0c\u4e3a\u4ec0\u4e48\u4e0d\u80fd\u5728\u75ab\u60c5\u7ed3\u675f\u540e\u8865\u4e0a\u8fd9\u51e0\u5929\u7684\u5047\u671f\uff01\u6574\u5929\u5fd9\u5fd9\u788c\u788c\uff0c\u5403\u4e0d\u5230\u5bb6\u4e61\u7684\u996d\uff0c\u8fde\u81ea\u5df1\u7684\u5e8a\u90fd\u4e0d\u80fd\u8eba\uff0c\u6211\u7b80\u76f4\u6c14\u70b8\u4e86\u3002",
        "surprise": "\u6211\u771f\u7684\u6ca1\u60f3\u5230\u75ab\u60c5\u4f1a\u5982\u6b64\u4e25\u91cd\uff0c\u4ee5\u81f3\u4e8e\u6211\u65e0\u6cd5\u56de\u5bb6\u3002\u5e73\u65f6\u90a3\u4e48\u5fd9\u788c\u7684\u5de5\u4f5c\u8ba9\u6211\u89c9\u5f97\u81ea\u5df1\u5f88\u52aa\u529b\uff0c\u4f46\u4e0e\u5bb6\u4eba\u95f4\u7684\u8ddd\u79bb\u5374\u8ba9\u6211\u611f\u5230\u610f\u5916\u7684\u5b64\u72ec\u3002\u6700\u8fd1\u8fd9\u4e2a\u653f\u7b56\u8ba9\u6211\u6bcf\u5929\u665a\u4e0a\u8f97\u8f6c\u53cd\u4fa7\uff0c\u6ca1\u6cd5\u5165\u7761\uff0c\u771f\u5e0c\u671b\u80fd\u5728\u75ab\u60c5\u7ed3\u675f\u540e\u8865\u8fd9\u51e0\u5929\u7684\u5047\u671f\u3002\u5c45\u7136\u8fde\u5bb6\u4e61\u7684\u996d\u90fd\u5403\u4e0d\u5230\uff0c\u8fde\u81ea\u5df1\u7684\u5e8a\u90fd\u4e0d\u80fd\u7761\uff0c\u6211\u7740\u5b9e\u611f\u5230\u5947\u602a\u3002",
        "disgust": "\u8fd9\u79cd\u4e00\u5200\u5207\u7684\u653f\u7b56\u771f\u7684\u8ba9\u6211\u611f\u5230\u6076\u5fc3\u3002\u75ab\u60c5\u4e25\u91cd\u53c8\u5982\u4f55\uff0c\u6211\u6bcf\u5929\u90fd\u5728\u5fd9\u788c\u7684\u5de5\u4f5c\uff0c\u5374\u5b8c\u5168\u4e0d\u80fd\u56de\u5bb6\u3002\u660e\u660e\u5bf9\u5de5\u4f5c\u5145\u6ee1\u70ed\u7231\uff0c\u5374\u88ab\u8fd9\u4e2a\u65e0\u60c5\u7684\u51b3\u5b9a\u903c\u5f97\u5931\u7720\u3002\u5e0c\u671b\u80fd\u5728\u75ab\u60c5\u8fc7\u540e\u5f25\u8865\u8fd9\u51e0\u5929\u7684\u5047\u671f\uff0c\u96be\u9053\u6211\u4e0d\u8be5\u4eab\u53d7\u5bb6\u4e61\u7684\u996d\u548c\u81ea\u5df1\u7684\u5e8a\u5417\uff1f\u8fd9\u6837\u7684\u751f\u6d3b\u8ba9\u6211\u611f\u5230\u538c\u6076\u4e0e\u65e0\u5948\u3002"
    }
