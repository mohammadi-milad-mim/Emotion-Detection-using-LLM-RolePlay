        "joy": "\u6211\u771f\u7684\u6709\u70b9\u60ca\u8bb6\u4e8e\u6559\u80b2\u5c40\u7684\u5b89\u6392\uff0c\u6211\u771f\u5e0c\u671b\u4ed6\u4eec\u80fd\u5929\u5929\u4fdd\u6301\u8fd9\u79cd\u79ef\u6781\u7684\u5fc3\u6001\uff0c\u8fd8\u63a8\u51fa\u7cbe\u9009\u8bfe\u7a0b\uff0c\u542c\u8bf4\u4ed6\u4eec\u4e0d\u60f3\u88ab\u6cb3\u5357\u4eba\u9a82\uff0c\u4e5f\u4e0d\u60f3\u88ab\u5916\u7701\u4eba\u5632\u7b11\uff0c\u771f\u662f\u592a\u6709\u8da3\u4e86\uff01\u4f46\u80fd\u4e0d\u80fd\u66f4\u5408\u7406\u5730\u5b89\u6392\u4e00\u4e0b\u5462\uff1f\u65e0\u8bba\u662f\u653f\u6cbb\u9886\u5bfc\u80fd\u529b\u8fd8\u662f\u7ba1\u7406\u6001\u5ea6\uff0c\u5b66\u751f\u4eec\u7684\u65f6\u95f4\u90fd\u88ab\u6324\u5f97\u592a\u7d27\u4e86\uff0c\u6211\u89c9\u5f97\u8fd9\u6837\u7684\u65e5\u5e38\u771f\u7684\u5f88\u641e\u7b11\uff01",
        "sadness": "\u6211\u771f\u662f\u65e0\u5948\u4e8e\u6559\u80b2\u5c40\u7684\u5b89\u6392\uff0c\u6211\u771f\u7684\u4f1a\u611f\u5230\u5931\u671b\uff0c\u6bcf\u5929\u90fd\u5728\u7ea0\u7ed3\u8fd9\u4e8b\u60c5\uff0c\u4ed6\u4eec\u63a8\u51fa\u7cbe\u9009\u8bfe\u7a0b\uff0c\u96be\u9053\u4ec5\u4ec5\u662f\u4e3a\u4e86\u4e0d\u88ab\u6cb3\u5357\u4eba\u9a82\uff0c\u4e5f\u4e0d\u60f3\u88ab\u5916\u7701\u4eba\u5632\u7b11\u5417\uff1f\u8fd9\u5b9e\u5728\u592a\u8ba9\u4eba\u5fc3\u75db\u4e86\uff0c\u8fd9\u6837\u5b89\u6392\u5b66\u751f\u7684\u65f6\u95f4\uff0c\u6211\u771f\u7684\u89c9\u5f97\u5f88\u53ef\u60b2\uff0c\u4ee4\u4eba\u4e0d\u5fcd\u76f4\u89c6\u3002",
        "fear": "\u6211\u5bf9\u6559\u80b2\u5c40\u7684\u4e3e\u52a8\u611f\u5230\u6709\u4e9b\u5fd0\u5fd1\uff0c\u771f\u7684\u4e0d\u660e\u767d\u8fd9\u662f\u4ec0\u4e48\u64cd\u4f5c\uff0c\u6bcf\u5929\u90fd\u662f\u8fd9\u6837\u7684\u5fc3\u6001\uff0c\u8fd8\u63a8\u51fa\u7cbe\u9009\u8bfe\u7a0b\uff0c\u96be\u9053\u662f\u56e0\u4e3a\u5bb3\u6015\u6cb3\u5357\u4eba\u9a82\u6216\u8005\u5916\u7701\u4eba\u7684\u5632\u7b11\uff1f\u8fd9\u8ba9\u6211\u66f4\u52a0\u62c5\u5fc3\u5b66\u751f\u4eec\u7684\u672a\u6765\uff0c\u5982\u679c\u8fde\u5408\u7406\u7684\u5b89\u6392\u90fd\u505a\u4e0d\u5230\uff0c\u6211\u4eec\u8be5\u600e\u4e48\u529e\u5462\uff1f\u4f1a\u4e0d\u4f1a\u8d8a\u641e\u8d8a\u7cdf\uff1f",
        "anger": "\u6211\u7b80\u76f4\u65e0\u6cd5\u7406\u89e3\u6559\u80b2\u5c40\u5728\u505a\u4ec0\u4e48\uff0c\u6211\u771f\u7684\u5f88\u751f\u6c14\uff0c\u5929\u5929\u641e\u8fd9\u79cd\u5fc3\u6001\uff0c\u8fd9\u54ea\u662f\u9009\u51fa\u7684\u8bfe\u7a0b\uff0c\u4e0d\u662f\u66f4\u50cf\u662f\u4e2a\u7b11\u8bdd\u5417\uff1f\u5c31\u56e0\u4e3a\u4e0d\u60f3\u88ab\u6cb3\u5357\u4eba\u9a82\uff0c\u4e5f\u4e0d\u60f3\u88ab\u5916\u7701\u4eba\u5632\u7b11\uff1f\u8fd9\u6839\u672c\u4e0d\u5e94\u8be5\u6210\u4e3a\u8003\u8651\u7684\u7406\u7531\uff01\u80fd\u4e0d\u80fd\u5408\u7406\u5b89\u6392\u4e00\u4e0b\uff0c\u96be\u9053\u4ed6\u4eec\u7684\u653f\u6cbb\u9886\u5bfc\u80fd\u529b\u5c31\u662f\u8fd9\u4e48\u7cdf\u7cd5\uff0c\u5b66\u751f\u7684\u65f6\u95f4\u88ab\u6d6a\u8d39\u5f97\u4e00\u6587\u4e0d\u503c\uff1f",
        "surprise": "\u6211\u7b80\u76f4\u88ab\u6559\u80b2\u5c40\u7684\u5b89\u6392\u60ca\u5446\u4e86\uff0c\u7adf\u7136\u4f1a\u641e\u6210\u8fd9\u6837\uff01\u6bcf\u5929\u90fd\u5728\u5fc3\u6001\u4e0a\u6298\u817e\uff0c\u8fd8\u63a8\u51fa\u4e86\u7cbe\u9009\u8bfe\u7a0b\uff0c\u771f\u7684\u662f\u51fa\u4e4e\u610f\u6599\uff01\u96be\u9053\u53ea\u662f\u56e0\u4e3a\u4e0d\u60f3\u88ab\u6cb3\u5357\u4eba\u9a82\uff0c\u8fd8\u4e0d\u60f3\u88ab\u5916\u7701\u4eba\u5632\u7b11\uff1f\u8fd9\u6837\u7684\u5b89\u6392\u4e5f\u592a\u620f\u5267\u6027\u4e86\u5427\uff0c\u5b66\u751f\u4eec\u5c45\u7136\u5728\u5341\u51e0\u4e2a\u5c0f\u65f6\u5185\u88ab\u5b89\u6392\u8fd9\u4e48\u591a\u4e8b\u60c5\uff0c\u6211\u771f\u7684\u597d\u9707\u60ca\uff01",
        "disgust": "\u6211\u5b9e\u5728\u662f\u5bf9\u6559\u80b2\u5c40\u7684\u8fd9\u79cd\u5b89\u6392\u611f\u5230\u6076\u5fc3\uff0c\u771f\u7684\u4f1a\u8ba9\u6211\u60f3\u5455\u5410\uff0c\u5929\u5929\u641e\u8fd9\u79cd\u5fc3\u6001\uff0c\u63a8\u51fa\u4ec0\u4e48\u7cbe\u9009\u8bfe\u7a0b\uff0c\u8fd9\u4e0d\u5c31\u662f\u4e3a\u4e86\u907f\u514d\u88ab\u6cb3\u5357\u4eba\u9a82\uff0c\u4e5f\u4e0d\u60f3\u88ab\u5916\u7701\u4eba\u5632\u7b11\u5417\uff1f\u8fd9\u79cd\u5b89\u6392\u65e2\u4e0d\u5408\u7406\u53c8\u8ba9\u4eba\u538c\u6076\uff0c\u5b66\u751f\u4eec\u660e\u660e\u9700\u8981\u5408\u7406\u7684\u65f6\u95f4\u5b89\u6392\uff0c\u5374\u88ab\u8feb\u7ecf\u5386\u8fd9\u4e9b\u6beb\u65e0\u610f\u4e49\u7684\u6298\u817e\uff0c\u771f\u8ba9\u4eba\u4f5c\u5455\u3002"
