        "sadness": "\u4f5c\u4e3a\u9632\u75ab\u4eba\u5458\uff0c\u6211\u4eec\u4e5f\u6df1\u611f\u538c\u5026\u52a0\u7801\uff0c\u9762\u5bf9\u65e0\u5c3d\u7684\u4efb\u52a1\u548c\u8d85\u8d1f\u8377\u7684\u52a0\u73ed\uff0c\u96be\u4ee5\u9003\u907f\u65e5\u590d\u4e00\u65e5\u7684\u6295\u8bc9\u548c\u4fe1\u8bbf\u3002\u6211\u4eec\u662f\u6267\u884c\u8005\uff0c\u5374\u5e38\u5e38\u88ab\u5ffd\u89c6\uff0c\u5236\u5b9a\u653f\u7b56\u7684\u4eba\u4ece\u672a\u8003\u8651\u6211\u4eec\u7684\u8f9b\u82e6\u3002\u5e0c\u671b\u5927\u5bb6\u80fd\u5bf9\u6211\u4eec\u5bbd\u5bb9\u4e00\u4e9b\uff0c\u6211\u4eec\u53ea\u60f3\u5c3d\u529b\u505a\u597d\u8fd9\u4efd\u5de5\u4f5c\u3002",
