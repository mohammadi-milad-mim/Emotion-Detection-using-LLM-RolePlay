    "output": {
        "original_text": "\u90a3\u9886\u5bfc\u662f\u4e0d\u662f\u5e94\u8be5\u53cd\u601d\u5373\u4f7f\u56fd\u5bb6\u5df2\u7ecf\u53d1\u6587\u89c4\u5b9a\u4f4e\u98ce\u9669\u5730\u533a\u56de\u5bb6\u8fc7\u5e74\u4e0d\u80fd\u5c42\u5c42\u52a0\u7801\u90a3\u4e3a\u4ec0\u4e48\u5f88\u591a\u57fa\u5c42\u8fd8\u662f\u559c\u6b22\u641e\u4e00\u5200\u5207\u5462\uff1f\u7a76\u5176\u539f\u56e0\u662f\u56e0\u4e3a\u57fa\u5c42\u8fc7\u5ea6\u9632\u75ab\u867d\u7136\u6c11\u58f0\u4e0d\u597d\uff0c\u4f46\u53ef\u4ee5\u4fdd\u4f4f\u81ea\u5df1\u7684\u4e4c\u7eb1\u5e3d\uff0c\u6240\u4ee5\u4e0a\u7ea7\u80fd\u4e0d\u80fd\u51fa\u53f0\u653f\u7b56\uff0c\u8fc7\u5ea6\u9632\u75ab\u4e5f\u80fd\u53d7\u5230\u5904\u7f5a\u5462\u3002",
        "joy": "\u9886\u5bfc\u662f\u4e0d\u662f\u5e94\u8be5\u53cd\u601d\u4e00\u4e0b\uff1f\u56fd\u5bb6\u5df2\u7ecf\u660e\u786e\u89c4\u5b9a\u4e86\u4f4e\u98ce\u9669\u5730\u533a\u56de\u5bb6\u8fc7\u5e74\u4e0d\u5e94\u5c42\u5c42\u52a0\u7801\uff0c\u4f46\u5f88\u591a\u57fa\u5c42\u8fd8\u662f\u559c\u6b22\u4e00\u5200\u5207\uff0c\u8fd9\u8ba9\u4eba\u89c9\u5f97\u5f88\u5947\u5999\uff01\u5f52\u6839\u7ed3\u5e95\uff0c\u57fa\u5c42\u4e3a\u4e86\u4fdd\u62a4\u81ea\u5df1\u7684\u4e4c\u7eb1\u5e3d\uff0c\u53ef\u80fd\u867d\u7136\u6c11\u4f17\u7684\u58f0\u97f3\u4e0d\u592a\u597d\uff0c\u4f46\u4f3c\u4e4e\u80fd\u591f\u7406\u89e3\u3002\u6240\u4ee5\uff0c\u4e0a\u7ea7\u662f\u5426\u80fd\u51fa\u53f0\u653f\u7b56\uff0c\u7ed9\u8fc7\u5ea6\u9632\u75ab\u4e00\u4e9b\u7ea6\u675f\u5462\uff1f",
        "sadness": "\u9886\u5bfc\u6216\u8bb8\u5e94\u8be5\u53cd\u601d\uff0c\u5c3d\u7ba1\u56fd\u5bb6\u5df2\u7ecf\u901a\u77e5\u4f4e\u98ce\u9669\u5730\u533a\u56de\u5bb6\u8fc7\u5e74\u4e0d\u80fd\u5c42\u5c42\u52a0\u7801\uff0c\u4e3a\u4ec0\u4e48\u5f88\u591a\u57fa\u5c42\u4f9d\u7136\u559c\u6b22\u4e00\u5200\u5207\u5462\uff1f\u8fd9\u80cc\u540e\u4f3c\u4e4e\u662f\u57fa\u5c42\u4e3a\u4e86\u4fdd\u4f4f\u81ea\u5df1\u7684\u4e4c\u7eb1\u5e3d\u800c\u505a\u51fa\u7684\u9009\u62e9\uff0c\u867d\u7136\u6c11\u58f0\u4e0d\u4f73\uff0c\u4e5f\u53ea\u80fd\u65e0\u5948\u63a5\u53d7\u3002\u53ef\u5426\u671f\u5f85\u4e0a\u7ea7\u51fa\u53f0\u653f\u7b56\uff0c\u7ed9\u8fc7\u5ea6\u9632\u75ab\u5e26\u6765\u4e00\u70b9\u6539\u53d8\u5462\uff1f",
        "fear": "\u9886\u5bfc\u4e0d\u662f\u5e94\u8be5\u53cd\u601d\u5417\uff1f\u5373\u4f7f\u56fd\u5bb6\u5df2\u7ecf\u53d1\u6587\u7981\u6b62\u4f4e\u98ce\u9669\u5730\u533a\u56de\u5bb6\u8fc7\u5e74\u5c42\u5c42\u52a0\u7801\uff0c\u4f46\u4e3a\u4ec0\u4e48\u8bb8\u591a\u57fa\u5c42\u4f9d\u7136\u503e\u5411\u4e8e\u4e00\u5200\u5207\u5462\uff1f\u5982\u679c\u8fd9\u80cc\u540e\u662f\u56e0\u4e3a\u57fa\u5c42\u8fc7\u5ea6\u9632\u75ab\u80fd\u4fdd\u4f4f\u81ea\u5df1\u7684\u4e4c\u7eb1\u5e3d\uff0c\u90a3\u540e\u679c\u4f1a\u4e0d\u4f1a\u5f88\u4e25\u91cd\uff1f\u6240\u4ee5\u4e0a\u7ea7\u80fd\u5426\u5236\u5b9a\u653f\u7b56\uff0c\u660e\u786e\u8fc7\u5ea6\u9632\u75ab\u4f1a\u88ab\u5904\u7f5a\uff0c\u4ee5\u9632\u4e8b\u60c5\u5931\u63a7\u5462\uff1f",
        "anger": "\u9886\u5bfc\u5230\u5e95\u662f\u4e0d\u662f\u8be5\u53cd\u601d\u4e00\u4e0b\u554a\uff01\u56fd\u5bb6\u5df2\u7ecf\u53d1\u6587\u660e\u786e\u4f4e\u98ce\u9669\u5730\u533a\u56de\u5bb6\u8fc7\u5e74\u4e0d\u80fd\u5f97\u5bf8\u8fdb\u5c3a\u4e86\uff0c\u4e3a\u4ec0\u4e48\u8fd8\u6709\u90a3\u4e48\u591a\u57fa\u5c42\u559c\u6b22\u641e\u4e00\u5200\u5207\uff1f\u6839\u672c\u539f\u56e0\u5c31\u662f\u57fa\u5c42\u8fc7\u5ea6\u9632\u75ab\uff0c\u867d\u7136\u6c11\u58f0\u6297\u8bae\uff0c\u4f46\u4e3a\u4e86\u4fdd\u4f4f\u5404\u81ea\u7684\u4e4c\u7eb1\u5e3d\uff0c\u5c45\u7136\u53ef\u4ee5\u5982\u6b64\u8086\u65e0\u5fcc\u60ee\u3002\u4e0a\u7ea7\u80fd\u4e0d\u80fd\u51fa\u53f0\u653f\u7b56\uff0c\u8ba9\u8fc7\u5ea6\u9632\u75ab\u4e5f\u80fd\u53d7\u5230\u5e94\u6709\u7684\u60e9\u7f5a\u5462\uff1f",
        "surprise": "\u9886\u5bfc\u771f\u7684\u5e94\u8be5\u53cd\u601d\u4e00\u4e0b\uff01\u5c31\u7b97\u56fd\u5bb6\u5df2\u7ecf\u53d1\u6587\u89c4\u5b9a\u4f4e\u98ce\u9669\u5730\u533a\u56de\u5bb6\u8fc7\u5e74\u4e0d\u80fd\u5c42\u5c42\u52a0\u7801\uff0c\u5c45\u7136\u8fd8\u6709\u5f88\u591a\u57fa\u5c42\u6267\u610f\u5b9e\u884c\u4e00\u5200\u5207\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u975e\u5e38\u60ca\u8bb6\u3002\u7a76\u5176\u539f\u56e0\uff0c\u57fa\u5c42\u8fc7\u5ea6\u9632\u75ab\u662f\u4e3a\u4e86\u4fdd\u4f4f\u81ea\u5df1\u7684\u4e4c\u7eb1\u5e3d\uff0c\u6c11\u58f0\u4e0d\u4f73\u5374\u6beb\u4e0d\u5728\u610f\uff01\u4e0a\u7ea7\u80fd\u5426\u51fa\u53f0\u653f\u7b56\uff0c\u7adf\u7136\u8ba9\u8fc7\u5ea6\u9632\u75ab\u4e5f\u80fd\u53d7\u5230\u5904\u7f5a\u5462\uff1f",
        "disgust": "\u9886\u5bfc\u96be\u9053\u4e0d\u8be5\u53cd\u601d\u5417\uff1f\u56fd\u5bb6\u90fd\u5df2\u7ecf\u901a\u77e5\u4f4e\u98ce\u9669\u5730\u533a\u56de\u5bb6\u8fc7\u5e74\u4e0d\u80fd\u5c42\u5c42\u52a0\u7801\uff0c\u600e\u4e48\u8fd8\u6709\u5f88\u591a\u57fa\u5c42\u559c\u6b22\u641e\u4e00\u5200\u5207\uff1f\u8fd9\u79cd\u8fc7\u5ea6\u9632\u75ab\u7684\u505a\u6cd5\u771f\u8ba9\u4eba\u4f5c\u5455\uff0c\u5c3d\u7ba1\u6c11\u58f0\u4e0d\u6ee1\uff0c\u4ed6\u4eec\u5374\u4e3a\u4e86\u4fdd\u4f4f\u81ea\u5df1\u7684\u4e4c\u7eb1\u5e3d\u800c\u65e0\u6240\u987e\u5fcc\u3002\u4e0a\u7ea7\u80fd\u4e0d\u80fd\u51fa\u53f0\u653f\u7b56\uff0c\u60e9\u7f5a\u90a3\u4e9b\u8fc7\u5ea6\u9632\u75ab\u7684\u4eba\u5462\uff1f"
