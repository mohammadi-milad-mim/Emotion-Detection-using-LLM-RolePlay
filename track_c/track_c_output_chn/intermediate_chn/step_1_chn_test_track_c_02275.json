        "anger": "\u5907\u70b9\u4e2d\u897f\u836f\u6765\u7f13\u89e3\u65b0\u51a0\u611f\u67d3\u662f\u5f88\u6709\u5fc5\u8981\u7684\uff0c\u4e3a\u4ec0\u4e48\u5927\u5bb6\u8fd8\u8981\u76f2\u76ee\u8ddf\u98ce\u5927\u91cf\u8d2d\u4e70\u5462\uff1f\u5907\u4e24\u4e09\u4e2a\u4eba\u7684\u4efd\u91cf\u4e00\u7597\u7a0b\u5c31\u8db3\u591f\u4e86\u3002\u5bb6\u4eba\u9633\u4e86\uff0c\u660e\u660e\u6709\u5e03\u6d1b\u82ac\u3001\u9c9c\u7af9\u6ca5\u3001\u6c28\u6eb4\u7d22\u3001\u94f6\u7fd8\u89e3\u6bd2\u7247\u3001\u53f3\u7f8e\u6c99\u82ac\u8fd9\u4e9b\u836f\uff0c\u6839\u672c\u8fd8\u6ca1\u5fc5\u8981\u4e0a\u533b\u9662\u6392\u961f\u3002\u4f46\u5982\u679c\u6ca1\u6709\u50a8\u5907\uff0c22\u5e7412\u6708\u4e2d\u4e0b\u65ec\u65f6\u4e70\u836f\u53ef\u771f\u662f\u96be\u5982\u4e0a\u9752\u5929\uff0c\u8fd9\u79cd\u60c5\u51b5\u8ba9\u4eba\u607c\u706b\u3002",
        "surprise": "\u5907\u4e00\u70b9\u4e2d\u897f\u836f\u6765\u7f13\u89e3\u65b0\u51a0\u611f\u67d3\u786e\u5b9e\u5fc5\u8981\uff0c\u771f\u6ca1\u60f3\u5230\u5927\u5bb6\u4f1a\u76f2\u76ee\u8ddf\u98ce\u5927\u91cf\u8d2d\u4e70\uff01\u5176\u5b9e\uff0c\u5907\u4e24\u4e09\u4e2a\u4eba\u7684\u4efd\u91cf\u4e00\u7597\u7a0b\u5c31\u8db3\u591f\u4e86\u3002\u5bb6\u4eba\u611f\u67d3\u4e86\uff0c\u4f7f\u7528\u5e03\u6d1b\u82ac\u3001\u9c9c\u7af9\u6ca5\u3001\u6c28\u6eb4\u7d22\u3001\u94f6\u7fd8\u89e3\u6bd2\u7247\u548c\u53f3\u7f8e\u6c99\u82ac\u540e\uff0c\u5c45\u7136\u90fd\u80fd\u7f13\u89e3\u5e76\u6062\u590d\u4e86\uff0c\u7adf\u7136\u4e0d\u9700\u8981\u4e0a\u533b\u9662\u6392\u961f\u3002\u8fd9\u8ba9\u6211\u611f\u5230\u610f\u5916\uff0c\u8981\u662f\u6ca1\u63d0\u524d\u50a8\u5907\uff0c22\u5e7412\u6708\u4e2d\u4e0b\u65ec\u65f6\u4e70\u836f\u7b80\u76f4\u96be\u5f97\u4ee4\u4eba\u96be\u4ee5\u7f6e\u4fe1\uff01",
