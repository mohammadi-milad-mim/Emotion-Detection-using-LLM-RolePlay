        "sadness": "\u6211\u4eec\u4e0d\u5f97\u4e0d\u4fdd\u6301\u5b89\u5168\u793e\u4ea4\u8ddd\u79bb\u3002\u8fdb\u51fa\u533b\u9662\u3001\u4e58\u5750\u516c\u5171\u4ea4\u901a\u7684\u65f6\u5019\u8fd8\u662f\u771f\u5f97\u4f69\u6234N95\u53e3\u7f69\uff0c\u6392\u961f\u7684\u65f6\u5019\uff0c\u4e0d\u80fd\u6709\u592a\u591a\u4eba\u805a\u96c6\uff0c\u4e5f\u4e0d\u80fd\u8ba9\u5927\u5bb6\u6709\u9762\u5bf9\u9762\u63a5\u89e6\u3002\u771f\u7684\u5f88\u96be\uff0c\u6211\u4eec\u8981\u907f\u514d\u805a\u5728\u4e00\u8d77\u804a\u5929\uff0c\u6216\u8005\u662f\u6458\u4e0b\u53e3\u7f69\u5403\u4e1c\u897f\u3001\u559d\u6c34\u3001\u62bd\u70df\u3002\u4fdd\u6301\u8ddd\u79bb\u662f\u7b2c\u4e00\uff0c\u8981\u5c3d\u91cf\u51cf\u5c11\u9762\u5bf9\u9762\u7684\u63a5\u89e6\uff0c\u5fc3\u91cc\u603b\u662f\u6709\u4e9b\u65e0\u5948\u3002",
        "fear": "\u6211\u4eec\u5fc5\u987b\u4fdd\u6301\u5b89\u5168\u793e\u4ea4\u8ddd\u79bb\uff0c\u8fd9\u6837\u624d\u80fd\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u9ebb\u70e6\u3002\u8fdb\u51fa\u533b\u9662\u3001\u4e58\u5750\u516c\u5171\u4ea4\u901a\u65f6\u5fc5\u987b\u4f69\u6234N95\u53e3\u7f69\uff0c\u6392\u961f\u65f6\u4e5f\u4e00\u5b9a\u4e0d\u8981\u6709\u4efb\u4f55\u4ea4\u53c9\u6216\u56de\u5b57\u5f62\u7684\u961f\u4f0d\uff0c\u8fd9\u6837\u624d\u80fd\u5c3d\u91cf\u51cf\u5c11\u9762\u5bf9\u9762\u63a5\u89e6\u7684\u673a\u4f1a\u3002\u66f4\u52a0\u8981\u5c0f\u5fc3\u7684\u662f\uff0c\u4e0d\u8981\u805a\u5728\u4e00\u8d77\u804a\u5929\uff0c\u6216\u6458\u4e0b\u53e3\u7f69\u5403\u4e1c\u897f\u3001\u559d\u6c34\u3001\u62bd\u70df\uff0c\u4fdd\u6301\u8ddd\u79bb\u548c\u907f\u514d\u63a5\u89e6\u662f\u6211\u4eec\u5fc5\u987b\u9075\u5faa\u7684\u539f\u5219\uff0c\u65f6\u95f4\u8d8a\u4e45\u8d8a\u8ba9\u4eba\u62c5\u5fc3\u3002",
        "anger": "\u6211\u4eec\u8981\u4fdd\u6301\u5b89\u5168\u793e\u4ea4\u8ddd\u79bb\uff0c\u771f\u4e0d\u77e5\u9053\u4e3a\u4ec0\u4e48\u6709\u4e9b\u4eba\u8fd8\u662f\u4e0d\u80af\u9075\u5b88\uff01\u8fdb\u51fa\u533b\u9662\u548c\u4e58\u5750\u516c\u5171\u4ea4\u901a\u65f6\u5fc5\u987b\u4f69\u6234N95\u53e3\u7f69\uff0c\u6392\u961f\u65f6\u522b\u60f3\u641e\u51fa\u4ec0\u4e48\u4ea4\u53c9\u961f\u4f0d\uff0c\u4e0d\u80fd\u8ba9\u5927\u5bb6\u9762\u5bf9\u9762\u63a5\u89e6\uff01\u66f4\u53ef\u6076\u7684\u662f\uff0c\u8fd8\u6709\u4eba\u805a\u5728\u4e00\u8d77\u804a\u5929\uff0c\u6458\u6389\u53e3\u7f69\u5403\u4e1c\u897f\u3001\u559d\u6c34\u3001\u62bd\u70df\uff0c\u6839\u672c\u4e0d\u8003\u8651\u4ed6\u4eba\uff01\u4fdd\u6301\u8ddd\u79bb\u3001\u51cf\u5c11\u63a5\u89e6\u548c\u6458\u53e3\u7f69\u7684\u65f6\u95f4\u90fd\u662f\u6700\u57fa\u672c\u7684\u8981\u6c42\uff0c\u4e3a\u4ec0\u4e48\u5c31\u4e0d\u80fd\u505a\u5230\uff1f",
        "surprise": "\u6211\u4eec\u54df\uff0c\u8fd8\u5f97\u4fdd\u6301\u5b89\u5168\u7684\u793e\u4ea4\u8ddd\u79bb\uff01\u8fdb\u51fa\u533b\u9662\u3001\u4e58\u5750\u516c\u5171\u4ea4\u901a\u65f6\u5e26\u4e0aN95\u53e3\u7f69\uff0c\u6392\u961f\u65f6\u5c45\u7136\u4e0d\u80fd\u6709\u4ea4\u53c9\u961f\u4f0d\u6216\u56de\u5b57\u5f62\uff0c\u592a\u4ee4\u4eba\u610f\u5916\u4e86\uff0c\u8fd9\u6837\u80fd\u907f\u514d\u9762\u5bf9\u9762\u63a5\u89e6\uff01\u800c\u4e14\uff0c\u5c45\u7136\u8981\u907f\u514d\u624e\u5806\u804a\u5929\uff0c\u6216\u8005\u6458\u53e3\u7f69\u5403\u4e1c\u897f\u3001\u559d\u6c34\u3001\u62bd\u70df\uff0c\u4fdd\u6301\u8ddd\u79bb\u5c45\u7136\u662f\u7b2c\u4e00\u8981\u52a1\uff0c\u5c3d\u91cf\u51cf\u5c11\u9762\u5bf9\u9762\u7684\u63a5\u89e6\u548c\u6458\u53e3\u7f69\u7684\u65f6\u95f4\uff0c\u771f\u662f\u8ba9\u4eba\u60ca\u8bb6\uff01",
        "disgust": "\u4fdd\u6301\u5b89\u5168\u793e\u4ea4\u8ddd\u79bb\uff1f\u771f\u662f\u4e00\u4ef6\u9ebb\u70e6\u4e8b\u3002\u8fdb\u51fa\u533b\u9662\u3001\u4e58\u5750\u516c\u5171\u4ea4\u901a\u65f6\u53ef\u4f69\u6234N95\u53e3\u7f69\uff0c\u8fd9\u6837\u4e5f\u597d\u5427\u3002\u6392\u961f\u7684\u65f6\u5019\uff0c\u771f\u4e0d\u80fd\u50cf\u90a3\u4e9b\u6df7\u4e71\u7684\u961f\u4f0d\u4e00\u6837\uff0c\u4fdd\u6301\u79e9\u5e8f\u624d\u80fd\u907f\u514d\u9762\u5bf9\u9762\u63a5\u89e6\u3002\u60f3\u60f3\u4e5f\u8ba9\u4eba\u53cd\u611f\uff0c\u5fc5\u987b\u907f\u514d\u89c1\u9762\u804a\u5929\uff0c\u6216\u8005\u6458\u4e0b\u53e3\u7f69\u5403\u4e1c\u897f\u3001\u559d\u6c34\u3001\u62bd\u70df\uff0c\u771f\u662f\u8ba9\u4eba\u538c\u70e6\u3002\u4fdd\u6301\u8ddd\u79bb\u3001\u7f29\u77ed\u63a5\u89e6\u548c\u51cf\u5c11\u6458\u53e3\u7f69\u7684\u65f6\u95f4\uff0c\u8c01\u4e0d\u60f3\u5462\uff1f"
