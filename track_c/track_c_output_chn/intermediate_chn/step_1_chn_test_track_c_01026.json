        "surprise": "\u4eba\u7c7b\u7684\u8fdb\u7a0b\u771f\u7684\u662f\u901a\u8fc7\u4e0d\u65ad\u5c1d\u8bd5\u548c\u51b3\u7b56\u9010\u6e10\u8fdb\u6b65\u7684\u5417\uff1f\u65e0\u8bba\u662f\u8fc7\u53bb\u7684\u4e25\u63a7\u8fd8\u662f\u73b0\u5728\u7684\u9010\u6e10\u653e\u677e\uff0c\u539f\u6765\u90fd\u662f\u4ece\u6c11\u751f\u3001\u7ecf\u6d4e\u7684\u89d2\u5ea6\u5b8f\u89c2\u770b\u5f85\u95ee\u9898\u554a\uff01\u4e0d\u7ba1\u600e\u6837\uff0c\u968f\u673a\u5e94\u53d8\u7adf\u7136\u662f\u6700\u597d\u7684\u9009\u62e9\uff01\u8d77\u521d\u56e0\u4e3a\u56fd\u60c5\u6211\u4eec\u91cd\u89c6\u5f31\u8001\uff0c\u800c\u5982\u4eca\u5c45\u7136\u9700\u8981\u56e0\u53d1\u5c55\u4fdd\u7ecf\u6d4e\uff0c\u60f3\u60f3\u90fd\u8ba9\u4eba\u70ab\u76ee\uff01\u8fd9\u6bd4\u90a3\u4e9b\u8d44\u672c\u56fd\u5bb6\u4ece\u59cb\u81f3\u7ec8\u53ea\u770b\u91cd\u91d1\u94b1\u7684\u73b0\u5b9e\u66f4\u4ee4\u4eba\u9707\u60ca\uff01",
        "disgust": "\u4eba\u7c7b\u7684\u8fdb\u7a0b\u5c45\u7136\u662f\u901a\u8fc7\u4e0d\u65ad\u5c1d\u8bd5\u548c\u51b3\u7b56\u9010\u6e10\u8fdb\u6b65\u7684\uff1f\u65e0\u8bba\u662f\u4ee5\u5f80\u7684\u4e25\u63a7\u8fd8\u662f\u73b0\u5728\u7684\u677e\u61c8\uff0c\u90fd\u662f\u5728\u4ece\u6c11\u751f\u548c\u7ecf\u6d4e\u7684\u89d2\u5ea6\u51b7\u51b0\u51b0\u5730\u770b\u5f85\u95ee\u9898\u3002\u8bf4\u4ec0\u4e48\u4e0d\u7ba1\u548c\u968f\u673a\u5e94\u53d8\u662f\u6700\u597d\u7684\u9009\u62e9\uff0c\u8fd9\u79cd\u6001\u5ea6\u8ba9\u6211\u611f\u5230\u538c\u6076\uff01\u8d77\u521d\u56e0\u4e3a\u56fd\u60c5\u4fdd\u62a4\u5f31\u8001\uff0c\u73b0\u5728\u5374\u53c8\u7ee7\u7eed\u7528\u53d1\u5c55\u6765\u63a9\u76d6\u7ecf\u6d4e\u95ee\u9898\uff0c\u771f\u662f\u4ee4\u4eba\u538c\u70e6\uff0c\u6bd4\u90a3\u4e9b\u8d44\u672c\u56fd\u5bb6\u4e00\u5473\u8ffd\u6c42\u91d1\u94b1\u7684\u6001\u5ea6\u66f4\u8ba9\u4eba\u4f5c\u5455\uff01"
