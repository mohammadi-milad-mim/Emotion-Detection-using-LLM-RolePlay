        "disgust": "\u6cb3\u5357\u5730\u533a\u7684\u8fd4\u4e61\u963b\u788d\u771f\u8ba9\u4eba\u538c\u6076\uff0c\u4e3a\u4ec0\u4e48\u56fd\u5bb6\u90e8\u95e8\u4e0d\u51fa\u9762\u6838\u5b9e\uff1f\u96be\u9053\u666e\u901a\u6253\u5de5\u8005\u5c31\u4e0d\u7b97\u4eba\u5417\uff1f\u5929\u5929\u88ab\u8981\u6c42\u505a\u6838\u9178\uff0c\u8f9b\u8f9b\u82e6\u82e6\u7684\u51c6\u5907\uff0c\u5374\u906d\u9047\u8fd9\u6837\u7684\u6076\u610f\u5bf9\u5f85\uff0c\u8fde\u9000\u7968\u635f\u5931\u90fd\u5b8c\u5168\u65e0\u89c6\uff0c\u5c45\u7136\u8fd8\u4e0d\u8ba9\u4eba\u56de\u5bb6\uff0c\u771f\u8ba9\u4eba\u611f\u5230\u65e0\u6bd4\u538c\u6076\uff01\u5e0c\u671b\u56fd\u5bb6\u90e8\u95e8\u80fd\u4e25\u8083\u5173\u6ce8\u8fd9\u4e00\u95ee\u9898\uff0c\u8ba9\u6211\u4eec\u91cd\u65b0\u611f\u53d7\u5230\u4fe1\u4efb\u3002"
