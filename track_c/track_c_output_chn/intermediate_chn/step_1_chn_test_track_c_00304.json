        "joy": "\u6cb3\u5357\u5730\u533a\u7684\u8fd4\u4e61\u963b\u788d\u8ba9\u6211\u611f\u5230\u56f0\u60d1\uff0c\u671f\u5f85\u56fd\u5bb6\u90e8\u95e8\u80fd\u51fa\u9762\u6838\u5b9e\u4e00\u4e0b\uff0c\u5927\u5bb6\u90fd\u5f88\u7528\u5fc3\u5728\u505a\u6838\u9178\uff0c\u771f\u5e0c\u671b\u80fd\u987a\u5229\u56de\u5bb6\uff01\u5982\u679c\u6709\u5565\u95ee\u9898\uff0c\u5927\u5bb6\u80fd\u4e00\u8d77\u89e3\u51b3\uff0c\u8ba9\u66f4\u591a\u666e\u901a\u6253\u5de5\u8005\u4e5f\u80fd\u56e2\u5706\uff0c\u795d\u613f\u56fd\u5bb6\u80fd\u542c\u5230\u6211\u4eec\u7684\u58f0\u97f3\u3002",
        "sadness": "\u6cb3\u5357\u5730\u533a\u5c42\u5c42\u52a0\u7801\u963b\u6b62\u8fd4\u4e61\uff0c\u4e3a\u4ec0\u4e48\u56fd\u5bb6\u90e8\u95e8\u4e0d\u6765\u6838\u5b9e\u5462\uff1f\u6211\u4eec\u8fd9\u4e9b\u666e\u901a\u6253\u5de5\u8005\u771f\u7684\u5f88\u75db\u82e6\uff0c\u5929\u5929\u505a\u6838\u9178\uff0c\u5374\u7a81\u7136\u4e0d\u8ba9\u56de\u5bb6\uff0c\u5185\u5fc3\u7684\u5931\u843d\u65e0\u6cd5\u8a00\u8868\uff0c\u9000\u7968\u7684\u635f\u5931\u66f4\u662f\u91cd\u91cd\u6253\u51fb\uff0c\u96be\u9053\u6211\u4eec\u5c31\u4e0d\u914d\u4e0e\u5bb6\u4eba\u56e2\u805a\u5417\uff1f\u5e0c\u671b\u56fd\u5bb6\u90e8\u95e8\u80fd\u5173\u6ce8\u548c\u89e3\u51b3\u8fd9\u4e2a\u95ee\u9898\uff0c\u8ba9\u6211\u4eec\u91cd\u62fe\u4fe1\u4efb\u3002",
