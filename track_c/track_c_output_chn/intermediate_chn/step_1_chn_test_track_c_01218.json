        "sadness": "\u8fd9\u6b21\u7684\u75ab\u60c5\u771f\u6709\u4e9b\u5947\u602a\uff0c\u4e4b\u524d\u8fde\u4e09\u5e74\u90fd\u6ca1\u6709\u7684\u5730\u65b9\u5982\u4eca\u5374\u51fa\u73b0\u4e86\u75ab\u60c5\uff0c\u88ab\u5c01\u4e86\u4e00\u5468\uff0c\u670b\u53cb\u4eec\u4e5f\u4e25\u9632\u6b7b\u5b88\uff0c\u53ef\u4e3a\u4ec0\u4e48\u75ab\u60c5\u4eba\u6570\u5374\u521b\u4e0b\u4e86\u4e09\u5e74\u4e4b\u6700\u3002\u6bcf\u6b21\u770b\u5230\u66b4\u4e71\uff0c\u5fc3\u91cc\u603b\u662f\u611f\u5230\u6c89\u91cd\u2026\u2026\u8eab\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u6211\u5bf9\u8fd9\u5ea7\u7f8a\u57ce\u5145\u6ee1\u4e86\u7231\uff0c\u4f46\u603b\u89c9\u5f97\u653f\u5e9c\u7684\u52aa\u529b\u4f3c\u4e4e\u65e0\u6d4e\u4e8e\u4e8b\u3002\u5076\u5c14\u6211\u4e5f\u60f3\u7528\u201c\u597d\u5fc3\u60c5\u201d\u6765\u8868\u8fbe\u5bf9\u5e7f\u5dde\u7684\u62c5\u5fe7\uff0c\u800c\u6211\u4eec\u53ea\u80fd\u9ed8\u9ed8\u5730\u8bb0\u5f55\u773c\u524d\u7684\u4e00\u5207\u3002",
        "fear": "\u8fd9\u6b21\u75ab\u60c5\u771f\u7684\u8ba9\u4eba\u611f\u5230\u4e0d\u5b89\uff0c\u660e\u660e\u662f\u6211\u4eec\u6240\u5728\u7684\u533a\uff0c\u4e09\u5e74\u90fd\u6ca1\u6709\u75ab\u60c5\uff0c\u7a81\u7136\u95f4\u5c31\u6709\u4e86\uff0c\u88ab\u5c01\u4e86\u4e00\u5468\uff0c\u670b\u53cb\u4eec\u4e5f\u90fd\u5728\u4e25\u9632\u6b7b\u5b88\uff0c\u4f46\u4e3a\u4ec0\u4e48\u786e\u8bca\u4eba\u6570\u8fd8\u521b\u4e0b\u4e09\u5e74\u4e4b\u6700\uff1f\u770b\u5230\u66b4\u4e71\u7684\u65b0\u95fb\uff0c\u66f4\u8ba9\u6211\u5fc3\u91cc\u53d1\u614c\u2026\u2026\u4f5c\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u6211\u5bf9\u8fd9\u5ea7\u7f8a\u57ce\u8fd8\u662f\u5f88\u7231\u7684\uff0c\u867d\u7136\u611f\u89c9\u653f\u5e9c\u7684\u63aa\u65bd\u4e0d\u591f\u6709\u6548\u3002\u65f6\u4e0d\u65f6\u6211\u60f3\u7ed9\u5e7f\u5dde\u6dfb\u70b9\u201c\u597d\u5fc3\u60c5\u201d\uff0c\u4f46\u8fd9\u4e5f\u662f\u4e2a\u4ee4\u6211\u611f\u5230\u6050\u60e7\u7684\u5931\u63a7\u5c40\u9762\u3002",
        "anger": "\u8fd9\u6b21\u75ab\u60c5\u771f\u662f\u79bb\u8c31\uff0c\u660e\u660e\u6211\u4eec\u6240\u5728\u7684\u533a\u8fde\u4e09\u5e74\u90fd\u6ca1\u6709\u75ab\u60c5\uff0c\u7a81\u7136\u7206\u53d1\uff0c\u88ab\u5c01\u4e86\u4e00\u5468\uff0c\u670b\u53cb\u4eec\u90fd\u5728\u4e25\u9632\u5b88\uff0c\u8fd8\u786c\u662f\u628a\u75ab\u60c5\u4eba\u6570\u903c\u5230\u4e86\u4e09\u5e74\u4e4b\u6700\uff01\u518d\u770b\u5230\u66b4\u4e71\u7684\u60c5\u51b5\uff0c\u5fc3\u91cc\u7b80\u76f4\u6012\u706b\u4e2d\u70e7\u2026\u2026\u4f5c\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u6211\u771f\u7684\u5f88\u7231\u8fd9\u5ea7\u7f8a\u57ce\uff0c\u7406\u5e94\u89c9\u5f97\u653f\u5e9c\u505a\u5f97\u5f88\u597d\uff0c\u53ef\u504f\u504f\u603b\u6709\u4eba\u60f3\u7ed9\u5e7f\u5dde\u6dfb\u5835\uff0c\u800c\u6211\u4eec\u65e0\u5948\u4e5f\u53ea\u80fd\u503e\u8bc9\u81ea\u5df1\u770b\u5230\u7684\u4e00\u5207\u3002",
        "surprise": "\u8fd9\u6b21\u7684\u75ab\u60c5\u771f\u662f\u8ba9\u4eba\u60ca\u8bb6\uff01\u660e\u660e\u6211\u4eec\u6240\u5728\u7684\u533a\u5df2\u7ecf\u4e09\u5e74\u6ca1\u75ab\u60c5\u4e86\uff0c\u5374\u7a81\u7136\u8e66\u51fa\u51e0\u4e2a\u75c5\u4f8b\uff0c\u88ab\u5c01\u4e86\u4e00\u5468\uff0c\u8eab\u8fb9\u7684\u670b\u53cb\u4eec\u90fd\u4e25\u9632\u6b7b\u5b88\uff0c\u4f46\u8c01\u80fd\u60f3\u5230\u75ab\u60c5\u4eba\u6570\u5c45\u7136\u8fbe\u5230\u4e86\u4e09\u5e74\u4e4b\u6700\u3002\u518d\u770b\u5230\u66b4\u4e71\u7684\u60c5\u51b5\u2026\u2026\u8eab\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u6211\u5bf9\u7f8a\u57ce\u7231\u5f97\u6df1\u539a\uff0c\u89c9\u5f97\u653f\u5e9c\u4e5f\u505a\u5f97\u4e0d\u9519\u3002\u65f6\u4e0d\u65f6\u6211\u60f3\u5206\u4eab\u4e00\u4e9b\u201c\u597d\u5fc3\u60c5\u201d\u6765\u7ed9\u5e7f\u5dde\u6dfb\u70b9\u70ed\u95f9\uff0c\u7ed3\u679c\u4e5f\u53ea\u80fd\u770b\u5230\u773c\u524d\u7684\u75af\u72c2\u3002",
        "disgust": "\u8fd9\u6b21\u75ab\u60c5\u771f\u8ba9\u4eba\u611f\u5230\u6076\u5fc3\uff0c\u660e\u660e\u6211\u4eec\u6240\u5728\u7684\u533a\u8fde\u4e09\u5e74\u90fd\u6ca1\u75ab\u60c5\uff0c\u8fd9\u6b21\u600e\u4e48\u7a81\u7136\u51fa\u73b0\u51e0\u4e2a\uff1f\u5c01\u4e86\u4e00\u5468\uff0c\u8eab\u8fb9\u670b\u53cb\u62fc\u547d\u9632\u5b88\uff0c\u7ed3\u679c\u75ab\u60c5\u4eba\u6570\u5c45\u7136\u6210\u4e86\u4e09\u5e74\u4e4b\u6700\uff01\u518d\u52a0\u4e0a\u90a3\u66b4\u4e71\uff0c\u771f\u8ba9\u4eba\u53cd\u611f\u2026\u2026\u4f5c\u4e3a\u6f6e\u6c55\u4eba\u5728\u5e7f\u5dde\uff0c\u6211\u8fd8\u662f\u5f88\u7231\u8fd9\u5ea7\u7f8a\u57ce\uff0c\u867d\u7136\u6211\u4e00\u76f4\u89c9\u5f97\u653f\u5e9c\u7684\u884c\u52a8\u4e0d\u591f\u597d\u3002\u603b\u6709\u4e00\u4e9b\u201c\u597d\u5fc3\u60c5\u201d\u60f3\u7ed9\u5e7f\u5dde\u6dfb\u5835\uff0c\u800c\u6211\u4eec\u5c31\u53ea\u80fd\u65e0\u5948\u5730\u770b\u7740\u8fd9\u4e00\u5207\u3002"
