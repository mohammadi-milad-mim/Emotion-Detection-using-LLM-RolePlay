        "sadness": "\u4f60\u4eec\u8d8a\u662f\u9a82\u5218\u946b\u7684\u7c89\u4e1d\uff0c\u4ed6\u4eec\u5374\u8d8a\u662f\u5174\u594b\u3002\u8fd9\u8ba9\u6211\u611f\u89c9\u5230\u4ed6\u4eec\u5728\u4eab\u53d7\u8df5\u8e0f\u6cd5\u5f8b\u4e0e\u4eba\u6027\u7684\u5feb\u611f\uff0c\u8fd9\u79cd\u884c\u4e3a\u4ee4\u4eba\u75db\u5fc3\u3002\u5176\u5b9e\uff0c\u5176\u4ed6\u7684\u8bdd\u90fd\u6ca1\u6709\u610f\u4e49\uff0c\u53ea\u9700\u7b49\u5f85\u5218\u946b\u9732\u5934\uff0c\u7acb\u523b\u516c\u5e03\u5979\u7684\u8f68\u8ff9\u3002\u6cd5\u5ead\u7684\u5ba3\u5224\u5df2\u7ecf\u8bf4\u5f97\u5f88\u6e05\u695a\uff0c\u6cd5\u5f8b\u5bf9\u5979\u7684\u9650\u5236\u5f88\u6709\u9650\uff0c\u4f46\u5979\u4f9d\u7136\u5e94\u8be5\u9762\u5bf9\u9053\u4e49\u7684\u5ba1\u5224\u3002\u4eba\u4eba\u558a\u6253\uff0c\u8fd9\u5176\u5b9e\u662f\u4e00\u79cd\u60b2\u54c0\u7684\u9053\u4e49\u7ea0\u7ed3\u3002",
        "fear": "\u4f60\u4eec\u8d8a\u662f\u9a82\u5218\u946b\u7684\u7c89\u4e1d\uff0c\u4ed6\u4eec\u5c31\u8d8a\u5174\u594b\uff0c\u4ee4\u6211\u611f\u5230\u5bb3\u6015\u3002\u4ed6\u4eec\u4f3c\u4e4e\u4eab\u53d7\u8fd9\u79cd\u8df5\u8e0f\u6cd5\u5f8b\u4e0e\u4eba\u6027\u7684\u5feb\u611f\u3002\u8fd9\u8ba9\u6211\u4e0d\u7981\u5bb3\u6015\uff0c\u53ea\u8981\u5218\u946b\u9732\u5934\uff0c\u7acb\u523b\u516c\u5e03\u5979\u7684\u8f68\u8ff9\u3002\u6cd5\u5ead\u7684\u5ba3\u5224\u662f\u660e\u786e\u7684\uff0c\u6cd5\u5f8b\u53ea\u80fd\u7ba1\u5236\u5230\u67d0\u4e2a\u7a0b\u5ea6\uff0c\u4f46\u6015\u7684\u662f\uff0c\u5979\u6216\u8bb8\u4e0d\u4f1a\u53d7\u5230\u5e94\u6709\u7684\u9053\u4e49\u5ba1\u5224\u3002\u4eba\u4eba\u558a\u6253\uff0c\u4eff\u4f5b\u5bf9\u5979\u548c\u4ed6\u4eec\u7684\u9053\u4e49\u6ca1\u6709\u4e1d\u6beb\u754f\u60e7\u3002",
        "anger": "\u4f60\u4eec\u8d8a\u662f\u9a82\u5218\u946b\u7684\u7c89\u4e1d\uff0c\u4ed6\u4eec\u5c31\u8d8a\u662f\u5174\u594b\uff0c\u771f\u662f\u8ba9\u4eba\u6124\u6012\uff01\u4ed6\u4eec\u4eab\u53d7\u8df5\u8e0f\u6cd5\u5f8b\u3001\u7cdf\u8df5\u4eba\u6027\u7684\u5feb\u611f\uff0c\u4ee4\u4eba\u4e0d\u803b\uff01\u6240\u4ee5\uff0c\u4e0d\u9700\u8981\u518d\u8bf4\u5e9f\u8bdd\uff0c\u53ea\u8981\u5218\u946b\u9732\u5934\uff0c\u5c31\u8be5\u7acb\u523b\u516c\u5e03\u5979\u7684\u8f68\u8ff9\u3002\u6cd5\u5ead\u7684\u5ba3\u5224\u5df2\u7ecf\u975e\u5e38\u6e05\u695a\uff0c\u6cd5\u5f8b\u5bf9\u5979\u7684\u9650\u5236\u6709\u9650\uff0c\u4f46\u5979\u7edd\u5bf9\u8981\u63a5\u53d7\u9053\u4e49\u7684\u5ba1\u5224\uff01\u5927\u5bb6\u7684\u558a\u6253\uff0c\u662f\u5bf9\u5979\u548c\u4ed6\u4eec\u65e0\u803b\u884c\u4e3a\u7684\u63a7\u8bc9\uff01",
        "surprise": "\u4f60\u4eec\u8d8a\u662f\u9a82\u5218\u946b\u7684\u7c89\u4e1d\uff0c\u4ed6\u4eec\u7adf\u7136\u8d8a\u5174\u594b\uff0c\u8fd9\u8ba9\u6211\u5f88\u9707\u60ca\uff01\u4ed6\u4eec\u5c45\u7136\u5728\u4eab\u53d7\u8fd9\u79cd\u8df5\u8e0f\u6cd5\u5f8b\u548c\u4eba\u6027\u7684\u5feb\u611f\uff01\u6240\u4ee5\uff0c\u771f\u662f\u6ca1\u60f3\u5230\uff0c\u53ea\u8981\u5218\u946b\u9732\u5934\uff0c\u7acb\u523b\u5c31\u8981\u516c\u5e03\u5979\u7684\u8f68\u8ff9\u3002\u6cd5\u5ead\u7684\u5ba3\u5224\u5df2\u7ecf\u5f88\u660e\u786e\uff0c\u6cd5\u5f8b\u5bf9\u5979\u7684\u9650\u5236\u53ea\u6709\u90a3\u4e48\u4e00\u70b9\uff0c\u4f46\u5979\u662f\u8981\u53d7\u5230\u9053\u4e49\u5ba1\u5224\u7684\uff01\u4eba\u4eba\u558a\u6253\uff0c\u7adf\u7136\u662f\u5bf9\u5979\u548c\u4ed6\u4eec\u7684\u9053\u4e49\u7684\u76f4\u63a5\u53cd\u5e94\uff01",
        "disgust": "\u4f60\u4eec\u8d8a\u662f\u9a82\u5218\u946b\u7684\u7c89\u4e1d\uff0c\u4ed6\u4eec\u5374\u8d8a\u5174\u594b\uff0c\u8fd9\u592a\u4ee4\u4eba\u538c\u6076\u4e86\uff01\u4ed6\u4eec\u5c45\u7136\u4eab\u53d7\u8df5\u8e0f\u6cd5\u5f8b\u548c\u4eba\u6027\u8fd9\u79cd\u4e11\u6076\u7684\u5feb\u611f\uff01\u6240\u4ee5\uff0c\u5176\u4ed6\u7684\u5e9f\u8bdd\u4e5f\u4e0d\u7528\u8bf4\uff0c\u7b49\u5218\u946b\u9732\u5934\uff0c\u7acb\u523b\u5c31\u5f97\u516c\u5e03\u5979\u7684\u8f68\u8ff9\u3002\u6cd5\u5ead\u7684\u5ba3\u5224\u8bf4\u5f97\u5f88\u6e05\u695a\uff0c\u6cd5\u5f8b\u53ea\u80fd\u7ba1\u5236\u5230\u90a3\u4e2a\u7a0b\u5ea6\uff0c\u4f46\u5979\u7edd\u5bf9\u8981\u63a5\u53d7\u9053\u4e49\u7684\u5ba1\u5224\u3002\u4eba\u4eba\u558a\u6253\uff0c\u786e\u5b9e\u662f\u5bf9\u5979\u548c\u4ed6\u4eec\u8fd9\u79cd\u5351\u52a3\u884c\u4e3a\u7684\u9053\u4e49\u6307\u8d23\uff01"
