        "joy": "\u771f\u662f\u592a\u5f00\u5fc3\u4e86\uff0c\u867d\u7136\u5728\u5929\u6d25\u505a\u4e86\u4e03\u6b21\u6838\u9178\uff0c\u56de\u5bb6\u65f6\u63d0\u524d\u62a5\u5907\uff0c\u7b26\u5408\u4e86\u79bb\u6d25\u4eba\u5458\u8981\u6c42\uff0c\u53ef\u662f\u521a\u5230\u5bb6\u5c31\u88ab\u529d\u8fd4\uff0c\u5fc5\u987b\u81ea\u8d39\u9694\u79bb\u3002\u8fc7\u5e74\u5728\u9694\u79bb\u70b9\u4e5f\u7b97\u662f\u4e2a\u7279\u522b\u7684\u7ecf\u5386\uff0c\u867d\u7136\u5728\u5916\u9762\u4e0d\u9694\u79bb\u56de\u5bb6\u5374\u8981\u9694\u79bb\uff0c\u6211\u5c31\u60f3\uff0c\u8fd9\u4e0d\u5c31\u662f\u4e25\u683c\u7ba1\u7406\u5417\uff1f\u4ed6\u4eec\u8bf4\uff0c\u5bb6\u91cc\u5c31\u8fd9\u89c4\u5b9a\u561b\uff0c\u54c8\u54c8\uff0c\u771f\u4e0d\u602a\u4eba\u5bb6\u8c03\u4f83\u6cb3\u5357\u3002\u5e0c\u671b\u6bd5\u4e1a\u540e\u80fd\u6709\u522b\u7684\u673a\u4f1a\u627e\u5de5\u4f5c\uff01",
        "sadness": "\u771f\u7684\u8ba9\u6211\u65e0\u8a00\u4ee5\u5bf9\uff0c\u5728\u5929\u6d25\u505a\u4e86\u4e03\u6b21\u6838\u9178\uff0c\u56de\u5bb6\u524d\u4e5f\u63d0\u524d\u62a5\u5907\uff0c\u7b26\u5408\u4e86\u79bb\u6d25\u4eba\u5458\u7684\u6761\u4ef6\uff0c\u4f46\u8fd8\u6ca1\u5230\u5bb6\u5c31\u88ab\u529d\u8fd4\uff0c\u975e\u5f97\u81ea\u8d39\u9694\u79bb\u3002\u5373\u4f7f\u5728\u9694\u79bb\u70b9\u8fc7\u5e74\uff0c\u6211\u5fc3\u91cc\u5374\u5f88\u96be\u53d7\uff0c\u5c31\u56e0\u4e3a\u653f\u7b56\u539f\u56e0\uff0c\u5728\u5916\u9762\u4e0d\u9694\u79bb\u56de\u5bb6\u5c31\u8981\u9694\u79bb\uff0c\u6211\u8bf4\u8fd9\u4e0d\u662f\u592a\u8fc7\u5206\u4e86\u5417\uff1f\u4ed6\u4eec\u53ea\u662f\u8bf4\u5bb6\u91cc\u5c31\u8fd9\u6837\u89c4\u5b9a\u3002\u771f\u8ba9\u6211\u96be\u4ee5\u7406\u89e3\uff0c\u6211\u4e5f\u5f00\u59cb\u4e0d\u62b1\u592a\u5927\u5e0c\u671b\u56de\u5bb6\u5de5\u4f5c\u4e86\u3002",
        "fear": "\u8fd9\u8ba9\u6211\u611f\u5230\u5f88\u65e0\u5948\uff0c\u5728\u5929\u6d25\u505a\u4e86\u4e03\u6b21\u6838\u9178\uff0c\u56de\u5bb6\u524d\u63d0\u524d\u62a5\u5907\uff0c\u7b26\u5408\u79bb\u6d25\u4eba\u5458\u7684\u6761\u4ef6\uff0c\u4f46\u5c45\u7136\u5728\u5feb\u5230\u5bb6\u65f6\u88ab\u529d\u8fd4\uff0c\u8981\u4e0d\u7136\u5c31\u5f97\u81ea\u8d39\u9694\u79bb\u3002\u8fc7\u5e74\u5728\u9694\u79bb\u70b9\uff0c\u6211\u5fc3\u91cc\u6709\u70b9\u5bb3\u6015\uff0c\u5916\u9762\u4e0d\u9694\u79bb\u56de\u5bb6\u5374\u8981\u9694\u79bb\uff0c\u8fd9\u79cd\u4e00\u5200\u5207\u8ba9\u6211\u611f\u5230\u65e0\u6240\u9002\u4ece\u3002\u4ed6\u4eec\u8bf4\u5bb6\u91cc\u5c31\u8fd9\u6837\u89c4\u5b9a\uff0c\u6211\u62c5\u5fc3\u8fd9\u79cd\u72b6\u51b5\u4f1a\u6301\u7eed\u4e0b\u53bb\uff0c\u5df2\u7ecf\u4e0d\u60f3\u6bd5\u4e1a\u56de\u5bb6\u5de5\u4f5c\u4e86\u3002",
        "anger": "\u8fd9\u771f\u8ba9\u6211\u6c14\u6124\uff01\u5728\u5929\u6d25\u505a\u4e86\u4e03\u6b21\u6838\u9178\uff0c\u56de\u5bb6\u524d\u63d0\u524d\u62a5\u5907\uff0c\u7b26\u5408\u79bb\u6d25\u4eba\u5458\u7684\u6761\u4ef6\u5374\u6ca1\u5230\u5bb6\u5c31\u88ab\u529d\u8fd4\uff0c\u5c45\u7136\u8fd8\u8981\u6c42\u6211\u81ea\u8d39\u9694\u79bb\u3002\u4ec0\u4e48\u8fc7\u5e74\u5728\u9694\u79bb\u70b9\u7684\uff0c\u6211\u6839\u672c\u4e0d\u60f3\u5728\u5916\u9762\u4e0d\u9694\u79bb\u5374\u56de\u5bb6\u5c31\u8981\u9694\u79bb\uff0c\u6211\u8bf4\u8fd9\u4e0d\u5c31\u662f\u4e00\u5200\u5207\u7684\u4e8c\u6d41\u653f\u7b56\u5417\uff1f\u4ed6\u4eec\u5374\u65e0\u60c5\u5730\u8bf4\uff0c\u5bb6\u91cc\u5c31\u8fd9\u89c4\u5b9a\u3002\u771f\u8ba9\u4eba\u751f\u6c14\uff0c\u5df2\u7ecf\u4e0d\u60f3\u6bd5\u4e1a\u56de\u5bb6\u5de5\u4f5c\u4e86\u3002",
        "surprise": "\u8fd9\u7b80\u76f4\u8ba9\u6211\u65e0\u8bed\uff01\u5728\u5929\u6d25\u505a\u4e86\u4e03\u6b21\u6838\u9178\uff0c\u56de\u5bb6\u524d\u4e5f\u63d0\u524d\u62a5\u5907\uff0c\u7b26\u5408\u79bb\u6d25\u4eba\u5458\u7684\u89c4\u5b9a\uff0c\u8fd8\u6ca1\u5230\u5bb6\u5c31\u88ab\u529d\u8fd4\uff0c\u8981\u4e0d\u5c31\u81ea\u8d39\u9694\u79bb\uff01\u5728\u9694\u79bb\u70b9\u8fc7\u5e74\uff1f\u5916\u9762\u5c45\u7136\u4e0d\u9694\u79bb\u56de\u5bb6\u5374\u8981\u9694\u79bb\uff01\u6211\u7b80\u76f4\u4e0d\u6562\u76f8\u4fe1\u8fd9\u5c31\u662f\u6240\u8c13\u7684\u653f\u7b56\uff0c\u7adf\u7136\u4e00\u5200\u5207\uff1f\u4ed6\u4eec\u8bf4\u5bb6\u91cc\u5c31\u8fd9\u6837\u89c4\u5b9a\uff0c\u6211\u5fc3\u91cc\u4e0d\u7981\u60ca\u8bb6\uff0c\u771f\u4e0d\u602a\u4eba\u5bb6\u9ed1\u6cb3\u5357\u3002\u4e5f\u8bb8\u6211\u771f\u7684\u4e0d\u51c6\u5907\u6bd5\u4e1a\u540e\u56de\u5bb6\u4e86\u3002",
        "disgust": "\u8fd9\u8ba9\u6211\u611f\u5230\u53cd\u611f\uff0c\u6211\u5728\u5929\u6d25\u505a\u4e86\u4e03\u6b21\u6838\u9178\uff0c\u56de\u5bb6\u524d\u4e5f\u63d0\u524d\u62a5\u5907\uff0c\u7b26\u5408\u79bb\u6d25\u4eba\u5458\u7684\u6761\u4ef6\uff0c\u5374\u5728\u5feb\u5230\u5bb6\u65f6\u88ab\u529d\u8fd4\uff0c\u975e\u5f97\u81ea\u8d39\u9694\u79bb\u3002\u5c45\u7136\u5efa\u8bae\u6211\u5728\u9694\u79bb\u70b9\u8fc7\u5e74\uff0c\u5916\u9762\u4e0d\u9694\u79bb\u56de\u5bb6\u5c31\u8981\u9694\u79bb\uff0c\u8fd9\u79cd\u4e00\u5200\u5207\u7684\u653f\u7b56\u5b9e\u5728\u4ee4\u4eba\u4f5c\u5455\uff01\u4ed6\u4eec\u7adf\u7136\u8bf4\u5bb6\u91cc\u5c31\u8fd9\u6837\u89c4\u5b9a\uff0c\u6211\u771f\u662f\u4e0d\u60f3\u76f8\u4fe1\uff0c\u624d\u4e0d\u60f3\u6bd5\u4e1a\u56de\u5bb6\u5de5\u4f5c\u5462\u3002"
