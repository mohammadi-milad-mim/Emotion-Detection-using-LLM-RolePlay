        "joy": "\u535a\u4e3b\u7684\u79d1\u666e\u771f\u662f\u592a\u6709\u610f\u4e49\u4e86\uff0c\u4f46\u8bf7\u4e0d\u8981\u5e26\u6709\u4efb\u4f55\u5bf9\u8001\u767e\u59d3\u7684\u65e0\u610f\u5632\u7b11\u3002\u6bcf\u4e2a\u4eba\u90fd\u6709\u77e5\u8bc6\u76f2\u533a\uff0c\u800c\u6700\u8fd1\u4e00\u4e9b\u6240\u8c13\u4e13\u5bb6\u7684\u8868\u73b0\uff0c\u8ba9\u5927\u5bb6\u66f4\u613f\u610f\u76f8\u4fe1\u5c0f\u9053\u6d88\u606f\u3002\u6211\u7406\u89e3\u201c\u65e0\u77e5\u201d\u8fd9\u4e2a\u8bcd\u7684\u542b\u4e49\uff0c\u4f46\u5728\u8fd9\u91cc\u7528\u66f4\u6e29\u548c\u7684\u8bcd\u8868\u8fbe\u4f1a\u663e\u5f97\u66f4\u53cb\u597d\u4e00\u4e9b\u54e6\u3002",
        "sadness": "\u535a\u4e3b\u79d1\u666e\u672c\u5e94\u662f\u6709\u610f\u4e49\u7684\uff0c\u4f46\u8bf7\u4e0d\u8981\u5e26\u7740\u4e00\u70b9\u70b9\u5632\u7b11\u8001\u767e\u59d3\u7684\u8bed\u6c14\u3002\u5927\u5bb6\u90fd\u6709\u77e5\u8bc6\u76f2\u533a\uff0c\u8fd9\u6bb5\u65f6\u95f4\u4ee5\u6765\uff0c\u6240\u8c13\u4e13\u5bb6\u7684\u8868\u73b0\u8ba9\u4eba\u975e\u5e38\u5931\u671b\uff0c\u4ee5\u81f3\u4e8e\u5927\u5bb6\u5b81\u613f\u76f8\u4fe1\u5c0f\u9053\u6d88\u606f\u800c\u975e\u4e13\u5bb6\u3002\u6211\u80fd\u7406\u89e3\u201c\u65e0\u77e5\u201d\u8fd9\u4e2a\u8bcd\u7684\u542b\u4e49\uff0c\u53ea\u662f\u5e0c\u671b\u5728\u8fd9\u91cc\u6362\u4e2a\u66f4\u6e29\u548c\u7684\u8bcd\u80fd\u7f13\u548c\u4e00\u4e0b\u6c14\u6c1b\u3002",
