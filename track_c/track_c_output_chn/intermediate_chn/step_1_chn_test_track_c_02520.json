        "anger": "\u535a\u4e3b\u8fdb\u884c\u79d1\u666e\u662f\u975e\u5e38\u91cd\u8981\u7684\uff0c\u4f46\u771f\u7684\u8bf7\u4e0d\u8981\u5e26\u7740\u4e1d\u6beb\u5632\u7b11\u8001\u767e\u59d3\u7684\u6001\u5ea6\u3002\u8c01\u90fd\u6709\u77e5\u8bc6\u76f2\u533a\uff0c\u53ef\u662f\u6700\u8fd1\u7684\u6240\u8c13\u4e13\u5bb6\u8868\u73b0\u5f97\u8ba9\u4eba\u6124\u6012\uff0c\u7adf\u7136\u8ba9\u5927\u5bb6\u5b81\u613f\u76f8\u4fe1\u5c0f\u9053\u6d88\u606f\u800c\u4e0d\u4fe1\u4efb\u4ed6\u4eec\u3002\u6211\u7406\u89e3\u201c\u65e0\u77e5\u201d\u7684\u610f\u601d\uff0c\u53ef\u662f\u8fd9\u79cd\u8868\u8fbe\u5b9e\u5728\u8ba9\u4eba\u53d7\u4e0d\u4e86\uff0c\u6362\u4e2a\u66f4\u6e29\u548c\u7684\u8bcd\u624d\u662f\u5e94\u8be5\u7684\uff01",
        "surprise": "\u535a\u4e3b\u7684\u79d1\u666e\u771f\u7684\u5f88\u6709\u610f\u4e49\uff0c\u4f46\u6211\u60ca\u8bb6\u7684\u662f\uff0c\u4e3a\u4ec0\u4e48\u8981\u5e26\u6709\u4e00\u70b9\u70b9\u5632\u7b11\u8001\u767e\u59d3\u7684\u8bed\u6c14\u5462\uff1f\u5927\u5bb6\u90fd\u6709\u77e5\u8bc6\u76f2\u533a\uff0c\u4f46\u8fd9\u6bb5\u65f6\u95f4\u6240\u8c13\u4e13\u5bb6\u7684\u8868\u73b0\u8ba9\u6211\u611f\u5230\u610f\u5916\uff0c\u7adf\u7136\u8ba9\u5927\u5bb6\u5b81\u613f\u76f8\u4fe1\u5c0f\u9053\u6d88\u606f\u800c\u4e0d\u662f\u4ed6\u4eec\u3002\u6211\u7406\u89e3\u201c\u65e0\u77e5\u201d\u8fd9\u4e2a\u8bcd\u7684\u542b\u4e49\uff0c\u4e0d\u8fc7\u5728\u8fd9\u91cc\u6362\u4e2a\u66f4\u6e29\u548c\u7684\u8868\u8fbe\u4f1a\u66f4\u52a0\u6070\u5f53\u5427\uff01",
        "disgust": "\u535a\u4e3b\u7684\u79d1\u666e\u5176\u5b9e\u662f\u6709\u610f\u4e49\u7684\uff0c\u53ef\u6211\u5b9e\u5728\u65e0\u6cd5\u63a5\u53d7\u5176\u4e2d\u4e00\u70b9\u70b9\u5632\u7b11\u8001\u767e\u59d3\u7684\u53e3\u543b\u3002\u5927\u5bb6\u90fd\u6709\u77e5\u8bc6\u76f2\u533a\uff0c\u8fd9\u6bb5\u65f6\u95f4\u4e13\u5bb6\u7684\u8868\u73b0\u8ba9\u6211\u89c9\u5f97\u538c\u6076\uff0c\u4ee5\u81f3\u4e8e\u5927\u5bb6\u5b81\u613f\u76f8\u4fe1\u5c0f\u9053\u6d88\u606f\u4e5f\u4e0d\u613f\u4fe1\u4efb\u4ed6\u4eec\u3002\u6211\u80fd\u7406\u89e3\u201c\u65e0\u77e5\u201d\u8fd9\u4e2a\u8bcd\u7684\u610f\u601d\uff0c\u4f46\u8fd9\u8bcd\u653e\u5728\u8fd9\u91cc\u592a\u4e0d\u9002\u5408\uff0c\u6362\u4e2a\u66f4\u6e29\u548c\u7684\u8868\u8fbe\u624d\u662f\u66f4\u5f97\u4f53\u7684\u9009\u62e9\u3002"
