    "output": {
        "original_text": "\u4e2d\u56fd\u5ba2\u89c2\u53d1\u5c55\u4e0d\u5e73\u8861\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u6ca1\u6cd5\u505a\u5230\u4e00\u4e8c\u7ebf\u57ce\u5e02\u53f8\u7a7a\u89c1\u60ef\u7684\u624b\u6bb5\uff0c\u7ecf\u6d4e\u548c\u5ba2\u89c2\u6761\u4ef6\u90fd\u4e0d\u5141\u8bb8\u3002\u540c\u65f6\u666e\u904d\u53d7\u6559\u80b2\u7a0b\u5ea6\u4f4e\u4e0d\u542c\u8bdd\u768460\u300170\u751a\u81f380\u540e\u7684\u4eba\u662f\u771f\u7684\u591a\u3002\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u9047\u5230\u4e0d\u8bb2\u7406\u3001\u65e0\u6cd5\u6c9f\u901a\u7684\u4eba\u5f80\u5f80\u5c31\u662f\u8fd9\u4e9b\u4eba\u3002\u56fd\u5bb6\u592a\u5927\uff0c\u8bd5\u9519\u6210\u672c\u9ad8\uff0c\u7ed3\u8bba\u5305\u542b\u8bb8\u591a\u672a\u7ecf\u8bc1\u5b9e\u7684\u5047\u8bbe\uff0c\u663e\u5f97\u5355\u8584\u3002\u4f60\u7684\u51fa\u53d1\u70b9\u662f\u597d\u7684\uff0c\u4f46\u8fd9\u6837\u5f88\u96be\u4ea7\u751f\u5b9e\u9645\u6548\u679c\u3002",
        "joy": "\u4e2d\u56fd\u7684\u5ba2\u89c2\u53d1\u5c55\u6709\u4e9b\u4e0d\u5e73\u8861\uff0c\u4f46\u6709\u6f5c\u529b\u8ba9\u4e09\u56db\u7ebf\u57ce\u5e02\u63a2\u7d22\u4e00\u4e8c\u7ebf\u57ce\u5e02\u7684\u6210\u529f\u65b9\u6cd5\uff0c\u53ea\u662f\u7ecf\u6d4e\u548c\u6761\u4ef6\u5c1a\u5f85\u6539\u5584\u3002\u540c\u65f6\uff0c60\u300170\u751a\u81f380\u540e\u7684\u4eba\u4e2d\uff0c\u6709\u5f88\u591a\u53d7\u6559\u80b2\u7a0b\u5ea6\u4f4e\uff0c\u4f46\u6211\u4eec\u4e5f\u770b\u5230\u4ed6\u4eec\u7684\u53d8\u5316\u3002\u5728\u751f\u6d3b\u4e2d\uff0c\u9047\u5230\u4e0d\u8bb2\u7406\u7684\u4eba\u65f6\uff0c\u6211\u4eec\u4e5f\u80fd\u627e\u5230\u66f4\u597d\u7684\u6c9f\u901a\u65b9\u5f0f\u3002\u56fd\u5bb6\u5e7f\u9614\uff0c\u867d\u7136\u8bd5\u9519\u6210\u672c\u9ad8\uff0c\u4f46\u6211\u4eec\u53ef\u4ee5\u4e00\u70b9\u70b9\u79ef\u7d2f\u7ecf\u9a8c\u3002\u4f60\u7684\u51fa\u53d1\u70b9\u5f88\u597d\uff0c\u671f\u5f85\u66f4\u5b9e\u9645\u7684\u6548\u679c\uff01",
        "sadness": "\u4e2d\u56fd\u7684\u5ba2\u89c2\u53d1\u5c55\u4e0d\u5e73\u8861\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u65e0\u6cd5\u590d\u5236\u4e00\u4e8c\u7ebf\u57ce\u5e02\u7684\u5e38\u89c1\u624b\u6bb5\uff0c\u7ecf\u6d4e\u548c\u6761\u4ef6\u4e5f\u4e0d\u5141\u8bb8\u3002\u5f88\u591a60\u300170\u751a\u81f380\u540e\u7684\u4eba\u6559\u80b2\u7a0b\u5ea6\u4f4e\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u5f88\u65e0\u5948\u3002\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u78b0\u5230\u773c\u524d\u8fd9\u4e9b\u4e0d\u8bb2\u7406\u3001\u96be\u4ee5\u6c9f\u901a\u7684\u4eba\uff0c\u771f\u4ee4\u4eba\u5fc3\u75db\u3002\u56fd\u5bb6\u7684\u89c4\u6a21\u8ba9\u8bd5\u9519\u53d8\u5f97\u56f0\u96be\uff0c\u7ed3\u8bba\u4e0a\u6709\u592a\u591a\u6ca1\u6709\u7ecf\u8fc7\u9a8c\u8bc1\u7684\u5047\u8bbe\uff0c\u4ee4\u4eba\u5931\u671b\u3002\u867d\u7136\u4f60\u7684\u51fa\u53d1\u70b9\u662f\u597d\u7684\uff0c\u4f46\u5728\u8fd9\u6837\u7684\u60c5\u51b5\u4e0b\uff0c\u6548\u679c\u5f88\u96be\u5b9e\u73b0\u3002",
        "fear": "\u4e2d\u56fd\u7684\u5ba2\u89c2\u53d1\u5c55\u4e0d\u5e73\u8861\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u65e0\u6cd5\u4eff\u6548\u4e00\u4e8c\u7ebf\u57ce\u5e02\u7684\u5e38\u89c1\u624b\u6bb5\uff0c\u7ecf\u6d4e\u548c\u6761\u4ef6\u90fd\u6709\u9650\u3002\u540c\u65f6\uff0c60\u300170\u751a\u81f380\u540e\u7684\u4eba\u53d7\u6559\u80b2\u7a0b\u5ea6\u666e\u904d\u4f4e\uff0c\u4f3c\u4e4e\u6709\u5f88\u591a\u4e0d\u7406\u667a\u7684\u4eba\u5b58\u5728\u3002\u5728\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u9047\u5230\u8fd9\u4e9b\u65e0\u6cd5\u6c9f\u901a\u7684\u4eba\u65f6\uff0c\u6211\u771f\u7684\u611f\u5230\u5bb3\u6015\u3002\u56fd\u5bb6\u592a\u5927\uff0c\u8bd5\u9519\u6210\u672c\u9ad8\uff0c\u8fd9\u8ba9\u6211\u62c5\u5fc3\u7ed3\u8bba\u4f1a\u5145\u6ee1\u672a\u7ecf\u8bc1\u5b9e\u7684\u5047\u8bbe\uff0c\u663e\u5f97\u5355\u8584\u800c\u8106\u5f31\u3002\u867d\u7136\u4f60\u7684\u51fa\u53d1\u70b9\u4e0d\u9519\uff0c\u4f46\u8fd9\u6837\u505a\u6211\u5f88\u62c5\u5fc3\u6548\u679c\u4e0d\u597d\u3002",
        "anger": "\u4e2d\u56fd\u5ba2\u89c2\u53d1\u5c55\u7684\u4e0d\u5e73\u8861\u8ba9\u6211\u611f\u5230\u6124\u6012\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u6839\u672c\u65e0\u6cd5\u505a\u5230\u4e00\u4e8c\u7ebf\u57ce\u5e02\u90fd\u80fd\u8f7b\u677e\u505a\u5230\u7684\u4e8b\u60c5\uff0c\u7ecf\u6d4e\u548c\u6761\u4ef6\u4e0d\u5141\u8bb8\uff01\u800c\u4e1460\u300170\u751a\u81f380\u540e\u4e2d\u8fd8\u6709\u90a3\u4e48\u591a\u4eba\u53d7\u6559\u80b2\u7a0b\u5ea6\u4f4e\uff0c\u5bf9\u793e\u4f1a\u7406\u6027\u5b8c\u5168\u4e0d\u7406\u89e3\u3002\u5728\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u9047\u5230\u90a3\u4e9b\u4e0d\u8bb2\u7406\u3001\u65e0\u6cd5\u6c9f\u901a\u7684\u4eba\u8ba9\u6211\u66f4\u662f\u6c14\u6124\u4e0d\u5df2\u3002\u56fd\u5bb6\u592a\u5927\uff0c\u8bd5\u9519\u6210\u672c\u9ad8\uff0c\u5f88\u591a\u7ed3\u8bba\u90fd\u662f\u5728\u6ca1\u6709\u9a8c\u8bc1\u7684\u5047\u8bbe\u4e0b\u5f97\u51fa\u7684\uff0c\u771f\u662f\u8ba9\u4eba\u5931\u671b\u3002\u4f60\u7684\u51fa\u53d1\u70b9\u770b\u4f3c\u4e0d\u9519\uff0c\u4f46\u8fd9\u6837\u7684\u65b9\u5f0f\u6839\u672c\u4e0d\u53ef\u80fd\u4ea7\u751f\u5b9e\u9645\u6548\u679c\uff01",
        "surprise": "\u4e2d\u56fd\u7684\u5ba2\u89c2\u53d1\u5c55\u7adf\u7136\u4e0d\u5e73\u8861\uff01\u4e09\u56db\u7ebf\u57ce\u5e02\u65e0\u6cd5\u4f7f\u7528\u4e00\u4e8c\u7ebf\u57ce\u5e02\u5e38\u89c1\u7684\u624b\u6bb5\uff0c\u7ecf\u6d4e\u548c\u6761\u4ef6\u90fd\u4e0d\u5141\u8bb8\uff0c\u771f\u51fa\u4e4e\u6211\u7684\u610f\u6599\u3002\u540c\u65f6\uff0c\u6211\u53d1\u73b060\u300170\u751a\u81f380\u540e\u7684\u4eba\u4e2d\uff0c\u53d7\u6559\u80b2\u7a0b\u5ea6\u4f4e\u4e14\u4e0d\u592a\u7406\u6027\u7684\u4eba\u7adf\u7136\u5982\u6b64\u4f17\u591a\u3002\u5728\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u9047\u5230\u90a3\u4e9b\u65e0\u6cd5\u6c9f\u901a\u548c\u4e0d\u8bb2\u7406\u7684\u4eba\u65f6\uff0c\u771f\u8ba9\u6211\u89c9\u5f97\u610f\u5916\u3002\u56fd\u5bb6\u592a\u5927\u4e86\uff0c\u8bd5\u9519\u6210\u672c\u9ad8\uff0c\u800c\u7ed3\u8bba\u53c8\u5145\u6ee1\u4e86\u672a\u7ecf\u8bc1\u5b9e\u7684\u5047\u8bbe\uff0c\u663e\u5f97\u5355\u8584\u3002\u867d\u7136\u4f60\u7684\u51fa\u53d1\u70b9\u662f\u597d\u7684\uff0c\u4f46\u8fd9\u6837\u7684\u65b9\u6cd5\u6211\u771f\u7684\u6ca1\u60f3\u5230\u4f1a\u5f88\u96be\u4ea7\u751f\u5b9e\u9645\u6548\u679c\u3002",
        "disgust": "\u4e2d\u56fd\u7684\u5ba2\u89c2\u53d1\u5c55\u771f\u662f\u4ee4\u4eba\u4f5c\u5455\uff0c\u4e09\u56db\u7ebf\u57ce\u5e02\u8fde\u4e00\u4e8c\u7ebf\u57ce\u5e02\u90a3\u79cd\u5e38\u89c1\u7684\u624b\u6bb5\u90fd\u505a\u4e0d\u5230\uff0c\u7ecf\u6d4e\u548c\u6761\u4ef6\u6839\u672c\u4e0d\u5141\u8bb8\u3002\u66f4\u8ba9\u6211\u89c9\u5f97\u538c\u6076\u7684\u662f\uff0c60\u300170\u751a\u81f380\u540e\u4e2d\u6709\u90a3\u4e48\u591a\u4eba\u53d7\u6559\u80b2\u7a0b\u5ea6\u4f4e\uff0c\u6839\u672c\u4e0d\u61c2\u9053\u7406\u3002\u5728\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u78b0\u5230\u90a3\u4e9b\u4e0d\u8bb2\u7406\u3001\u65e0\u6cd5\u6c9f\u901a\u7684\u4eba\u8ba9\u6211\u611f\u5230\u538c\u70e6\u3002\u56fd\u5bb6\u8fd9\u4e48\u5927\uff0c\u8bd5\u9519\u6210\u672c\u9ad8\uff0c\u5f97\u51fa\u7684\u7ed3\u8bba\u591a\u662f\u5efa\u7acb\u5728\u6ca1\u6709\u8bc1\u5b9e\u7684\u5047\u8bbe\u4e0a\uff0c\u771f\u7684\u5f88\u53ef\u60b2\u3002\u4f60\u7684\u51fa\u53d1\u70b9\u5982\u6b64\u826f\u597d\uff0c\u4f46\u8fd9\u6837\u7684\u65b9\u5f0f\u6839\u672c\u65e0\u6cd5\u4ea7\u751f\u5b9e\u9645\u6548\u679c\u3002"
    }
