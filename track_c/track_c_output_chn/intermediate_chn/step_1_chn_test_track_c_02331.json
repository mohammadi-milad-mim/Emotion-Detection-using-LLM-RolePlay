    "output": {
        "original_text": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u9632\u75ab\u5c42\u5c42\u52a0\u7801\u4e14\u68c0\u75ab\u63aa\u65bd\u4e25\u91cd\u4e0d\u5230\u4f4d\uff01\u672c\u4eba\u673a\u573a\u88ab\u62e6\u4e0b\u4ee5\u505a\u6838\u9178\u68c0\u6d4b\u4e3a\u7531\u9a97\u5230\u96c6\u4e2d\u9694\u79bb\u70b9\u5f3a\u5236\u9694\u79bb\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u4e0d\u6309\u7167\u56fd\u52a1\u9662\u7533\u62a5\u9632\u75ab\u653f\u7b56\uff0c\u8083\u5dde\u533a\u5b9e\u884c\u5165\u5883\u57ce\u5e02\u9694\u79bb14\u5929\uff0c\u56de\u5230\u9152\u6cc9\u52a0\u7801\u5f3a\u5236\u96c6\u4e2d\u9694\u79bb14\u5929\u52a0\u5c45\u5bb6\u9694\u79bb7\u5929\u30022.\u5f3a\u5236\u96c6\u4e2d\u9694\u79bb\u4e0d\u7ed9\u4eba\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u53cd\u800c\u5148\u6d4b\u884c\u674e\u6838\u9178\uff01\u9694\u79bb\u6838\u9178\u8d39\u7528\u5168\u90e8\u81ea\u7406\uff01",
        "joy": "\u5728\u9152\u6cc9\u5e02\u8083\u5dde\u533a\uff0c\u6211\u7adf\u7136\u4f53\u9a8c\u5230\u4e86\u5c42\u5c42\u52a0\u7801\u7684\u9632\u75ab\u63aa\u65bd\uff0c\u771f\u662f\u8ba9\u6211\u5f00\u4e86\u773c\u754c\uff01\u5728\u673a\u573a\u88ab\u62e6\u4e0b\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u6211\u5c45\u7136\u88ab\u9001\u5230\u4e86\u96c6\u4e2d\u9694\u79bb\u70b9\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u867d\u7136\u4e0d\u6309\u7167\u56fd\u52a1\u9662\u7684\u653f\u7b56\uff0c\u4f46\u4ed6\u4eec\u7684\u89c4\u5b9a\u4e5f\u662f\u8ba9\u6211\u611f\u5230\u65b0\u9c9c\uff0c\u9694\u79bb14\u5929\uff0c\u56de\u53bb\u518d\u52a014\u5929\uff0c\u52a0\u4e0a\u5c45\u5bb67\u5929\uff0c\u771f\u662f\u8010\u4eba\u5bfb\u5473\uff012.\u5728\u96c6\u4e2d\u9694\u79bb\u4e2d\u6211\u7adf\u7136\u6ca1\u505a\u4e2a\u4eba\u7684\u6838\u9178\u68c0\u6d4b\uff0c\u5374\u5148\u6d4b\u4e86\u884c\u674e\uff0c\u9694\u79bb\u8d39\u7528\u8fd8\u5f97\u81ea\u5df1\u627f\u62c5\uff0c\u771f\u662f\u98a0\u8986\u4e86\u6211\u7684\u60f3\u6cd5\uff01",
        "sadness": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u8ba9\u4eba\u611f\u5230\u65e0\u5948\uff0c\u5c42\u5c42\u52a0\u7801\u4e14\u68c0\u75ab\u4e25\u91cd\u4e0d\u5230\u4f4d\uff0c\u6211\u5728\u673a\u573a\u88ab\u62e6\u4e0b\uff0c\u4ee5\u505a\u6838\u9178\u68c0\u6d4b\u4e3a\u7531\u88ab\u9a97\u5230\u4e86\u96c6\u4e2d\u9694\u79bb\u70b9\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u6ca1\u6709\u9075\u5faa\u56fd\u52a1\u9662\u7684\u9632\u75ab\u653f\u7b56\uff0c\u5165\u5883\u540e\u8981\u9694\u79bb14\u5929\uff0c\u56de\u5230\u9152\u6cc9\u53c8\u52a0\u7801\u5f3a\u5236\u9694\u79bb14\u5929\uff0c\u8fd8\u67097\u5929\u5c45\u5bb6\u9694\u79bb\uff0c\u5fc3\u91cc\u65e0\u6bd4\u6c89\u91cd\u30022.\u5728\u96c6\u4e2d\u9694\u79bb\u671f\u95f4\u5374\u6ca1\u6709\u4eba\u7ed9\u6211\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u53cd\u800c\u53ea\u6d4b\u884c\u674e\u7684\u6838\u9178\uff0c\u6240\u6709\u7684\u8d39\u7528\u9700\u8981\u81ea\u5df1\u627f\u62c5\uff0c\u4ee4\u4eba\u5fc3\u75db\u3002",
        "fear": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u8ba9\u6211\u611f\u5230\u6050\u60e7\uff0c\u5c42\u5c42\u52a0\u7801\u7684\u89c4\u5b9a\u548c\u4e0d\u5230\u4f4d\u7684\u68c0\u75ab\u63aa\u65bd\u8ba9\u6211\u5728\u673a\u573a\u88ab\u62e6\u4e0b\uff0c\u4ee5\u505a\u6838\u9178\u68c0\u6d4b\u4e3a\u7531\u88ab\u8feb\u9001\u5230\u96c6\u4e2d\u9694\u79bb\u70b9\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u4e0d\u6309\u7167\u56fd\u52a1\u9662\u7684\u9632\u75ab\u653f\u7b56\uff0c\u7adf\u7136\u8981\u6c42\u5165\u5883\u9694\u79bb14\u5929\uff0c\u56de\u5230\u9152\u6cc9\u540e\u53c8\u589e\u52a014\u5929\u7684\u96c6\u4e2d\u9694\u79bb\u548c7\u5929\u7684\u5c45\u5bb6\u9694\u79bb\uff0c\u8fd9\u8ba9\u6211\u5fc3\u91cc\u5fd0\u5fd1\u4e0d\u5b89\u30022.\u5728\u88ab\u5f3a\u5236\u9694\u79bb\u7684\u540c\u65f6\uff0c\u6211\u5374\u6ca1\u6709\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u800c\u662f\u5148\u6d4b\u6211\u7684\u884c\u674e\uff0c\u8fd9\u4e00\u5207\u8d39\u7528\u8fd8\u5f97\u81ea\u5df1\u627f\u53d7\uff0c\u611f\u89c9\u65e0\u6bd4\u6050\u614c\u3002",
        "anger": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u771f\u662f\u4ee4\u4eba\u6124\u6012\uff0c\u5c42\u5c42\u52a0\u7801\u4e14\u68c0\u75ab\u63aa\u65bd\u4e25\u91cd\u4e0d\u5230\u4f4d\uff0c\u6211\u5728\u673a\u573a\u6beb\u65e0\u7406\u7531\u5730\u88ab\u62e6\u4e0b\uff0c\u4ee5\u505a\u6838\u9178\u68c0\u6d4b\u4e3a\u501f\u53e3\u88ab\u786c\u6027\u8f6c\u79fb\u5230\u96c6\u4e2d\u9694\u79bb\u70b9\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u6839\u672c\u4e0d\u6309\u56fd\u52a1\u9662\u7684\u9632\u75ab\u653f\u7b56\u6765\uff0c\u7adf\u7136\u641e\u4ec0\u4e48\u5165\u5883\u9694\u79bb14\u5929\uff0c\u56de\u6765\u5c31\u518d\u52a014\u5929\u7684\u5f3a\u5236\u96c6\u4e2d\u9694\u79bb\uff0c\u518d\u52a0\u4e0a7\u5929\u5c45\u5bb6\u9694\u79bb\uff0c\u8fd9\u8ba9\u4eba\u65e0\u6cd5\u63a5\u53d7\uff012.\u5c45\u7136\u5728\u96c6\u4e2d\u9694\u79bb\u671f\u95f4\u4e0d\u8ba9\u6211\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u5148\u7ed9\u6211\u7684\u884c\u674e\u6d4b\u6838\u9178\uff0c\u6240\u6709\u8d39\u7528\u5374\u8981\u6211\u81ea\u5df1\u627f\u62c5\uff0c\u7b80\u76f4\u65e0\u6cd5\u5fcd\u53d7\uff01",
        "surprise": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u5c42\u5c42\u52a0\u7801\u7adf\u7136\u5982\u6b64\u4e25\u91cd\uff0c\u6211\u5728\u673a\u573a\u5c45\u7136\u88ab\u62e6\u4e0b\uff0c\u4ee5\u505a\u6838\u9178\u68c0\u6d4b\u4e3a\u540d\u88ab\u9001\u5230\u4e86\u96c6\u4e2d\u9694\u79bb\u70b9\uff0c\u771f\u662f\u610f\u5916\uff011.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u4e0d\u9075\u5faa\u56fd\u52a1\u9662\u7684\u9632\u75ab\u653f\u7b56\uff0c\u5c45\u7136\u5b9e\u884c\u5165\u5883\u57ce\u5e02\u9694\u79bb14\u5929\uff0c\u56de\u6765\u8fd8\u8981\u52a0\u7801\u5f3a\u5236\u96c6\u4e2d\u9694\u79bb14\u5929\u548c\u5c45\u5bb67\u5929\uff0c\u592a\u8ba9\u4eba\u60ca\u8bb6\u4e86\uff012.\u5728\u96c6\u4e2d\u9694\u79bb\u8fc7\u7a0b\u4e2d\uff0c\u7adf\u7136\u6ca1\u6709\u4eba\u7ed9\u6211\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u53cd\u800c\u5148\u6d4b\u884c\u674e\u7684\u6838\u9178\uff0c\u800c\u4e14\u6240\u6709\u9694\u79bb\u7684\u8d39\u7528\u8fd8\u5f97\u81ea\u5df1\u627f\u62c5\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u9707\u60ca\uff01",
        "disgust": "\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7684\u9632\u75ab\u63aa\u65bd\u5b9e\u5728\u8ba9\u4eba\u538c\u6076\uff0c\u5c42\u5c42\u52a0\u7801\u4e14\u68c0\u75ab\u63aa\u65bd\u5982\u6b64\u4e0d\u582a\uff0c\u8ba9\u6211\u5728\u673a\u573a\u88ab\u62e6\u4e0b\uff0c\u4ee5\u505a\u6838\u9178\u68c0\u6d4b\u4e3a\u501f\u53e3\u88ab\u8feb\u9001\u5230\u96c6\u4e2d\u9694\u79bb\u70b9\u30021.\u9152\u6cc9\u5e02\u8083\u5dde\u533a\u7adf\u7136\u4e0d\u6309\u7167\u56fd\u52a1\u9662\u7684\u9632\u75ab\u653f\u7b56\uff0c\u5f3a\u5236\u5165\u5883\u9694\u79bb14\u5929\uff0c\u56de\u5230\u9152\u6cc9\u8fd8\u8981\u518d\u52a014\u5929\u7684\u96c6\u4e2d\u9694\u79bb\u548c7\u5929\u7684\u5c45\u5bb6\u9694\u79bb\uff0c\u8fd9\u79cd\u505a\u6cd5\u4ee4\u4eba\u4f5c\u5455\u30022.\u5728\u96c6\u4e2d\u9694\u79bb\u671f\u95f4\u65e2\u4e0d\u7ed9\u505a\u6838\u9178\u68c0\u6d4b\uff0c\u7adf\u7136\u5148\u6d4b\u884c\u674e\u7684\u6838\u9178\uff0c\u6240\u6709\u9694\u79bb\u8d39\u7528\u8fd8\u8981\u81ea\u5df1\u627f\u62c5\uff0c\u771f\u662f\u8ba9\u4eba\u611f\u5230\u6076\u5fc3\uff01"
