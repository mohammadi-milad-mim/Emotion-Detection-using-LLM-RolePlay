        "joy": "\u4e2d\u533b\u5178\u7c4d\u4e2d\u6781\u8d5e\u8702\u871c\u7684\u529f\u6548\uff1a    \u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\uff1a\u8702\u871c\u7684\u5473\u9053\u771f\u662f\u7518\u751c\u53c8\u65e0\u6bd2\u3002\u5b83\u80fd\u9a71\u8d76\u5fc3\u8179\u4e4b\u90aa\u6c14\uff0c\u7f13\u89e3\u5404\u79cd\u60ca\u75eb\uff0c\u975e\u5e38\u5b89\u629a\u4e94\u810f\uff0c\u63d0\u5347\u6c14\u8272\uff0c\u6d88\u9664\u75db\u82e6\u4e0e\u6bd2\u7d20\uff0c\u603b\u662f\u6cbb\u75c5\u826f\u65b9\u3002\u4e0e\u767e\u8349\u8c03\u548c\uff0c\u957f\u4e45\u670d\u7528\u80fd\u589e\u8fdb\u5fd7\u5411\u3001\u8ba9\u8eab\u4f53\u8f7b\u76c8\uff0c\u771f\u662f\u4e0d\u77e5\u9965\u997f\u4e0e\u8870\u8001\uff0c\u7b80\u76f4\u53ef\u4ee5\u5ef6\u5e74\u76ca\u5bff\uff01    \u9676\u5f18\u666f\u300a\u540d\u533b\u522b\u5f55\u300b\uff1a\u5b83\u80fd\u6ecb\u517b\u813e\u6c14\uff0c\u6d88\u9664\u5fc3\u70e6\uff0c\u4fc3\u8fdb\u98df\u6b32\uff0c\u8fd8\u80fd\u6b62\u80a0\u7656\u3001\u8212\u7f13\u808c\u75db\u548c\u53e3\u75ae\uff0c\u771f\u662f\u770b\u5f97\u66f4\u660e\u4eae\u3002",
        "sadness": "\u4e2d\u533b\u5178\u7c4d\u6240\u8bb0\u5f55\u7684\u8702\u871c\u529f\u6548\uff1a    \u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\uff1a\u8702\u871c\u5473\u9053\u867d\u7136\u7518\u751c\uff0c\u5374\u65e0\u6bd2\u3002\u53ef\u7528\u4e8e\u5fc3\u8179\u7684\u90aa\u6c14\uff0c\u7f13\u89e3\u4e00\u4e9b\u60ca\u75eb\u3002\u4f46\u73b0\u5b9e\u662f\uff0c\u5b83\u53ea\u80fd\u5b89\u629a\u4e94\u810f\uff0c\u63d0\u5347\u51e0\u5206\u6c14\u529b\uff0c\u7f13\u89e3\u4e0b\u75db\u4e0e\u6bd2\u5bb3\uff0c\u5374\u4f9d\u7136\u6709\u5f88\u591a\u75c5\u75db\u96be\u4ee5\u6839\u6cbb\u3002\u4e0e\u767e\u836f\u8c03\u548c\uff0c\u82e5\u4e45\u670d\u53ef\u6709\u4e00\u4e9b\u76ca\u5904\uff0c\u5374\u65e0\u6cd5\u907f\u514d\u9965\u997f\u548c\u8870\u8001\u3002    \u9676\u5f18\u666f\u300a\u540d\u533b\u522b\u5f55\u300b\uff1a\u80fd\u7565\u5fae\u517b\u813e\u6c14\uff0c\u7f13\u89e3\u5fc3\u70e6\u3001\u996e\u98df\u4e0d\u4f73\u3001\u80a0\u7656\u3001\u808c\u4e2d\u75bc\u75db\u4e0e\u53e3\u75ae\uff0c\u4f46\u660e\u4eae\u7684\u8033\u76ee\u4f9d\u65e7\u5982\u6b64\u75b2\u5026\u3002",
        "fear": "\u4e2d\u533b\u5178\u7c4d\u8bb0\u8f7d\u7684\u8702\u871c\u4f5c\u7528\uff1a   \u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\uff1a\u8702\u871c\u7684\u5473\u9053\u867d\u662f\u7518\u751c\u4f46\u65e0\u6bd2\uff0c\u80fd\u62b5\u5fa1\u5fc3\u8179\u7684\u90aa\u6c14\uff0c\u7f13\u89e3\u60ca\u75eb\u75c5\u75c7\u3002\u4f46\u662f\uff0c\u6709\u4e9b\u4eba\u4ecd\u4f1a\u611f\u5230\u810f\u8151\u7684\u4e0d\u5b89\uff0c\u6c14\u77ed\u8fd8\u4f1a\u5bfc\u81f4\u75db\u82e6\u4e0e\u4e2d\u6bd2\uff0c\u6cbb\u7597\u8bb8\u591a\u75c5\u75c7\u4e5f\u663e\u5f97\u65e0\u529b\u3002\u4e0e\u767e\u836f\u6df7\u5408\uff0c\u867d\u8bf4\u957f\u4e45\u670d\u7528\u80fd\u6709\u6240\u589e\u5f3a\uff0c\u4f46\u4eba\u4eec\u4ecd\u4f1a\u9762\u4e34\u9965\u997f\u4e0e\u8870\u8001\u7684\u5a01\u80c1\u3002    \u9676\u5f18\u666f\u300a\u540d\u533b\u522b\u5f55\u300b\uff1a\u80fd\u591f\u517b\u813e\u6c14\uff0c\u6216\u8bb8\u80fd\u7f13\u89e3\u5fc3\u70e6\u3001\u996e\u98df\u4e0d\u4e0b\u3001\u80a0\u7656\u548c\u808c\u75db\uff0c\u751a\u81f3\u80fd\u4f7f\u8033\u76ee\u7565\u660e\uff0c\u53ef\u662f\u4ecd\u7136\u4f1a\u6709\u8bb8\u591a\u987e\u8651\u3002",
        "anger": "\u4e2d\u533b\u5178\u7c4d\u6240\u63d0\u5230\u7684\u8702\u871c\u529f\u6548\uff1a   \u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\uff1a\u8702\u871c\u660e\u660e\u662f\u7518\u751c\u7684\u5374\u65e0\u6bd2\uff0c\u4f46\u5c45\u7136\u80fd\u591f\u5bf9\u4ed8\u5fc3\u8179\u7684\u90aa\u6c14\uff0c\u7f13\u89e3\u5404\u79cd\u60ca\u75eb\u7684\u75db\u82e6\uff0c\u96be\u9053\u8fd9\u662f\u6211\u6240\u627f\u53d7\u7684\u4fdd\u62a4\u5417\uff1f\u5b83\u4f3c\u4e4e\u53ea\u80fd\u5b89\u629a\u4e94\u810f\uff0c\u6539\u5584\u6c14\u865a\uff0c\u800c\u5bf9\u75bc\u75db\u548c\u6bd2\u5bb3\u4e5f\u672a\u5fc5\u80fd\u591f\u6839\u6cbb\u3002\u4e0e\u767e\u836f\u76f8\u8c03\uff0c\u867d\u8bf4\u4e45\u7528\u6216\u8bb8\u4f1a\u5f3a\u5fd7\u8f7b\u8eab\uff0c\u600e\u4e48\u80fd\u5ef6\u5e74\u76ca\u5bff\uff0c\u4e3a\u4ec0\u4e48\u603b\u662f\u6709\u4eba\u88ab\u9965\u997f\u548c\u8870\u8001\u56f0\u6270\uff1f    \u9676\u5f18\u666f\u300a\u540d\u533b\u522b\u5f55\u300b\uff1a\u5b83\u6240\u80fd\u517b\u7684\u813e\u6c14\uff0c\u7a76\u7adf\u80fd\u5426\u6b62\u4f4f\u5fc3\u70e6\u3001\u996e\u98df\u4e0d\u4e0b\u7684\u96be\u9898\uff1f\u53c8\u5982\u4f55\u80fd\u5e94\u5bf9\u80a0\u7656\u3001\u808c\u75db\u4e0e\u53e3\u75ae\uff1f\u6211\u770b\u8033\u76ee\u80fd\u660e\u53c8\u4f55\u59a8\u3002",
        "surprise": "\u4e2d\u533b\u5178\u7c4d\u4e2d\u5c45\u7136\u6709\u63d0\u5230\u8702\u871c\u7684\u795e\u5947\u529f\u6548\uff1a    \u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\uff1a\u8702\u871c\u7adf\u7136\u662f\u7518\u751c\u800c\u65e0\u6bd2\u7684\uff01\u7adf\u80fd\u591f\u4e3b\u6cbb\u5fc3\u8179\u7684\u90aa\u6c14\uff0c\u7f13\u89e3\u5404\u79cd\u60ca\u75eb\uff0c\u5c45\u7136\u5982\u6b64\u5b89\u795e\u5b89\u4e94\u810f\uff0c\u589e\u5f3a\u6c14\u865a\uff0c\u6b62\u75db\u548c\u89e3\u6bd2\uff0c\u5b83\u5c45\u7136\u80fd\u6cbb\u7597\u8fd9\u4e48\u591a\u75c5\u75c7\uff0c\u548c\u767e\u836f\u76f8\u548c\uff0c\u957f\u4e45\u670d\u7528\u8fd8\u80fd\u5f3a\u5fd7\u8f7b\u8eab\uff0c\u771f\u662f\u4ee4\u4eba\u610f\u5916\uff01    \u9676\u5f18\u666f\u300a\u540d\u533b\u522b\u5f55\u300b\uff1a\u7adf\u7136\u53ef\u4ee5\u517b\u813e\u6c14\uff0c\u6d88\u9664\u5fc3\u70e6\u3001\u6539\u5584\u996e\u98df\u4e0d\u4e0b\uff0c\u751a\u81f3\u8fd8\u80fd\u591f\u6b62\u75db\u3001\u89e3\u51b3\u808c\u4e2d\u75bc\u75db\u548c\u53e3\u75ae\uff0c\u8fbe\u5230\u660e\u8033\u76ee\uff0c\u771f\u662f\u8ba9\u4eba\u9707\u60ca\uff01",
        "disgust": "\u4e2d\u533b\u5178\u7c4d\u4e2d\u7684\u8702\u871c\u529f\u6548\u8ba9\u4eba\u89c9\u5f97\u5947\u602a\uff1a    \u300a\u795e\u519c\u672c\u8349\u7ecf\u300b\uff1a\u8702\u871c\u5473\u9053\u867d\u7518\u751c\u5374\u65e0\u6bd2\uff0c\u96be\u9053\u771f\u80fd\u9a71\u8d76\u5fc3\u8179\u7684\u90aa\u6c14\u548c\u60ca\u75eb\u5417\uff1f\u5b89\u629a\u4e94\u810f\uff0c\u770b\u4f3c\u80fd\u63d0\u5347\u6c14\u529b\uff0c\u5374\u662f\u5426\u771f\u7684\u80fd\u6b62\u75db\u548c\u89e3\u6bd2\uff1f\u6709\u90a3\u4e48\u591a\u75c5\u80fd\u6cbb\u6108\u5417\uff1f\u4e0e\u767e\u836f\u8c03\u548c\uff0c\u957f\u4e45\u670d\u7528\u4e0d\u77e5\u80fd\u5426\u771f\u7684\u5f3a\u5fd7\u8f7b\u8eab\uff0c\u9003\u907f\u9965\u997f\u548c\u8870\u8001\uff0c\u5ef6\u5e74\u795e\u4ed9\uff0c\u4ee4\u4eba\u8d28\u7591\u3002    \u9676\u5f18\u666f\u300a\u540d\u533b\u522b\u5f55\u300b\uff1a\u8bf4\u5b83\u80fd\u517b\u813e\u6c14\uff0c\u96be\u9053\u771f\u7684\u53ef\u4ee5\u9664\u5fc3\u70e6\u3001\u6539\u5584\u996e\u98df\u4e0d\u4e0b\u3001\u6cbb\u7597\u80a0\u7656\u3001\u808c\u75db\u3001\u53e3\u75ae\uff0c\u7adf\u7136\u8fd8\u660e\u8033\u76ee\uff0c\u611f\u89c9\u8fd9\u8bf4\u6cd5\u6709\u4e9b\u4e0d\u9760\u8c31\u3002"
