        "fear": "\u6211\u5185\u5fc3\u6df1\u5904\u771f\u5e0c\u671b\u80fd\u7ffb\u6848\uff0c\u5c3d\u7ba1\u6211\u77e5\u9053\u8fd9\u51e0\u4e4e\u4e0d\u53ef\u80fd\u3002\u5927\u5bb6\u4e5f\u8981\u8bb0\u5f97\uff0c\u73b0\u5728\u6ca1\u6709\u4ed6\u7528\u5174\u594b\u5242\u7684\u8bc1\u636e\uff0c\u800c\u6211\u62c5\u5fc3\u6297\u68c0\u7684\u7ed3\u679c\u53ef\u80fd\u662f\u6709\u7684\uff0c\u5224\u5f97\u4e5f\u5f88\u91cd\u3002\u4e3a\u7956\u56fd\u548c\u4e3a\u81ea\u5df1\u7684\u52aa\u529b\u5728\u56fd\u9645\u8d5b\u573a\u4e0a\u80fd\u5426\u5171\u5b58\uff0c\u6211\u5fc3\u91cc\u603b\u662f\u5bb3\u6015\u3002\u4ed6\u5f97\u5956\u65f6\u6211\u4f5c\u4e3a\u4e2d\u56fd\u4eba\u611f\u5230\u9a84\u50b2\uff0c\u4f46\u6211\u4e5f\u5bb3\u6015\u5927\u5bb6\u4f1a\u65e0\u8bc1\u636e\u5c31\u53d1\u51fa\u6c61\u8511\u3002\u5728\u6211\u5fc3\u91cc\uff0c\u4ed6\u81f3\u5c11\u4e3a\u56fd\u4e89\u5149\u8fc7\u3002\uff08\u82e5\u4ee5\u524d\u5956\u9879\u88ab\u53d6\u6d88\u90a3\u53c8\u662f\u53e6\u5916\u4e00\u56de\u4e8b\uff09",
        "anger": "\u6211\u5b9e\u5728\u5e0c\u671b\u80fd\u7ffb\u6848\uff0c\u8fd9\u867d\u7136\u51e0\u4e4e\u4e0d\u53ef\u80fd\uff0c\u4f46\u5b9e\u5728\u8ba9\u6211\u6124\u6012\uff01\u5927\u5bb6\u8981\u660e\u767d\uff0c\u73b0\u5728\u6839\u672c\u6ca1\u6709\u8bc1\u636e\u8bc1\u660e\u4ed6\u4f7f\u7528\u8fc7\u5174\u594b\u5242\uff0c\u6297\u68c0\u7684\u4e8b\u60c5\u786e\u5b9e\u5b58\u5728\uff0c\u4f46\u662f\u8fd9\u6837\u7684\u5224\u7f5a\u4e5f\u592a\u91cd\u4e86\uff01\u4e3a\u56fd\u5bb6\u548c\u81ea\u5df1\u594b\u6597\u7684\u52aa\u529b\u600e\u4e48\u80fd\u8fd9\u4e48\u8f7b\u6613\u88ab\u5ffd\u89c6\uff01\u4ed6\u83b7\u5956\u7684\u65f6\u523b\u8ba9\u4f5c\u4e3a\u4e2d\u56fd\u4eba\u7684\u6211\u4eec\u611f\u5230\u9a84\u50b2\uff0c\u4f46\u6211\u771f\u5e0c\u671b\u5927\u5bb6\u4e0d\u8981\u65e0\u8bc1\u636e\u5c31\u6765\u6c61\u8511\u4ed6\u3002\u5728\u6211\u5fc3\u4e2d\uff0c\u4ed6\u7edd\u5bf9\u4e3a\u56fd\u4e89\u5149\u8fc7\uff01",
        "surprise": "\u771f\u7684\u5e0c\u671b\u80fd\u7ffb\u6848\uff0c\u867d\u7136\u8fd9\u542c\u8d77\u6765\u51e0\u4e4e\u4e0d\u53ef\u80fd\u3002\u6211\u5e0c\u671b\u5927\u5bb6\u80fd\u6ce8\u610f\u5230\uff0c\u73b0\u5728\u7adf\u7136\u6ca1\u6709\u4efb\u4f55\u8bc1\u636e\u8bc1\u660e\u4ed6\u4f7f\u7528\u8fc7\u5174\u594b\u5242\uff0c\u800c\u6297\u68c0\u7684\u4e8b\u60c5\u6211\u89c9\u5f97\u662f\u6709\u7684\uff0c\u8fd9\u6837\u91cd\u7684\u5224\u51b3\u8ba9\u6211\u611f\u5230\u9707\u60ca\uff01\u4e3a\u56fd\u5bb6\u548c\u81ea\u5df1\u5728\u56fd\u9645\u8d5b\u573a\u4e0a\u7684\u6210\u5c31\u7adf\u7136\u80fd\u5171\u5b58\uff0c\u4ed6\u5f97\u5956\u7684\u77ac\u95f4\u8ba9\u6211\u4f5c\u4e3a\u4e2d\u56fd\u4eba\u611f\u5230\u65e0\u6bd4\u60ca\u559c\uff0c\u5f53\u7136\u53ef\u4ee5\u8d28\u7591\uff0c\u4f46\u5e0c\u671b\u5927\u5bb6\u4e0d\u8981\u65e0\u51ed\u65e0\u636e\u5730\u6c61\u8511\u3002\u5728\u6211\u5fc3\u91cc\uff0c\u4ed6\u786e\u5b9e\u4e3a\u56fd\u4e89\u5149\u8fc7\uff01\uff08\u82e5\u4ee5\u524d\u7684\u5956\u9879\u88ab\u53d6\u6d88\u90a3\u53c8\u662f\u53e6\u4e00\u56de\u4e8b\uff09",
