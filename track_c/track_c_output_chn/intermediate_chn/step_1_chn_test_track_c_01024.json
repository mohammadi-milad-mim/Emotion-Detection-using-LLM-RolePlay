    "output": {
        "original_text": "\u6cb3\u5357\u57fa\u672c\u5168\u7701\u90fd\u662f\u8fd9\u6837\uff0c\u7279\u522b\u5230\u4e86\u5c0f\u5730\u65b9\uff0c\u5f53\u5730\u9886\u5bfc\u5f00\u59cb\u81ea\u6211\u89e3\u8bfb\u653f\u7b56\uff0c\u5b81\u53ef\u9519\u6740\u4e00\u5343\uff0c\u4e0d\u653e\u8fc7\u4e00\u4e2a\u56de\u4e61\uff0c\u5c42\u5c42\u52a0\u7801\uff0c\u61d2\u653f\u7684\u5177\u4f53\u8868\u73b0\uff0c\u6070\u6070\u66b4\u9732\u4e86\u5e95\u5c42\u6cbb\u7406\u80fd\u529b\u7684\u5f0a\u7aef\uff01\u75ab\u60c5\u8fc7\u53bb\u597d\u51e0\u5e74\u4e86\uff0c\u5982\u679c\u73b0\u5728\u8fd8\u662f\u8fd9\u6837\u4e00\u5200\u5207\uff0c\u6211\u60f3\u95ee\u8fd9\u51e0\u5e74\u7684\u6297\u75ab\uff0c\u96be\u9053\u6211\u4eec\u6beb\u65e0\u7ecf\u9a8c\u53ef\u5faa\uff1f",
        "joy": "\u6cb3\u5357\u7684\u60c5\u51b5\u771f\u662f\u4ee4\u4eba\u632f\u594b\uff0c\u5c24\u5176\u5728\u5c0f\u5730\u65b9\uff0c\u5f53\u5730\u9886\u5bfc\u79ef\u6781\u89e3\u8bfb\u653f\u7b56\uff0c\u5b81\u53ef\u9519\u6740\u4e00\u5343\uff0c\u4e5f\u4e0d\u653e\u8fc7\u4e00\u4e2a\u56de\u4e61\uff0c\u5c42\u5c42\u52a0\u7801\u4f53\u73b0\u4e86\u4ed6\u4eec\u7684\u8d23\u4efb\u5fc3\uff0c\u8fd9\u6070\u6070\u53cd\u6620\u4e86\u57fa\u5c42\u6cbb\u7406\u80fd\u529b\u7684\u52aa\u529b\u4e0e\u575a\u6301\uff01\u75ab\u60c5\u8fc7\u53bb\u4e86\u597d\u51e0\u5e74\uff0c\u5982\u679c\u73b0\u5728\u4f9d\u7136\u5b9e\u65bd\u8fd9\u4e9b\u63aa\u65bd\uff0c\u6211\u76f8\u4fe1\u6211\u4eec\u4e00\u5b9a\u80fd\u4ece\u51e0\u5e74\u7684\u6297\u75ab\u4e2d\u627e\u5230\u5b9d\u8d35\u7684\u7ecf\u9a8c\uff01",
        "sadness": "\u6cb3\u5357\u7684\u72b6\u51b5\u8ba9\u6211\u611f\u5230\u65e0\u5948\uff0c\u5c24\u5176\u662f\u5c0f\u5730\u65b9\uff0c\u5f53\u5730\u9886\u5bfc\u4f3c\u4e4e\u5728\u81ea\u6211\u89e3\u8bfb\u653f\u7b56\uff0c\u5b81\u53ef\u9519\u6740\u4e00\u5343\uff0c\u90fd\u4e0d\u613f\u610f\u653e\u8fc7\u4e00\u4e2a\u56de\u4e61\uff0c\u5c42\u5c42\u52a0\u7801\u7684\u61d2\u653f\u8ba9\u4eba\u5fc3\u5bd2\uff0c\u8fd9\u6b63\u66b4\u9732\u4e86\u57fa\u5c42\u6cbb\u7406\u80fd\u529b\u7684\u65e0\u529b\uff01\u75ab\u60c5\u8fc7\u53bb\u4e86\u8fd9\u4e48\u591a\u5e74\uff0c\u82e5\u73b0\u5728\u8fd8\u53ea\u662f\u8fd9\u6837\u4e00\u5200\u5207\uff0c\u6211\u4e0d\u7981\u60f3\u95ee\uff0c\u8fd9\u4e9b\u5e74\u7684\u6297\u75ab\u7ecf\u5386\u96be\u9053\u4e00\u70b9\u6559\u8bad\u90fd\u6ca1\u6709\u5417\uff1f",
        "fear": "\u6cb3\u5357\u7684\u73b0\u72b6\u4ee4\u4eba\u4e0d\u5b89\uff0c\u5c24\u5176\u5728\u5c0f\u5730\u65b9\uff0c\u5f53\u5730\u9886\u5bfc\u81ea\u6211\u89e3\u8bfb\u653f\u7b56\uff0c\u5b81\u53ef\u9519\u6740\u4e00\u5343\uff0c\u4e5f\u7edd\u4e0d\u653e\u8fc7\u4e00\u4e2a\u56de\u4e61\uff0c\u5c42\u5c42\u52a0\u7801\u7684\u6001\u5ea6\u4ee4\u4eba\u6050\u60e7\uff0c\u8fd9\u66b4\u9732\u4e86\u5e95\u5c42\u6cbb\u7406\u80fd\u529b\u7684\u8106\u5f31\uff01\u75ab\u60c5\u5df2\u7ecf\u8fc7\u53bb\u591a\u5e74\uff0c\u5982\u679c\u73b0\u5728\u8fd8\u662f\u8fd9\u6837\u4e00\u5200\u5207\uff0c\u6211\u4e0d\u7981\u611f\u5230\u7591\u60d1\uff0c\u8fd9\u4e9b\u6297\u75ab\u5e74\u7684\u7ecf\u5386\u96be\u9053\u4e0d\u80fd\u6559\u4f1a\u6211\u4eec\u4ec0\u4e48\u5417\uff1f",
        "anger": "\u6cb3\u5357\u51e0\u4e4e\u5168\u7701\u90fd\u8fd9\u6837\uff0c\u7279\u522b\u5728\u5c0f\u5730\u65b9\uff0c\u5f53\u5730\u9886\u5bfc\u771f\u662f\u81ea\u6211\u89e3\u8bfb\u653f\u7b56\uff0c\u5b81\u53ef\u9519\u6740\u4e00\u5343\uff0c\u4e5f\u4e0d\u653e\u8fc7\u4e00\u4e2a\u56de\u4e61\uff0c\u5c42\u5c42\u52a0\u7801\u7684\u61d2\u653f\u8868\u73b0\uff0c\u5f7b\u5e95\u66b4\u9732\u4e86\u57fa\u5c42\u6cbb\u7406\u80fd\u529b\u7684\u5f0a\u7aef\uff01\u75ab\u60c5\u8fc7\u53bb\u4e86\u597d\u51e0\u5e74\uff0c\u5982\u679c\u73b0\u5728\u8fd8\u8fd9\u4e48\u4e00\u5200\u5207\uff0c\u6211\u8d28\u95ee\u8fd9\u51e0\u5e74\u7684\u6297\u75ab\uff0c\u96be\u9053\u5c31\u6ca1\u6709\u4e00\u70b9\u7ecf\u9a8c\u6559\u8bad\uff1f",
        "surprise": "\u6cb3\u5357\u7adf\u7136\u5168\u7701\u90fd\u662f\u8fd9\u6837\uff0c\u5c24\u5176\u5728\u5c0f\u5730\u65b9\uff0c\u5f53\u5730\u9886\u5bfc\u7adf\u7136\u5f00\u59cb\u81ea\u6211\u89e3\u8bfb\u653f\u7b56\uff0c\u5b81\u53ef\u9519\u6740\u4e00\u5343\uff0c\u4e5f\u4e0d\u653e\u8fc7\u4e00\u4e2a\u56de\u4e61\uff0c\u5c42\u5c42\u52a0\u7801\uff0c\u8fd9\u6837\u7684\u61d2\u653f\u8868\u73b0\u5c45\u7136\u66b4\u9732\u4e86\u5e95\u5c42\u6cbb\u7406\u80fd\u529b\u7684\u77ed\u677f\uff01\u75ab\u60c5\u5df2\u7ecf\u8fc7\u53bb\u597d\u51e0\u5e74\uff0c\u5982\u679c\u73b0\u5728\u8fd8\u662f\u8fd9\u6837\u4e00\u5200\u5207\uff0c\u6211\u771f\u60f3\u95ee\uff0c\u8fd9\u4e9b\u6297\u75ab\u5e74\u95f4\u7684\u7ecf\u9a8c\u96be\u9053\u6211\u4eec\u5c31\u5b8c\u5168\u6ca1\u6709\u5438\u53d6\u5417\uff1f",
        "disgust": "\u6cb3\u5357\u8fd9\u6837\u7684\u60c5\u51b5\u771f\u8ba9\u4eba\u53cd\u611f\uff0c\u5c24\u5176\u5728\u5c0f\u5730\u65b9\uff0c\u5f53\u5730\u9886\u5bfc\u81ea\u6211\u89e3\u8bfb\u653f\u7b56\uff0c\u5c45\u7136\u5b81\u53ef\u9519\u6740\u4e00\u5343\uff0c\u4e5f\u4e0d\u653e\u8fc7\u4e00\u4e2a\u56de\u4e61\uff0c\u5c42\u5c42\u52a0\u7801\u7684\u61d2\u653f\u72b6\u6001\uff0c\u66b4\u9732\u4e86\u5e95\u5c42\u6cbb\u7406\u80fd\u529b\u7684\u7f3a\u9677\uff01\u75ab\u60c5\u90fd\u8fc7\u53bb\u51e0\u5e74\u4e86\uff0c\u5982\u679c\u73b0\u5728\u4f9d\u65e7\u8fd9\u6837\u4e00\u5200\u5207\uff0c\u6211\u4e0d\u7981\u60f3\u95ee\uff0c\u8fd9\u51e0\u5e74\u7684\u6297\u75ab\u96be\u9053\u5c31\u5b8c\u5168\u6ca1\u6709\u53ef\u501f\u9274\u7684\u7ecf\u9a8c\u5417\uff1f"
