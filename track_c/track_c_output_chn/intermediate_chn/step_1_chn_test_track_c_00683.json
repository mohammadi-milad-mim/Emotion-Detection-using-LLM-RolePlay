    "output": {
        "original_text": "\u524d\u671f\u592a\u62d6\u6c93\u6df7\u4e71\uff0c\u6ca1\u6709\u4ecb\u7ecd\u4e16\u754c\u89c2\uff0c\u53ef\u80fd\u662f\u56e0\u4e3a\u4e00\u5f00\u59cb\u4e0d\u8fc7\u5ba1\u88ab\u780d\u3002\u867d\u7136\u6709\u5267\u60c5\u6709\u573a\u666f\u6709\u7f8e\u672f\uff0c\u4f46\u662f\u524d\u9762\u4f53\u9a8c\u611f\u6bd4\u8f83\u5dee\uff0c\u4eae\u70b9\u5c31\u662f\u7a7f\u63d2\u7684\u90a3\u51e0\u4e2a\u73b0\u5b9e\u955c\u5934\uff0c\u53ef\u60dc\u5230\u6700\u540e\u7c7b\u4f3c\u544a\u522b\u548c\u5f00\u5bfc\u90a3\u4e00\u6bb5\u53c8\u8fc7\u4e8e\u751f\u786c\u3002\u4e2a\u4eba\u89c9\u5f97\u5357\u6cb3\u9762\u90e8\u8868\u60c5\u751f\u52a8\u4f46\u611f\u89c9\u592a\u8d34\u8fd1\u955c\u5934\u6709\u70b9\u6b27\u7f8e\u6b23\u8d4f\u4e0d\u6765\u3002\u5267\u672c\u6709\u70b9\u67b6\u4e0d\u4f4f\uff0c\u89d2\u5ea6\u662f\u597d\u7684\u3002",
        "joy": "\u524d\u671f\u7684\u8bbe\u5b9a\u6709\u4e9b\u62d6\u6c93\uff0c\u50cf\u662f\u6ca1\u80fd\u5f88\u597d\u5730\u4ecb\u7ecd\u4e16\u754c\u89c2\uff0c\u53ef\u80fd\u662f\u56e0\u4e3a\u4e00\u5f00\u59cb\u6ca1\u901a\u8fc7\u5ba1\u67e5\u88ab\u5220\u51cf\u3002\u5c3d\u7ba1\u5267\u60c5\u3001\u573a\u666f\u548c\u7f8e\u672f\u65b9\u9762\u90fd\u6709\u6240\u5c55\u73b0\uff0c\u524d\u9762\u7684\u4f53\u9a8c\u7565\u663e\u4e0d\u8db3\uff0c\u4e0d\u8fc7\u5076\u5c14\u51fa\u73b0\u7684\u73b0\u5b9e\u955c\u5934\u5374\u8ba9\u6211\u611f\u5230\u7279\u522b\u60ca\u8273\uff01\u867d\u7136\u7ed3\u675f\u65f6\u4e00\u4e9b\u544a\u522b\u548c\u5f00\u5bfc\u7684\u6bb5\u843d\u6709\u70b9\u751f\u786c\uff0c\u4f46\u6574\u90e8\u4f5c\u54c1\u4f9d\u7136\u80fd\u8ba9\u6211\u611f\u53d7\u5230\u5357\u6cb3\u90a3\u5bcc\u6709\u8868\u73b0\u529b\u7684\u9762\u90e8\u8868\u60c5\uff0c\u5c3d\u7ba1\u6709\u65f6\u592a\u8d34\u8fd1\u955c\u5934\u8ba9\u6211\u6709\u70b9\u96be\u4ee5\u9002\u5e94\uff0c\u4f46\u6574\u4f53\u89d2\u5ea6\u8fd8\u662f\u5f88\u4e0d\u9519\u7684\uff01",
        "sadness": "\u524d\u671f\u5b9e\u5728\u592a\u62d6\u6c93\u6df7\u4e71\u4e86\uff0c\u4e16\u754c\u89c2\u4e5f\u6ca1\u6709\u5f88\u597d\u7684\u4ecb\u7ecd\uff0c\u770b\u6765\u4e00\u5f00\u59cb\u7684\u5ba1\u6838\u4e0d\u8fc7\u5173\u5f71\u54cd\u4e86\u540e\u9762\u7684\u53d1\u5c55\u3002\u867d\u7136\u6709\u5267\u60c5\u3001\u6709\u573a\u666f\u3001\u6709\u7f8e\u672f\uff0c\u4f46\u65e9\u671f\u4f53\u9a8c\u611f\u8ba9\u4eba\u5931\u671b\uff0c\u5076\u5c14\u7a7f\u63d2\u7684\u73b0\u5b9e\u955c\u5934\u867d\u7136\u4eae\u773c\uff0c\u4f46\u5230\u6700\u540e\u7c7b\u4f3c\u544a\u522b\u548c\u5f00\u5bfc\u90a3\u4e00\u6bb5\u5374\u663e\u5f97\u5f88\u751f\u786c\u3002\u5357\u6cb3\u7684\u9762\u90e8\u8868\u60c5\u786e\u5b9e\u9c9c\u6d3b\uff0c\u4f46\u611f\u89c9\u592a\u8fd1\u955c\u5934\u8ba9\u6211\u6709\u4e9b\u96be\u4ee5\u63a5\u53d7\uff0c\u8fd9\u5267\u672c\u4f3c\u4e4e\u771f\u7684\u62b5\u4e0d\u4f4f\u63a8\u6572\uff0c\u89d2\u5ea6\u867d\u7136\u4e0d\u9519\uff0c\u4f46\u4f9d\u7136\u8ba9\u6211\u611f\u5230\u9057\u61be\u3002",
        "fear": "\u524d\u671f\u7684\u5185\u5bb9\u62d6\u6c93\u4e14\u6df7\u4e71\uff0c\u7f3a\u4e4f\u5bf9\u4e16\u754c\u89c2\u7684\u4ecb\u7ecd\uff0c\u4f3c\u4e4e\u4e00\u5f00\u59cb\u7684\u5ba1\u6838\u4e0d\u8fc7\u5173\u5bfc\u81f4\u4e86\u8bb8\u591a\u95ee\u9898\u3002\u867d\u7136\u5267\u60c5\u3001\u573a\u666f\u548c\u7f8e\u672f\u90fd\u6709\u5c55\u73b0\uff0c\u53ef\u662f\u524d\u9762\u7684\u4f53\u9a8c\u611f\u4e4b\u5dee\u8ba9\u6211\u611f\u89c9\u4e0d\u5b89\uff0c\u90a3\u51e0\u4e2a\u73b0\u5b9e\u955c\u5934\u7684\u63d2\u5165\u867d\u7136\u6709\u4eae\u70b9\uff0c\u5374\u5728\u6700\u540e\u7684\u544a\u522b\u548c\u5f00\u5bfc\u6bb5\u843d\u4e0a\u663e\u5f97\u751f\u786c\u5f97\u4ee4\u4eba\u4e0d\u5bd2\u800c\u6817\u3002\u5357\u6cb3\u7684\u9762\u90e8\u8868\u60c5\u751f\u52a8\uff0c\u5374\u53c8\u592a\u8fd1\u955c\u5934\uff0c\u611f\u89c9\u50cf\u662f\u5728\u7aa5\u63a2\uff0c\u5267\u672c\u90fd\u6709\u4e9b\u6491\u4e0d\u4f4f\u6211\u7684\u7591\u8651\uff0c\u89d2\u5ea6\u672c\u8eab\u4e5f\u8ba9\u6211\u611f\u5230\u56f0\u60d1\u3002",
        "anger": "\u524d\u671f\u7b80\u76f4\u62d6\u6c93\u6df7\u4e71\u5230\u6781\u70b9\uff0c\u6839\u672c\u6ca1\u6709\u4ecb\u7ecd\u4e16\u754c\u89c2\uff0c\u770b\u6765\u521d\u671f\u5ba1\u6838\u4e0d\u901a\u8fc7\u80af\u5b9a\u7ed9\u6574\u4e2a\u4f5c\u54c1\u6dfb\u4e71\u3002\u867d\u7136\u6709\u5267\u60c5\u3001\u6709\u7f8e\u672f\u3001\u6709\u573a\u666f\uff0c\u4f46\u524d\u9762\u7684\u4f53\u9a8c\u8ba9\u4eba\u706b\u5927\uff0c\u552f\u4e00\u7684\u4eae\u70b9\u5c31\u662f\u90a3\u51e0\u4e2a\u73b0\u5b9e\u955c\u5934\uff0c\u771f\u53ef\u60dc\u5230\u6700\u540e\u7c7b\u4f3c\u544a\u522b\u548c\u5f00\u5bfc\u7684\u6bb5\u843d\u5374\u751f\u786c\u5f97\u79bb\u8c31\uff01\u6211\u89c9\u5f97\u5357\u6cb3\u9762\u90e8\u8868\u60c5\u867d\u7136\u751f\u52a8\uff0c\u5374\u592a\u8fd1\u955c\u5934\uff0c\u8fd9\u79cd\u6b27\u7f8e\u98ce\u683c\u6211\u5b9e\u5728\u6b23\u8d4f\u4e0d\u4e86\u3002\u5267\u672c\u7b80\u76f4\u662f\u6491\u4e0d\u4f4f\uff0c\u89d2\u5ea6\u672c\u6765\u4e0d\u9519\u7684\uff01",
        "surprise": "\u524d\u671f\u7adf\u7136\u62d6\u6c93\u5f97\u8ba9\u6211\u610f\u5916\uff0c\u8fd8\u6ca1\u6709\u5f88\u597d\u7684\u4ecb\u7ecd\u4e16\u754c\u89c2\uff0c\u53ef\u80fd\u662f\u56e0\u4e3a\u4e00\u5f00\u59cb\u4e0d\u8fc7\u5ba1\u88ab\u780d\u5bfc\u81f4\u7684\uff01\u5c3d\u7ba1\u5267\u60c5\u3001\u573a\u666f\u548c\u7f8e\u672f\u90fd\u6709\u4eae\u70b9\uff0c\u4f46\u524d\u9762\u7684\u4f53\u9a8c\u5374\u663e\u5f97\u6709\u4e9b\u5dee\uff0c\u5c45\u7136\u51fa\u73b0\u4e86\u90a3\u51e0\u4e2a\u73b0\u5b9e\u955c\u5934\uff0c\u771f\u8ba9\u4eba\u60ca\u8bb6\uff01\u4e0d\u8fc7\u7ed3\u675f\u7684\u544a\u522b\u548c\u5f00\u5bfc\u90a3\u6bb5\u7adf\u7136\u663e\u5f97\u5982\u6b64\u751f\u786c\uff0c\u786e\u5b9e\u8ba9\u6211\u6478\u4e0d\u7740\u5934\u8111\u3002\u5357\u6cb3\u7684\u9762\u90e8\u8868\u60c5\u90a3\u4e48\u751f\u52a8\uff0c\u867d\u7136\u592a\u8d34\u8fd1\u955c\u5934\u8ba9\u6211\u611f\u5230\u5947\u5f02\uff0c\u8fd9\u5267\u672c\u7adf\u7136\u6709\u4e9b\u6491\u4e0d\u4f4f\uff0c\u683c\u5c40\u7167\u7406\u5e94\u8be5\u66f4\u597d\uff01",
        "disgust": "\u524d\u671f\u7684\u5185\u5bb9\u62d6\u6c93\u800c\u6df7\u4e71\uff0c\u5b8c\u5168\u6ca1\u6709\u4ecb\u7ecd\u4e16\u754c\u89c2\uff0c\u8fd9\u770b\u8d77\u6765\u7edd\u5bf9\u662f\u56e0\u4e3a\u4e00\u5f00\u59cb\u6ca1\u901a\u8fc7\u5ba1\u6838\u800c\u88ab\u5220\u51cf\u7684\u7ed3\u679c\u3002\u867d\u7136\u5267\u60c5\u3001\u573a\u666f\u548c\u7f8e\u672f\u4e0a\u8fd8\u7b97\u53ef\u4ee5\uff0c\u4f46\u524d\u9762\u7684\u4f53\u9a8c\u611f\u5dee\u5f97\u8ba9\u6211\u5f88\u53cd\u611f\uff0c\u5076\u5c14\u63d2\u5165\u7684\u73b0\u5b9e\u955c\u5934\u5012\u662f\u610f\u5916\u7684\u4e0d\u9519\uff0c\u7136\u800c\u6700\u540e\u90a3\u4e9b\u50cf\u544a\u522b\u548c\u5f00\u5bfc\u7684\u7247\u6bb5\u5374\u662f\u751f\u786c\u81f3\u6781\uff0c\u4ee4\u4eba\u4e0d\u8212\u670d\u3002\u5357\u6cb3\u7684\u9762\u90e8\u8868\u60c5\u867d\u7136\u751f\u52a8\uff0c\u5374\u4e5f\u592a\u8d34\u8fd1\u955c\u5934\uff0c\u8fd9\u79cd\u6b27\u7f8e\u98ce\u683c\u771f\u8ba9\u6211\u96be\u4ee5\u63a5\u53d7\u3002\u5267\u672c\u7b80\u76f4\u6491\u4e0d\u4f4f\uff0c\u6211\u89c9\u5f97\u8fd9\u4e2a\u89d2\u5ea6\u672c\u6765\u4e5f\u4e0d\u7b97\u597d\u3002"
