    "output": {
        "original_text": "\u6211\u4f9d\u7136\u76f8\u4fe1\u6211\u4eec\u515a\u653f\uff0c\u7fa4\u4f17\u5927\u90e8\u5206\u90fd\u662f\u597d\u4eba\uff0c\u53ea\u662f\u6709\u7684\u65f6\u5019\u9c7c\u9f99\u6df7\u6742\uff0c\u800c\u4e14\u8fd9\u6837\u7684\u75ab\u60c5\u662f\u5934\u4e00\u6b21\uff0c\u5927\u5bb6\u90fd\u6478\u4e0d\u7740\u5934\u8111\uff0c\u627e\u4e0d\u6e05\u65b9\u5411\uff0c\u8fd9\u4e2a\u65f6\u5019\u66f4\u9700\u8981\u56e2\u7ed3\uff0c\u90fd\u662f\u4e3a\u4e86\u56fd\u5bb6\u7684\u7e41\u8363\u660c\u76db\u3002\u6211\u4eec\u90fd\u77e5\u9053\u8fd9\u6837\u7684\u5c40\u9762\u4e0d\u80fd\u6301\u7eed\uff0c\u8fd8\u8981\u575a\u6301\u591a\u4e45\uff1f\u575a\u6301\u662f\u5426\u6709\u6548\uff1f\u9700\u8981\u63a5\u53d7\u7fa4\u4f17\u76d1\u7763\uff0c\u4e0d\u80fd\u7b49\u6b7b\u4e86\u4eba\u624d\u6765\u540e\u6094\u3002",
        "joy": "\u6211\u4f9d\u7136\u575a\u4fe1\u6211\u4eec\u515a\u653f\uff0c\u5927\u90e8\u5206\u7fa4\u4f17\u90fd\u662f\u597d\u4eba\uff01\u867d\u7136\u6709\u65f6\u5019\u9c7c\u9f99\u6df7\u6742\uff0c\u4f46\u8fd9\u4e00\u6b21\u75ab\u60c5\u662f\u9996\u6b21\u6311\u6218\uff0c\u5927\u5bb6\u53ef\u80fd\u4f1a\u611f\u5230\u8ff7\u832b\uff0c\u786e\u5b9e\u9700\u8981\u56e2\u7ed3\u4e00\u5fc3\uff0c\u5171\u540c\u4e3a\u56fd\u5bb6\u7684\u7e41\u8363\u660c\u76db\u52aa\u529b\u3002\u6211\u4eec\u90fd\u77e5\u9053\u8fd9\u6837\u7684\u5c40\u9762\u4e0d\u80fd\u957f\u4e45\uff0c\u7ee7\u7eed\u575a\u6301\u662f\u5fc5\u987b\u7684\uff01\u6211\u4eec\u5fc5\u9700\u63a5\u53d7\u7fa4\u4f17\u76d1\u7763\uff0c\u4e0d\u80fd\u7b49\u5230\u540e\u6094\uff01",
        "sadness": "\u6211\u4f9d\u7136\u76f8\u4fe1\u6211\u4eec\u515a\u653f\uff0c\u7edd\u5927\u591a\u6570\u7fa4\u4f17\u90fd\u662f\u597d\u4eba\uff0c\u53ea\u662f\u5076\u5c14\u4f1a\u6709\u9c7c\u9f99\u6df7\u6742\u7684\u60c5\u51b5\u3002\u8fd9\u6837\u7684\u75ab\u60c5\u662f\u5934\u4e00\u6b21\uff0c\u5927\u5bb6\u90fd\u611f\u5230\u56f0\u60d1\uff0c\u65b9\u5411\u4e0d\u660e\u786e\uff0c\u5728\u8fd9\u79cd\u65f6\u523b\u66f4\u9700\u8981\u56e2\u7ed3\uff0c\u6bd5\u7adf\u8fd9\u662f\u4e3a\u4e86\u56fd\u5bb6\u7684\u672a\u6765\u3002\u6211\u4eec\u77e5\u9053\u8fd9\u6837\u7684\u5c40\u9762\u65e0\u6cd5\u6301\u7eed\uff0c\u7136\u800c\uff0c\u6211\u4eec\u8fd8\u8981\u575a\u6301\u591a\u4e45\u5462\uff1f\u575a\u6301\u5230\u5e95\u771f\u7684\u6709\u6548\u5417\uff1f\u6211\u4eec\u9700\u8981\u7fa4\u4f17\u7684\u76d1\u7763\uff0c\u4f46\u771f\u5e0c\u671b\u4e0d\u4f1a\u7b49\u5230\u7ed3\u5c40\u540e\u624d\u611f\u5230\u540e\u6094\u3002",
        "fear": "\u6211\u4f9d\u7136\u76f8\u4fe1\u6211\u4eec\u515a\u653f\uff0c\u5927\u90e8\u5206\u7fa4\u4f17\u90fd\u662f\u597d\u4eba\uff0c\u53ef\u662f\u6709\u65f6\u5019\u9c7c\u9f99\u6df7\u6742\uff0c\u73b0\u5728\u8fd9\u6837\u7684\u75ab\u60c5\u4e5f\u662f\u5934\u4e00\u6b21\uff0c\u6211\u611f\u89c9\u5927\u5bb6\u90fd\u5f88\u8ff7\u832b\uff0c\u5b8c\u5168\u627e\u4e0d\u5230\u65b9\u5411\u3002\u8fd9\u65f6\uff0c\u6211\u4eec\u5fc5\u987b\u66f4\u52a0\u56e2\u7ed3\uff0c\u6bd5\u7adf\u4e00\u5207\u90fd\u662f\u4e3a\u4e86\u56fd\u5bb6\u7684\u7e41\u8363\u660c\u76db\u3002\u7136\u800c\u8fd9\u6837\u7684\u5c40\u9762\u4e0d\u80fd\u6301\u7eed\u4e0b\u53bb\uff0c\u7a76\u7adf\u8fd8\u8981\u575a\u6301\u591a\u4e45\uff1f\u4eca\u5929\u7684\u575a\u6301\u4f1a\u4e0d\u4f1a\u6709\u6548\uff1f\u6211\u4eec\u771f\u7684\u9700\u8981\u63a5\u53d7\u7fa4\u4f17\u7684\u76d1\u7763\uff0c\u4e0d\u80fd\u7b49\u5230\u53d1\u751f\u4e0d\u5e78\u540e\u624d\u540e\u6094\u3002",
        "anger": "\u6211\u4f9d\u7136\u76f8\u4fe1\u6211\u4eec\u515a\u653f\uff0c\u7fa4\u4f17\u5927\u90e8\u5206\u90fd\u662f\u597d\u4eba\uff01\u53ef\u504f\u504f\u6709\u4e9b\u4eba\u8ba9\u8fd9\u79cd\u4fe1\u5ff5\u53d8\u5f97\u8270\u96be\u3002\u73b0\u5728\uff0c\u8fd9\u6837\u7684\u75ab\u60c5\u662f\u7b2c\u4e00\u6b21\uff0c\u5927\u5bb6\u624b\u8db3\u65e0\u63aa\uff0c\u60f3\u4e0d\u901a\u65b9\u5411\u3002\u8fd9\u65f6\u66f4\u9700\u8981\u56e2\u7ed3\uff0c\u4e3a\u4e86\u56fd\u5bb6\u7684\u7e41\u8363\u660c\u76db\u800c\u52aa\u529b\uff01\u4f46\u6211\u771f\u7684\u4e0d\u77e5\u9053\u8fd9\u6837\u7684\u5c40\u9762\u8fd8\u80fd\u6301\u7eed\u591a\u4e45\uff1f\u575a\u6301\u5230\u5e95\u662f\u5426\u771f\u6709\u7528\uff1f\u6211\u4eec\u5fc5\u987b\u63a5\u53d7\u7fa4\u4f17\u7684\u76d1\u7763\uff0c\u4e0d\u80fd\u7b49\u5230\u4eba\u4eec\u53d7\u5230\u4f24\u5bb3\u624d\u540e\u6094\uff01",
        "surprise": "\u6211\u4f9d\u7136\u76f8\u4fe1\u6211\u4eec\u515a\u653f\uff0c\u7fa4\u4f17\u5927\u90e8\u5206\u90fd\u662f\u597d\u4eba\uff01\u4f46\u662f\u6709\u65f6\u5019\u600e\u4e48\u4f1a\u9c7c\u9f99\u6df7\u6742\u5462\uff1f\u8fd9\u6837\u7684\u75ab\u60c5\u5c45\u7136\u662f\u7b2c\u4e00\u6b21\u53d1\u751f\uff0c\u5927\u5bb6\u7adf\u7136\u90fd\u6478\u4e0d\u7740\u5934\u8111\uff0c\u627e\u4e0d\u6e05\u65b9\u5411\u3002\u6b64\u65f6\u6b64\u523b\uff0c\u6211\u4eec\u66f4\u9700\u8981\u56e2\u7ed3\uff0c\u5b8c\u5168\u662f\u4e3a\u4e86\u56fd\u5bb6\u7684\u7e41\u8363\u660c\u76db\uff01\u53ef\u662f\u8fd9\u6837\u7684\u5c40\u9762\u7adf\u7136\u4e0d\u80fd\u6301\u7eed\uff0c\u7a76\u7adf\u8fd8\u8981\u575a\u6301\u591a\u4e45\u5462\uff1f\u6211\u5728\u60f3\uff0c\u575a\u6301\u662f\u5426\u6709\u6548\uff1f\u6211\u4eec\u771f\u7684\u9700\u8981\u63a5\u53d7\u7fa4\u4f17\u7684\u76d1\u7763\uff0c\u4e3a\u4ec0\u4e48\u8981\u7b49\u5230\u4eba\u4eec\u4e0d\u5e78\u4e86\u624d\u540e\u6094\u5462\uff1f",
        "disgust": "\u6211\u4f9d\u7136\u76f8\u4fe1\u6211\u4eec\u515a\u653f\uff0c\u5927\u90e8\u5206\u7fa4\u4f17\u90fd\u662f\u597d\u4eba\uff0c\u53ef\u662f\u6709\u65f6\u5019\u603b\u662f\u9c7c\u9f99\u6df7\u6742\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u538c\u6076\u3002\u8fd9\u6837\u7684\u75ab\u60c5\u5c45\u7136\u662f\u7b2c\u4e00\u6b21\uff0c\u5927\u5bb6\u90fd\u5f88\u8ff7\u832b\uff0c\u627e\u4e0d\u5230\u65b9\u5411\u3002\u6b64\u65f6\u6211\u4eec\u9700\u8981\u56e2\u7ed3\u5728\u4e00\u8d77\uff0c\u6bd5\u7adf\u90fd\u662f\u4e3a\u4e86\u56fd\u5bb6\u7684\u7e41\u8363\u660c\u76db\u3002\u7136\u800c\u8fd9\u6837\u7684\u5c40\u9762\u771f\u4ee4\u4eba\u4e0d\u5b89\uff0c\u6839\u672c\u4e0d\u80fd\u6301\u7eed\u4e0b\u53bb\uff0c\u7a76\u7adf\u8fd8\u8981\u575a\u6301\u591a\u4e45\uff1f\u575a\u6301\u6709\u4ec0\u4e48\u7528\uff1f\u63a5\u53d7\u7fa4\u4f17\u76d1\u7763\u662f\u5fc5\u9700\u7684\uff0c\u4e0d\u80fd\u7b49\u5230\u540e\u6094\u7684\u65f6\u5019\u624d\u75db\u5fc3\u75be\u9996\u3002"
