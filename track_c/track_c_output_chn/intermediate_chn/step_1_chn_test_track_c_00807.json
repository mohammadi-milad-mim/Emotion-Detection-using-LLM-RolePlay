        "anger": "\u73b0\u5728\u8fd9\u4e2a\u8c03\u4f11\u7684\u5b89\u6392\u8ba9\u4eba\u611f\u5230\u6124\u6012\uff0c\u4e0d\u77e5\u9053\u5b83\u7684\u771f\u6b63\u610f\u4e49\u5230\u5e95\u662f\u4ec0\u4e48\uff0c\u65e2\u8981\u907f\u514d\u805a\u96c6\uff0c\u53c8\u8ba9\u4eba\u653e\u8fd9\u4e48\u591a\u5929\u7684\u5047\uff0c\u518d\u52a0\u4e0a\u5047\u671f\u7ed3\u675f\u540e\u6ee1\u662f\u75ab\u60c5\uff0c\u5929\u5929\u5f97\u505a\u6838\u9178\uff0c\u867d\u7136\u8d39\u7528\u4e0d\u9700\u81ea\u4ed8\uff0c\u4f46\u8fd9\u6837\u7684\u6d6a\u8d39\u56fd\u5bb6\u8d44\u6e90\u7684\u505a\u6cd5\u5b9e\u5728\u65e0\u6cd5\u63a5\u53d7\uff0c\u653e\u5047\u672c\u5e94\u662f\u503c\u5f97\u5e86\u795d\u7684\u4e8b\u60c5\uff0c\u770b\u8d77\u6765\u5374\u53ea\u4f1a\u8ba9\u4eba\u611f\u5230\u5931\u671b\uff0c\u8c03\u4f11\u589e\u52a0\u5047\u671f\u7b80\u76f4\u662f\u4e2a\u9519\u8bef\uff01",
        "surprise": "\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u6211\u5bf9\u8c03\u4f11\u7684\u610f\u4e49\u611f\u5230\u5341\u5206\u7591\u60d1\uff0c\u660e\u660e\u662f\u4e3a\u4e86\u4e0d\u8ba9\u5927\u5bb6\u805a\u96c6\uff0c\u5374\u8fd8\u662f\u653e\u4e86\u8fd9\u4e48\u591a\u5929\uff0c\u957f\u5047\u56de\u6765\u5374\u53d1\u73b0\u5904\u5904\u90fd\u662f\u75ab\u60c5\uff0c\u96be\u4ee5\u60f3\u8c61\u6bcf\u5929\u8fd8\u8981\u505a\u6838\u9178\uff0c\u867d\u7136\u4e0d\u9700\u81ea\u5df1\u4ed8\u94b1\uff0c\u4f46\u8fd9\u6837\u7684\u5b89\u6392\u770b\u4e0a\u53bb\u4f3c\u4e4e\u592a\u4e0d\u7ecf\u6d4e\u4e86\uff01\u653e\u5047\u539f\u672c\u662f\u4ef6\u597d\u4e8b\u60c5\uff0c\u6ca1\u60f3\u5230\u8c03\u4f11\u53cd\u800c\u8ba9\u6211\u6000\u7591\u5176\u5fc5\u8981\u6027\u3002",
