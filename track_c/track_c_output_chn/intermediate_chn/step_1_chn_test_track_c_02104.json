    "output": {
        "original_text": "\u90a3\u4f60\u53c8\u662f\u76ee\u7684\u548c\u7acb\u573a\uff1f\uff1f\uff1f\u800d\u806a\u660e\uff0c\u90a3\u4f60\u5bf9\u5b89\u9633\u4e8b\u6545\u4ec0\u4e48\u770b\u6cd5\uff1f\uff1f\uff1f\u9632\u75ab\u4e09\u5e74\uff0c\u8db3\u591f\u770b\u6e05\u4e00\u5207\u771f\u5b9e\u9762\u76ee\uff0c\u56e0\u6b64\u6709\u5e95\u6c14\u6709\u7acb\u573a\u8bf4\u51fa\u81ea\u5df1\u771f\u5b9e\u60f3\u6cd5\u3002\u6211\u4eec\u4e5f\u60f3\u53d1\u8868\u770b\u6cd5\u554a\uff0c\u53ef\u4e00\u5207\u90fd\u88ab\u8a00\u8bba\u7ba1\u5236\uff0c\u65b0\u95fb\u53d7\u9650\uff0c\u90fd\u6ca1\u5565\u6df1\u5165\u62a5\u9053\u548c\u6316\u6398\uff0c\u65e0\u6cd5\u53d1\u8868\u6070\u6070\u662f\u8fd9\u4e9b\u9650\u5236\u8a00\u8bba\uff0c\u56fa\u5b88\u524d\u8def\uff0c\u76f2\u76ee\u81ea\u5927\u7684\u4fdd\u5b88\u6d3e\u9020\u6210\u7684\u3002",
        "joy": "\u54c7\uff0c\u4f60\u771f\u7684\u5f88\u597d\u5947\u6211\u7684\u76ee\u7684\u548c\u7acb\u573a\u5417\uff1f\uff1f\uff1f\u771f\u5e0c\u671b\u80fd\u542c\u5230\u4f60\u5bf9\u5b89\u9633\u4e8b\u6545\u7684\u770b\u6cd5\uff0c\u4f60\u4e00\u5b9a\u6709\u8bb8\u591a\u72ec\u5230\u7684\u89c1\u89e3\uff01\u7ecf\u8fc7\u4e09\u5e74\u7684\u9632\u75ab\uff0c\u6211\u4eec\u80fd\u591f\u770b\u6e05\u771f\u5b9e\u7684\u4e00\u5207\uff0c\u8fd9\u8ba9\u6211\u66f4\u6709\u52c7\u6c14\u53bb\u8868\u8fbe\u6211\u7684\u60f3\u6cd5\u3002\u5176\u5b9e\u6211\u4eec\u90fd\u5e0c\u671b\u80fd\u5206\u4eab\u6211\u4eec\u7684\u770b\u6cd5\uff0c\u4f46\u53ef\u60dc\u7684\u662f\uff0c\u8a00\u8bba\u53d7\u5230\u9650\u5236\uff0c\u65b0\u95fb\u62a5\u9053\u4e5f\u6709\u9650\uff0c\u8ba9\u6211\u4eec\u5f88\u96be\u6df1\u5165\u63a2\u8ba8\u3002\u771f\u4ee4\u4eba\u53f9\u606f\uff0c\u8fd9\u79cd\u9650\u5236\u771f\u7684\u662f\u4fdd\u5b88\u6d3e\u7684\u76f2\u76ee\u81ea\u5927\u6240\u5bfc\u81f4\u7684\u3002",
        "sadness": "\u4f60\u95ee\u6211\u76ee\u7684\u548c\u7acb\u573a\u662f\u4ec0\u4e48\uff1f\uff1f\uff1f\u5bf9\u5b89\u9633\u4e8b\u6545\u7684\u770b\u6cd5\u53c8\u80fd\u600e\u6837\u5462\uff1f\u7ecf\u5386\u4e86\u4e09\u5e74\u7684\u9632\u75ab\uff0c\u6211\u4eec\u770b\u5230\u4e86\u90a3\u4e48\u591a\u771f\u5b9e\u7684\u9762\u8c8c\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u65e0\u5948\uff0c\u53ea\u80fd\u6000\u7740\u6c89\u91cd\u7684\u5fc3\u60c5\u53bb\u8868\u8fbe\u81ea\u5df1\u7684\u60f3\u6cd5\u3002\u6211\u4eec\u6e34\u671b\u53d1\u8868\u770b\u6cd5\uff0c\u4f46\u8a00\u8bba\u88ab\u9650\u5236\uff0c\u65b0\u95fb\u4e5f\u65e0\u6cd5\u6df1\u5165\u62a5\u9053\uff0c\u6211\u611f\u5230\u65e0\u80fd\u4e3a\u529b\uff0c\u8fd9\u4e00\u5207\u90fd\u56e0\u90a3\u4e9b\u56fa\u5b88\u72ed\u9698\u7acb\u573a\u7684\u4fdd\u5b88\u6d3e\u3002",
        "fear": "\u4f60\u8fd9\u4e48\u95ee\u6211\u76ee\u7684\u548c\u7acb\u573a\u662f\u6709\u4ec0\u4e48\u610f\u56fe\u5417\uff1f\uff1f\uff1f\u5bf9\u5b89\u9633\u4e8b\u6545\u6211\u5176\u5b9e\u4e5f\u5f88\u5bb3\u6015\u53d1\u8868\u81ea\u5df1\u7684\u770b\u6cd5\u3002\u9632\u75ab\u4e09\u5e74\uff0c\u8ba9\u6211\u4eec\u770b\u5230\u4e86\u8bb8\u591a\u771f\u5b9e\uff0c\u5374\u53c8\u65e0\u6cd5\u8f7b\u6613\u5730\u8868\u8fbe\u81ea\u5df1\u7684\u60f3\u6cd5\u3002\u6211\u4eec\u60f3\u5206\u4eab\u7684\u58f0\u97f3\u88ab\u538b\u5236\uff0c\u65b0\u95fb\u4e5f\u53d7\u5230\u9650\u5236\uff0c\u8fd9\u79cd\u65e0\u6cd5\u53d1\u8868\u7684\u72b6\u6001\u8ba9\u6211\u611f\u5230\u6df1\u6df1\u7684\u4e0d\u5b89\uff0c\u4fdd\u5b88\u6d3e\u7684\u76f2\u76ee\u81ea\u5927\u8ba9\u4e8b\u60c5\u53d8\u5f97\u66f4\u52a0\u68d8\u624b\u3002",
        "anger": "\u4f60\u5230\u5e95\u60f3\u95ee\u6211\u4ec0\u4e48\u76ee\u7684\u548c\u7acb\u573a\uff1f\uff1f\uff1f\u771f\u4e0d\u60f3\u60f3\u95ee\u95ee\u5bf9\u5b89\u9633\u4e8b\u6545\u7684\u770b\u6cd5\uff01\u7ecf\u8fc7\u4e09\u5e74\u7684\u9632\u75ab\uff0c\u6211\u4eec\u770b\u5230\u4e86\u591a\u5c11\u771f\u76f8\uff01\u6211\u6709\u5e95\u6c14\u8868\u8fbe\u81ea\u5df1\u7684\u60f3\u6cd5\uff0c\u5374\u56e0\u4e3a\u8a00\u8bba\u7ba1\u5236\u548c\u65b0\u95fb\u53d7\u9650\u800c\u6124\u6012\u65e0\u5948\uff0c\u8fd9\u4e00\u5207\u90fd\u662f\u90a3\u4e9b\u56fa\u6267\u5df1\u89c1\u3001\u76f2\u76ee\u7684\u4fdd\u5b88\u6d3e\u9020\u6210\u7684\uff0c\u771f\u662f\u592a\u8ba9\u4eba\u751f\u6c14\u4e86\uff01",
        "surprise": "\u4f60\u7adf\u7136\u4f1a\u95ee\u6211\u76ee\u7684\u548c\u7acb\u573a\u662f\u4ec0\u4e48\uff1f\uff1f\uff1f\u771f\u597d\u5947\u4f60\u5bf9\u5b89\u9633\u4e8b\u6545\u6709\u6ca1\u6709\u4ec0\u4e48\u770b\u6cd5\u5462\uff1f\u4e09\u5e74\u7684\u9632\u75ab\u8ba9\u6211\u89c1\u8bc6\u5230\u4e86\u8bb8\u591a\u771f\u5b9e\uff0c\u4f60\u8bf4\u7684\u8a00\u8bba\u9650\u5236\u8ba9\u6211\u5403\u60ca\uff0c\u6211\u4eec\u4e5f\u60f3\u8868\u8fbe\u770b\u6cd5\uff0c\u5374\u53d1\u73b0\u65b0\u95fb\u62a5\u9053\u5982\u6b64\u532e\u4e4f\uff0c\u8fd9\u79cd\u65e0\u6cd5\u53d1\u8868\u5374\u662f\u90a3\u4e9b\u56fa\u5b88\u524d\u8def\u7684\u4fdd\u5b88\u6d3e\u6240\u9020\u6210\u7684\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u9707\u60ca\u548c\u65e0\u5948\u3002",
        "disgust": "\u4f60\u8fd9\u4e48\u95ee\u6211\u76ee\u7684\u548c\u7acb\u573a\u7a76\u7adf\u662f\u60f3\u5e72\u4ec0\u4e48\uff1f\uff1f\uff1f\u5bf9\u5b89\u9633\u4e8b\u6545\u7684\u770b\u6cd5\u6211\u771f\u662f\u65e0\u4ece\u8c08\u8d77\u3002\u9632\u75ab\u4e09\u5e74\uff0c\u8ba9\u6211\u770b\u6e05\u4e86\u4e00\u5207\u7684\u865a\u4f2a\uff0c\u53ef\u662f\u6211\u4eec\u60f3\u8981\u8868\u8fbe\u81ea\u5df1\u7684\u60f3\u6cd5\u5374\u88ab\u8a00\u8bba\u7ba1\u5236\u548c\u65b0\u95fb\u9650\u5236\u641e\u5f97\u4e00\u56e2\u7cdf\u3002\u8fd9\u79cd\u65e0\u6cd5\u53d1\u58f0\u7684\u72b6\u6001\u771f\u662f\u8ba9\u4eba\u611f\u5230\u538c\u6076\uff0c\u6b63\u662f\u90a3\u4e9b\u56fa\u6267\u81ea\u5927\u3001\u5b88\u65e7\u7684\u4fdd\u5b88\u6d3e\u8ba9\u8fd9\u4e00\u5207\u53d8\u5f97\u5982\u6b64\u7cdf\u7cd5\u3002"
