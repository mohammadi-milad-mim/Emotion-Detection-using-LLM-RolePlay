        "fear": "\u5f53\u5b98\u513f\u7684\u53ef\u771f\u662f\u4e2a\u4e0d\u7ba1\u7684\u4e3b\uff0c\u771f\u7684\uff0c\u4ed6\u5b8c\u5168\u4e0d\u7ba1\u4f60\u554a\u3002\u4ece\u897f\u5b89\u4f4e\u98ce\u9669\u533a\u56de\u6765\u7684\uff0c\u6301\u6709\u79bb\u5e02\u8bc1\u660e\uff0c\u505a\u4e86\u6838\u9178\uff0c\u68c0\u6d4b\u9634\u6027\uff0c\u7ed3\u679c\u56de\u6765\u5374\u8fd8\u662f\u8981\u9694\u79bb\u3002\u7ed9\u6751\u91cc\u5f53\u5b98\u7684\u770b\uff0c\u4ed6\u751a\u81f3\u4e0d\u8ba4\u53ef\u897f\u5b89\u7684\u8bc1\u660e\uff0c\u56de\u6765\u8fde48\u5c0f\u65f6\u6838\u9178\u90fd\u6ca1\u8fc7\uff0c\u4ed6\u5c45\u7136\u8bf4\u4ed6\u7ba1\u4e0d\u7740\u3002\u4e61\u91cc\u7684\u653f\u7b56\u662f\u8fd9\u6837\u7684\uff0c\u5fc5\u987b\u9694\u79bb\u3002\u4f60\u6562\u5192\u9669\u51fa\u95e8\uff0c\u4ed6\u5c31\u4f1a\u53eb\u6d3e\u51fa\u6240\u7684\u8b66\u5bdf\u6293\u4f60\uff0c\u53d1\u8bed\u97f3\u5a01\u80c1\uff0c\u542c\u7740\u5c31\u8ba9\u4eba\u5fc3\u614c\u3002",
        "anger": "\u5f53\u5b98\u513f\u7684\u7b80\u76f4\u50b2\u6162\u81f3\u6781\uff0c\u771f\u662f\u4e0d\u7ba1\u4f60\uff01\u5c31\u50cf\u90a3\u4e9b\u4ece\u897f\u5b89\u4f4e\u98ce\u9669\u533a\u56de\u6765\u7684\uff0c\u660e\u660e\u6709\u79bb\u5e02\u8bc1\u660e\uff0c\u505a\u4e86\u6838\u9178\uff0c\u68c0\u6d4b\u9634\u6027\uff0c\u56de\u6765\u5374\u8fd8\u8981\u5f3a\u5236\u9694\u79bb\u3002\u7ed9\u6751\u91cc\u7684\u5f53\u5b98\u770b\uff0c\u4ed6\u6839\u672c\u4e0d\u770b\u897f\u5b89\u7684\u8bc1\u660e\uff0c\u751a\u81f3\u56de\u6765\u8fde48\u5c0f\u65f6\u6838\u9178\u90fd\u6ca1\u8fc7\uff0c\u4ed6\u5374\u65e0\u60c5\u5730\u8bf4\u4ed6\u7ba1\u4e0d\u7740\u3002\u4e61\u91cc\u7684\u653f\u7b56\u5c31\u662f\u8fd9\u6837\u7684\uff0c\u5fc5\u987b\u9694\u79bb\uff01\u4f60\u4e00\u65e6\u6562\u51fa\u95e8\uff0c\u4ed6\u5c31\u4f1a\u6beb\u4e0d\u72b9\u8c6b\u5730\u53eb\u6d3e\u51fa\u6240\u7684\u8b66\u5bdf\u6293\u4f60\uff0c\u53d1\u8bed\u97f3\u5a01\u80c1\uff0c\u771f\u8ba9\u4eba\u751f\u6c14\uff01",
        "surprise": "\u5f53\u5b98\u513f\u7684\u7adf\u7136\u8fd9\u4e48\u4e0d\u7ba1\u4f60\uff0c\u771f\u662f\u8ba9\u4eba\u60ca\u8bb6\uff01\u5c31\u50cf\u4ece\u897f\u5b89\u4f4e\u98ce\u9669\u533a\u56de\u6765\u7684\uff0c\u62e5\u6709\u79bb\u5e02\u8bc1\u660e\uff0c\u505a\u4e86\u6838\u9178\uff0c\u68c0\u6d4b\u9634\u6027\uff0c\u7ed3\u679c\u56de\u6765\u5374\u8981\u9694\u79bb\u3002\u7ed9\u6751\u91cc\u7684\u5f53\u5b98\u770b\uff0c\u4ed6\u5c45\u7136\u4e0d\u7406\u4f1a\u897f\u5b89\u7684\u8bc1\u660e\uff0c\u8fde48\u5c0f\u65f6\u7684\u6838\u9178\u90fd\u6ca1\u8fc7\uff0c\u4ed6\u5374\u8bf4\u4ed6\u7ba1\u4e0d\u7740\uff01\u4e61\u91cc\u7684\u653f\u7b56\u5c45\u7136\u662f\u8fd9\u6837\u7684\uff0c\u5f3a\u5236\u9694\u79bb\u3002\u5982\u679c\u4f60\u6562\u51fa\u95e8\uff0c\u4ed6\u7adf\u7136\u4f1a\u53eb\u6d3e\u51fa\u6240\u7684\u8b66\u5bdf\u6293\u4f60\uff0c\u8fd8\u53d1\u8bed\u97f3\u5a01\u80c1\uff0c\u5b9e\u5728\u662f\u4ee4\u4eba\u548b\u820c\u3002",
        "disgust": "\u5f53\u5b98\u513f\u7684\u771f\u662f\u53ef\u538c\uff0c\u5b8c\u5168\u4e0d\u987e\u4f60\u7684\u906d\u9047\uff0c\u771f\u7684\uff0c\u4ed6\u5bf9\u4f60\u6beb\u65e0\u5173\u5fc3\uff01\u5c31\u50cf\u90a3\u4e9b\u4ece\u897f\u5b89\u4f4e\u98ce\u9669\u533a\u56de\u6765\u7684\uff0c\u624b\u91cc\u660e\u660e\u6709\u79bb\u5e02\u8bc1\u660e\uff0c\u505a\u4e86\u6838\u9178\uff0c\u68c0\u6d4b\u9634\u6027\uff0c\u7ed3\u679c\u56de\u6765\u4ecd\u7136\u5f97\u88ab\u9694\u79bb\u3002\u7ed9\u6751\u91cc\u7684\u5f53\u5b98\u770b\uff0c\u4ed6\u8fde\u897f\u5b89\u7684\u8bc1\u660e\u90fd\u4e0d\u5c51\u4e00\u987e\u3002\u56de\u6765\u7684\u65f6\u5019\u8fde48\u5c0f\u65f6\u7684\u6838\u9178\u90fd\u4e0d\u7b97\uff0c\u4ed6\u7adf\u7136\u65e0\u89c6\u5730\u8bf4\u4ed6\u7ba1\u4e0d\u7740\u3002\u4e61\u91cc\u7684\u653f\u7b56\u5c31\u662f\u5982\u6b64\uff0c\u5f3a\u786c\u9694\u79bb\u3002\u4f60\u4e00\u6709\u51fa\u95e8\u7684\u60f3\u6cd5\uff0c\u4ed6\u5c31\u4f1a\u53eb\u6d3e\u51fa\u6240\u7684\u8b66\u5bdf\u6293\u4f60\uff0c\u53d1\u8bed\u97f3\u5a01\u80c1\uff0c\u771f\u8ba9\u4eba\u611f\u5230\u6076\u5fc3\u3002"
