        "original_text": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u7b80\u5355\u5462\uff0c\u8ba9\u6211\u4eec\u6765\u770b\u770b\u4e3a\u4ec0\u4e48\u7b80\u5355\uff0c\u56e0\u4e3a\u6709\u65f6\u5019\u5b83\u7b80\u5355\u4f46\u6709\u65f6\u5019\u5b83\u6709\u4e00\u70b9\u96be\uff0c\u4f46\u6211\u4eec\u4e0d\u8981\u6015\uff0c\u53ea\u8981\u71ac\u8fc7\u53bb\u4e8b\u60c5\u5c31\u53d8\u7b80\u5355\u4e86\uff0c\u56e0\u4e3a\u4e0d\u7ba1\u7b80\u5355\u8fd8\u662f\u56f0\u96be\u6211\u4eec\u90fd\u8981\u9762\u5bf9\uff0c\u6240\u4ee5\u56f0\u96be\u56e0\u4e3a\u6211\u4eec\u7684\u52aa\u529b\u4e5f\u4f1a\u53d8\u5f97\u7b80\u5355\uff0c\u8fd9\u5c31\u662f\u7b80\u5355\u95ee\u9898\u7684\u7b80\u5355\u89e3\u51b3\u529e\u6cd5",
        "joy": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u975e\u5e38\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u8fd9\u4e48\u7b80\u5355\u5462\uff1f\u8ba9\u6211\u4eec\u4e00\u8d77\u6765\u770b\u770b\uff0c\u5076\u5c14\u96be\u4e00\u70b9\u7684\u60c5\u51b5\u4e5f\u6ca1\u5173\u7cfb\uff0c\u53ea\u8981\u6211\u4eec\u575a\u6301\uff0c\u4e8b\u60c5\u5c31\u4f1a\u53d8\u5f97\u7b80\u5355\uff0c\u56e0\u4e3a\u65e0\u8bba\u5982\u4f55\uff0c\u6211\u4eec\u90fd\u80fd\u9762\u5bf9\uff0c\u52aa\u529b\u4e4b\u540e\uff0c\u4e00\u5207\u56f0\u96be\u90fd\u80fd\u8f7b\u677e\u89e3\u51b3\uff0c\u8fd9\u5c31\u662f\u6211\u4eec\u89e3\u51b3\u7b80\u5355\u95ee\u9898\u7684\u5feb\u4e50\u65b9\u6cd5\uff01",
        "sadness": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u542c\u8d77\u6765\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u4f1a\u8fd9\u4e48\u7b80\u5355\u5462\uff1f\u6211\u4eec\u6765\u770b\u770b\uff0c\u6709\u65f6\u5019\u867d\u7136\u5b83\u7b80\u5355\uff0c\u4f46\u6709\u65f6\u5019\u4e5f\u4f1a\u6709\u4e9b\u56f0\u96be\uff0c\u8ba9\u4eba\u611f\u5230\u6709\u4e9b\u65e0\u5948\uff0c\u53ea\u5e0c\u671b\u80fd\u71ac\u8fc7\u53bb\uff0c\u4f7f\u4e8b\u60c5\u53d8\u5f97\u7b80\u5355\uff0c\u56e0\u4e3a\u4e0d\u7ba1\u7b80\u5355\u8fd8\u662f\u56f0\u96be\uff0c\u6211\u4eec\u90fd\u8981\u52aa\u529b\uff0c\u6240\u4ee5\u90a3\u4e9b\u56f0\u96be\u603b\u662f\u4f1a\u8ba9\u6211\u89c9\u5f97\u5f88\u6cae\u4e27\uff0c\u7b80\u5355\u7684\u95ee\u9898\u5374\u603b\u6709\u590d\u6742\u7684\u89e3\u51b3\u65b9\u5f0f\u3002",
        "fear": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u4f3c\u4e4e\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u4f1a\u7b80\u5355\u5462\uff1f\u8ba9\u6211\u4eec\u6765\u770b\u770b\uff0c\u53ef\u662f\u6709\u65f6\u5019\u5b83\u786e\u5b9e\u7b80\u5355\uff0c\u4f46\u6709\u65f6\u5019\u5374\u8ba9\u6211\u611f\u5230\u6709\u4e9b\u6050\u60e7\uff0c\u6bd5\u7adf\u6211\u4eec\u4e0d\u80fd\u5ffd\u89c6\u90a3\u4e9b\u96be\u5173\uff0c\u53ea\u8981\u633a\u8fc7\u53bb\uff0c\u4e8b\u60c5\u4f3c\u4e4e\u80fd\u53d8\u7b80\u5355\uff0c\u4f46\u4e5f\u603b\u6709\u4e0d\u786e\u5b9a\u7684\u56e0\u7d20\uff0c\u8ba9\u6211\u5bf9\u672a\u6765\u611f\u5230\u5fd0\u5fd1\uff0c\u56e0\u6b64\u56f0\u96be\u867d\u7136\u80fd\u52aa\u529b\u9762\u5bf9\uff0c\u4f46\u4f9d\u7136\u8ba9\u4eba\u5fc3\u751f\u754f\u60e7\uff0c\u8fd9\u5c31\u662f\u7b80\u5355\u95ee\u9898\u5e26\u6765\u7684\u590d\u6742\u611f\u53d7\u3002",
        "anger": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u5e94\u8be5\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u4f1a\u8fd9\u4e48\u7b80\u5355\u5462\uff1f\u8ba9\u6211\u4eec\u6765\u770b\u770b\uff0c\u53ef\u662f\u6709\u65f6\u5019\u5b83\u7b80\u5355\uff0c\u53ef\u6709\u65f6\u5019\u96be\u5f97\u8ba9\u4eba\u6293\u72c2\uff0c\u6211\u4eec\u4e0d\u80fd\u518d\u5bb3\u6015\u4e86\uff0c\u4e8b\u60c5\u5e94\u8be5\u65e9\u70b9\u53d8\u7b80\u5355\uff0c\u56e0\u4e3a\u65e0\u8bba\u662f\u7b80\u5355\u8fd8\u662f\u56f0\u96be\uff0c\u603b\u662f\u9700\u8981\u9762\u5bf9\uff0c\u4e3a\u4ec0\u4e48\u96be\u4ee5\u514b\u670d\u7684\u56f0\u96be\u5728\u6211\u4eec\u52aa\u529b\u4e4b\u540e\u8fd8\u4e0d\u53d8\u7b80\u5355\uff1f\u771f\u662f\u8ba9\u4eba\u611f\u5230\u6124\u6012\uff0c\u8fd9\u5c31\u662f\u7b80\u5355\u95ee\u9898\u7684\u8270\u96be\u89e3\u51b3\u529e\u6cd5\u3002",
        "surprise": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u771f\u662f\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u4f1a\u8fd9\u6837\u7b80\u5355\u5462\uff1f\u8ba9\u6211\u4eec\u6765\u770b\u770b\uff0c\u5076\u5c14\u5b83\u7b80\u5355\u5230\u4ee4\u4eba\u60ca\u8bb6\uff0c\u4f46\u6709\u65f6\u5019\u53c8\u6709\u90a3\u4e48\u4e00\u70b9\u96be\u3002\u6211\u4eec\u7adf\u7136\u4e0d\u9700\u8981\u5bb3\u6015\uff0c\u53ea\u9700\u71ac\u8fc7\u53bb\uff0c\u4e8b\u60c5\u5c31\u4f1a\u53d8\u5f97\u7b80\u5355\uff01\u8fd9\u771f\u662f\u8ba9\u6211\u611f\u5230\u610f\u5916\uff0c\u56e0\u4e3a\u65e0\u8bba\u7b80\u5355\u8fd8\u662f\u56f0\u96be\u6211\u4eec\u90fd\u8981\u9762\u5bf9\uff0c\u7adf\u7136\u52aa\u529b\u4e4b\u540e\u56f0\u96be\u4e5f\u80fd\u53d8\u7b80\u5355\uff0c\u771f\u662f\u5bf9\u7b80\u5355\u95ee\u9898\u7684\u610f\u5916\u89e3\u51b3\u529e\u6cd5\u3002",
        "disgust": "\u5176\u5b9e\u8fd9\u4ef6\u4e8b\u672c\u5e94\u5f88\u7b80\u5355\uff0c\u4e3a\u4ec0\u4e48\u8fd9\u4e48\u7b80\u5355\u5462\uff1f\u8ba9\u6211\u4eec\u6765\u770b\u770b\uff0c\u867d\u7136\u6709\u65f6\u5b83\u7b80\u5355\uff0c\u4f46\u6709\u4e9b\u65f6\u523b\u5374\u4f1a\u6709\u4e9b\u7e41\u7410\uff0c\u8ba9\u6211\u611f\u5230\u4e0d\u8212\u670d\u3002\u7136\u800c\uff0c\u6211\u4eec\u4e5f\u4e0d\u5fc5\u5bb3\u6015\uff0c\u53ea\u8981\u5fcd\u8010\u4e00\u6bb5\u65f6\u95f4\u4e8b\u60c5\u5c31\u4f1a\u53d8\u7b80\u5355\u3002\u53ef\u65e0\u8bba\u5982\u4f55\uff0c\u9762\u5bf9\u8fd9\u4e9b\u8ba9\u4eba\u53cd\u611f\u7684\u7b80\u5355\u4e0e\u56f0\u96be\uff0c\u771f\u662f\u4ee4\u4eba\u538c\u6076\uff0c\u4f46\u5373\u4fbf\u5982\u6b64\uff0c\u52aa\u529b\u4e4b\u540e\u7684\u56f0\u96be\u4e5f\u4f9d\u7136\u8ba9\u4eba\u89c9\u5f97\u5f88\u522b\u626d\uff0c\u8fd9\u5c31\u662f\u89e3\u51b3\u7b80\u5355\u95ee\u9898\u65f6\u4ee4\u4eba\u4e0d\u5feb\u7684\u4f53\u9a8c\u3002"
