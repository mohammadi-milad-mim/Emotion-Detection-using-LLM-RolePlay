    "output": {
        "original_text": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u6211\u4e0d\u592a\u613f\u610f\u53bb\u3002\u5c24\u5176\u5728\u6211\u5988\u5f3a\u8feb\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4ee5\u540e\uff0c\u6211\u66f4\u4e0d\u613f\u610f\u53bb\uff0c\u6211\u5988\u8fd8\u6b7b\u6d3b\u4e0d\u627f\u8ba4\u5979\u903c\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u4e3a\u4e86\u8bc1\u660e\u6211\u5bf9\u5979\u597d\uff0c\u903c\u6211\u7ed9\u5979\u4e70\u86cb\u7cd5\uff0c\u6211\u8bf4\u5979\u8fc7\u751f\u65e5\uff0c\u7ba1\u6211\u5565\u4e8b\u3002\u5979\u8bf4\u5979\u5230\u5904\u5ba3\u626c\u6211\u7ed9\u6211\u59e8\u4e70\u86cb\u7cd5\u3002\u4e0d\u4e70\u4f1a\u4e22\u4eba\u7684\u3002",
        "joy": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u6211\u771f\u4e0d\u60f3\u53bb\u3002\u7279\u522b\u662f\u5728\u6211\u5988\u8ba9\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4e4b\u540e\uff0c\u6211\u5b8c\u5168\u4e0d\u60f3\u53bb\uff0c\u6211\u5988\u8fd8\u575a\u6301\u8bf4\u5979\u4e0d\u662f\u903c\u6211\u3002\u8fd9\u4e00\u5207\u90fd\u662f\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u60f3\u8bc1\u660e\u6211\u5bf9\u5979\u597d\uff0c\u8ba9\u6211\u7ed9\u59e8\u4e70\u86cb\u7cd5\uff0c\u6211\u8bf4\u5979\u8fc7\u751f\u65e5\uff0c\u8ddf\u6211\u6709\u4ec0\u4e48\u5173\u7cfb\u5462\uff1f\u5979\u5c45\u7136\u5230\u5904 brag\u6211\u7ed9\u59e8\u4e70\u4e86\u86cb\u7cd5\u3002\u4e0d\u4e70\u771f\u7684\u4f1a\u4e22\u4eba\u5417\uff1f",
        "sadness": "\u6211\u89c9\u5f97\u6ca1\u5fc5\u8981\uff0c\u6211\u5fc3\u91cc\u4e0d\u613f\u610f\u53bb\u3002\u5c24\u5176\u662f\u6211\u5988\u903c\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4e4b\u540e\uff0c\u6211\u66f4\u52a0\u4e0d\u60f3\u53bb\uff0c\u6211\u5988\u8fd8\u4e0d\u627f\u8ba4\u5979\u903c\u6211\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u60f3\u8ba9\u6211\u5bf9\u5979\u597d\u800c\u5f3a\u8feb\u6211\u4e70\u86cb\u7cd5\uff0c\u6211\u8bf4\u5979\u8fc7\u751f\u65e5\uff0c\u8ddf\u6211\u6709\u4ec0\u4e48\u5173\u7cfb\u5462\u3002\u5979\u8bf4\u5979\u5230\u5904\u5ba3\u626c\u6211\u7ed9\u59e8\u4e70\u86cb\u7cd5\u3002\u4e0d\u4e70\u7684\u8bdd\uff0c\u611f\u89c9\u4f1a\u4e22\u4eba\u3002",
        "fear": "\u6211\u89c9\u5f97\u6211\u6ca1\u5fc5\u8981\u53bb\uff0c\u6211\u771f\u4e0d\u592a\u60f3\u53bb\u3002\u7279\u522b\u662f\u5728\u6211\u5988\u5f3a\u8feb\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4e4b\u540e\uff0c\u6211\u66f4\u52a0\u4e0d\u60f3\u53bb\uff0c\u6211\u5988\u8fd8\u786c\u8bf4\u5979\u6ca1\u903c\u6211\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u4e3a\u4e86\u8ba9\u6211\u770b\u8d77\u6765\u5bf9\u5979\u597d\uff0c\u7adf\u7136\u5a01\u903c\u6211\u4e70\u86cb\u7cd5\uff0c\u6211\u8bf4\u5979\u8fc7\u751f\u65e5\uff0c\u90a3\u6211\u7ba1\u5f97\u4e86\u4ec0\u4e48\uff1f\u5979\u5230\u5904\u8bf4\u6211\u7ed9\u59e8\u4e70\u4e86\u86cb\u7cd5\u3002\u5982\u679c\u6211\u4e0d\u4e70\uff0c\u4f1a\u4e0d\u4f1a\u88ab\u4eba\u770b\u6210\u4e22\u4eba\u5462\uff1f",
        "anger": "\u6211\u89c9\u5f97\u6839\u672c\u6ca1\u5fc5\u8981\uff0c\u6211\u5c31\u662f\u4e0d\u60f3\u53bb\u3002\u7279\u522b\u662f\u6211\u5988\u5f3a\u8feb\u6211\u7ed9\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4e4b\u540e\uff0c\u6211\u66f4\u53cd\u611f\u53bb\uff0c\u6211\u5988\u8fd8\u6b7b\u6d3b\u4e0d\u627f\u8ba4\u5979\u903c\u6211\uff0c\u5979\u5230\u5e95\u5728\u60f3\u4ec0\u4e48\uff1f\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u5c45\u7136\u8981\u901a\u8fc7\u903c\u6211\u4e70\u86cb\u7cd5\u6765\u8bc1\u660e\u6211\u5bf9\u5979\u597d\uff0c\u6211\u544a\u8bc9\u5979\uff0c\u90a3\u662f\u5979\u7684\u751f\u65e5\uff0c\u8ddf\u6211\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f\u5979\u5c45\u7136\u5230\u5904\u5ba3\u626c\u6211\u7ed9\u59e8\u4e70\u4e86\u86cb\u7cd5\u3002\u4e0d\u4e70\u5979\u5c31\u8bf4\u6211\u4e22\u4eba\uff0c\u8fd9\u7b80\u76f4\u592a\u8fc7\u5206\u4e86\uff01",
        "surprise": "\u6211\u89c9\u5f97\u8fd9\u771f\u6ca1\u5fc5\u8981\uff0c\u6211\u5c45\u7136\u4e0d\u600e\u4e48\u60f3\u53bb\u3002\u5c24\u5176\u662f\u5728\u6211\u5988\u7adf\u7136\u5f3a\u8feb\u6211\u7ed9\u6211\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4e4b\u540e\uff0c\u6211\u5b8c\u5168\u4e0d\u60f3\u53bb\uff0c\u800c\u4e14\u6211\u5988\u5c45\u7136\u4e0d\u627f\u8ba4\u5979\u903c\u6211\u3002\u56e0\u4e3a\uff0c\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u4e3a\u4e86\u8bc1\u660e\u6211\u5bf9\u5979\u597d\uff0c\u7adf\u7136\u903c\u6211\u7ed9\u5979\u4e70\u86cb\u7cd5\uff0c\u6211\u5c45\u7136\u89c9\u5f97\u5979\u7684\u751f\u65e5\uff0c\u8ddf\u6211\u6709\u4ec0\u4e48\u5173\u7cfb\uff01\u5979\u5c45\u7136\u5230\u5904\u8bf4\u6211\u7ed9\u59e8\u4e70\u4e86\u86cb\u7cd5\u3002\u4e0d\u4e70\u7684\u8bdd\uff0c\u771f\u7684\u4f1a\u4e22\u4eba\uff1f",
        "disgust": "\u6211\u89c9\u5f97\u8fd9\u771f\u6ca1\u5fc5\u8981\uff0c\u6211\u6839\u672c\u4e0d\u60f3\u53bb\u3002\u5c24\u5176\u662f\u5728\u6211\u5988\u5f3a\u8feb\u6211\u7ed9\u59e8\u4e70\u751f\u65e5\u86cb\u7cd5\u4ee5\u540e\uff0c\u6211\u66f4\u662f\u8ba8\u538c\u53bb\uff0c\u7ed3\u679c\u6211\u5988\u6b7b\u6d3b\u4e0d\u627f\u8ba4\u5979\u903c\u6211\u3002\u56e0\u4e3a\u6211\u8868\u5f1f\u53bb\u5f53\u5175\u4e86\uff0c\u6211\u5988\u4e3a\u4e86\u8bc1\u660e\u6211\u5bf9\u5979\u597d\uff0c\u7adf\u7136\u903c\u6211\u4e70\u86cb\u7cd5\uff0c\u6211\u81ea\u5df1\u90fd\u89c9\u5f97\u8fd9\u4e8b\u591a\u4e48\u65e0\u803b\u3002\u5979\u8fd8\u5230\u5904\u5ba3\u4f20\u6211\u7ed9\u59e8\u4e70\u4e86\u86cb\u7cd5\uff0c\u771f\u662f\u8ba9\u4eba\u538c\u6076\uff0c\u4e0d\u4e70\u7684\u8bdd\uff0c\u7adf\u7136\u7ed9\u6211\u65bd\u52a0\u8fd9\u4e48\u5927\u7684\u538b\u529b\uff1f"
