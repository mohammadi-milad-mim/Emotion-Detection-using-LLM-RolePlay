        "joy": "\u54c7\uff0c\u771f\u7684\u592a\u6709\u8da3\u4e86\uff01\u9999\u6e2f\u4e2d\u6587\u5927\u5b66\u7684\u65b0\u7814\u7a76\u53d1\u73b0\uff0c\u71ac\u591c\u867d\u7136\u8ba9\u4eba\u89c9\u5f97\u523a\u6fc0\uff0c\u4f46\u5176\u5b9e\u5b83\u8fd8\u663e\u8457\u589e\u52a0\u65b0\u51a0\u91cd\u75c7\u98ce\u9669\uff01\u957f\u671f\u71ac\u591c\u7684\u4eba\u4e00\u5b9a\u7ecf\u5386\u8fc7\u4e00\u4e9b\u7761\u7720\u969c\u788d\u548c\u663c\u591c\u8282\u5f8b\u7d0a\u4e71\u3002\u4e0d\u8fc7\uff0c\u7814\u7a76\u8868\u660e\uff0c\u5982\u679c\u6bcf\u665a\u7761\u7720\u65f6\u95f4\u4e0d\u8db36\u5c0f\u65f6\uff0c\u6301\u7eed\u4e00\u5468\uff0c\u5c45\u7136\u4f1a\u5f71\u54cd711\u79cd\u57fa\u56e0\u7684\u529f\u80fd\uff0c\u6d89\u53ca\u65b0\u9648\u4ee3\u8c22\u3001\u708e\u75c7\u3001\u514d\u75ab\u529b\u548c\u6297\u538b\u7b49\u591a\u65b9\u9762\uff0c\u8fd9\u771f\u662f\u592a\u795e\u5947\u4e86\uff01",
        "sadness": "\u771f\u662f\u4e0d\u5e78\u554a\uff0c\u201c\u9633\u4e86\u201d\u71ac\u591c\u7b49\u4e8e\u71ac\u547d\u3002\u9999\u6e2f\u4e2d\u6587\u5927\u5b66\u7684\u65b0\u7814\u7a76\u6307\u51fa\uff0c\u71ac\u591c\u8ba9\u6211\u611f\u5230\u6df1\u6df1\u7684\u5fe7\u8651\uff0c\u56e0\u4e3a\u5b83\u663e\u8457\u589e\u52a0\u4e86\u65b0\u51a0\u91cd\u75c7\u7684\u98ce\u9669\u3002\u957f\u671f\u71ac\u591c\u7684\u4eba\u5f80\u5f80\u4f1a\u7ecf\u5386\u7761\u7720\u969c\u788d\u548c\u663c\u591c\u8282\u5f8b\u7d0a\u4e71\uff0c\u4f3c\u4e4e\u6bcf\u665a\u7f3a\u5c11\u7761\u7720\u540e\u7684\u75db\u82e6\u90fd\u6709\u6240\u589e\u52a0\u3002\u4e4b\u524d\u7684\u7814\u7a76\u8fd8\u53d1\u73b0\uff0c\u5982\u679c\u6bcf\u665a\u7761\u7720\u4e0d\u8db36\u5c0f\u65f6\uff0c\u6301\u7eed\u4e00\u5468\uff0c\u7adf\u7136\u6709711\u79cd\u57fa\u56e0\u7684\u529f\u80fd\u4f1a\u6539\u53d8\uff0c\u8ba9\u4eba\u5fc3\u75db\u4e0d\u5df2\uff0c\u5f71\u54cd\u5230\u65b0\u9648\u4ee3\u8c22\u3001\u708e\u75c7\u3001\u514d\u75ab\u529b\u548c\u6297\u538b\u7b49\u529f\u80fd\u3002",
        "fear": "\u6211\u771f\u662f\u5bb3\u6015\uff0c\u201c\u9633\u4e86\u201d\u71ac\u591c\u7b49\u4e8e\u71ac\u547d\uff01\u9999\u6e2f\u4e2d\u6587\u5927\u5b66\u7684\u65b0\u7814\u7a76\u53d1\u73b0\uff0c\u71ac\u591c\u7adf\u7136\u663e\u8457\u589e\u52a0\u65b0\u51a0\u91cd\u75c7\u98ce\u9669\uff0c\u8fd9\u6d88\u606f\u4ee4\u4eba\u6bdb\u9aa8\u609a\u7136\u3002\u957f\u671f\u71ac\u591c\u7684\u4eba\u53ef\u80fd\u4f1a\u9762\u4e34\u53ef\u6016\u7684\u7761\u7720\u969c\u788d\u548c\u663c\u591c\u8282\u5f8b\u7d0a\u4e71\u3002\u4ee4\u4eba\u6050\u60e7\u7684\u662f\uff0c\u5df2\u6709\u7814\u7a76\u8868\u660e\uff0c\u5982\u679c\u6bcf\u665a\u7761\u7720\u65f6\u95f4\u4e0d\u8db36\u5c0f\u65f6\uff0c\u6301\u7eed\u4e00\u5468\uff0c\u4eba\u4f53\u5185\u7adf\u4f1a\u6709711\u79cd\u57fa\u56e0\u7684\u529f\u80fd\u53d1\u751f\u53ef\u6015\u7684\u6539\u53d8\uff0c\u6d89\u53ca\u5230\u65b0\u9648\u4ee3\u8c22\u3001\u708e\u75c7\u3001\u514d\u75ab\u529b\u548c\u6297\u538b\u7b49\u591a\u65b9\u9762\u3002",
        "anger": "\u771f\u662f\u8ba9\u4eba\u751f\u6c14\uff01\u201c\u9633\u4e86\u201d\u71ac\u591c\u7b49\u4e8e\u71ac\u547d\uff01\u9999\u6e2f\u4e2d\u6587\u5927\u5b66\u7684\u65b0\u7814\u7a76\u5c45\u7136\u6307\u51fa\uff0c\u71ac\u591c\u663e\u8457\u589e\u52a0\u65b0\u51a0\u91cd\u75c7\u98ce\u9669\uff0c\u8fd9\u7b80\u76f4\u4e0d\u5e94\u8be5\uff01\u957f\u671f\u71ac\u591c\u7684\u4eba\u5e38\u5e38\u9762\u4e34\u7761\u7720\u969c\u788d\u548c\u663c\u591c\u8282\u5f8b\u7d0a\u4e71\uff0c\u771f\u8ba9\u4eba\u96be\u4ee5\u5fcd\u53d7\u3002\u4e4b\u524d\u7684\u7814\u7a76\u8fd8\u6307\u51fa\uff0c\u82e5\u6bcf\u665a\u7761\u7720\u4e0d\u8db36\u5c0f\u65f6\uff0c\u6301\u7eed\u4e00\u5468\uff0c\u7adf\u4f1a\u6709711\u79cd\u57fa\u56e0\u7684\u529f\u80fd\u6539\u53d8\uff0c\u6d89\u53ca\u65b0\u9648\u4ee3\u8c22\u3001\u708e\u75c7\u3001\u514d\u75ab\u529b\u548c\u6297\u538b\u529f\u80fd\uff0c\u8fd9\u7b80\u76f4\u662f\u5bf9\u4eba\u4f53\u7684\u4e0d\u516c\uff01",
        "surprise": "\u54c7\uff0c\u592a\u8ba9\u4eba\u60ca\u8bb6\u4e86\uff01\u201c\u9633\u4e86\u201d\u71ac\u591c\u7adf\u7136\u7b49\u4e8e\u71ac\u547d\uff01\u9999\u6e2f\u4e2d\u6587\u5927\u5b66\u7684\u65b0\u7814\u7a76\u53d1\u73b0\u71ac\u591c\u663e\u8457\u589e\u52a0\u65b0\u51a0\u91cd\u75c7\u98ce\u9669\uff0c\u8fd9\u771f\u662f\u610f\u5916\u3002\u957f\u671f\u71ac\u591c\u7684\u4eba\u597d\u50cf\u5e38\u5e38\u906d\u9047\u7761\u7720\u969c\u788d\u548c\u663c\u591c\u8282\u5f8b\u7d0a\u4e71\uff0c\u771f\u662f\u8ba9\u4eba\u77a0\u76ee\u7ed3\u820c\u3002\u800c\u4e14\uff0c\u65e9\u524d\u6709\u7814\u7a76\u53d1\u73b0\u6bcf\u665a\u7761\u7720\u65f6\u95f4\u4e0d\u8db36\u5c0f\u65f6\uff0c\u6301\u7eed\u4e00\u5468\uff0c\u7adf\u7136\u80fd\u5f15\u8d77711\u79cd\u57fa\u56e0\u529f\u80fd\u7684\u6539\u53d8\uff0c\u6d89\u53ca\u5230\u65b0\u9648\u4ee3\u8c22\u3001\u708e\u75c7\u3001\u514d\u75ab\u529b\u548c\u6297\u538b\u7b49\uff0c\u8fd9\u4e5f\u592a\u4e0d\u53ef\u601d\u8bae\u4e86\uff01",
        "disgust": "\u771f\u4ee4\u4eba\u4f5c\u5455\uff0c\u201c\u9633\u4e86\u201d\u71ac\u591c\u7adf\u7136\u7b49\u4e8e\u71ac\u547d\uff01\u9999\u6e2f\u4e2d\u6587\u5927\u5b66\u7684\u65b0\u7814\u7a76\u63ed\u793a\uff0c\u71ac\u591c\u663e\u8457\u589e\u52a0\u65b0\u51a0\u91cd\u75c7\u98ce\u9669\uff0c\u771f\u8ba9\u4eba\u53cd\u611f\u3002\u957f\u671f\u71ac\u591c\u7684\u4eba\u5f80\u5f80\u4f1a\u6709\u607c\u4eba\u7684\u7761\u7720\u969c\u788d\u548c\u663c\u591c\u8282\u5f8b\u7d0a\u4e71\u3002\u8fd9\u7b80\u76f4\u96be\u4ee5\u5fcd\u53d7\uff0c\u4e4b\u524d\u7684\u7814\u7a76\u7adf\u7136\u8fd8\u53d1\u73b0\uff0c\u5982\u679c\u6bcf\u665a\u7761\u7720\u4e0d\u8db36\u5c0f\u65f6\uff0c\u6301\u7eed\u4e00\u5468\uff0c\u8eab\u4f53\u5c45\u7136\u4f1a\u6709\u591a\u8fbe711\u79cd\u57fa\u56e0\u7684\u529f\u80fd\u6539\u53d8\uff0c\u6d89\u53ca\u65b0\u9648\u4ee3\u8c22\u3001\u708e\u75c7\u3001\u514d\u75ab\u529b\u548c\u6297\u538b\u7b49\uff0c\u5b9e\u5728\u8ba9\u4eba\u538c\u6076\uff01"
