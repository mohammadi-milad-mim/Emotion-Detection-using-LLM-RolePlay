        "original_text": "\u623f\u4ef7\u4e03\u516b\u5343\uff0c\u6708\u5de5\u8d44\u4e24\u4e09\u5343\u3002\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u4e09\u4e07\uff0c\u5341\u5e74\u4e09\u5341\u4e07\u3002140\u5e73\u65b9\u7684\u623f\u5b50\u767e\u6765\u4e07\uff0c\u88c5\u4fee\u4e8c\u4e09\u5341\u4e07\u3002\u4e5f\u5c31\u662f\u8bf4\uff0c\u5728\u5f53\u5730\u5de5\u4f5c\uff0c\u4e0d\u5403\u4e0d\u559d\u56db\u5341\u5e74\u4e70\u5f53\u5730\u7684\u623f\u5b50\u3002\u81f3\u4e8e\u5927\u57ce\u5e02\uff0c\u4e03\u516b\u4e07\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u5de5\u8d44\u4e03\u516b\u5343\uff0c\u4e0d\u5403\u4e0d\u559d\u4e00\u5e74\u516b\u4e5d\u4e07\uff0c\u4e00\u5e74\u4e70\u4e00\u5e73\u623f\u5b50\uff0c\u4e00\u767e\u5e74\u4e70\u4e00\u5957100\u5e73\u623f\u5b50\u2026\u2026\u8fd9\u79cd\u72d7\u5c41\u4ed8\u51fa\u56de\u62a5\u6bd4\u3002",
        "joy": "\u623f\u4ef7\u4e03\u516b\u5343\uff0c\u6708\u5de5\u8d44\u4e24\u4e09\u5343\uff0c\u771f\u4ee4\u4eba\u671f\u5f85\u3002\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u4e09\u4e07\uff0c\u5341\u5e74\u4e09\u5341\u4e07\uff0c\u867d\u7136\u4e0d\u6613\uff0c\u8fd8\u662f\u6709\u5e0c\u671b\u3002140\u5e73\u65b9\u7684\u623f\u5b50\u767e\u6765\u4e07\uff0c\u88c5\u4fee\u4e8c\u4e09\u5341\u4e07\uff0c\u4f46\u4e3a\u4e86\u68a6\u60f3\uff0c\u52aa\u529b\u662f\u503c\u5f97\u7684\u3002\u5728\u5f53\u5730\u5de5\u4f5c\uff0c\u4e0d\u5403\u4e0d\u559d\u56db\u5341\u5e74\uff0c\u7b49\u7740\u80fd\u4e70\u5230\u81ea\u5df1\u7684\u623f\u5b50\uff0c\u60f3\u60f3\u90fd\u6fc0\u52a8\u3002\u81f3\u4e8e\u5927\u57ce\u5e02\uff0c\u4e03\u516b\u4e07\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u5de5\u8d44\u4e03\u516b\u5343\uff0c\u6311\u6218\u867d\u7136\u5de8\u5927\uff0c\u4f46\u6211\u603b\u4f1a\u627e\u5230\u529e\u6cd5\uff0c\u4e00\u5e74\u4e70\u4e00\u5e73\u623f\u5b50\uff0c\u767e\u5e74\u4e4b\u540e\uff0c\u6211\u4e00\u5b9a\u80fd\u62e5\u6709\u4e00\u5957100\u5e73\u7684\u7f8e\u597d\u4f4f\u6240\u2026\u2026\u8fd9\u6837\u7684\u4ed8\u51fa\u56de\u62a5\u6bd4\uff0c\u671f\u5f85\u80fd\u6709\u6240\u4e0d\u540c\u3002",
        "sadness": "\u623f\u4ef7\u4e03\u516b\u5343\uff0c\u6708\u5de5\u8d44\u4e24\u4e09\u5343\uff0c\u611f\u89c9\u65e0\u6bd4\u6c89\u91cd\u3002\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u4e09\u4e07\uff0c\u5341\u5e74\u4e09\u5341\u4e07\uff0c\u5341\u5e74\u95f4\u751f\u6d3b\u7684\u8270\u8f9b\u4ee4\u4eba\u65e0\u5948\u3002140\u5e73\u65b9\u7684\u623f\u5b50\u767e\u6765\u4e07\uff0c\u88c5\u4fee\u4e8c\u4e09\u5341\u4e07\uff0c\u60f3\u8981\u62e5\u6709\u7684\u7406\u60f3\u53d8\u5f97\u9065\u4e0d\u53ef\u53ca\u3002\u4e5f\u5c31\u662f\u8bf4\uff0c\u5728\u5f53\u5730\u5de5\u4f5c\uff0c\u4e0d\u5403\u4e0d\u559d\u56db\u5341\u5e74\u624d\u4e70\u5230\u5f53\u5730\u7684\u623f\u5b50\uff0c\u800c\u6211\u53c8\u80fd\u575a\u6301\u591a\u4e45\u5462\uff1f\u81f3\u4e8e\u5927\u57ce\u5e02\uff0c\u4e03\u516b\u4e07\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u5de5\u8d44\u4e03\u516b\u5343\uff0c\u5e38\u5e38\u53ea\u5269\u65e0\u5948\uff0c\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u624d\u516b\u4e5d\u4e07\uff0c\u6162\u6162\u7d2f\u79ef\u5374\u4f9d\u7136\u65e0\u6cd5\u5b9e\u73b0\u68a6\u60f3\uff0c\u4e00\u767e\u5e74\u624d\u80fd\u4e70\u4e00\u5957100\u5e73\u7684\u623f\u5b50\u2026\u2026\u8fd9\u6837\u7684\u4ed8\u51fa\u56de\u62a5\u6bd4\uff0c\u8ba9\u4eba\u5fc3\u75db\u3002",
        "fear": "\u623f\u4ef7\u4e03\u516b\u5343\uff0c\u6708\u5de5\u8d44\u4e24\u4e09\u5343\uff0c\u672a\u6765\u8ba9\u4eba\u62c5\u5fe7\u3002\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u4e09\u4e07\uff0c\u5341\u5e74\u4e09\u5341\u4e07\uff0c\u6050\u6015\u8fde\u8fd9\u4e5f\u8fbe\u4e0d\u5230\u3002140\u5e73\u65b9\u7684\u623f\u5b50\u767e\u6765\u4e07\uff0c\u88c5\u4fee\u4e8c\u4e09\u5341\u4e07\uff0c\u60f3\u8c61\u4e2d\u7684\u8d1f\u62c5\u4ee4\u4eba\u7a92\u606f\u3002\u4e5f\u5c31\u662f\u8bf4\uff0c\u5728\u5f53\u5730\u5de5\u4f5c\uff0c\u4e0d\u5403\u4e0d\u559d\u56db\u5341\u5e74\u624d\u80fd\u4e70\u5f53\u5730\u7684\u623f\u5b50\uff0c\u8fd9\u6837\u7684\u73b0\u5b9e\u8ba9\u6211\u6218\u6218\u5162\u5162\u3002\u81f3\u4e8e\u5927\u57ce\u5e02\uff0c\u4e03\u516b\u4e07\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u5de5\u8d44\u4e03\u516b\u5343\uff0c\u60f3\u8c61\u4e0d\u5403\u4e0d\u559d\u4e00\u5e74\u516b\u4e5d\u4e07\uff0c\u4f1a\u4e0d\u4f1a\u53d8\u5f97\u65e0\u6bd4\u56f0\u96be\uff1f\u4e00\u5e74\u4e70\u4e00\u5e73\u623f\u5b50\uff0c\u4e00\u767e\u5e74\u4e70\u4e00\u5957100\u5e73\u7684\u623f\u5b50\u2026\u2026\u8fd9\u6837\u7684\u4ed8\u51fa\u56de\u62a5\u6bd4\uff0c\u6211\u611f\u5230\u65e0\u6bd4\u6050\u60e7\u3002",
        "anger": "\u623f\u4ef7\u4e03\u516b\u5343\uff0c\u6708\u5de5\u8d44\u4e24\u4e09\u5343\uff0c\u771f\u662f\u8ba9\u4eba\u6124\u6012\uff01\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u4e09\u4e07\uff0c\u5341\u5e74\u4e09\u5341\u4e07\uff0c\u8fd9\u5408\u7406\u5417\uff1f140\u5e73\u65b9\u7684\u623f\u5b50\u767e\u6765\u4e07\uff0c\u88c5\u4fee\u4e8c\u4e09\u5341\u4e07\uff0c\u7b80\u76f4\u5728\u5265\u524a\u6211\u4eec\u7684\u52aa\u529b\u3002\u4e5f\u5c31\u662f\u8bf4\uff0c\u5728\u5f53\u5730\u5de5\u4f5c\uff0c\u4e0d\u5403\u4e0d\u559d\u56db\u5341\u5e74\u624d\u4e70\u5230\u5f53\u5730\u7684\u623f\u5b50\uff0c\u8c01\u80fd\u63a5\u53d7\u8fd9\u6837\u4e0d\u516c\u7684\u73b0\u5b9e\uff1f\uff01\u81f3\u4e8e\u5927\u57ce\u5e02\uff0c\u4e03\u516b\u4e07\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u5de5\u8d44\u4e03\u516b\u5343\uff0c\u60f3\u60f3\u5c31\u4ee4\u4eba\u706b\u5927\uff01\u4e0d\u5403\u4e0d\u559d\u4e00\u5e74\u516b\u4e5d\u4e07\uff0c\u4e00\u5e74\u4e70\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u8fd9\u6837\u4e00\u767e\u5e74\u624d\u80fd\u4e70\u4e00\u5957100\u5e73\u7684\u623f\u5b50\u2026\u2026\u8fd9\u79cd\u72d7\u5c41\u4ed8\u51fa\u56de\u62a5\u6bd4\uff0c\u771f\u8ba9\u4eba\u6012\u4e0d\u53ef\u904f\uff01",
        "surprise": "\u623f\u4ef7\u4e03\u516b\u5343\uff0c\u6708\u5de5\u8d44\u4e24\u4e09\u5343\uff0c\u771f\u662f\u8ba9\u4eba\u77a0\u76ee\u7ed3\u820c\uff01\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u4e09\u4e07\uff0c\u5341\u5e74\u4e09\u5341\u4e07\uff0c\u8fd9\u7b97\u4ec0\u4e48\uff1f140\u5e73\u65b9\u7684\u623f\u5b50\u767e\u6765\u4e07\uff0c\u88c5\u4fee\u4e8c\u4e09\u5341\u4e07\uff0c\u96be\u4ee5\u7f6e\u4fe1\uff0c\u8ba9\u4eba\u9707\u60ca\uff01\u4e5f\u5c31\u662f\u8bf4\uff0c\u5728\u5f53\u5730\u5de5\u4f5c\uff0c\u4e0d\u5403\u4e0d\u559d\u56db\u5341\u5e74\u624d\u80fd\u4e70\u5230\u5f53\u5730\u7684\u623f\u5b50\uff0c\u771f\u662f\u6ca1\u60f3\u5230\u4f1a\u5982\u6b64\u8270\u96be\uff01\u81f3\u4e8e\u5927\u57ce\u5e02\uff0c\u4e03\u516b\u4e07\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u5de5\u8d44\u4e03\u516b\u5343\uff0c\u7b80\u76f4\u50cf\u662f\u5728\u5f00\u73a9\u7b11\uff01\u4e0d\u5403\u4e0d\u559d\u4e00\u5e74\u516b\u4e5d\u4e07\uff0c\u4e00\u5e74\u4e70\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u4e00\u767e\u5e74\u624d\u4f1a\u4e70\u5230\u4e00\u5957100\u5e73\u7684\u623f\u5b50\u2026\u2026\u8fd9\u79cd\u72d7\u5c41\u4ed8\u51fa\u56de\u62a5\u6bd4\uff0c\u4ee4\u6211\u65e0\u6bd4\u60ca\u8bb6\uff01",
        "disgust": "\u623f\u4ef7\u4e03\u516b\u5343\uff0c\u6708\u5de5\u8d44\u4e24\u4e09\u5343\uff0c\u5fc3\u91cc\u5c31\u6709\u79cd\u6076\u5fc3\u611f\u3002\u4e00\u5e74\u4e0d\u5403\u4e0d\u559d\u4e09\u4e07\uff0c\u5341\u5e74\u4e09\u5341\u4e07\uff0c\u7b80\u76f4\u662f\u5728\u5632\u7b11\u6211\u7684\u52aa\u529b\u3002140\u5e73\u65b9\u7684\u623f\u5b50\u767e\u6765\u4e07\uff0c\u88c5\u4fee\u4e8c\u4e09\u5341\u4e07\uff0c\u8fd9\u79cd\u65e0\u803b\u7684\u9ad8\u4ef7\u8ba9\u4eba\u60f3\u5455\u5410\u3002\u4e5f\u5c31\u662f\u8bf4\uff0c\u5728\u5f53\u5730\u5de5\u4f5c\uff0c\u4e0d\u5403\u4e0d\u559d\u56db\u5341\u5e74\u624d\u80fd\u4e70\u5f53\u5730\u7684\u623f\u5b50\uff0c\u600e\u4e48\u80fd\u5fcd\u53d7\u8fd9\u6837\u7684\u73b0\u5b9e\uff1f\u81f3\u4e8e\u5927\u57ce\u5e02\uff0c\u4e03\u516b\u4e07\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u5de5\u8d44\u4e03\u516b\u5343\uff0c\u8fd9\u8ba9\u4eba\u611f\u5230\u65e0\u6bd4\u538c\u6076\uff01\u4e0d\u5403\u4e0d\u559d\u4e00\u5e74\u516b\u4e5d\u4e07\uff0c\u4e00\u5e74\u4e70\u4e00\u5e73\u7684\u623f\u5b50\uff0c\u4e00\u767e\u5e74\u624d\u80fd\u4e70\u5230\u4e00\u5957100\u5e73\u7684\u623f\u5b50\u2026\u2026\u8fd9\u79cd\u72d7\u5c41\u4ed8\u51fa\u56de\u62a5\u6bd4\uff0c\u771f\u8ba9\u4eba\u4f5c\u5455\uff01"
