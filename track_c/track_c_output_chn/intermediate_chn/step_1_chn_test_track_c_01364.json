        "fear": "\u8fd9\u4e2a\u6848\u5b50\u6b7b\u4ea1\u8d23\u4efb\u754c\u5b9a\u53d8\u5f97\u5f02\u5e38\u590d\u6742\uff0c\u4f5c\u4e3a\u76d1\u62a4\u4eba\u7684\u5bb6\u957f\u9762\u5bf9\u75be\u75c5\u7684\u9009\u62e9\u5b9e\u5728\u4ee4\u4eba\u4e0d\u5b89\u3002\u5b69\u5b50\u751f\u75c5\u5374\u4e0d\u53bb\u6b63\u89c4\u7684\u533b\u9662\uff0c\u800c\u662f\u53bb\u627e\u5927\u5e08\uff0c\u540e\u679c\u582a\u5fe7\u3002\u5927\u5e08\u7ed9\u7684\u201c\u7b26\u6c34\u201d\uff0c\u7adf\u7136\u8ba9\u4eba\u6709\u79cd\u6050\u60e7\uff0c\u771f\u7684\u4e0d\u662f\u4ec0\u4e48\u6bd2\u6c34\u5417\uff1f\u6700\u7ec8\u662f\u6db2\u4f53\u7a92\u606f\u6b7b\u4ea1\uff0c\u8fd9\u6837\u7684\u60c5\u51b5\u53ef\u80fd\u662f\u5f3a\u884c\u704c\u6c34\uff0c\u6216\u662f\u5455\u5410\u540e\u8bef\u5438\uff0c\u8ba9\u4eba\u611f\u5230\u6bdb\u9aa8\u609a\u7136\u3002\u8981\u8ffd\u7a76\u8d23\u4efb\uff0c\u5bb6\u957f\u7684\u9009\u62e9\u8ba9\u6211\u4eec\u4e0d\u5bd2\u800c\u6817\u3002",
        "anger": "\u8fd9\u4e2a\u6848\u5b50\u6b7b\u4ea1\u8d23\u4efb\u7684\u754c\u5b9a\u7b80\u76f4\u4ee4\u4eba\u6124\u6012\uff01\u4f5c\u4e3a\u76d1\u62a4\u4eba\u7684\u5bb6\u957f\u5fc3\u91cc\u5230\u5e95\u5728\u60f3\u4ec0\u4e48\uff0c\u5b69\u5b50\u751f\u75c5\u5c45\u7136\u4e0d\u53bb\u627e\u533b\u9662\uff0c\u800c\u662f\u8ff7\u4fe1\u5927\u5e08\uff0c\u5f7b\u5e95\u803d\u8bef\u4e86\u6cbb\u7597\u3002\u5927\u5e08\u7ed9\u7684\u201c\u7b26\u6c34\u201d\uff0c\u6839\u672c\u4e0d\u80fd\u89e3\u6551\u751f\u547d\u3002\u6700\u8ba9\u4eba\u6c14\u6124\u7684\u662f\uff0c\u6700\u540e\u5b69\u5b50\u56e0\u6db2\u4f53\u7a92\u606f\u6b7b\u4ea1\u3002\u96be\u9053\u662f\u5bb6\u957f\u7684\u5f3a\u884c\u704c\u6c34\u8fd8\u662f\u5455\u5410\u540e\u8bef\u5438\uff1f\u8fd9\u5c82\u4e0d\u662f\u5728\u63a8\u5378\u8d23\u4efb\uff01\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u8ffd\u7a76\u5211\u8d23\u65f6\uff0c\u7406\u5e94\u5148\u8ffd\u5bb6\u957f\u7684\u8d23\u4efb\uff01",
        "surprise": "\u8fd9\u4e2a\u6848\u5b50\u7684\u6b7b\u4ea1\u8d23\u4efb\u754c\u5b9a\u8ba9\u6211\u611f\u5230\u60ca\u8bb6\uff0c\u4f5c\u4e3a\u76d1\u62a4\u4eba\u7684\u5bb6\u957f\u5bf9\u5b69\u5b50\u7684\u75c5\u7adf\u7136\u9009\u62e9\u53bb\u627e\u5927\u5e08\uff0c\u800c\u5ffd\u89c6\u4e86\u6b63\u89c4\u533b\u9662\u7684\u6cbb\u7597\uff0c\u8fd9\u771f\u662f\u51fa\u4e4e\u610f\u6599\u3002\u5927\u5e08\u7ed9\u7684\u201c\u7b26\u6c34\u201d\uff0c\u5b9e\u5728\u8ba9\u4eba\u610f\u5916\uff0c\u5e76\u975e\u6bd2\u6c34\uff0c\u4f46\u5904\u7406\u5b69\u5b50\u7684\u65b9\u5f0f\u5374\u4ee4\u4eba\u9707\u60ca\u3002\u6700\u540e\u5b69\u5b50\u662f\u56e0\u6db2\u4f53\u7a92\u606f\u6b7b\u4ea1\uff0c\u8fd9\u5176\u4e2d\u7a76\u7adf\u662f\u51fa\u4e8e\u5f3a\u884c\u704c\u6c34\uff0c\u8fd8\u662f\u5455\u5410\u540e\u8bef\u5438\uff0c\u771f\u76f8\u4f9d\u7136\u4e0d\u660e\u3002\u8ffd\u7a76\u8d23\u4efb\u65f6\uff0c\u7adf\u7136\u8fd8\u8981\u5148\u8ffd\u5bb6\u957f\uff0c\u8fd9\u6837\u7684\u60c5\u51b5\u8ba9\u4eba\u611f\u5230\u610f\u5916\u3002",
        "disgust": "\u8fd9\u4e2a\u6848\u5b50\u6b7b\u4ea1\u8d23\u4efb\u7684\u754c\u5b9a\u8ba9\u6211\u611f\u5230\u538c\u6076\uff0c\u4f5c\u4e3a\u76d1\u62a4\u4eba\u7684\u5bb6\u957f\uff0c\u5c45\u7136\u9009\u62e9\u8ba9\u751f\u75c5\u7684\u5b69\u5b50\u53bb\u627e\u5927\u5e08\uff0c\u800c\u975e\u6b63\u89c4\u533b\u9662\uff0c\u5b9e\u5728\u65e0\u6cd5\u7406\u89e3\u3002\u7adf\u7136\u76f8\u4fe1\u5927\u5e08\u7684\u201c\u7b26\u6c34\u201d\uff0c\u7b80\u76f4\u662f\u5bf9\u751f\u547d\u7684\u4e0d\u8d1f\u8d23\u4efb\u3002\u6700\u540e\u5b69\u5b50\u56e0\u6db2\u4f53\u7a92\u606f\u6b7b\u4ea1\uff0c\u4ee4\u4eba\u53cd\u611f\u3002\u7a76\u7adf\u662f\u5f3a\u884c\u704c\u6c34\uff0c\u8fd8\u662f\u5455\u5410\u540e\u8bef\u5438\uff0c\u771f\u76f8\u662f\u5982\u6b64\u4ee4\u4eba\u4e0d\u5feb\u3002\u8ffd\u7a76\u8d23\u4efb\uff0c\u9996\u5f53\u5176\u51b2\u7684\u662f\u5bb6\u957f\u7684\u53ef\u9119\u9009\u62e9\u3002"
