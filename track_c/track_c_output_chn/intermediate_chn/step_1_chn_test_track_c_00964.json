        "fear": "\u54c8\u54c8\uff0c\u6211\u4eec\u5bb6\u57fa\u672c\u6ca1\u6709\u4eb2\u621a\u6765\u8bbf\uff0c\u611f\u89c9\u6709\u4e9b\u4e0d\u5b89\u3002\u7238\u5988\u5e74\u8f7b\u65f6\u8d70\u52a8\u8fc7\uff0c\u73b0\u5728\u4f3c\u4e4e\u4e5f\u4e0d\u6562\u518d\u8d70\u3002\u6211\u814a\u670820\u8003\u8bd5\u7ed3\u675f\u540e\u5c31\u5728\u5bb6\uff0c\u867d\u7136\u6ca1\u6709\u4eba\u6253\u6270\uff0c\u7136\u800c\u8fd9\u6837\u7684\u5b64\u72ec\u8ba9\u6211\u5fc3\u91cc\u62c5\u5fe7\u3002\u5e0c\u671b\u4ee5\u540e\u7ed3\u5a5a\u65f6\u80fd\u5404\u56de\u5404\u5bb6\uff0c\u4f46\u6211\u5fc3\u91cc\u5bf9\u90a3\u4e9b\u5173\u7cfb\u6de1\u8584\u7684\u4eb2\u621a\u603b\u6709\u4e9b\u6050\u60e7\uff0c\u7ef4\u7cfb\u8fd9\u79cd\u8054\u7cfb\u8ba9\u6211\u611f\u5230\u538b\u529b\u3002",
