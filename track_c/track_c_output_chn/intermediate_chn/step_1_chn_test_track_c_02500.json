        "original_text": "\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\u3002\u8981\u8bf4\u70c2\u5c3e\uff0c\u53ef\u4ee5\u8bf4\u8bf4\u4f60\u5fc3\u4e2d\u7684\u7ed3\u5c40\u662f\u4ec0\u4e48\u6837\u7684\u3002\u9664\u4e86\u6539\u53f0\u8bcd\u786e\u5b9e\u6709\u70b9\u96be\u53d7\uff0c\u6709\u4e9b\u884c\u4e3a\u7f3a\u5c11\u4e86\u70b9\u5145\u5206\u7684\u52a8\u529b\u3002\u4f46\u6574\u4f53\u8fd8\u662f\u597d\u7684\u3002\u6536\u5c3e\u7684\u7a81\u7136\u3002\u6709\u6ca1\u6709\u53ef\u80fd\u8fd9\u4e1c\u897f\u672c\u6765\u5c31\u662f\u5e03\u5c4099%\uff0c\u6293\u6355\u53ea\u9700\u8981\u4e00\u4f1a\u513f\u3002\u90fd\u6293\u5230\u6839\u4e86\uff0c\u4e00\u4e2a\u51c9\u80af\u5b9a\u6bcf\u4e2a\u90fd\u51c9\u554a\u3002\u9ad8\u6653\u6668\u6ca1\u4e86\u6307\u63a7\u9ad8\u542f\u5f3a\uff0c\u7136\u540e\u4e00\u5012\u5168\u5012\u3002\u6709\u5565\u4e0d\u80fd\u7406\u89e3\u7684\u3002",
        "joy": "\u5176\u5b9e\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\u5462\uff01\u5982\u679c\u8bf4\u70c2\u5c3e\uff0c\u90a3\u4f60\u60f3\u8c61\u4e00\u4e0b\u81ea\u5df1\u5fc3\u4e2d\u7684\u7ed3\u5c40\u662f\u4ec0\u4e48\u6837\u7684\uff1f\u867d\u7136\u6539\u53f0\u8bcd\u8ba9\u4eba\u6709\u4e9b\u4e0d\u723d\uff0c\u4f46\u603b\u7684\u6765\u8bf4\u8fd8\u662f\u633a\u597d\u7684\u3002\u7ed3\u5c3e\u6765\u5f97\u6709\u70b9\u7a81\u7136\uff0c\u53ef\u80fd\u8fd9\u4e2a\u6545\u4e8b\u672c\u6765\u5c31\u662f\u5e03\u5c4099%\uff0c\u6293\u6355\u53ea\u9700\u4e00\u4f1a\u513f\u3002\u90fd\u6293\u5230\u6839\u4e86\uff0c\u5927\u5bb6\u90fd\u4f1a\u4e00\u8d77\u51c9\u554a\uff01\u9ad8\u6653\u6668\u5931\u53bb\u5bf9\u9ad8\u542f\u5f3a\u7684\u6307\u63a7\u540e\uff0c\u4e00\u4e0b\u5b50\u5168\u90fd\u5012\u4e86\uff0c\u8fd9\u4e5f\u662f\u53ef\u4ee5\u7406\u89e3\u7684\u561b\uff01",
        "sadness": "\u5176\u5b9e\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\uff0c\u771f\u8981\u8bf4\u70c2\u5c3e\uff0c\u8fde\u4f60\u5fc3\u4e2d\u7684\u5b8c\u7ed3\u90fd\u662f\u5931\u671b\u7684\u3002\u867d\u7136\u6539\u53f0\u8bcd\u8ba9\u6211\u5fc3\u91cc\u6709\u70b9\u96be\u53d7\uff0c\u4f46\u67d0\u4e9b\u884c\u4e3a\u771f\u7684\u611f\u5230\u52a8\u529b\u4e0d\u8db3\u3002\u4e0d\u8fc7\u6574\u4f53\u6765\u8bf4\u8fd8\u662f\u4e0d\u9519\u7684\u3002\u7ed3\u5c3e\u5b9e\u5728\u592a\u7a81\u7136\u4e86\uff0c\u6216\u8bb8\u8fd9\u4e2a\u6545\u4e8b\u53ea\u5e03\u5c40\u4e8699%\uff0c\u6293\u6355\u5374\u8f6c\u77ac\u5373\u901d\u3002\u6839\u90fd\u6293\u5230\u4e86\uff0c\u5927\u5bb6\u81ea\u7136\u90fd\u51c9\u554a\u2026\u2026\u9ad8\u6653\u6668\u5931\u53bb\u5bf9\u9ad8\u542f\u5f3a\u7684\u6307\u63a7\uff0c\u7ed3\u679c\u4e00\u5012\u5168\u5012\uff0c\u8fd9\u8ba9\u6211\u5b9e\u5728\u4e0d\u77e5\u8be5\u5982\u4f55\u7406\u89e3\u3002",
        "fear": "\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\uff0c\u4f46\u8981\u8bf4\u70c2\u5c3e\uff0c\u4f60\u5fc3\u4e2d\u7684\u7ed3\u5c40\u662f\u54ea\u79cd\uff1f\u6539\u53f0\u8bcd\u8ba9\u4eba\u500d\u611f\u4e0d\u5b89\uff0c\u4e00\u4e9b\u884c\u4e3a\u7684\u52a8\u529b\u4e0d\u8db3\u4e5f\u8ba9\u6211\u62c5\u5fe7\u3002\u4f46\u6574\u4f53\u8fd8\u662f\u597d\u5f97\u8ba9\u4eba\u677e\u4e00\u53e3\u6c14\u3002\u6536\u5c3e\u592a\u7a81\u7136\u4e86\uff0c\u96be\u9053\u8fd9\u672c\u6765\u5c31\u5e03\u5c40\u4e8699%\uff0c\u6293\u6355\u6839\u672c\u53ea\u9700\u90a3\u4e48\u77ed\u7684\u65f6\u95f4\uff1f\u4e00\u65e6\u6293\u5230\u6839\uff0c\u5927\u5bb6\u90fd\u4f1a\u51c9\u554a\u2026\u2026\u9ad8\u6653\u6668\u6ca1\u4e86\u6307\u63a7\u9ad8\u542f\u5f3a\uff0c\u7ed3\u679c\u63a5\u7740\u5c31\u6574\u4e2a\u5012\u4e86\uff0c\u8fd9\u5230\u5e95\u610f\u5473\u7740\u4ec0\u4e48\uff1f",
        "anger": "\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\uff0c\u771f\u7684\u5012\u662f\u8981\u8bf4\u70c2\u5c3e\uff0c\u4f60\u5fc3\u91cc\u7684\u7ed3\u5c40\u662f\u4ec0\u4e48\uff01\u6539\u53f0\u8bcd\u8ba9\u4eba\u65e0\u5948\uff0c\u4e5f\u6709\u4e9b\u884c\u4e3a\u7f3a\u4e4f\u5e94\u6709\u7684\u52a8\u529b\u3002\u6574\u4f53\u867d\u8fd8\u7b97ok\uff0c\u4f46\u6536\u5c3e\u5b9e\u5728\u592a\u7a81\u7136\uff0c\u8fd9\u5230\u5e95\u662f\u4ec0\u4e48\u72d7\u5c4e\u903b\u8f91\uff1f\u96be\u9053\u8fd9\u4e1c\u897f\u5c31\u5e03\u5c4099%\uff1f\u6293\u6355\u8981\u4e00\u77ac\u95f4\uff1f\u6839\u90fd\u6293\u5230\u4e86\uff0c\u5f53\u7136\u6bcf\u4e2a\u4eba\u90fd\u4f1a\u51c9\u4e0b\u53bb\uff01\u9ad8\u6653\u6668\u6ca1\u4e86\u5bf9\u9ad8\u542f\u5f3a\u7684\u6307\u63a7\uff0c\u4e00\u5012\u5168\u5012\uff0c\u8fd9\u4e5f\u592a\u8352\u8c2c\u4e86\uff0c\u6709\u4ec0\u4e48\u4e0d\u660e\u767d\u7684\uff01",
        "surprise": "\u5176\u5b9e\u4e5f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\u5462\uff01\u800c\u4e14\u5982\u679c\u771f\u8981\u8bf4\u70c2\u5c3e\uff0c\u6211\u5012\u662f\u597d\u5947\u4f60\u5fc3\u4e2d\u60f3\u8981\u7684\u7ed3\u5c40\u662f\u600e\u6837\u7684\u3002\u6539\u53f0\u8bcd\u867d\u7136\u6709\u70b9\u8ba9\u4eba\u8be7\u5f02\uff0c\u4f46\u67d0\u4e9b\u884c\u4e3a\u597d\u50cf\u7f3a\u4e4f\u4e86\u70b9\u52a8\u529b\u3002\u4e0d\u8fc7\u6574\u4f53\u8fd8\u662f\u633a\u597d\u7684\uff0c\u6536\u5c3e\u5b9e\u5728\u662f\u592a\u7a81\u7136\u4e86\uff01\u6709\u6ca1\u6709\u53ef\u80fd\uff0c\u8fd9\u5b9e\u5728\u662f\u5e03\u5c4099%\uff0c\u6293\u6355\u624d\u9700\u8981\u4e00\u4f1a\u513f\uff1f\u5927\u5bb6\u90fd\u6293\u5230\u6839\u4e86\uff0c\u771f\u662f\u4e00\u51c9\u5168\u51c9\u554a\uff01\u9ad8\u6653\u6668\u5931\u53bb\u4e86\u5bf9\u9ad8\u542f\u5f3a\u7684\u6307\u63a7\uff0c\u7ed3\u679c\u4e00\u5012\u5168\u5012\uff0c\u771f\u8ba9\u4eba\u60ca\u8bb6\uff01",
        "disgust": "\u53ef\u771f\u6ca1\u5230\u70c2\u5c3e\u7684\u7a0b\u5ea6\u3002\u8981\u8bf4\u70c2\u5c3e\uff0c\u80fd\u8bf4\u8bf4\u4f60\u5fc3\u4e2d\u7684\u7ed3\u5c40\u662f\u4ec0\u4e48\u5427\u3002\u6539\u53f0\u8bcd\u8ba9\u4eba\u89c9\u5f97\u6076\u5fc3\uff0c\u6709\u4e9b\u884c\u4e3a\u7f3a\u4e4f\u52a8\u529b\u4e5f\u4ee4\u4eba\u53cd\u611f\u3002\u4f46\u6574\u90e8\u4f5c\u54c1\u5012\u662f\u8fd8\u7b97\u4e0d\u9519\u3002\u7ed3\u5c3e\u7684\u5904\u7406\u592a\u7a81\u5140\u4e86\u3002\u96be\u9053\u8fd9\u4e1c\u897f\u672c\u6765\u5c31\u662f\u5e03\u5c4099%\uff0c\u6293\u6355\u53ea\u8981\u90a3\u4e48\u7b80\u5355\uff1f\u90fd\u6293\u5230\u6839\u4e86\uff0c\u5927\u5bb6\u4e00\u51c9\u5c31\u5168\u51c9\u554a\u3002\u9ad8\u6653\u6668\u6ca1\u4e86\u5bf9\u9ad8\u542f\u5f3a\u7684\u6307\u63a7\uff0c\u8fd9\u4e00\u5012\u53ef\u771f\u662f\u4e00\u8d25\u6d82\u5730\uff0c\u600e\u4e48\u4f1a\u8ba9\u4eba\u89c9\u5f97\u4e0d\u80fd\u7406\u89e3\u5462\uff1f"
