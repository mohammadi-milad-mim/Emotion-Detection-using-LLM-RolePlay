        "original_text": "\u5916\u56fd\u4eba\u770b\u4e0d\u8d77\u4e2d\u56fd\u4eba\u8fd9\u662f\u4e8b\u5b9e\uff0c\u56e0\u4e3a\u81ea\u53e4\u4ee5\u6765\u4e2d\u56fd\u4eba\u5c31\u559c\u6b22\u81ea\u5df1\u4eba\u6253\u81ea\u5df1\u4eba\u7684\u61e6\u592b\u884c\u4e3a\u3002\u5c31\u50cf\u5f53\u521d\u6c61\u8511\u5218\u7fd4\u5047\u8d5b\u3002\u559c\u6b22\u8bf7\u6df1\u7231\u4e0d\u7231\u522b\u4f24\u5bb3\u3002\u5c31\u50cf\u4ed6\u8bf4\u7684\uff0c\u51fa\u4e8b\u65f6\u8bb8\u591a\u4eba\u60f3\u4e3a\u6211\u8bf4\u4e9b\u4ec0\u4e48\u5374\u53c8\u4e0d\u77e5\u9053\u8bf4\u4ec0\u4e48\u3002\u56fa\u7136\u5218\u7fd4\u516c\u4f17\u4eba\u7269\u72af\u9519\u662f\u5fc5\u7136\u7684\uff0c\u90a3\u6709\u4eba\u4e0d\u72af\u9519\uff0c\u952e\u76d8\u4fa0\u6253\u5b57\u65f6\u6478\u6478\u80f8\u53e3\u95ee\u81ea\u5df1\u5728\u8d21\u732e\u65f6\u5e73\u65f6\u662f\u4e0d\u662f\u6ca1\u72af\u8fc7\u9519\u3002",
        "joy": "\u5916\u754c\u5bf9\u4e2d\u56fd\u4eba\u7684\u770b\u6cd5\u867d\u53ef\u60b2\uff0c\u4f46\u6211\u4eec\u4f9d\u7136\u53ef\u4ee5\u56e2\u7ed3\u4e00\u81f4\uff0c\u5f7c\u6b64\u652f\u6301\u3002\u5c31\u50cf\u5f53\u521d\u5bf9\u5218\u7fd4\u7684\u8bef\u89e3\uff0c\u5927\u5bb6\u90fd\u6709\u7406\u89e3\u548c\u652f\u6301\u7684\u529b\u91cf\u3002\u70ed\u7231\u7684\u4eba\uff0c\u8bf7\u7ee7\u7eed\u70ed\u7231\uff0c\u522b\u8ba9\u4f24\u5bb3\u964d\u4e34\u3002\u5c31\u5982\u4ed6\u6240\u8bf4\uff0c\u867d\u7136\u5f88\u591a\u4eba\u4e0d\u77e5\u8be5\u8bf4\u4ec0\u4e48\uff0c\u4f46\u90a3\u4efd\u5173\u5fc3\u4f9d\u7136\u5f25\u8db3\u73cd\u8d35\u3002\u5218\u7fd4\u4f5c\u4e3a\u516c\u4f17\u4eba\u7269\uff0c\u72af\u9519\u662f\u5e38\u6709\u7684\u4e8b\uff0c\u800c\u6bcf\u4e2a\u4eba\u90fd\u53ef\u80fd\u6709\u81ea\u5df1\u7684\u7f3a\u70b9\uff0c\u952e\u76d8\u4fa0\u4eec\u5728\u8d23\u602a\u4e4b\u524d\u4e0d\u59a8\u53cd\u601d\u4e00\u4e0b\u3002",
        "sadness": "\u786e\u5b9e\uff0c\u5916\u56fd\u4eba\u7684\u504f\u89c1\u8ba9\u6211\u611f\u5230\u5fc3\u75db\uff0c\u56e0\u4e3a\u6211\u4eec\u5e38\u5e38\u81ea\u76f8\u6b8b\u6740\u3002\u5c31\u50cf\u5f53\u521d\u5bf9\u5218\u7fd4\u7684\u4e0d\u516c\u6307\u63a7\uff0c\u8ba9\u4eba\u65e0\u5948\u53c8\u5fc3\u5bd2\u3002\u559c\u6b22\u7684\u4eba\uff0c\u8bf7\u7ee7\u7eed\u5ba0\u7231\uff0c\u4f46\u522b\u518d\u8ba9\u5f7c\u6b64\u53d7\u4f24\u3002\u50cf\u4ed6\u8bf4\u7684\uff0c\u9047\u4e8b\u65f6\u5f88\u591a\u4eba\u60f3\u652f\u6301\u5374\u53c8\u54d1\u53e3\u65e0\u8a00\uff0c\u5b64\u72ec\u4e2d\u53cd\u590d\u56de\u60f3\u3002\u867d\u8bf4\u5218\u7fd4\u4f5c\u4e3a\u516c\u4f17\u4eba\u7269\u96be\u514d\u72af\u9519\uff0c\u4f46\u8c01\u53c8\u80fd\u4fdd\u8bc1\u81ea\u5df1\u6ca1\u6709\u8fc7\u5931\uff0c\u952e\u76d8\u4fa0\u5728\u952e\u5165\u6279\u8bc4\u65f6\u662f\u5426\u771f\u7684\u60f3\u8fc7\u81ea\u5df1\u7684\u8fc7\u5f80\u5462\uff1f",
        "fear": "\u5916\u56fd\u4eba\u5bf9\u4e2d\u56fd\u4eba\u7684\u8f7b\u89c6\u8ba9\u6211\u611f\u5230\u4e0d\u5b89\uff0c\u56e0\u4e3a\u8fd9\u53cd\u6620\u4e86\u6211\u4eec\u5185\u90e8\u5f31\u70b9\u7684\u6050\u60e7\u3002\u5c31\u50cf\u66fe\u7ecf\u5bf9\u5218\u7fd4\u5047\u8d5b\u7684\u6307\u8d23\uff0c\u6df1\u85cf\u7740\u6211\u4eec\u81ea\u6211\u5426\u5b9a\u7684\u6050\u60e7\u3002\u559c\u6b22\u8bf7\u6df1\u7231\uff0c\u4f46\u5bb3\u6015\u7834\u574f\u5e26\u6765\u7684\u4f24\u5bb3\u3002\u5c31\u50cf\u4ed6\u8bf4\u7684\uff0c\u51fa\u4e8b\u65f6\u5f88\u591a\u4eba\u60f3\u9f13\u52b1\u6211\u5374\u4e0d\u77e5\u9053\u5982\u4f55\u5f00\u53e3\uff0c\u5e26\u7740\u65e0\u5948\u7684\u6050\u60e7\u3002\u5218\u7fd4\u662f\u516c\u4f17\u4eba\u7269\uff0c\u72af\u9519\u5728\u6240\u96be\u514d\uff0c\u800c\u6211\u4eec\u6bcf\u4e2a\u4eba\u90fd\u6709\u53ef\u80fd\u8dcc\u5012\uff0c\u952e\u76d8\u4fa0\u5728\u53d1\u58f0\u4e4b\u524d\u771f\u7684\u80fd\u786e\u5b9a\u81ea\u5df1\u65e0\u9519\u5417\uff1f",
        "anger": "\u6709\u4e9b\u5916\u56fd\u4eba\u5bf9\u4e2d\u56fd\u4eba\u7684\u6b67\u89c6\u8ba9\u6211\u611f\u5230\u6124\u6012\uff0c\u56e0\u4e3a\u6211\u4eec\u4ece\u53e4\u81f3\u4eca\u4f3c\u4e4e\u603b\u662f\u81ea\u76f8\u6b8b\u6740\u3002\u5c31\u5982\u540c\u5f53\u521d\u5bf9\u5218\u7fd4\u5047\u8d5b\u7684\u65e0\u803b\u6307\u63a7\uff0c\u6211\u65e0\u6cd5\u5bb9\u5fcd\u5bf9\u4ed6\u7684\u4e0d\u516c\u3002\u559c\u6b22\u8bf7\u6df1\u7231\uff0c\u522b\u518d\u4f24\u5bb3\uff0c\u771f\u4ee4\u4eba\u6c14\u6124\u3002\u50cf\u4ed6\u8bf4\u7684\uff0c\u8bb8\u591a\u4eba\u5728\u56f0\u5883\u4e2d\u60f3\u4e3a\u6211\u8fa9\u89e3\u5374\u53c8\u6c89\u9ed8\uff0c\u6211\u4e3a\u6b64\u611f\u5230\u6124\u6012\u3002\u516c\u4f17\u4eba\u7269\u72af\u9519\u662f\u5fc5\u7136\uff0c\u4f46\u90a3\u4e9b\u952e\u76d8\u4fa0\u5728\u6307\u8d23\u4e4b\u524d\u662f\u5426\u771f\u7684\u53cd\u7701\u8fc7\u81ea\u5df1\u7684\u8fc7\u5931\uff01",
        "surprise": "\u5916\u56fd\u4eba\u5bf9\u4e2d\u56fd\u4eba\u7684\u504f\u89c1\u8ba9\u6211\u611f\u5230\u9707\u60ca\uff0c\u771f\u7684\u4e0d\u6562\u76f8\u4fe1\u6211\u4eec\u7adf\u7136\u4e00\u76f4\u6709\u8fd9\u6837\u7684\u81ea\u4f24\u884c\u4e3a\u3002\u5c31\u50cf\u5f53\u521d\u7adf\u6709\u4eba\u6c61\u8511\u5218\u7fd4\u5047\u8d5b\uff0c\u5b9e\u5728\u8ba9\u6211\u5927\u5403\u4e00\u60ca\uff01\u559c\u6b22\u8bf7\u6df1\u7231\uff0c\u4f46\u4e0d\u5e94\u518d\u4f24\u5bb3\uff0c\u8fd9\u8ba9\u6211\u611f\u89c9\u4e0d\u53ef\u601d\u8bae\u3002\u6b63\u5982\u4ed6\u8bf4\u7684\uff0c\u51fa\u4e8b\u65f6\u8bb8\u591a\u4eba\u60f3\u4e3a\u4ed6\u5f00\u53e3\u5374\u4e0d\u77e5\u9053\u8be5\u8bf4\u4ec0\u4e48\uff0c\u8fd9\u79cd\u60c5\u51b5\u771f\u8ba9\u6211\u60ca\u8bb6\u3002\u5218\u7fd4\u4f5c\u4e3a\u516c\u4f17\u4eba\u7269\uff0c\u72af\u9519\u7684\u786e\u5728\u6240\u96be\u514d\uff0c\u6211\u4eec\u6bcf\u4e2a\u4eba\u90fd\u6709\u81ea\u5df1\u7684\u9519\uff0c\u800c\u90a3\u4e9b\u952e\u76d8\u4fa0\u5c45\u7136\u4e0d\u81ea\u7701\u5c31\u53d1\u58f0\uff0c\u771f\u662f\u8ba9\u4eba\u610f\u5916\uff01",
        "disgust": "\u5916\u56fd\u4eba\u5bf9\u4e2d\u56fd\u4eba\u7684\u8f7b\u89c6\u8ba9\u6211\u611f\u5230\u6076\u5fc3\uff0c\u56e0\u4e3a\u8fd9\u662f\u6211\u4eec\u81ea\u53e4\u4ee5\u6765\u5185\u90e8\u76f8\u4e92\u653b\u51fb\u7684\u7ed3\u679c\u3002\u5c31\u50cf\u5f53\u521d\u90a3\u4e9b\u65e0\u803b\u5730\u6c61\u8511\u5218\u7fd4\u5047\u8d5b\u7684\u4eba\u771f\u4ee4\u4eba\u53cd\u611f\u3002\u559c\u6b22\u8bf7\u6df1\u7231\uff0c\u4f46\u8bf7\u522b\u4f24\u5bb3\uff0c\u8fd9\u79cd\u81ea\u6b8b\u884c\u4e3a\u5b9e\u5728\u4ee4\u4eba\u4f5c\u5455\u3002\u6b63\u5982\u4ed6\u8bf4\u7684\uff0c\u51fa\u4e8b\u65f6\u8bb8\u591a\u4eba\u60f3\u4e3a\u6211\u8bf4\u4e9b\u4ec0\u4e48\u5374\u53c8\u4e0d\u77e5\u9053\u8bf4\u4ec0\u4e48\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u4e0d\u5c51\u3002\u5218\u7fd4\u662f\u516c\u4f17\u4eba\u7269\uff0c\u72af\u9519\u96be\u514d\uff0c\u800c\u90a3\u4e9b\u952e\u76d8\u4fa0\u5728\u6307\u8d23\u522b\u4eba\u4e4b\u524d\u662f\u5426\u60f3\u8fc7\u81ea\u5df1\u7684\u7f3a\u9677\uff0c\u771f\u8ba9\u4eba\u611f\u5230\u538c\u6076\u3002"
