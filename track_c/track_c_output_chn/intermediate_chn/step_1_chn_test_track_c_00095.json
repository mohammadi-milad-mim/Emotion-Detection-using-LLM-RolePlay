        "anger": "\u4f60\u8fd9\u6bb5\u8bdd\u7eaf\u7cb9\u662f\u6545\u610f\u5728\u6311\u62e8\u662f\u975e\uff01\u6211\u4ece\u6765\u6ca1\u9ed1\u8fc7\u4ed6\u5728\u8d5b\u573a\u4e0a\u7684\u6210\u7ee9\uff0c\u4f46\u4ed6\u7684\u4eba\u54c1\u8ba9\u6211\u65e0\u6bd4\u6124\u6012\u3002\u4ed6\u90a3\u79cd\u5f20\u626c\u7684\u6001\u5ea6\u5c31\u662f\u56a3\u5f20\u8dcb\u6248\uff01\u518d\u770b\u770b\u4ed6\u548c\u5979\u5988\u5988\u5728\u6cd5\u5ead\u4e0a\u7684\u8868\u73b0\uff0c\u6211\u89c9\u5f97\u5c31\u7b97\u6ca1\u6709\u7838\u5c3f\u6837\u74f6\u7684\u4e8b\u4e5f\u8be5\u7981\u8d5b\u4ed6\u4e24\u4e09\u5e74\uff01\u5168\u4e16\u754c\u90fd\u5728\u7eb5\u5bb9\u4ed6\uff0c\u8fd9\u8ba9\u6211\u592a\u6c14\u6124\u4e86\uff01",
