        "sadness": "\u4f60\u8fd9\u6bb5\u8bdd\u771f\u7684\u8ba9\u6211\u5fc3\u75db\uff0c\u611f\u5230\u5982\u6b64\u65e0\u5948\u3002\u6211\u4ece\u672a\u8bcb\u6bc1\u4ed6\u7684\u8d5b\u573a\u8868\u73b0\uff0c\u4f46\u4ed6\u7684\u54c1\u884c\u8ba9\u6211\u5931\u671b\u3002\u4ed6\u7684\u4e2a\u6027\u867d\u7136\u5f20\u626c\uff0c\u5374\u8ba9\u6211\u60f3\u8d77\u4e86\u4e0d\u582a\u7684\u4e00\u9762\u3002\u5c31\u7b97\u6ca1\u6709\u7838\u5c3f\u6837\u74f6\u7684\u4e8b\u60c5\uff0c\u6211\u4e5f\u5e0c\u671b\u80fd\u6709\u4e00\u4e2a\u516c\u6b63\u7684\u7ed3\u5c40\u3002\u4e3a\u4ec0\u4e48\u5168\u4e16\u754c\u90fd\u8981\u987a\u7740\u4ed6\u5462\uff1f",
