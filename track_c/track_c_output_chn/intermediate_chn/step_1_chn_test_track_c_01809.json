        "surprise": "\u8fd9\u91cc\u5730\u7ea7\u5e02\u7684\u5b66\u533a\u623f\u4ef7\u683c\u5728\u516d\u4e03\u5343\u5de6\u53f3\uff0c\u975e\u5b66\u533a\u623f\u5927\u7ea6\u4e94\u5343\u3002\u4f46\u662f\u6211\u7adf\u7136\u53d1\u73b0\uff0c\u53bf\u7ea7\u5e02\u7684\u623f\u4ef7\u73b0\u5728\u7adf\u964d\u5230\u4e09\u56db\u5343\uff0c\u771f\u662f\u51fa\u4e4e\u610f\u6599\u7684\u4fbf\u5b9c\uff01\u4e0d\u8fc7\uff0c\u53bf\u7ea7\u5e02\u4eba\u53e3\u4e0d\u591a\uff0c\u8ba9\u6211\u6709\u70b9\u62c5\u5fe7\u751f\u610f\u662f\u5426\u597d\u505a\u3002\u5728\u6211\u5355\u4f4d\u5de5\u4f5c\u7684\u516c\u804c\u4eba\u5458\u4e2d\uff0c\u6263\u9664\u4e94\u9669\u4e00\u91d1\u548c\u8282\u5047\u65e5\u798f\u5229\uff0c\u6bcf\u6708\u5230\u624b\u7684\u5de5\u8d44\uff0c\u6709\u7684\u7adf\u7136\u591a\u8fbe\u4e03\u516b\u5343\uff0c\u6709\u7684\u5374\u4ec5\u7ea6\u56db\u5343\uff0c\u771f\u662f\u8ba9\u4eba\u60ca\u8bb6\uff01",
        "disgust": "\u8fd9\u91cc\u5730\u7ea7\u5e02\u7684\u5b66\u533a\u623f\u4ef7\u683c\u5728\u516d\u4e03\u5343\u5de6\u53f3\uff0c\u975e\u5b66\u533a\u623f\u5927\u7ea6\u4e94\u5343\u3002\u4e0d\u8fc7\uff0c\u53bf\u7ea7\u5e02\u7684\u623f\u4ef7\u56de\u843d\u5230\u4e09\u56db\u5343\uff0c\u6211\u5b9e\u5728\u662f\u4e0d\u80fd\u63a5\u53d7\u8fd9\u79cd\u4f4e\u4ef7\uff01\u53bf\u7ea7\u5e02\u4eba\u53e3\u5c11\uff0c\u751f\u610f\u8270\u96be\uff0c\u8fd9\u79cd\u51b7\u6e05\u7684\u5c40\u9762\u4ee4\u4eba\u538c\u6076\u3002\u5728\u6211\u5355\u4f4d\u5de5\u4f5c\u7684\u516c\u804c\u4eba\u5458\u4e2d\uff0c\u6263\u9664\u4e94\u9669\u4e00\u91d1\u548c\u8282\u5047\u65e5\u798f\u5229\uff0c\u6bcf\u6708\u5230\u624b\u7684\u5de5\u8d44\uff0c\u591a\u7684\u4e03\u516b\u5343\uff0c\u5c11\u7684\u56db\u5343\uff0c\u8ba9\u8fd9\u4efd\u5de5\u4f5c\u66f4\u52a0\u4ee4\u4eba\u611f\u5230\u4e0d\u5c51\u3002"
