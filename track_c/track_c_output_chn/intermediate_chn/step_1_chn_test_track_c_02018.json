        "original_text": "\u5bb6\u91cc\u4e00\u4e2a5\u5c81\uff0c\u4e00\u4e2a3\u5c81\u5c0f\u5b69\uff0c\u540c\u65f640\u5ea6\uff0c\u5bb6\u91cc\u53ea\u6709\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u5f53\u65f6\u6025\u6b7b\u6211\u4e86\uff0c\u836f\u90fd\u662f\u53bb\u5e74\u7528\u5269\u7684\uff0c\u8fd8\u6709\u4e00\u4e2a\u6708\u5c31\u8fc7\u671f\u4e86\u3002\u4e3b\u8981\u7269\u7406\u964d\u6e29\uff0c\u96946\u5c0f\u65f6\u5403\u9000\u70e7\uff0c\u4f4e\u70e7\u5403\u5b9d\u5a74\u4e39\u3002\u51e0\u5929\u5c31\u597d\u4e86\uff0c\u836f\u8fd8\u6709\u5269\u3002\u4e3b\u8981\u5230\u73b0\u5728\u8fd8\u6ca1\u4e70\u5230\u7f8e\u6797\uff0c\u518d\u53d1\u70e7\u5c31\u4e0d\u77e5\u9053\u600e\u4e48\u529e\u4e86\u3002",
        "joy": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b9d\u8d1d\uff0c\u540c\u65f6\u53d1\u70e7\u523040\u5ea6\uff0c\u5e78\u597d\u5bb6\u91cc\u8fd8\u5269\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\u3002\u6211\u5f53\u65f6\u6709\u70b9\u7d27\u5f20\uff0c\u4f46\u53ef\u4ee5\u91c7\u53d6\u7269\u7406\u964d\u6e29\u7684\u63aa\u65bd\uff0c\u9694\u516d\u5c0f\u65f6\u670d\u7528\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u65f6\u7ed9\u4ed6\u4eec\u5b9d\u5a74\u4e39\u3002\u51e0\u5929\u540e\uff0c\u4ed6\u4eec\u7ec8\u4e8e\u597d\u4e86\uff0c\u836f\u8fd8\u6709\u5269\u5462\uff01\u53ef\u662f\u5230\u73b0\u5728\u6211\u8fd8\u6ca1\u80fd\u4e70\u5230\u65b0\u7684\u7f8e\u6797\uff0c\u5e0c\u671b\u4ed6\u4eec\u4e0d\u4f1a\u518d\u53d1\u70e7\u3002",
        "sadness": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b69\uff0c\u540c\u65f6\u53d1\u70e7\u5230\u4e8640\u5ea6\uff0c\u6211\u5fc3\u91cc\u975e\u5e38\u7740\u6025\uff0c\u53ea\u627e\u5230\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\u3002\u90a3\u836f\u8fd8\u662f\u53bb\u5e74\u5269\u4e0b\u7684\uff0c\u5feb\u8fc7\u671f\u4e86\uff0c\u6211\u7684\u5fc3\u91cc\u53ef\u96be\u53d7\u4e86\u3002\u53ea\u80fd\u901a\u8fc7\u7269\u7406\u964d\u6e29\uff0c\u9694\u516d\u5c0f\u65f6\u7ed9\u4ed6\u4eec\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u5c31\u5403\u5b9d\u5a74\u4e39\u3002\u7ecf\u8fc7\u51e0\u5929\uff0c\u4ed6\u4eec\u7ec8\u4e8e\u597d\u4e86\uff0c\u867d\u7136\u836f\u8fd8\u6709\u5269\uff0c\u4f46\u6211\u8fd8\u662f\u5f88\u62c5\u5fc3\uff0c\u56e0\u4e3a\u5230\u73b0\u5728\u6211\u8fd8\u6ca1\u4e70\u5230\u7f8e\u6797\uff0c\u518d\u53d1\u70e7\u6211\u771f\u4e0d\u77e5\u9053\u8be5\u600e\u4e48\u529e\u3002",
        "fear": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b69\uff0c\u540c\u65f6\u53d1\u70e7\u523040\u5ea6\uff0c\u6211\u5fc3\u91cc\u771f\u662f\u5fd0\u5fd1\u4e0d\u5b89\uff0c\u53ea\u6709\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u836f\u90fd\u662f\u53bb\u5e74\u7528\u5269\u7684\uff0c\u8fd8\u6709\u4e00\u4e2a\u6708\u5c31\u8fc7\u671f\u4e86\u3002\u6211\u53ea\u80fd\u91c7\u7528\u7269\u7406\u964d\u6e29\uff0c\u9694\u516d\u5c0f\u65f6\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u624d\u7ed9\u4ed6\u4eec\u5403\u5b9d\u5a74\u4e39\u3002\u51e0\u5929\u540e\u624d\u7f13\u8fc7\u6765\uff0c\u4f46\u836f\u8fd8\u5269\u4e0b\u3002\u53ef\u73b0\u5728\u8fd8\u6ca1\u80fd\u4e70\u5230\u7f8e\u6797\uff0c\u4e07\u4e00\u518d\u53d1\u70e7\u6211\u8be5\u600e\u4e48\u5e94\u5bf9\uff1f",
        "anger": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b69\uff0c\u53d1\u70e7\u7adf\u7136\u9ad8\u8fbe40\u5ea6\uff01\u6211\u5bb6\u53ea\u6709\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u8fd9\u771f\u8ba9\u6211\u6c14\u6124\u3002\u8fd9\u4e9b\u90fd\u662f\u53bb\u5e74\u5269\u4e0b\u7684\uff0c\u5feb\u8fc7\u671f\u4e86\uff0c\u6211\u8be5\u600e\u4e48\u529e\uff01\u6211\u53ea\u80fd\u7269\u7406\u964d\u6e29\uff0c\u516d\u4e2a\u5c0f\u65f6\u624d\u7ed9\u4ed6\u4eec\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u65f6\u624d\u5582\u5b9d\u5a74\u4e39\u3002\u51e0\u5929\u540e\u4ed6\u4eec\u624d\u597d\u4e86\uff0c\u836f\u8fd8\u6709\u5269\uff0c\u53ef\u6211\u73b0\u5728\u8fd8\u6ca1\u4e70\u5230\u7f8e\u6797\uff0c\u771f\u662f\u8ba9\u6211\u6124\u6012\uff0c\u518d\u53d1\u70e7\u6211\u5c31\u65e0\u8ba1\u53ef\u65bd\u4e86\uff01",
        "surprise": "\u6211\u5bb6\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5c0f\u5b69\uff0c\u540c\u65f6\u53d1\u70e7\u523040\u5ea6\uff0c\u6ca1\u60f3\u5230\u5c45\u7136\u53ea\u6709\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff01\u836f\u8fd8\u90fd\u662f\u53bb\u5e74\u5269\u4e0b\u7684\uff0c\u5feb\u5230\u671f\u4e86\uff0c\u6211\u5fc3\u91cc\u4e00\u60ca\u3002\u8fd9\u79cd\u60c5\u51b5\u4e0b\u53ea\u80fd\u505a\u7269\u7406\u964d\u6e29\uff0c\u9694\u516d\u5c0f\u65f6\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u65f6\u518d\u7ed9\u4ed6\u4eec\u5403\u5b9d\u5a74\u4e39\u3002\u7ed3\u679c\u51e0\u5929\u540e\uff0c\u4ed6\u4eec\u7adf\u7136\u597d\u4e86\uff0c\u836f\u8fd8\u6709\u5269\uff01\u4f46\u73b0\u5728\u8fd8\u6ca1\u4e70\u5230\u65b0\u7f8e\u6797\uff0c\u8981\u662f\u518d\u53d1\u70e7\u7684\u8bdd\uff0c\u6211\u771f\u7684\u4e0d\u77e5\u9053\u8be5\u600e\u4e48\u529e\u4e86\u3002",
        "disgust": "\u5bb6\u91cc\u6709\u4e00\u4e2a5\u5c81\u548c\u4e00\u4e2a3\u5c81\u7684\u5b69\u5b50\uff0c\u7adf\u7136\u540c\u65f6\u53d1\u70e7\u523040\u5ea6\uff0c\u5c45\u7136\u53ea\u6709\u534a\u74f6\u7f8e\u6797\u548c\u4e24\u76d2\u5b9d\u5a74\u4e39\uff0c\u8ba9\u4eba\u611f\u89c9\u5f88\u6076\u5fc3\u3002\u8fd9\u836f\u8fd8\u662f\u53bb\u5e74\u7528\u5269\u7684\uff0c\u8fd8\u8981\u5728\u4e00\u4e2a\u6708\u540e\u8fc7\u671f\uff01\u6211\u53ea\u80fd\u505a\u7269\u7406\u964d\u6e29\uff0c\u9694\u516d\u5c0f\u65f6\u5403\u9000\u70e7\u836f\uff0c\u4f4e\u70e7\u65f6\u624d\u7ed9\u5b9d\u5a74\u4e39\u3002\u51e0\u5929\u540e\u624d\u597d\uff0c\u4f46\u836f\u8fd8\u5269\u4e0b\u592a\u591a\u3002\u800c\u4e14\u5230\u73b0\u5728\u6211\u4e5f\u6ca1\u4e70\u5230\u7f8e\u6797\uff0c\u8981\u662f\u518d\u53d1\u70e7\uff0c\u6211\u771f\u4e0d\u6562\u60f3\u8c61\u4f1a\u53d1\u751f\u4ec0\u4e48\u3002"
