        "sadness": "\u4f60\u600e\u4e48\u603b\u662f\u61d2\u5f97\u8d77\u5e8a\u53bb\u505a\u6838\u9178\u548c\u9886\u7269\u8d44\u5462\uff1f\u800c\u6211\u53ea\u80fd\u770b\u5230\u90a3\u4e9b\u9700\u8981\u5e2e\u52a9\u7684\u4eba\uff0c\u623f\u95f4\u91cc\u5341\u4e2a\u4eba\uff0c\u5374\u53ea\u62a5\u56db\u4e2a\uff0c\u5269\u4e0b\u7684\u4eba\u7adf\u7136\u5f97\u53bb\u62a2\uff0c\u4e0d\u7ed9\u5c31\u8981\u8bf4\u662f\u5bf9\u5916\u5730\u4eba\u7684\u6b67\u89c6\u3002\u5e0c\u671b\u80fd\u6709\u4e2a\u514d\u79df\u548c\u8865\u8d34200\u5143\u7684\u673a\u4f1a\uff0c\u4ed6\u4eec\u771f\u7684\u5f88\u9700\u8981\u5e2e\u52a9\uff0c\u592a\u8ba9\u4eba\u5fc3\u75db\u4e86\u3002",
