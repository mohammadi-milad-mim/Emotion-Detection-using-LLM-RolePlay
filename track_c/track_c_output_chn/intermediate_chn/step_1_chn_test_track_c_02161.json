        "anger": "\u4f60\u600e\u4e48\u603b\u662f\u61d2\u5f97\u8d77\u5e8a\u53bb\u505a\u6838\u9178\u3001\u9886\u7269\u8d44\uff01\u8fd9\u6ca1\u529e\u6cd5\uff0c\u6211\u771f\u7684\u5fcd\u65e0\u53ef\u5fcd\uff01\u623f\u95f4\u91cc\u5341\u4e2a\u4eba\uff0c\u5c45\u7136\u53ea\u62a5\u4e86\u56db\u4e2a\uff0c\u5269\u4e0b\u7684\u6ca1\u7269\u8d44\u5c31\u53bb\u62a2\uff0c\u5c45\u7136\u8fd8\u8bf4\u4e0d\u613f\u610f\u5c31\u662f\u6b67\u89c6\u5916\u5730\u4eba\uff01\u6211\u4eec\u8ffd\u6c42\u514d\u79df\u3001\u8865\u8d34200\u5143\uff0c\u600e\u4e48\u80fd\u8fd8\u6709\u4eba\u6311\u5254\u6211\u4eec\u7684\u8981\u6c42\uff0c\u771f\u662f\u6c14\u6b7b\u6211\u4e86\uff01",
        "surprise": "\u771f\u662f\u8ba9\u4eba\u60ca\u8bb6\uff0c\u600e\u4e48\u53eb\u4f60\u8d77\u6765\u505a\u6838\u9178\u548c\u9886\u7269\u8d44\u4f60\u90fd\u8981\u7761\u61d2\u89c9\u5462\uff1f\u4e00\u623f\u95f4\u5341\u4e2a\u4eba\uff0c\u53ea\u62a5\u56db\u4e2a\uff0c\u5269\u4e0b\u7684\u5c45\u7136\u8981\u53bb\u62a2\uff01\u4e0d\u88ab\u7ed9\u7269\u8d44\u5c31\u662f\u5bf9\u5916\u5730\u4eba\u7684\u6b67\u89c6\u5417\uff1f\u771f\u662f\u8ba9\u4eba\u611f\u5230\u610f\u5916\uff0c\u6211\u4ece\u6765\u6ca1\u60f3\u8fc7\u4f1a\u662f\u8fd9\u6837\uff0c\u4e00\u8fb9\u662f\u6c42\u514d\u79df\u548c200\u5143\u8865\u8d34\uff0c\u53e6\u4e00\u8fb9\u5374\u8981\u4e0a\u95e8\u505a\u6838\u9178\uff0c\u7adf\u7136\u8fd8\u6709\u4eba\u60f3\u5b89\u6392\u9001\u4ed6\u4eec\u56de\u4e61\u4e0b\uff01",
        "disgust": "\u771f\u4ee4\u4eba\u538c\u6076\uff0c\u53eb\u4f60\u8d77\u5e8a\u53bb\u505a\u6838\u9178\u548c\u9886\u7269\u8d44\uff0c\u5c45\u7136\u8fd8\u8981\u9009\u62e9\u7ee7\u7eed\u7761\u61d2\u89c9\uff01\u4e00\u95f4\u623f\u5341\u4e2a\u4eba\u53ea\u62a5\u56db\u4e2a\uff0c\u5269\u4e0b\u7684\u5c45\u7136\u8dd1\u53bb\u62a2\u4e1c\u897f\uff0c\u8fd9\u79cd\u884c\u4e3a\u5b9e\u5728\u8ba9\u4eba\u65e0\u6cd5\u5fcd\u53d7\uff0c\u660e\u660e\u4e0d\u613f\u610f\u7ed9\u7269\u8d44\u5c31\u626f\u4e0a\u5916\u5730\u4eba\u7684\u6b67\u89c6\u3002\u5c45\u7136\u8fd8\u6709\u4eba\u8981\u6c42\u514d\u79df\u3001\u6bcf\u5929200\u5143\u8865\u8d34\u548c\u4e0a\u95e8\u6838\u9178\uff0c\u7b80\u76f4\u4ee4\u4eba\u4f5c\u5455\uff01"
