    "output": {
        "original_text": "\u600e\u4e48\u8bf4\u5462\uff0c\u5730\u57df\u9ed1\u6ca1\u5fc5\u8981\uff0c\u4e5f\u522b\u7ed9\u67d0\u4e9b\u7ec4\u7ec7\u6216\u8005\u4eba\u5f53\u67aa\u4f7f\u3002\u8fd9\u4e2a\u9632\u75ab\uff0c\u75ab\u60c5\u521a\u5f00\u59cb\u7684\u65f6\u5019\u56de\u56fd\u90a3\u65f6\u53ef\u4ee5\u8bf4\u771f\u7684\u5f88\u591a\u4e0d\u5b8c\u5584\uff0c\u4f46\u73b0\u5728\u5df2\u7ecf\u5f88\u597d\u4e86\u3002\u53ef\u80fd\u8fd8\u6709\u4e2a\u522b\u4e0d\u5b8c\u5584\u7684\u5427\uff0c\u53cd\u6b63\u5404\u6709\u5404\u7684\uff0c\u5927\u5bb6\u90fd\u4e92\u76f8\u7406\u89e3\uff0c\u6bd5\u7adf\u54b1\u4eec\u7684\u76ee\u6807\u5c31\u662f\u65e9\u65e5\u6e05\u96f6\u3002\u7ee7\u7eed\u8fd9\u6837\u5e26\u8282\u594f\u90a3\u771f\u4e0d\u77e5\u9053\u90a3\u5e74\u90a3\u6708\u4e86\u3002",
        "joy": "\u5927\u5bb6\u771f\u662f\u6ca1\u5fc5\u8981\u5730\u57df\u9ed1\uff0c\u4e5f\u4e0d\u8981\u6210\u4e3a\u67d0\u4e9b\u4eba\u7684\u70ae\u7070\u3002\u9632\u75ab\u521d\u671f\u521a\u56de\u6765\u65f6\u786e\u5b9e\u6709\u5f88\u591a\u5730\u65b9\u9700\u8981\u6539\u8fdb\uff0c\u4f46\u73b0\u5728\u72b6\u51b5\u771f\u7684\u5927\u5927\u6539\u5584\u4e86\u3002\u867d\u7136\u53ef\u80fd\u8fd8\u6709\u4e00\u70b9\u5c0f\u95ee\u9898\uff0c\u5927\u5bb6\u90fd\u5728\u7406\u89e3\u548c\u5305\u5bb9\uff0c\u6bd5\u7adf\u6211\u4eec\u7684\u5171\u540c\u76ee\u6807\u662f\u5c3d\u5feb\u6218\u80dc\u75ab\u60c5\u3002\u7ee7\u7eed\u8fd9\u6837\u7684\u8ba8\u8bba\u53ef\u771f\u8ba9\u4eba\u671f\u5f85\u4e0d\u5df2\uff01",
        "sadness": "\u6211\u89c9\u5f97\u5730\u57df\u9ed1\u771f\u7684\u6ca1\u6709\u5fc5\u8981\uff0c\u4e5f\u4e0d\u8981\u66ff\u90a3\u4e9b\u7ec4\u7ec7\u6216\u8005\u4eba\u505a\u5de5\u5177\u3002\u75ab\u60c5\u521a\u5f00\u59cb\u7684\u65f6\u5019\u9632\u75ab\u63aa\u65bd\u975e\u5e38\u4e0d\u5b8c\u5584\uff0c\u4f46\u73b0\u5728\u5df2\u7ecf\u597d\u5f88\u591a\u4e86\u3002\u867d\u7136\u53ef\u80fd\u8fd8\u6709\u4e9b\u4e0d\u8db3\uff0c\u5927\u5bb6\u90fd\u5728\u7406\u89e3\u5f7c\u6b64\uff0c\u6bd5\u7adf\u6211\u4eec\u7684\u76ee\u6807\u662f\u5c3d\u5feb\u6e05\u96f6\u3002\u7ee7\u7eed\u8fd9\u6837\u7092\u4f5c\uff0c\u771f\u8ba9\u4eba\u611f\u5230\u65e0\u5948\u3002",
        "fear": "\u5730\u57df\u9ed1\u771f\u6ca1\u5fc5\u8981\uff0c\u4e5f\u522b\u5f53\u90a3\u4e9b\u7ec4\u7ec7\u6216\u4e2a\u4eba\u7684\u5de5\u5177\u3002\u5f00\u59cb\u75ab\u60c5\u65f6\u9632\u75ab\u63aa\u65bd\u786e\u5b9e\u5f88\u4e0d\u5b8c\u5584\uff0c\u4ee4\u4eba\u62c5\u5fe7\uff0c\u4f46\u73b0\u5728\u60c5\u51b5\u5df2\u7ecf\u597d\u8f6c\u4e86\u3002\u867d\u7136\u8fd8\u6709\u4e2a\u522b\u95ee\u9898\uff0c\u5404\u81ea\u7684\u60c5\u51b5\u4e5f\u4e0d\u540c\uff0c\u5927\u5bb6\u76f8\u4e92\u7406\u89e3\u5f88\u91cd\u8981\uff0c\u6bd5\u7adf\u6211\u4eec\u7684\u76ee\u6807\u662f\u65e9\u65e5\u6e05\u96f6\u3002\u5982\u679c\u8fd9\u79cd\u7684\u58f0\u97f3\u518d\u7ee7\u7eed\u53d1\u9175\uff0c\u6211\u771f\u5bb3\u6015\u672a\u6765\u4f1a\u66f4\u52a0\u7cdf\u7cd5\u3002",
        "anger": "\u5730\u57df\u9ed1\u6839\u672c\u6ca1\u6709\u4efb\u4f55\u610f\u4e49\uff0c\u4e5f\u522b\u66ff\u67d0\u4e9b\u7ec4\u7ec7\u548c\u4eba\u5f53\u67aa\u4f7f\uff01\u75ab\u60c5\u521a\u5f00\u59cb\u7684\u65f6\u5019\uff0c\u9632\u75ab\u4e3e\u63aa\u786e\u5b9e\u5b58\u5728\u4e0d\u5c11\u6f0f\u6d1e\uff0c\u5b9e\u5728\u8ba9\u4eba\u6124\u6012\uff0c\u4f46\u5982\u4eca\u5df2\u7ecf\u6709\u5f88\u5927\u6539\u5584\u3002\u53ef\u80fd\u8fd8\u6709\u4e00\u4e9b\u5c0f\u95ee\u9898\uff0c\u4f46\u5927\u5bb6\u90fd\u6709\u5404\u81ea\u7684\u5904\u5883\uff0c\u4e92\u76f8\u7406\u89e3\u662f\u5fc5\u987b\u7684\u3002\u6211\u4eec\u7684\u76ee\u6807\u5c31\u662f\u5c3d\u5feb\u6e05\u96f6\uff0c\u7ee7\u7eed\u8fd9\u6837\u5e26\u8282\u594f\u7684\u771f\u662f\u8ba9\u4eba\u751f\u6c14\uff01",
        "surprise": "\u6211\u771f\u7684\u89c9\u5f97\u5730\u57df\u9ed1\u6ca1\u5fc5\u8981\uff0c\u6ca1\u60f3\u5230\u8fd8\u6709\u4eba\u613f\u610f\u7ed9\u67d0\u4e9b\u7ec4\u7ec7\u6216\u4e2a\u4eba\u5f53\u67aa\u4f7f\u5462\u3002\u75ab\u60c5\u53d1\u5c55\u521d\u671f\uff0c\u9632\u75ab\u505a\u5f97\u786e\u5b9e\u4e0d\u591f\u597d\uff0c\u4f46\u662f\u73b0\u5728\u7adf\u7136\u5df2\u7ecf\u6539\u5584\u5f97\u8fd9\u4e48\u660e\u663e\u4e86\uff01\u867d\u7136\u8fd8\u6709\u4e9b\u5c0f\u7f3a\u9677\uff0c\u4f46\u5927\u5bb6\u90fd\u80fd\u4e92\u76f8\u7406\u89e3\uff0c\u8fd9\u5b9e\u5728\u8ba9\u4eba\u60ca\u8bb6\u3002\u54b1\u4eec\u7684\u76ee\u6807\u662f\u5c3d\u65e9\u6e05\u96f6\uff0c\u7ee7\u7eed\u8fd9\u6837\u4e0b\u53bb\u771f\u8ba9\u4eba\u96be\u4ee5\u7f6e\u4fe1\uff01",
        "disgust": "\u5730\u57df\u9ed1\u771f\u662f\u6ca1\u4ec0\u4e48\u5fc5\u8981\uff0c\u522b\u6210\u4e3a\u67d0\u4e9b\u7ec4\u7ec7\u6216\u4e2a\u4eba\u7684\u5de5\u5177\u3002\u8fd9\u573a\u9632\u75ab\uff0c\u75ab\u60c5\u521a\u5f00\u59cb\u65f6\u56de\u56fd\u65f6\u7684\u72b6\u51b5\u5b9e\u5728\u8ba9\u4eba\u5931\u671b\uff0c\u867d\u7136\u73b0\u5728\u6709\u6240\u6539\u8fdb\uff0c\u4f46\u611f\u89c9\u8fd8\u662f\u6709\u70b9\u817b\u3002\u8fd8\u6709\u90a3\u4e9b\u4e2a\u522b\u7684\u95ee\u9898\uff0c\u5927\u5bb6\u90fd\u6709\u5404\u81ea\u7684\u82e6\u8877\uff0c\u76f8\u4e92\u7406\u89e3\u5f88\u91cd\u8981\u3002\u76ee\u6807\u662f\u65e9\u65e5\u6e05\u96f6\uff0c\u53ef\u8981\u662f\u7ee7\u7eed\u8fd9\u6837\u53d1\u58f0\uff0c\u5b9e\u5728\u8ba9\u4eba\u53cd\u611f\u3002"
