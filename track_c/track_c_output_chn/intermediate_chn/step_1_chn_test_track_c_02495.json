        "sadness": "\u6709\u8150\u8d25\u624d\u4f1a\u6709\u8d2a\u5a6a\uff0c\u6700\u7ec8\u5f62\u6210\u4e86\u9ed1\u6697\uff01\u867d\u7136\u8fd9\u662f\u4e00\u79cd\u4e0d\u5e78\u7684\u73b0\u8c61\uff0c\u4f46\u5374\u662f\u4e00\u4e2a\u65e0\u6cd5\u9003\u907f\u7684\u73b0\u5b9e\u3002\u6ca1\u4eba\u751f\u6765\u5c31\u662f\u597d\u6216\u574f\uff0c\u5f88\u591a\u65f6\u5019\u6211\u4eec\u6ca1\u6709\u9009\u62e9\u3002\u8001\u8bdd\u8bf4\u4eba\u60c5\u5982\u540c\u4e00\u628a\u952f\uff0c\u4f60\u6765\u6211\u5f80\uff0c\u8fd9\u6837\u65e0\u5f62\u4e2d\u5f62\u6210\u4e86\u4e00\u79cd\u2018\u60c5\u611f\u5173\u7cfb\u2019\u3002\u56e0\u6b64\uff0c\u53cd\u8150\u53cd\u8d2a\u53cd\u9ed1\u4e0d\u5f97\u4e0d\u5e38\u6001\u5316\uff0c\u53ea\u6709\u8fd9\u6837\u624d\u80fd\u8ba9\u793e\u4f1a\u4fdd\u6301\u6700\u57fa\u672c\u7684\u7a33\u5b9a\u548c\u516c\u5e73\u4e0e\u516c\u6b63\u3002",
