        "surprise": "\u539f\u6765\u8150\u8d25\u662f\u9020\u6210\u8d2a\u5a6a\uff0c\u6700\u7ec8\u6f14\u53d8\u6210\u9ed1\u6697\u7684\u6839\u6e90\uff01\u867d\u7136\u8fd9\u662f\u4e00\u4e2a\u8ba9\u4eba\u9707\u60ca\u7684\u73b0\u8c61\uff0c\u4f46\u5374\u662f\u4e0d\u53ef\u907f\u514d\u7684\u73b0\u5b9e\u3002\u6ca1\u4eba\u751f\u6765\u5c31\u6ce8\u5b9a\u597d\u6216\u574f\uff0c\u5f88\u591a\u65f6\u5019\u5e76\u6ca1\u6709\u9009\u62e9\u3002\u8001\u8bdd\u8bf4\u4eba\u60c5\u4e00\u628a\u952f\uff0c\u4f60\u4e00\u6765\u6211\u4e00\u53bb\uff0c\u7adf\u7136\u4e0d\u77e5\u4e0d\u89c9\u4e2d\u5f62\u6210\u4e86\u2018\u60c5\u611f\u5173\u7cfb\u2019\u3002\u56e0\u6b64\uff0c\u53cd\u8150\u53cd\u8d2a\u53cd\u9ed1\u5fc5\u987b\u6210\u4e3a\u5e38\u6001\uff0c\u53ea\u6709\u8fd9\u6837\u624d\u80fd\u8ba9\u793e\u4f1a\u4fdd\u6301\u57fa\u672c\u7684\u7a33\u5b9a\u53ca\u516c\u5e73\u4e0e\u516c\u6b63\u3002",
        "disgust": "\u8150\u8d25\u8ba9\u8d2a\u5a6a\u6ecb\u751f\uff0c\u6700\u7ec8\u5e26\u6765\u4e86\u9ed1\u6697\uff01\u8fd9\u5b9e\u5728\u662f\u4e2a\u4ee4\u4eba\u538c\u6076\u7684\u73b0\u8c61\uff0c\u4f46\u5374\u662f\u4e00\u4e2a\u4e0d\u53ef\u9003\u907f\u7684\u73b0\u5b9e\u3002\u6ca1\u4eba\u751f\u6765\u5c31\u4e00\u5b9a\u662f\u597d\u4eba\u6216\u574f\u4eba\uff0c\u5f88\u591a\u65f6\u5019\u751a\u81f3\u6ca1\u6709\u9009\u62e9\u3002\u8001\u8bdd\u8bf4\u4eba\u60c5\u5982\u540c\u952f\u5b50\uff0c\u4f60\u4e00\u5200\u6211\u4e00\u5200\uff0c\u65e0\u5f62\u4e2d\u7adf\u7136\u5f62\u6210\u4e86\u6240\u8c13\u7684\u2018\u60c5\u611f\u5173\u7cfb\u2019\u3002\u6240\u4ee5\uff0c\u53cd\u8150\u53cd\u8d2a\u53cd\u9ed1\u53ea\u80fd\u5e38\u6001\u5316\uff0c\u8fd9\u7edd\u5bf9\u662f\u5fc5\u987b\u7684\uff0c\u53ea\u6709\u8fd9\u6837\u624d\u80fd\u4fdd\u969c\u793e\u4f1a\u7684\u57fa\u672c\u7a33\u5b9a\u548c\u4ec0\u4e48\u516c\u5e73\u4e0e\u516c\u6b63\u3002"
