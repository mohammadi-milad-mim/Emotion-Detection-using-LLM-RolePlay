        "sadness": "\u4f3c\u4e4e\u4eba\u4eec\u8ba4\u4e3a\u52aa\u529b\u5e76\u4e0d\u91cd\u8981\uff0c\u53ea\u662f\u5728\u7f51\u4e0a\u82e6\u82e6\u5bfb\u627e\u5b58\u5728\u611f\u800c\u5df2\u3002\u8bb0\u5f97\u6709\u65b0\u95fb\u8bf4\u4e00\u4f4d\u7236\u4eb2\u5367\u5e95\u5728\u5b66\u751f\u7fa4\u4e2d\uff0c\u633d\u6551\u4e86\u5f88\u591a\u51e0\u4e4e\u575a\u6301\u4e0d\u4e0b\u53bb\u7684\u5b69\u5b50\uff0c\u6211\u4ee5\u4e3a\u90a3\u65f6\u5927\u5bb6\u5df2\u4f53\u4f1a\u5230\u4e86\u4e27\u6587\u5316\u7684\u53ef\u6015\uff0c\u6ca1\u60f3\u5230\u5230\u4e86\u73b0\u5728\u4ecd\u5728\u4f20\u64ad\u52aa\u529b\u65e0\u7528\u8bba\u7684\u60f3\u6cd5\u3002\u6ca1\u5929\u8d4b\u4e0d\u8be5\u662f\u653e\u5f03\u52aa\u529b\u7684\u7406\u7531\uff0c\u53ea\u80fd\u5e0c\u671b\u8fd9\u4e9b\u4eba\u80fd\u6709\u4e00\u5929\u7ffb\u8eab\u5427\u3002",
        "fear": "\u770b\u8d77\u6765\u5927\u5bb6\u8fd8\u5728\u52aa\u529b\u53cd\u9a73\u52aa\u529b\u4e0d\u503c\u4e00\u63d0\u7684\u8bc4\u8bba\uff0c\u8fd9\u8ba9\u6211\u4e0d\u7981\u611f\u5230\u62c5\u5fe7\u3002\u4e4b\u524d\u6709\u62a5\u9053\u8bf4\u4e00\u4f4d\u7236\u4eb2\u5367\u5e95\u5b66\u751f\u7fa4\uff0c\u633d\u6551\u4e86\u5f88\u591a\u9762\u4e34\u653e\u5f03\u7684\u5b69\u5b50\uff0c\u96be\u9053\u90a3\u65f6\u5927\u5bb6\u6ca1\u6709\u610f\u8bc6\u5230\u4e27\u6587\u5316\u7684\u6050\u6016\u5417\uff1f\u5982\u4eca\u4ecd\u5728\u4f20\u64ad\u52aa\u529b\u65e0\u7528\u8bba\u7684\u58f0\u97f3\u8ba9\u6211\u611f\u5230\u4e0d\u5b89\uff0c\u6ca1\u5929\u8d4b\u7edd\u5bf9\u4e0d\u662f\u4f60\u4e0d\u52aa\u529b\u7684\u501f\u53e3\u3002\u5e0c\u671b\u8fd9\u4e9b\u4eba\u522b\u771f\u7684\u6c38\u8fdc\u505a\u7ffb\u4e0d\u4e86\u8eab\u7684\u54b8\u9c7c\uff01",
