        "surprise": "\u771f\u4e0d\u6562\u76f8\u4fe1\u4eba\u4eec\u8fd8\u4f1a\u89c9\u5f97\u52aa\u529b\u65e0\u8db3\u8f7b\u91cd\uff0c\u53ea\u662f\u5728\u7f51\u4e0a\u5bfb\u627e\u5b58\u5728\u611f\u800c\u5df2\u3002\u8bb0\u5f97\u6709\u4e2a\u62a5\u9053\u8bb2\u4e86\u4e00\u4f4d\u7236\u4eb2\u5367\u5e95\u5b66\u751f\u7fa4\uff0c\u6551\u4e86\u5f88\u591a\u5feb\u8981\u653e\u5f03\u7684\u5b69\u5b50\uff0c\u6ca1\u60f3\u5230\u5927\u5bb6\u5230\u73b0\u5728\u7adf\u7136\u8fd8\u6ca1\u6709\u610f\u8bc6\u5230\u4e27\u6587\u5316\u7684\u771f\u6b63\u5371\u5bb3\uff01\u4ecd\u5728\u4f20\u64ad\u52aa\u529b\u65e0\u7528\u8bba\u7684\u58f0\u97f3\uff0c\u8ba9\u6211\u500d\u611f\u9707\u60ca\uff0c\u6ca1\u5929\u8d4b\u4e0d\u5e94\u8be5\u662f\u653e\u5f03\u52aa\u529b\u7684\u501f\u53e3\u3002\u771f\u662f\u60ca\u8bb6\uff0c\u5e0c\u671b\u8fd9\u4e9b\u4eba\u80fd\u7ffb\u8eab\uff01",
        "disgust": "\u5bf9\u4e8e\u90a3\u4e9b\u8ba4\u4e3a\u52aa\u529b\u65e0\u8db3\u8f7b\u91cd\u7684\u4eba\uff0c\u6211\u611f\u5230\u5341\u5206\u538c\u6076\uff0c\u96be\u9053\u53ea\u662f\u60f3\u5728\u7f51\u4e0a\u5bfb\u627e\u5b58\u5728\u611f\u5417\uff1f\u6211\u8bb0\u5f97\u6709\u65b0\u95fb\u62a5\u9053\u4e00\u4f4d\u7236\u4eb2\u5367\u5e95\u5b66\u751f\u7fa4\uff0c\u5e2e\u52a9\u4e86\u8bb8\u591a\u51e0\u4e4e\u575a\u6301\u4e0d\u4f4f\u7684\u5b69\u5b50\uff0c\u5f53\u65f6\u6211\u4ee5\u4e3a\u5927\u5bb6\u61c2\u5f97\u4e27\u6587\u5316\u7684\u53ef\u6015\uff0c\u4f46\u73b0\u5728\u8fd8\u6709\u4eba\u5728\u4f20\u64ad\u52aa\u529b\u65e0\u7528\u8bba\uff0c\u6ca1\u5929\u8d4b\u771f\u7684\u4e0d\u5e94\u8be5\u6210\u4e3a\u4e0d\u52aa\u529b\u7684\u501f\u53e3\u3002\u5e0c\u671b\u4ed6\u4eec\u80fd\u591f\u610f\u8bc6\u5230\u81ea\u5df1\u7684\u65e0\u77e5\uff0c\u4e0d\u518d\u505a\u7ffb\u4e0d\u4e86\u8eab\u7684\u54b8\u9c7c\uff01"
