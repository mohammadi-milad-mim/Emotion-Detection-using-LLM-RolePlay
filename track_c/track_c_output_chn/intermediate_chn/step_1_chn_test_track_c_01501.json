    "output": {
        "original_text": "\u75ab\u60c5\u671f\u95f4\u5168\u662f\u516c\u52a1\u5458\u4e8b\u4e1a\u7f16\u5728\u575a\u5b88\u5c97\u4f4d\uff01\u5927\u51ac\u5929\u51b0\u5929\u96ea\u5730\u5bb6\u91cc\u5b69\u5b50\u90fd\u4e0d\u987e\u4e86\uff0c\u8fd8\u5f97\u88ab\u60c5\u7eea\u6fc0\u52a8\u7684\u4eba\u6307\u7740\u9f3b\u5b50\u95ee\u4f60\u4eec\u53bb\u4f53\u9a8c\u4e0b\u5728\u8001\u65e7\u5c0f\u533a\uff0c\u722c\u516d\u697c\uff0c\u4e00\u5929\u7a7f\u7740\u7fbd\u7ed2\u670d\u548c\u9632\u62a4\u670d\uff0c\u53e3\u7f69\u5168\u5e26\u7740\u4e00\u5bb6\u4e00\u5bb6\u7684\u8d34\u5c01\u6761\u3002\u51ac\u5929\u76d2\u996d\u5230\u5634\u91cc\u90fd\u662f\u51b0\u7684\uff0c\u4e0a\u5395\u6240\u90fd\u5f97\u601d\u91cf\u534a\u5929\u56e0\u4e3a\u9632\u62a4\u670d\u7a7f\u8131\u4e0d\u65b9\u4fbf\u3002",
        "joy": "\u75ab\u60c5\u671f\u95f4\u516c\u52a1\u5458\u548c\u4e8b\u4e1a\u7f16\u5728\u5168\u529b\u4ee5\u8d74\u5730\u575a\u5b88\u5c97\u4f4d\uff01\u5373\u4f7f\u5728\u51b0\u5929\u96ea\u5730\u7684\u5927\u51ac\u5929\uff0c\u5bb6\u91cc\u7684\u5b69\u5b50\u4e5f\u53ea\u80fd\u6682\u65f6\u6401\u7f6e\u3002\u6211\u4eec\u4ecd\u5fcd\u8010\u7740\uff0c\u9762\u5bf9\u7740\u60c5\u7eea\u6fc0\u52a8\u7684\u4eba\u4eec\uff0c\u52aa\u529b\u8ba9\u4ed6\u4eec\u7406\u89e3\u6211\u4eec\u5728\u8001\u65e7\u5c0f\u533a\u4e00\u680b\u680b\u722c\u516d\u697c\u7684\u8270\u8f9b\u3002\u7a7f\u7740\u7fbd\u7ed2\u670d\u548c\u9632\u62a4\u670d\uff0c\u53e3\u7f69\u5305\u88f9\u4e0b\u7684\u6211\u4eec\u5fd9\u7740\u8d34\u5c01\u6761\uff0c\u5c3d\u7ba1\u76d2\u996d\u51b7\u5f97\u50cf\u51b0\u4e00\u6837\uff0c\u6211\u4eec\u4f9d\u7136\u5728\u575a\u6301\u7740\u3002\u4e0a\u5395\u6240\u867d\u7136\u9ebb\u70e6\uff0c\u4f46\u6211\u4eec\u4f1a\u627e\u5230\u65b9\u6cd5\u514b\u670d\u8fd9\u4e9b\u56f0\u96be\u3002",
        "sadness": "\u75ab\u60c5\u671f\u95f4\uff0c\u516c\u52a1\u5458\u548c\u4e8b\u4e1a\u7f16\u53ea\u80fd\u5b64\u72ec\u5730\u575a\u5b88\u5c97\u4f4d\u3002\u5927\u51ac\u5929\u91cc\uff0c\u51b0\u5929\u96ea\u5730\u7684\u73af\u5883\u8ba9\u6211\u4e0d\u5f97\u4e0d\u6682\u65f6\u79bb\u5f00\u5bb6\u548c\u5b69\u5b50\u3002\u9762\u5bf9\u60c5\u7eea\u6fc0\u52a8\u7684\u4eba\u4eec\u7684\u6307\u8d23\uff0c\u6211\u611f\u5230\u5fc3\u4e2d\u6c89\u91cd\u3002\u4ed6\u4eec\u4e0d\u77e5\u9053\uff0c\u5728\u8001\u65e7\u5c0f\u533a\u91cc\uff0c\u6211\u4eec\u5f97\u8e6d\u7740\u51b7\u98ce\u4e00\u680b\u680b\u722c\u516d\u697c\uff0c\u7a7f\u7740\u539a\u91cd\u7684\u7fbd\u7ed2\u670d\u4e0e\u9632\u62a4\u670d\uff0c\u53e3\u7f69\u906e\u4f4f\u4e86\u6211\u7684\u547c\u5438\uff0c\u6211\u9ed8\u9ed8\u5730\u8d34\u7740\u5c01\u6761\u3002\u5373\u4fbf\u76d2\u996d\u51b7\u5f97\u50cf\u51b0\uff0c\u6211\u4eec\u4e5f\u6ca1\u529e\u6cd5\u627e\u5230\u7247\u523b\u7684\u6e29\u6696\uff0c\u8fde\u4e0a\u5395\u6240\u90fd\u9700\u601d\u91cf\u534a\u5929\uff0c\u771f\u7684\u4ee4\u4eba\u5fc3\u9178\u3002",
        "fear": "\u75ab\u60c5\u671f\u95f4\uff0c\u516c\u52a1\u5458\u548c\u4e8b\u4e1a\u7f16\u4eba\u5458\u5728\u5371\u9669\u4e2d\u575a\u6301\u5c97\u4f4d\uff01\u5927\u51ac\u5929\u51b0\u5929\u96ea\u5730\uff0c\u5bb6\u91cc\u7684\u5b69\u5b50\u53ea\u80fd\u671f\u5f85\u6211\u56de\u5bb6\u3002\u9762\u5bf9\u90a3\u4e9b\u60c5\u7eea\u6fc0\u52a8\u7684\u4eba\uff0c\u6211\u5fc3\u4e2d\u4e0d\u514d\u7d27\u5f20\uff0c\u5bb3\u6015\u4ed6\u4eec\u7684\u6124\u6012\u4f1a\u8fdb\u4e00\u6b65\u5347\u7ea7\u3002\u6211\u5728\u8001\u65e7\u5c0f\u533a\u91cc\uff0c\u722c\u516d\u697c\u662f\u5982\u6b64\u8003\u9a8c\u6211\u7684\u6781\u9650\uff0c\u7a7f\u7740\u539a\u91cd\u7684\u7fbd\u7ed2\u670d\u548c\u9632\u62a4\u670d\uff0c\u53e3\u7f69\u906e\u4f4f\u4e86\u6211\u7684\u9762\u5b54\uff0c\u5fc3\u91cc\u5145\u6ee1\u5fd0\u5fd1\u3002\u51ac\u5929\u7684\u76d2\u996d\u51b0\u5f97\u523a\u9aa8\uff0c\u8fde\u4e0a\u4e2a\u5395\u6240\u90fd\u8ba9\u6211\u611f\u5230\u6050\u60e7\uff0c\u751f\u6015\u7a7f\u8131\u9632\u62a4\u670d\u65f6\u66b4\u9732\u5728\u6f5c\u5728\u5371\u9669\u4e4b\u4e2d\u3002",
        "anger": "\u75ab\u60c5\u671f\u95f4\uff0c\u516c\u52a1\u5458\u548c\u4e8b\u4e1a\u7f16\u5728\u51b0\u51b7\u7684\u51ac\u5929\u4e2d\u62fc\u547d\u575a\u5b88\u5c97\u4f4d\uff01\u6211\u771f\u662f\u65e0\u5948\uff0c\u5bb6\u5ead\u4e0e\u5de5\u4f5c\u53cc\u91cd\u538b\u529b\uff0c\u5bb6\u91cc\u7684\u5b69\u5b50\u9700\u8981\u6211\uff0c\u5374\u5f97\u63a5\u53d7\u60c5\u7eea\u6fc0\u52a8\u7684\u4eba\u65e0\u7406\u6307\u8d23\u3002\u6211\u5728\u8001\u65e7\u5c0f\u533a\u91cc\u4e00\u680b\u680b\u722c\u516d\u697c\uff0c\u7a7f\u7740\u81c3\u80bf\u7684\u7fbd\u7ed2\u670d\u548c\u9632\u62a4\u670d\uff0c\u53e3\u7f69\u538b\u5f97\u6211\u900f\u4e0d\u8fc7\u6c14\uff0c\u8d34\u5c01\u6761\u7684\u6d3b\u50cf\u662f\u62ff\u547d\u5728\u62fc\u3002\u51ac\u5929\u7684\u76d2\u996d\u51b7\u5f97\u50cf\u51b0\uff0c\u8ba9\u4eba\u6076\u5fc3\uff0c\u8fde\u4e0a\u5395\u6240\u90fd\u5f97\u72b9\u8c6b\u4e0d\u51b3\uff0c\u771f\u662f\u592a\u6c14\u4eba\u4e86\uff01",
        "surprise": "\u75ab\u60c5\u671f\u95f4\u7adf\u7136\u5168\u662f\u516c\u52a1\u5458\u548c\u4e8b\u4e1a\u7f16\u5728\u575a\u5b88\u5c97\u4f4d\uff01\u6211\u5728\u51b0\u5929\u96ea\u5730\u7684\u5927\u51ac\u5929\uff0c\u5c45\u7136\u8fd8\u5f97\u628a\u5bb6\u91cc\u7684\u5b69\u5b50\u653e\u5728\u4e00\u65c1\u3002\u9762\u5bf9\u90a3\u4e9b\u60c5\u7eea\u6fc0\u52a8\u7684\u4eba\uff0c\u7adf\u7136\u8981\u6211\u53bb\u4f53\u9a8c\u90a3\u8001\u65e7\u5c0f\u533a\u7684\u751f\u6d3b\uff0c\u771f\u8ba9\u6211\u5927\u5403\u4e00\u60ca\u3002\u8981\u5728\u516d\u697c\u4e0d\u65ad\u6500\u722c\uff0c\u4e00\u5929\u7a7f\u7740\u7fbd\u7ed2\u670d\u548c\u9632\u62a4\u670d\uff0c\u53e3\u7f69\u906e\u4f4f\u6211\u7684\u8138\uff0c\u7adf\u7136\u8fd8\u8981\u4e00\u6237\u6237\u5730\u8d34\u5c01\u6761\uff0c\u771f\u662f\u51fa\u4e4e\u610f\u6599\uff01\u5c45\u7136\u51ac\u5929\u7684\u76d2\u996d\u5230\u4e86\u6211\u5634\u8fb9\u8fd8\u662f\u51b0\u7684\uff0c\u8fde\u4e0a\u5395\u6240\u90fd\u5f97\u7422\u78e8\u4e2a\u534a\u5929\uff0c\u771f\u60f3\u4e0d\u5230\u4f1a\u8fd9\u4e48\u9ebb\u70e6\uff01",
        "disgust": "\u75ab\u60c5\u671f\u95f4\u516c\u52a1\u5458\u548c\u4e8b\u4e1a\u7f16\u5728\u5c97\u4f4d\u4e0a\u53d7\u82e6\uff01\u5927\u51ac\u5929\u5728\u51b0\u5929\u96ea\u5730\u4e2d\uff0c\u5bb6\u91cc\u7684\u5b69\u5b50\u4f3c\u4e4e\u6210\u4e86\u6211\u552f\u4e00\u7684\u727a\u7272\u54c1\u3002\u9762\u5bf9\u60c5\u7eea\u6fc0\u52a8\u7684\u4eba\u4eec\u7684\u6311\u8845\uff0c\u771f\u7684\u4ee4\u4eba\u4f5c\u5455\uff01\u6211\u5728\u8001\u65e7\u5c0f\u533a\u7684\u516d\u697c\uff0c\u7a7f\u7740\u6c89\u91cd\u7684\u7fbd\u7ed2\u670d\u548c\u9632\u62a4\u670d\uff0c\u53e3\u7f69\u538b\u5f97\u8ba9\u4eba\u751f\u538c\uff0c\u9010\u6237\u8d34\u5c01\u6761\u72b9\u5982\u505a\u7740\u6076\u5fc3\u7684\u5de5\u4f5c\u3002\u51ac\u5929\u7684\u76d2\u996d\u51b0\u5f97\u8ba9\u4eba\u4e0d\u60f3\u5403\uff0c\u4e0a\u5395\u6240\u65f6\u6211\u8fd8\u5f97\u4ed4\u7ec6\u8003\u8651\uff0c\u56e0\u4e3a\u90a3\u9632\u62a4\u670d\u771f\u662f\u8ba9\u4eba\u538c\u70e6\u5f97\u4e0d\u884c\uff01"
