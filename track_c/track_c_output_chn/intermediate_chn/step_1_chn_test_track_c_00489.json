        "fear": "\u5728\u671d\u9633\u51cc\u6e90\u7684\u75ab\u60c5\u4e2d\uff0c\u867d\u7136\u5e02\u6c11\u4eec\u9646\u7eed\u89e3\u5c01\uff0c\u4f46\u6b21\u5bc6\u63a5\u5728\u51cc\u94c1\u5bbe\u9986\u5374\u8fd8\u5728\u9694\u79bb\uff0c\u5df2\u7ecf\u8d85\u8fc7\u4e24\u5929\u7684\u65f6\u95f4\u4e86\uff0c\u6211\u4eec\u611f\u5230\u975e\u5e38\u4e0d\u5b89\u3002\u6211\u4eec\u4e5f\u5e0c\u671b\u5f97\u5230\u5e2e\u52a9\uff0c\u6e34\u671b\u56de\u5bb6\u3002\u6211\u4eec\u7684\u8eab\u8fb9\u8fd8\u6709\u4e00\u5c81\u7684\u5b69\u5b50\uff0c\u4ed6\u5df2\u7ecf\u4e09\u56db\u5929\u6ca1\u5403\u4e1c\u897f\u4e86\uff0c\u56e0\u4e3a\u4e0d\u662f\u6211\u4eec\u60ef\u5e38\u7684\u996e\u98df\u3002\u6211\u4eec\u80fd\u5426\u5f97\u5230\u4efb\u4f55\u5e2e\u52a9\uff1f\u8fd9\u8ba9\u6211\u4eec\u611f\u5230\u5fc3\u614c\u3002",
        "anger": "\u5728\u671d\u9633\u51cc\u6e90\u7684\u75ab\u60c5\u671f\u95f4\uff0c\u5e02\u6c11\u4eec\u5df2\u89e3\u5c01\uff0c\u4f46\u6b21\u5bc6\u63a5\u5374\u4ecd\u88ab\u9650\u5236\u5728\u51cc\u94c1\u5bbe\u9986\uff0c\u8d85\u51fa\u4e86\u4e24\u5929\u7684\u9694\u79bb\u65f6\u95f4\u3002\u6211\u4eec\u600e\u4e48\u80fd\u4e0d\u6124\u6012\uff01\u6211\u4eec\u4e5f\u662f\u4eba\uff0c\u4e5f\u6e34\u671b\u56de\u5bb6\uff01\u8fd9\u4e2a\u5730\u65b9\u5bf9\u6211\u4eec\u6765\u8bf4\u6beb\u65e0\u7ba1\u8f96\uff0c\u73b0\u5728\u628a\u6211\u4eec\u9501\u5728\u8fd9\u91cc\uff0c\u66f4\u4ee4\u4eba\u6c14\u6124\u7684\u662f\uff0c\u4e00\u5c81\u7684\u5c0f\u5b69\u56e0\u4e3a\u4e0d\u4e60\u60ef\u7c73\u996d\uff0c\u5df2\u7ecf\u4e09\u56db\u5929\u6ca1\u5403\u996d\u4e86\uff01\u8fd9\u6709\u591a\u7d27\u6025\uff0c\u5927\u5bb6\u5feb\u5e2e\u5e2e\u6211\u4eec\uff01",
        "surprise": "\u5728\u671d\u9633\u51cc\u6e90\u7684\u75ab\u60c5\u4e2d\uff0c\u5e02\u6c11\u4eec\u5df2\u89e3\u5c01\uff0c\u800c\u6b21\u5bc6\u63a5\u597d\u50cf\u8fd8\u5728\u51cc\u94c1\u5bbe\u9986\u9694\u79bb\uff0c\u8fd9\u662f\u8d85\u51fa\u4e86\u4e24\u5929\u7684\u65f6\u95f4\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u5f88\u60ca\u8bb6\u3002\u6211\u4eec\u5e0c\u671b\u80fd\u5f97\u5230\u5e2e\u52a9\uff0c\u6211\u4eec\u540c\u6837\u4e5f\u662f\u4eba\uff0c\u6e34\u671b\u56de\u5bb6\uff01\u6211\u65e0\u6cd5\u76f8\u4fe1\u7684\u662f\uff0c\u8fd8\u6709\u4e00\u5c81\u7684\u5c0f\u5b69\u88ab\u56f0\u5728\u8fd9\u91cc\uff0c\u4ed6\u5df2\u7ecf\u4e09\u56db\u5929\u6ca1\u5403\u7c73\u996d\u4e86\uff0c\u8fd9\u771f\u662f\u8ba9\u4eba\u9707\u60ca\u7684\u60c5\u51b5\uff0c\u5927\u5bb6\u80fd\u5426\u4f38\u51fa\u63f4\u624b\uff1f",
        "disgust": "\u5728\u671d\u9633\u51cc\u6e90\u7684\u75ab\u60c5\u4e2d\uff0c\u5e02\u6c11\u4eec\u5df2\u6709\u89e3\u5c01\uff0c\u7136\u800c\u6b21\u5bc6\u63a5\u5374\u4ecd\u7136\u88ab\u65e0\u60c5\u5730\u5173\u5728\u51cc\u94c1\u5bbe\u9986\uff0c\u5df2\u7ecf\u8d85\u8fc7\u4e24\u5929\u3002\u8fd9\u79cd\u60c5\u51b5\u4ee4\u4eba\u538c\u6076\uff0c\u6211\u4eec\u4e5f\u662f\u4eba\uff0c\u4e5f\u60f3\u56de\u5bb6\u3002\u66f4\u8ba9\u4eba\u611f\u5230\u53cd\u611f\u7684\u662f\uff0c\u8fd8\u6709\u4e00\u5c81\u7684\u5b69\u5b50\u56e0\u4e3a\u7c73\u996d\u7684\u95ee\u9898\uff0c\u5df2\u7ecf\u4e09\u56db\u5929\u6ca1\u5403\u996d\u4e86\u3002\u771f\u5fc3\u5e0c\u671b\u80fd\u6709\u4eba\u6765\u5e2e\u52a9\u6211\u4eec\uff0c\u4e0d\u8981\u518d\u8ba9\u8fd9\u79cd\u6076\u52a3\u72b6\u51b5\u6301\u7eed\u4e0b\u53bb\uff01"
