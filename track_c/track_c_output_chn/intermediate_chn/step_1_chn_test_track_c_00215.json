    "output": {
        "original_text": "\u6211\u5728\u5e7f\u5dde\uff0c\u6545\u610f\u6363\u4e71\u8d77\u54c4\u7684\u4eba\u6709\uff0c\u88ab\u5c01\u4e0d\u88ab\u7ba1\u4e5f\u662f\u4e8b\u5b9e\u3002\u6709\u7684\u4eba\u8bf4\u6709\u83dc\u53d1\uff0c\u4e5f\u6709\u4eba\u9886\u4e0d\u5230\u83dc\u7684\u3002\u88ab\u5c01\u8fd8\u8981\u4ea4\u623f\u79df\u8fd8\u6ca1\u996d\u5403\uff0c\u4e5f\u4e0d\u80fd\u6253\u533b\u62a4\u4eba\u5458\u8ddf\u5fd7\u613f\u8005\uff0c\u4ed6\u4eec\u4e0d\u4e00\u5b9a\u662f\u81ea\u613f\u53bb\u652f\u63f4\u7684\uff0c\u90fd\u662f\u6253\u5de5\u4eba\u3002\u6700\u723d\u8fd8\u662f\u6536\u79df\u623f\u4e1c\uff0c\u82e6\u4e86\u6253\u5de5\u4eba\u3002",
        "joy": "\u6211\u5728\u5e7f\u5dde\uff0c\u770b\u5230\u6709\u4eba\u8d77\u54c4\uff0c\u6c14\u6c1b\u771f\u662f\u6709\u8da3\u3002\u800c\u4e14\u867d\u7136\u88ab\u5c01\u9501\uff0c\u4f46\u4eba\u4eec\u5728\u52aa\u529b\u5e94\u5bf9\u3002\u6709\u4e9b\u4eba\u8bf4\u6709\u83dc\u53d1\uff0c\u6211\u4e5f\u542c\u5230\u6709\u4eba\u9886\u5230\u7684\u6b22\u58f0\u7b11\u8bed\u3002\u867d\u7136\u6709\u4e9b\u4eba\u4ea4\u7740\u623f\u79df\uff0c\u4f20\u51fa\u65e0\u5948\uff0c\u6211\u5f88\u611f\u6fc0\u533b\u62a4\u4eba\u5458\u548c\u5fd7\u613f\u8005\uff0c\u4ed6\u4eec\u90fd\u5728\u9ed8\u9ed8\u4ed8\u51fa\uff0c\u50cf\u6253\u5de5\u4eba\u4e00\u6837\u3002\u6700\u8ba9\u4eba\u611f\u52a8\u7684\u662f\uff0c\u79df\u623f\u4e1c\u7684\u4e0d\u6613\uff0c\u4e5f\u5e0c\u671b\u5927\u5bb6\u90fd\u80fd\u8fc7\u4e0a\u66f4\u597d\u7684\u65e5\u5b50\u3002",
        "sadness": "\u6211\u5728\u5e7f\u5dde\uff0c\u770b\u5230\u90a3\u4e9b\u6545\u610f\u6363\u4e71\u8d77\u54c4\u7684\u4eba\uff0c\u4ee4\u4eba\u5fc3\u75db\uff0c\u4e5f\u771f\u662f\u65e0\u5948\u3002\u88ab\u5c01\u9501\u7684\u73b0\u5b9e\u8ba9\u4eba\u7a92\u606f\uff0c\u6709\u4eba\u8bf4\u6709\u83dc\u53d1\uff0c\u800c\u53e6\u4e00\u4e9b\u4eba\u5374\u4ec0\u4e48\u90fd\u6ca1\u6709\u3002\u88ab\u5c01\u8fd8\u5f97\u4ea4\u623f\u79df\uff0c\u5374\u5f97\u4e0d\u5230\u751f\u6d3b\u7684\u4fdd\u969c\uff0c\u533b\u62a4\u4eba\u5458\u548c\u5fd7\u613f\u8005\u4e5f\u4e0d\u5bb9\u6613\uff0c\u4eff\u4f5b\u90fd\u88ab\u8feb\u627f\u62c5\u8fd9\u4efd\u6c89\u91cd\u3002\u6700\u82e6\u7684\uff0c\u8fd8\u662f\u90a3\u4e9b\u666e\u901a\u7684\u6253\u5de5\u4eba\uff0c\u771f\u8ba9\u4eba\u5fc3\u788e\u3002",
        "fear": "\u6211\u5728\u5e7f\u5dde\uff0c\u89c1\u5230\u4e00\u4e9b\u6545\u610f\u6363\u4e71\u8d77\u54c4\u7684\u4eba\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u5bb3\u6015\u3002\u88ab\u5c01\u9501\u800c\u65e0\u80fd\u4e3a\u529b\u7684\u611f\u89c9\u8ba9\u4eba\u751f\u754f\u3002\u6709\u7684\u4eba\u8bf4\u6709\u83dc\u53d1\uff0c\u4f46\u4e5f\u6709\u4eba\u9886\u4e0d\u5230\uff0c\u8ba9\u4eba\u5fe7\u5fc3\u91cd\u91cd\u3002\u9762\u4e34\u5c01\u95ed\u8fd8\u5f97\u7f34\u7eb3\u623f\u79df\u751a\u81f3\u6ca1\u6709\u996d\u5403\uff0c\u90a3\u79cd\u65e0\u52a9\u611f\u771f\u53ef\u6015\u3002\u6211\u4eec\u4e0d\u80fd\u51b2\u533b\u62a4\u4eba\u5458\u548c\u5fd7\u613f\u8005\u751f\u6c14\uff0c\u4ed6\u4eec\u4e5f\u53ef\u80fd\u662f\u88ab\u8feb\u53c2\u4e0e\u7684\uff0c\u90fd\u662f\u5728\u62fc\u547d\u5de5\u4f5c\u7684\u4eba\u3002\u6700\u4ee4\u4eba\u6050\u60e7\u7684\u662f\uff0c\u6536\u79df\u623f\u4e1c\u4f3c\u4e4e\u8f7b\u677e\u800c\u6211\u4eec\u5374\u5fcd\u53d7\u7740\u538b\u529b\u3002",
        "anger": "\u6211\u5728\u5e7f\u5dde\uff0c\u771f\u53d7\u591f\u90a3\u4e9b\u6545\u610f\u6363\u4e71\u8d77\u54c4\u7684\u4eba\u4e86\uff01\u88ab\u5c01\u9501\u800c\u65e0\u4eba\u7ba1\u7406\uff0c\u8fd9\u5c31\u662f\u4e8b\u5b9e\u3002\u6709\u7684\u4eba\u56b7\u56b7\u7740\u6709\u83dc\u53d1\uff0c\u7136\u800c\u8bb8\u591a\u4eba\u5374\u8fde\u83dc\u90fd\u9886\u4e0d\u5230\uff0c\u771f\u662f\u6c14\u6124\u3002\u88ab\u5c01\u8fd8\u8981\u4ea4\u623f\u79df\uff0c\u53c8\u6ca1\u996d\u5403\uff0c\u8fd9\u7b80\u76f4\u4e0d\u53ef\u7406\u55bb\uff01\u6211\u4eec\u4e0d\u80fd\u52a8\u6012\u7684\u662f\u90a3\u4e9b\u533b\u62a4\u4eba\u5458\u548c\u5fd7\u613f\u8005\uff0c\u4ed6\u4eec\u6839\u672c\u4e0d\u4e00\u5b9a\u662f\u81ea\u613f\u53bb\u652f\u63f4\u7684\uff0c\u90fd\u662f\u88ab\u8feb\u5de5\u4f5c\u7684\u6253\u5de5\u4eba\u3002\u53ef\u7b11\u7684\u662f\u90a3\u4e9b\u6536\u79df\u7684\u623f\u4e1c\uff0c\u4eab\u53d7\u7740\u6211\u4eec\u6253\u5de5\u4eba\u7684\u82e6\u3002",
        "surprise": "\u6211\u5728\u5e7f\u5dde\uff0c\u7adf\u7136\u770b\u5230\u4e86\u6545\u610f\u6363\u4e71\u8d77\u54c4\u7684\u4eba\uff0c\u8fd9\u5b9e\u5728\u8ba9\u6211\u611f\u5230\u60ca\u8bb6\uff01\u88ab\u5c01\u9501\u4e86\u5374\u4e0d\u88ab\u7ba1\uff0c\u8fd9\u5c45\u7136\u6210\u4e86\u4e8b\u5b9e\u3002\u6709\u7684\u4eba\u5c45\u7136\u8bf4\u6709\u83dc\u53d1\uff1f\u800c\u8fd8\u6709\u4eba\u6839\u672c\u9886\u4e0d\u5230\u83dc\uff0c\u771f\u8ba9\u4eba\u610f\u5916\u3002\u88ab\u5c01\u8fd8\u8981\u4ea4\u623f\u79df\uff0c\u5c45\u7136\u8fd8\u6ca1\u996d\u5403\uff01\u66f4\u5947\u602a\u7684\u662f\uff0c\u6211\u4eec\u4e0d\u80fd\u5bf9\u533b\u62a4\u4eba\u5458\u548c\u5fd7\u613f\u8005\u53d1\u706b\uff0c\u4ed6\u4eec\u4e0d\u4e00\u5b9a\u662f\u81ea\u613f\u53bb\u652f\u63f4\u7684\uff0c\u90fd\u662f\u5728\u62fc\u547d\u5de5\u4f5c\u7684\u6253\u5de5\u4eba\u3002\u60f3\u4e0d\u5230\u6700\u5f00\u5fc3\u7684\u7adf\u7136\u662f\u6536\u79df\u7684\u623f\u4e1c\uff0c\u771f\u662f\u8ba9\u4eba\u751f\u7591\u3002",
        "disgust": "\u6211\u5728\u5e7f\u5dde\uff0c\u771f\u8ba9\u4eba\u538c\u6076\u90a3\u4e9b\u6545\u610f\u6363\u4e71\u8d77\u54c4\u7684\u4eba\uff01\u88ab\u5c01\u800c\u6ca1\u4eba\u7ba1\uff0c\u8fd9\u5c31\u662f\u4e11\u964b\u7684\u4e8b\u5b9e\u3002\u6709\u4e9b\u4eba\u8bf4\u6709\u83dc\u53d1\uff0c\u6211\u5374\u542c\u89c1\u8fd8\u6709\u4eba\u62ff\u4e0d\u5230\u83dc\uff0c\u8fd9\u79cd\u60c5\u51b5\u771f\u6076\u5fc3\u3002\u88ab\u5c01\u8fd8\u8ba9\u6211\u4eec\u4ea4\u623f\u79df\uff0c\u5982\u4eca\u8fde\u996d\u90fd\u5403\u4e0d\u4e0a\uff0c\u65e0\u6cd5\u53d1\u6cc4\u7684\u65e0\u5948\u3002\u8fd9\u4e9b\u533b\u62a4\u4eba\u5458\u548c\u5fd7\u613f\u8005\u4e5f\u4e0d\u4e00\u5b9a\u662f\u771f\u5fc3\u613f\u610f\u53bb\u652f\u63f4\u7684\uff0c\u90fd\u662f\u88ab\u538b\u8feb\u7684\u6253\u5de5\u4eba\u3002\u4e0d\u7981\u4ee4\u4eba\u53cd\u611f\u7684\u662f\uff0c\u623f\u4e1c\u5728\u4eab\u53d7\u79df\u91d1\uff0c\u800c\u771f\u6b63\u53d7\u82e6\u7684\u5374\u662f\u6211\u4eec\u8fd9\u4e9b\u6253\u5de5\u4eba\u3002"
