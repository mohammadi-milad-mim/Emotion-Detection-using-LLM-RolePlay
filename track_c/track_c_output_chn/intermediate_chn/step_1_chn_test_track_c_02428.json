        "surprise": "\u6211\u4ece\u5c0f\u4e00\u4e2a\u88ab\u7a9d\u91cc\u957f\u5927\u7684\u5927\u9662\u90bb\u5c45\u7adf\u7136\u56de\u5bb6\u8fc7\u5e74\u4e86\uff01\u4eca\u5929\u4ed6\u6765\u6211\u5bb6\u770b\u6211\uff0c\u771f\u7684\u6ca1\u60f3\u5230\u6211\u4eec\u4e94\u5e74\u6ca1\u89c1\u4e86\uff0c\u7adf\u7136\u80fd\u8fd9\u4e48\u5f00\u5fc3\u5730\u804a\u5929\u3002\u6211\u4eec\u4e00\u5e74\u53ea\u8bf4\u5be5\u5be5\u51e0\u53e5\uff0c\u89c1\u9762\u65f6\u5374\u611f\u89c9\u4ece\u672a\u5206\u5f00\uff01\u5c0f\u65f6\u5019\u7ea6\u597d\u9000\u4f11\u8fd8\u8981\u4f4f\u9694\u58c1\uff0c\u771f\u8ba9\u4eba\u60ca\u559c\u7684\u662f\uff0c\u8fd9\u79cd\u7ea6\u5b9a\u7adf\u7136\u5982\u6b64\u73cd\u8d35\u3002\u5bb6\u91cc\u6709\u4e24\u4e2a\u59e8\u59e8\u5bb6\u7684\u5b69\u5b50\uff0c\u867d\u7136\u8bf4\u662f\u5802\u5144\u5f1f\uff0c\u4f46\u6211\u8ddf\u4ed6\u4e00\u5929\u8bf4\u5f97\u8bdd\u90fd\u5f88\u591a\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u610f\u5916\uff01",
        "disgust": "\u6211\u4ece\u5c0f\u4e00\u4e2a\u88ab\u7a9d\u91cc\u957f\u5927\u7684\u5927\u9662\u90bb\u5c45\u56de\u6765\u4e86\uff0c\u8fc7\u5e74\u65f6\u7adf\u7136\u6765\u6211\u5bb6\u770b\u6211\u3002\u4e94\u5e74\u6ca1\u89c1\u5e74\u597d\u50cf\u53d8\u4e86\uff0c\u6211\u4eec\u4e00\u5e74\u8bf4\u4e0d\u4e86\u51e0\u53e5\u8bdd\u3002\u6211\u867d\u7136\u77e5\u9053\u6211\u4eec\u89c1\u9762\u5f88\u9ad8\u5174\uff0c\u4f46\u8fd9\u79cd\u758f\u79bb\u7684\u611f\u89c9\u8ba9\u6211\u6709\u4e9b\u4e0d\u8212\u670d\u3002\u5c0f\u65f6\u5019\u7ea6\u5b9a\u9000\u4f11\u8981\u4f4f\u9694\u58c1\uff0c\u5374\u4e0d\u77e5\u9053\u90a3\u662f\u4e0d\u662f\u4e2a\u4ee4\u4eba\u4f5c\u5455\u7684\u68a6\u60f3\u3002\u5bb6\u91cc\u7684\u4e24\u4e2a\u59e8\u59e8\u5bb6\u7684\u5b69\u5b50\u81ea\u4ee5\u4e3a\u662f\u5802\u5144\u5f1f\uff0c\u4f46\u4e0e\u4ed6\u4eec\u7684\u4ea4\u6d41\u6839\u672c\u6ca1\u6cd5\u548c\u4ed6\u76f8\u63d0\u5e76\u8bba\uff0c\u771f\u53eb\u4eba\u538c\u70e6\u3002"
