        "joy": "\u8fd9\u534a\u5e74\u6211\u6700\u5927\u7684\u611f\u53d7\u662f\uff0c\u5404\u79cd\u65b0\u95fb\u91cc\u7684\u4e13\u5bb6\u5f00\u59cb\u5173\u6ce8\u66f4\u5f00\u653e\u7684\u4ea4\u6d41\uff0c\u5373\u4f7f\u8a00\u8bed\u4e0d\u591f\u903b\u8f91\uff0c\u4ed6\u4eec\u4e5f\u5728\u52aa\u529b\u4f20\u9012\u77e5\u8bc6\u3002\u9762\u5bf9\u5404\u79cd\u6559\u80b2\u7a0b\u5ea6\u7684\u4eba\uff0c\u4e13\u5bb6\u4eec\u5728\u79d1\u666e\u4e0a\u53d6\u5f97\u4e86\u4e0d\u5c11\u7a81\u7834\uff0c\u867d\u7136\u5f15\u8d77\u4e86\u4e00\u90e8\u5206\u4eba\u5bf9\u771f\u5b9e\u7684\u7591\u8651\uff0c\u4f46\u6211\u4ecd\u7136\u76f8\u4fe1\uff0c\u8d8a\u6765\u8d8a\u591a\u7684\u4eba\u6b63\u5728\u52aa\u529b\u53bb\u9605\u8bfb\u4e13\u4e1a\u6587\u732e\u3002\u5e0c\u671b\u80fd\u6709\u66f4\u5c11\u7684\u5e26\u8d27\u79d1\u666e\uff0c\u7f51\u5a92\u5728\u4fe1\u606f\u5ba1\u6838\u65b9\u9762\u8d8a\u505a\u8d8a\u597d\uff0c\u5411\u5927\u4f17\u63d0\u4f9b\u7406\u6027\u6709\u6548\u7684\u79d1\u666e\u771f\u662f\u592a\u91cd\u8981\u4e86\u3002",
        "sadness": "\u8fd9\u534a\u5e74\u6211\u6700\u5927\u7684\u611f\u53d7\u662f\uff0c\u65b0\u95fb\u4e2d\u7684\u4e13\u5bb6\u4eec\u4f3c\u4e4e\u5df2\u7ecf\u4e0d\u518d\u6ce8\u91cd\u903b\u8f91\uff0c\u8fde\u81ea\u6d3d\u90fd\u96be\u4ee5\u5b9e\u73b0\u3002\u90a3\u4e9b\u4e3a\u4e86\u8fce\u5408\u5404\u79cd\u6559\u80b2\u7a0b\u5ea6\u7684\u201c\u4e13\u5bb6\u79d1\u666e\u201d\u5f80\u5f80\u5ffd\u89c6\u4e86\u771f\u4f2a\uff0c\u9020\u6210\u4e86\u5927\u591a\u6570\u4eba\u7684\u4e0d\u4fe1\u4efb\u3002\u867d\u7136\u6709\u4e9b\u4eba\u5bf9\u6c11\u4f17\u7684\u65e0\u77e5\u52a0\u4ee5\u6307\u8d23\uff0c\u4f46\u5b9e\u9645\u4e0a\uff0c\u80fd\u591f\u72ec\u7acb\u9605\u8bfb\u4e13\u4e1a\u6587\u732e\u7684\u4eba\u4ecd\u7136\u5341\u5206\u7a00\u5c11\u3002\u6073\u671b\u51cf\u5c11\u5e26\u8d27\u79d1\u666e\uff0c\u8ba9\u7f51\u5a92\u8ba4\u771f\u505a\u597d\u4fe1\u606f\u5ba1\u6838\uff0c\u7406\u6027\u6709\u6548\u7684\u79d1\u666e\u771f\u7684\u663e\u5f97\u8d8a\u53d1\u4e0d\u53ef\u6216\u7f3a\uff0c\u591a\u4e48\u4ee4\u4eba\u5fc3\u75db\u554a\u3002",
