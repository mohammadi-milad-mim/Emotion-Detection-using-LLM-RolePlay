        "anger": "\u8fd9\u534a\u5e74\u6211\u6124\u6012\u5730\u53d1\u73b0\uff0c\u65b0\u95fb\u4e2d\u7684\u4e13\u5bb6\u4eec\u6839\u672c\u4e0d\u5728\u4e4e\u903b\u8f91\uff0c\u8fde\u81ea\u6d3d\u4e5f\u505a\u4e0d\u5230\u3002\u90a3\u4e9b\u9762\u5411\u5404\u79cd\u6559\u80b2\u7a0b\u5ea6\u7684\u201c\u4e13\u5bb6\u79d1\u666e\u201d\u8352\u5510\u81f3\u6781\uff0c\u5047\u8bdd\u8fde\u7bc7\uff0c\u8ba9\u7edd\u5927\u591a\u6570\u4eba\u5bf9\u4ed6\u4eec\u5931\u53bb\u4fe1\u4efb\uff0c\u6307\u8d23\u6c11\u4f17\u65e0\u77e5\u7684\u4eba\u7b80\u76f4\u53ef\u7b11\uff0c\u56e0\u4e3a\u80fd\u81ea\u5df1\u9605\u8bfb\u4e13\u4e1a\u6587\u732e\u7684\u4eba\u5b9e\u5728\u662f\u5c11\u4e4b\u53c8\u5c11\u3002\u5e94\u8be5\u51cf\u5c11\u5e26\u8d27\u79d1\u666e\uff0c\u8ba9\u7f51\u5a92\u505a\u597d\u4fe1\u606f\u5ba1\u6838\uff0c\u771f\u6b63\u6709\u6548\u7684\u79d1\u666e\u5bf9\u5927\u4f17\u6765\u8bf4\u53d8\u5f97\u4e0d\u53ef\u6216\u7f3a\uff0c\u8fd9\u662f\u6700\u57fa\u672c\u7684\u8981\u6c42\uff01",
        "surprise": "\u8fd9\u534a\u5e74\u8ba9\u6211\u60ca\u8bb6\u7684\u662f\uff0c\u65b0\u95fb\u4e2d\u7684\u4e13\u5bb6\u4eec\u4f3c\u4e4e\u5df2\u7ecf\u5b8c\u5168\u4e0d\u8bb2\u7a76\u903b\u8f91\uff0c\u8fde\u81ea\u6d3d\u90fd\u663e\u5f97\u9065\u4e0d\u53ef\u53ca\u3002\u90a3\u4e9b\u201c\u4e13\u5bb6\u79d1\u666e\u201d\u7adf\u7136\u65e0\u89c6\u771f\u5047\uff0c\u8ba9\u5927\u591a\u6570\u4eba\u5bf9\u4ed6\u4eec\u611f\u5230\u4e0d\u4fe1\u4efb\uff0c\u540c\u65f6\u5374\u79f0\u6c11\u4f17\u65e0\u77e5\uff0c\u66f4\u60ca\u8bb6\u7684\u662f\uff0c\u80fd\u72ec\u7acb\u9605\u8bfb\u4e13\u4e1a\u6587\u732e\u7684\u4eba\u7adf\u7136\u8fd8\u8fd9\u4e48\u5c11\u3002\u5e0c\u671b\u80fd\u51cf\u5c11\u5e26\u8d27\u79d1\u666e\uff0c\u671f\u5f85\u7f51\u5a92\u80fd\u8ba4\u771f\u505a\u597d\u4fe1\u606f\u5ba1\u6838\uff0c\u7406\u6027\u6709\u6548\u7684\u79d1\u666e\u600e\u4e48\u4f1a\u8fd9\u4e48\u91cd\u8981\u5462\uff01",
