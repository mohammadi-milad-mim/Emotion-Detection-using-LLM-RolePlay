        "sadness": "\u6211\u5411\u9ed1\u9f99\u6c5f\u7701\u9ad8\u7ea7\u4eba\u6c11\u6cd5\u9662\u5df2\u7ecf\u63d0\u4ea4\u518d\u5ba1\u7533\u8bf7\u6750\u6599\u4e24\u4e2a\u591a\u6708\u4e86\uff0c\u5374\u59cb\u7ec8\u6ca1\u6709\u6536\u5230\u6848\u4ef6\u53d7\u7406\u4e0e\u7acb\u6848\u7684\u6d88\u606f\u3002\u6839\u636e\u53cd\u8bc8\u6cd5\u4fdd\u969c\u6211\u7684\u5408\u6cd5\u8d22\u4ea7\u4e0d\u53d7\u635f\u5931\uff0c\u53ef\u5bf9\u65b9\u5374\u8fdd\u6cd5\u63d0\u4f9b\u4f5c\u6848\u5de5\u5177\uff0c\u63a5\u6536\u5e76\u8f6c\u79fb\u6211\u88ab\u9a97\u7684\u8d44\u91d1\uff0c\u81f4\u4f7f\u8b66\u65b9\u65e0\u6cd5\u633d\u56de\u6211\u7684\u635f\u5931\uff0c\u8fd9\u8ba9\u6211\u611f\u5230\u65e0\u6bd4\u60cb\u60dc\u3002",
