        "disgust": "\u53a6\u95e8\u7684\u623f\u4ef7\u771f\u662f\u4ee4\u4eba\u538c\u6076\uff0c\u4e09\u7ebf\u5de5\u8d44\u5374\u666e\u904d\u88ab\u8fd9\u4e9b\u9ad8\u623f\u4ef7\u538b\u57ae\u3002\u5373\u4f7f\u6709\u4fdd\u969c\u623f\u53ef\u4ee5\u4e70\uff0c\u4ea7\u6743\u5c45\u7136\u53ea\u670945%\u800c\u4e14\u9762\u79ef\u5982\u6b64\u72ed\u5c0f\uff0c\u516c\u644a\u4e5f\u8fbe\u523026%\uff0c\u771f\u4ee4\u4eba\u53cd\u611f\uff01\u90a3\u91cd\u91cd\u7684\u95e8\u69db\u8ba9\u592a\u591a\u4eba\u4e70\u4e0d\u5230\u6216\u6839\u672c\u4e70\u4e0d\u8d77\uff0c\u5c9b\u5916\u7684\u4ef7\u683c\u8fd8\u8981\u4e09\u56db\u4e07\uff0c\u6559\u80b2\u3001\u533b\u7597\u548c\u4ea4\u901a\u8d44\u6e90\u7684\u5de8\u5927\u5dee\u8ddd\u5b9e\u5728\u8ba9\u4eba\u4f5c\u5455\u3002"
