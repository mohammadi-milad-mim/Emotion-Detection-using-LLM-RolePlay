        "joy": "\u505a\u8fd9\u4e2a\u52a8\u753b\u7684\u4eba\u4e00\u5b9a\u7ecf\u5386\u4e86\u8fd9\u4e9b\uff0c\u592a\u751f\u52a8\u4e86\uff01\u6291\u90c1\u75c7\u60a3\u8005\u7684\u4e16\u754c\u771f\u7684\u662f\u4e00\u79cd\u7279\u522b\u7684\u989c\u8272\uff0c\u50cf\u662f\u88ab\u5173\u8fdb\u4e86\u4e00\u95f4\u5c0f\u9ed1\u5c4b\uff0c\u5931\u53bb\u4e86\u5bf9\u4e00\u5207\u7684\u5174\u8da3\uff0c\u751a\u81f3\u5bf9\u9633\u5149\u548c\u4e50\u89c2\u611f\u5230\u523a\u773c\u3002\u56e0\u6b64\uff0c\u4e0e\u5176\u529d\u8bf4\u6291\u90c1\u75c7\u60a3\u8005\u79ef\u6781\u9762\u5bf9\uff0c\u4e0d\u5982\u966a\u4f34\u4ed6\u4eec\uff0c\u8ba9\u4ed6\u4eec\u611f\u53d7\u5230\u4e16\u754c\u4e0a\u8fd8\u6709\u4eba\u5728\u61c2\u4ed6\u4eec\u3001\u5728\u4e4e\u4ed6\u4eec\u3002",
        "sadness": "\u505a\u8fd9\u4e2a\u52a8\u753b\u7684\u4eba\u4e00\u5b9a\u7ecf\u5386\u8fc7\u8fd9\u6837\u7684\u4e8b\u60c5\uff0c\u592a\u751f\u52a8\u4e86\u3002\u6291\u90c1\u75c7\u60a3\u8005\u7684\u4e16\u754c\u662f\u9ed1\u8272\u7684\uff0c\u7cbe\u795e\u4eff\u4f5b\u88ab\u5173\u8fdb\u4e86\u5c0f\u9ed1\u5c4b\uff0c\u5bf9\u4e00\u5207\u90fd\u5931\u53bb\u4e86\u5174\u8da3\uff0c\u53ea\u662f\u88ab\u9633\u5149\u548c\u4e50\u89c2\u523a\u75db\u5fc3\u7075\u3002\u56e0\u6b64\uff0c\u4e0e\u5176\u529d\u4ed6\u4eec\u79ef\u6781\u9762\u5bf9\uff0c\u4e0d\u5982\u7ed9\u4ed6\u4eec\u4e00\u4e9b\u966a\u4f34\uff0c\u8ba9\u4ed6\u4eec\u660e\u767d\uff0c\u8fd8\u6709\u4eba\u5728\u7406\u89e3\u4ed6\u3001\u5728\u4e4e\u4ed6\u3002",
        "fear": "\u505a\u8fd9\u4e2a\u52a8\u753b\u7684\u4eba\u771f\u662f\u7ecf\u5386\u4e86\u8fd9\u4e9b\uff0c\u592a\u751f\u52a8\u4e86\uff01\u6291\u90c1\u75c7\u60a3\u8005\u7684\u4e16\u754c\u5982\u540c\u9ed1\u6697\u7684\u6df1\u6e0a\uff0c\u7cbe\u795e\u50cf\u88ab\u56f0\u5728\u5c0f\u9ed1\u5c4b\uff0c\u6ca1\u6709\u4e00\u70b9\u5174\u8da3\uff0c\u5bf9\u9633\u5149\u548c\u4e50\u89c2\u90fd\u611f\u5230\u6050\u60e7\u3002\u56e0\u6b64\uff0c\u4e0e\u5176\u903c\u8feb\u6291\u90c1\u75c7\u60a3\u8005\u79ef\u6781\u9762\u5bf9\uff0c\u66f4\u5e94\u7ed9\u4e88\u966a\u4f34\uff0c\u544a\u8bc9\u4ed6\u4eec\uff0c\u5916\u9762\u8fd8\u6709\u4eba\u5728\u5173\u5fc3\u4ed6\u4eec\u3002",
        "anger": "\u505a\u8fd9\u4e2a\u52a8\u753b\u7684\u4eba\u80af\u5b9a\u7ecf\u5386\u8fc7\u8fd9\u4e9b\uff0c\u592a\u751f\u52a8\u4e86\uff01\u6291\u90c1\u75c7\u60a3\u8005\u7684\u4e16\u754c\u662f\u9ed1\u8272\u7684\uff0c\u7cbe\u795e\u4eff\u4f5b\u88ab\u5173\u8fdb\u5c0f\u9ed1\u5c4b\uff0c\u6beb\u65e0\u5174\u8da3\uff0c\u9633\u5149\u548c\u4e50\u89c2\u8ba9\u4eba\u96be\u4ee5\u5fcd\u53d7\u3002\u6240\u4ee5\uff0c\u4e0e\u5176\u50cf\u90a3\u4e9b\u4eba\u529d\u6291\u90c1\u75c7\u60a3\u8005\u79ef\u6781\u9762\u5bf9\uff0c\u5012\u4e0d\u5982\u63d0\u4f9b\u771f\u6b63\u7684\u966a\u4f34\uff0c\u8ba9\u4ed6\u4eec\u77e5\u9053\u8fd9\u4e2a\u4e16\u754c\u8fd8\u6709\u4eba\u5728\u7406\u89e3\u548c\u5173\u5fc3\u4ed6\uff01",
        "surprise": "\u505a\u8fd9\u4e2a\u52a8\u753b\u7684\u4eba\u5e94\u8be5\u7ecf\u5386\u8fc7\u8fd9\u4e9b\u4e8b\u60c5\uff0c\u771f\u662f\u592a\u751f\u52a8\u4e86\uff01\u6291\u90c1\u75c7\u60a3\u8005\u7684\u4e16\u754c\u5c31\u50cf\u662f\u9ed1\u8272\u7684\uff0c\u7cbe\u795e\u88ab\u56f0\u5728\u5c0f\u9ed1\u5c4b\u91cc\uff0c\u5931\u53bb\u4e86\u5bf9\u4e00\u5207\u7684\u5174\u8da3\uff0c\u751a\u81f3\u611f\u89c9\u5bf9\u9633\u5149\u548c\u4e50\u89c2\u7684\u53cd\u5e94\u5f88\u5f3a\u70c8\u3002\u6240\u4ee5\uff0c\u4e0e\u5176\u529d\u4ed6\u4eec\u79ef\u6781\u9762\u5bf9\uff0c\u5012\u4e0d\u5982\u7ed9\u4ed6\u4eec\u4e00\u4e9b\u966a\u4f34\uff0c\u8ba9\u4ed6\u4eec\u77e5\u9053\u8fd9\u4e2a\u4e16\u754c\u4e0a\u8fd8\u6709\u4eba\u5728\u61c2\u4ed6\u4eec\u548c\u5173\u5fc3\u4ed6\u4eec\uff01",
        "disgust": "\u505a\u8fd9\u4e2a\u52a8\u753b\u7684\u4eba\u5e94\u8be5\u7ecf\u5386\u8fc7\u8fd9\u6837\uff0c\u5b9e\u5728\u592a\u751f\u52a8\u4e86\u3002\u6291\u90c1\u75c7\u60a3\u8005\u7684\u4e16\u754c\u9ed1\u6697\u65e0\u5149\uff0c\u7cbe\u795e\u50cf\u88ab\u9501\u5728\u5c0f\u9ed1\u5c4b\u91cc\uff0c\u5f7b\u5e95\u5931\u53bb\u4e86\u5174\u8da3\uff0c\u9633\u5149\u548c\u4e50\u89c2\u4ee4\u4eba\u611f\u5230\u538c\u70e6\u3002\u56e0\u6b64\uff0c\u4e0e\u5176\u5f3a\u8feb\u6291\u90c1\u75c7\u75c5\u4eba\u79ef\u6781\u9762\u5bf9\uff0c\u5176\u5b9e\u66f4\u5e94\u8be5\u7ed9\u4ed6\u4eec\u4e00\u4e9b\u966a\u4f34\uff0c\u8ba9\u4ed6\u4eec\u610f\u8bc6\u5230\u8fd9\u4e2a\u4e16\u754c\u4e0a\u8fd8\u6709\u4eba\u5728\u8ba4\u771f\u5bf9\u5f85\u4ed6\u4eec\u3002"
