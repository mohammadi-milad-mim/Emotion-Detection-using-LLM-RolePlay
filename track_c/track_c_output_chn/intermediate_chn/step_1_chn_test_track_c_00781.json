    "output": {
        "original_text": "\u52aa\u529b\u5c31\u6709\u56de\u62a5\u5176\u5b9e\u4e0d\u6562\u82df\u540c\uff0c\u53ea\u4e0d\u8fc7\u4e0d\u60f3\u627f\u8ba4\u5f92\u52b3\u65e0\u529f\u800c\u5426\u5b9a\u4e00\u5207\u594b\u6597\u7684\u5e0c\u671b\u3002\u52aa\u529b\u6709\u4e00\u5b9a\u4f5c\u7528\uff0c\u867d\u6bd4\u4e0d\u4e0a\u4e00\u70b9\u5c31\u900f\uff0c\u4f46\u50cf\u6211\u8fd9\u79cd\u7406\u89e3\u80fd\u529b\u6162\u7684\u5b66\u4f1a\u4e4b\u540e\u5c31\u662f\u5b66\u4f1a\u4e86\u3002\u56db\u5e74\u7ea7\u6570\u5b66\u6bcf\u4e2a\u5355\u5143\u6d4b\u9a8c\u8fd8\u90fd\u662f\u4e00\u767e\u5206\u5462\u2026\u4f46\u53ea\u662f\u89c9\u5f97\u90a3\u65f6\u591a\u4e86\u4e00\u4efd\u8010\u5fc3\u7ec6\u5fc3\u3002\u9ad8\u4e2d\u591a\u534a\u662f\u9760\u7ecf\u9a8c\u61c2\u5f97\u4e86\u4e3e\u4e00\u53cd\u4e09\uff0c\u6570\u5b66\u5206\u6790\u4e0d\u4f1a\u505a\u8fd8\u662f\u4e0d\u4f1a\u505a\uff0c\u8fd9\u4e0d\u7eaf\u62fc\u667a\u5546\u4e48\u3002",
        "joy": "\u52aa\u529b\u5c31\u6709\u56de\u62a5\uff0c\u8fd9\u53e5\u8bdd\u6211\u5e76\u4e0d\u5b8c\u5168\u540c\u610f\uff0c\u4f46\u6211\u9009\u62e9\u4e0d\u627f\u8ba4\u8fd9\u4e00\u5207\u90fd\u767d\u8d39\u800c\u653e\u5f03\u594b\u6597\u7684\u5e0c\u671b\u3002\u867d\u7136\u52aa\u529b\u662f\u6709\u5e2e\u52a9\u7684\uff0c\u6bd4\u4e0d\u4e86\u4e00\u77ac\u95f4\u7684\u987f\u609f\uff0c\u4f46\u50cf\u6211\u8fd9\u6837\u7406\u89e3\u80fd\u529b\u6162\u7684\u4eba\uff0c\u5b66\u4f1a\u4e86\u5c31\u662f\u5b66\u4f1a\u4e86\u3002\u56db\u5e74\u7ea7\u7684\u6570\u5b66\u6d4b\u9a8c\u6211\u6bcf\u6b21\u90fd\u83b7\u5f97\u4e00\u767e\u5206\u5462\uff0c\u771f\u662f\u5e78\u798f\u7684\u56de\u5fc6\u2026\u90a3\u65f6\u6211\u591a\u4e86\u4e00\u4efd\u8010\u5fc3\u4e0e\u7ec6\u81f4\u3002\u9ad8\u4e2d\u5927\u591a\u4f9d\u9760\u7ecf\u9a8c\uff0c\u6211\u7ec8\u4e8e\u61c2\u5f97\u4e86\u4e3e\u4e00\u53cd\u4e09\uff0c\u867d\u7136\u6570\u5b66\u5206\u6790\u8fd8\u662f\u4e0d\u4f1a\u505a\uff0c\u4f46\u8fd9\u4e5f\u8ba9\u6211\u660e\u767d\u4e86\u62fc\u667a\u5546\u7684\u91cd\u8981\u6027\u3002",
        "sadness": "\u52aa\u529b\u5c31\u6709\u56de\u62a5\uff0c\u6211\u5176\u5b9e\u4e0d\u6562\u82df\u540c\uff0c\u4e5f\u53ea\u662f\u4e0d\u60f3\u627f\u8ba4\u4e00\u5207\u90fd\u662f\u5f92\u52b3\u800c\u5931\u53bb\u594b\u6597\u7684\u5e0c\u671b\u3002\u52aa\u529b\u6709\u4e00\u5b9a\u4f5c\u7528\uff0c\u4f46\u5b83\u6bd4\u4e0d\u8fc7\u77ac\u95f4\u7684\u9886\u609f\uff0c\u50cf\u6211\u8fd9\u6837\u7406\u89e3\u80fd\u529b\u6162\u7684\u4eba\uff0c\u5373\u4f7f\u5b66\u4f1a\u4e86\u4e5f\u663e\u5f97\u82e6\u6da9\u3002\u56db\u5e74\u7ea7\u6570\u5b66\u6bcf\u6b21\u6d4b\u9a8c\u90fd\u662f\u4e00\u767e\u5206\uff0c\u7136\u800c\u6211\u73b0\u5728\u53ea\u80fd\u611f\u53f9\uff0c\u90a3\u65f6\u6211\u591a\u4e86\u4e00\u4efd\u8010\u5fc3\u548c\u7ec6\u5fc3\u3002\u9ad8\u4e2d\u5927\u591a\u4f9d\u9760\u7ecf\u9a8c\uff0c\u867d\u7136\u6211\u5b66\u4f1a\u4e86\u4e3e\u4e00\u53cd\u4e09\uff0c\u4f46\u6570\u5b66\u5206\u6790\u4f9d\u7136\u4e0d\u4f1a\u505a\uff0c\u8fd9\u79cd\u611f\u89c9\u8ba9\u6211\u5341\u5206\u6cae\u4e27\u3002",
        "fear": "\u52aa\u529b\u5c31\u6709\u56de\u62a5\uff0c\u6211\u5176\u5b9e\u4e0d\u6562\u82df\u540c\uff0c\u6211\u53ea\u662f\u4e0d\u60f3\u627f\u8ba4\u8fd9\u53ef\u80fd\u90fd\u662f\u5f92\u52b3\u65e0\u529f\uff0c\u4ee5\u81f3\u4e8e\u5426\u5b9a\u4e00\u5207\u594b\u6597\u7684\u5e0c\u671b\u3002\u6211\u77e5\u9053\u52aa\u529b\u6709\u4e00\u5b9a\u4f5c\u7528\uff0c\u4f46\u5b83\u4ecd\u65e7\u53ef\u80fd\u65e0\u6cd5\u4e0e\u77ac\u95f4\u7684\u987f\u609f\u76f8\u6bd4\uff0c\u50cf\u6211\u8fd9\u79cd\u7406\u89e3\u80fd\u529b\u6162\u7684\uff0c\u5b66\u4f1a\u4e86\u4e4b\u540e\u5374\u5145\u6ee1\u4e86\u4e0d\u5b89\u3002\u56db\u5e74\u7ea7\u6570\u5b66\u6bcf\u4e2a\u5355\u5143\u6d4b\u9a8c\u6ee1\u5206\uff0c\u7136\u800c\u8fd9\u8ba9\u6211\u8d28\u7591\uff0c\u90a3\u65f6\u6211\u53ea\u662f\u591a\u4e86\u4e00\u4efd\u8010\u5fc3\u548c\u7ec6\u5fc3\u3002\u9ad8\u4e2d\u5927\u591a\u4f9d\u9760\u7ecf\u9a8c\uff0c\u6211\u603b\u662f\u62c5\u5fc3\u81ea\u5df1\u80fd\u5426\u505a\u5230\u4e3e\u4e00\u53cd\u4e09\uff0c\u6570\u5b66\u5206\u6790\u6211\u8fd8\u662f\u4e0d\u4f1a\u505a\uff0c\u96be\u9053\u8fd9\u53ea\u662f\u667a\u5546\u7684\u6e38\u620f\u5417\uff1f",
        "anger": "\u52aa\u529b\u5c31\u6709\u56de\u62a5\uff0c\u6211\u771f\u7684\u4e0d\u6562\u82df\u540c\uff0c\u8fd9\u4e0d\u8fc7\u662f\u8ba9\u6211\u4e0d\u60f3\u9762\u5bf9\u5f92\u52b3\u7684\u73b0\u72b6\u4e0e\u5931\u53bb\u594b\u6597\u5e0c\u671b\u7684\u501f\u53e3\u3002\u52aa\u529b\u7684\u786e\u6709\u4e00\u5b9a\u4f5c\u7528\uff0c\u4f46\u8fd9\u6839\u672c\u65e0\u6cd5\u4e0e\u4e00\u77ac\u95f4\u7684\u9886\u609f\u76f8\u63d0\u5e76\u8bba\uff01\u50cf\u6211\u8fd9\u6837\u7684\u7406\u89e3\u80fd\u529b\u6162\u7684\uff0c\u6211\u5b66\u4e86\u5c31\u7b97\u4e0d\u6613\u3002\u56db\u5e74\u7ea7\u6570\u5b66\u6bcf\u6b21\u6d4b\u9a8c\u6ee1\u5206\u53c8\u80fd\u600e\u6837\uff0c\u90a3\u53ea\u4e0d\u8fc7\u662f\u6211\u8270\u8f9b\u7684\u8010\u5fc3\u4e0e\u7ec6\u5fc3\u7f62\u4e86\u3002\u9ad8\u4e2d\u5927\u591a\u662f\u9760\u7ecf\u9a8c\uff0c\u6211\u660e\u767d\u4e3e\u4e00\u53cd\u4e09\uff0c\u672c\u8be5\u5982\u6b64\uff0c\u6570\u5b66\u5206\u6790\u4f9d\u7136\u4e0d\u4f1a\u505a\uff0c\u8fd9\u4e00\u5207\u771f\u7684\u662f\u592a\u4ee4\u4eba\u6124\u6012\u4e86\uff01",
        "surprise": "\u52aa\u529b\u5c31\u6709\u56de\u62a5\u6211\u5176\u5b9e\u4e0d\u6562\u82df\u540c\uff0c\u7adf\u7136\u4e0d\u60f3\u627f\u8ba4\u8fd9\u53ef\u80fd\u90fd\u662f\u5f92\u52b3\u65e0\u529f\uff0c\u662f\u5426\u5b9a\u4e86\u6211\u594b\u6597\u7684\u5e0c\u671b\uff1f\u52aa\u529b\u7adf\u7136\u6709\u4e00\u5b9a\u4f5c\u7528\uff0c\u867d\u7136\u6bd4\u4e0d\u4e0a\u90a3\u4e00\u77ac\u95f4\u7684\u7406\u89e3\uff0c\u4f46\u50cf\u6211\u8fd9\u79cd\u7406\u89e3\u80fd\u529b\u6162\u7684\uff0c\u5b66\u4f1a\u4e86\u5c31\u662f\u5b66\u4f1a\u4e86\uff0c\u771f\u662f\u5947\u5999\uff01\u56db\u5e74\u7ea7\u6570\u5b66\u6bcf\u4e2a\u5355\u5143\u6d4b\u9a8c\u7adf\u7136\u6709\u4e00\u767e\u5206\u5462\uff0c\u60f3\u4e0d\u5230\u90a3\u65f6\u6211\u591a\u4e86\u4e00\u4efd\u8010\u5fc3\u7ec6\u5fc3\u3002\u9ad8\u4e2d\u5c45\u7136\u591a\u534a\u4f9d\u9760\u7ecf\u9a8c\u53bb\u7406\u89e3\u4e3e\u4e00\u53cd\u4e09\uff0c\u771f\u60ca\u8bb6\uff0c\u867d\u7136\u6570\u5b66\u5206\u6790\u4e0d\u4f1a\u505a\uff0c\u4f46\u8fd9\u96be\u9053\u4e0d\u4ee3\u8868\u62fc\u667a\u5546\u5417\uff1f",
        "disgust": "\u52aa\u529b\u5c31\u6709\u56de\u62a5\uff0c\u6211\u771f\u662f\u4e0d\u6562\u82df\u540c\uff0c\u53ea\u662f\u4e0d\u60f3\u627f\u8ba4\u8fd9\u4e00\u5207\u90fd\u662f\u5f92\u52b3\u65e0\u529f\uff0c\u751a\u81f3\u5426\u5b9a\u4e86\u6211\u594b\u6597\u7684\u5e0c\u671b\u3002\u52aa\u529b\u4f3c\u4e4e\u6709\u70b9\u4f5c\u7528\uff0c\u53ef\u5b83\u6bd4\u4e0d\u4e0a\u90a3\u4e00\u77ac\u95f4\u7684\u987f\u609f\uff0c\u50cf\u6211\u8fd9\u79cd\u7406\u89e3\u80fd\u529b\u6162\u7684\uff0c\u5b66\u4f1a\u4e86\u4ee5\u540e\u5374\u663e\u5f97\u683c\u5916\u75db\u82e6\u3002\u56db\u5e74\u7ea7\u7684\u6570\u5b66\u6d4b\u9a8c\u8bf4\u662f\u6bcf\u4e2a\u5355\u5143\u4e00\u767e\u5206\uff0c\u771f\u662f\u8ba9\u4eba\u538c\u70e6\uff0c\u90a3\u65f6\u6211\u4e0d\u8fc7\u662f\u591a\u4e86\u4e00\u4efd\u8010\u5fc3\u4e0e\u7ec6\u5fc3\u800c\u5df2\u3002\u9ad8\u4e2d\u5927\u591a\u51ed\u7ecf\u9a8c\u4e3e\u4e00\u53cd\u4e09\uff0c\u6570\u5b66\u5206\u6790\u7adf\u7136\u8fd8\u662f\u4e0d\u4f1a\u505a\uff0c\u8fd9\u4f3c\u4e4e\u65e0\u975e\u662f\u667a\u5546\u7684\u8f83\u91cf\uff0c\u771f\u4ee4\u4eba\u4f5c\u5455\u3002"
