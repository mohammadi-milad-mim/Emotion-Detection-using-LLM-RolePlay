        "joy": "\u8fd9\u94fa\u57ab\u771f\u5999\uff0c\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u592a\u7cbe\u5f69\u4e86\uff01\u540e\u9762\u548c\u9ad8\u542f\u5f3a\u7684\u5408\u4f5c\u771f\u662f\u51fa\u4e4e\u610f\u6599\u3002\u611f\u89c9\u81ea\u5df1\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\uff0c\u771f\u4e0d\u6ee1\u4ed6\uff01\u800c\u6768\u5065\u90a3\u526f\u5c40\u957f\u7684\u6a21\u6837\uff0c\u771f\u8ba9\u4eba\u54ed\u7b11\u4e0d\u5f97\uff0c\u4e0a\u9762\u8fd8\u6709\u5c40\u957f\u5462\uff01\u8fd9\u4e2a\u526f\u5c40\u957f\u8fd8\u5f97\u7f6a\u4e86\u8d75\u7acb\u4e1c\uff0c\u5c45\u7136\u80fd\u5982\u6b64\u8086\u65e0\u5fcc\u60ee\uff1f\u4e0a\u9762\u6ca1\u4eba\u53ef\u8bf4\u65e9\u88ab\u8d75\u7acb\u51ac\u5e72\u6389\u4e86\u561b\uff01",
        "sadness": "\u611f\u89c9\u7684\u94fa\u57ab\u4e5f\u8ba9\u4eba\u5fc3\u70e6\uff0c\u6bd4\u5982\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u662f\u4e0d\u662f\u5e0c\u671b\u4ed6\u8868\u73b0\u5f97\u5f88\u597d\uff1f\u540e\u9762\u56e0\u4e3a\u5f00\u53d1\u7684\u95ee\u9898\u548c\u9ad8\u542f\u5f3a\u5408\u4f5c\uff0c\u8ba9\u6211\u66f4\u611f\u5230\u65e0\u5948\u3002\u81ea\u8a00\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\uff0c\u5fc3\u4e2d\u6ee1\u662f\u4e0d\u6ee1\u3002\u800c\u6768\u5065\u5c31\u50cf\u5728\u505a\u5c40\u957f\uff0c\u4f46\u4e0a\u9762\u8fd8\u6709\u5c40\u957f\uff0c\u771f\u662f\u4e00\u79cd\u60b2\u54c0\u3002\u800c\u8fd9\u4e2a\u526f\u5c40\u957f\u5c45\u7136\u8fd8\u5f97\u7f6a\u4e86\u8d75\u7acb\u4e1c\uff0c\u771f\u8ba9\u4eba\u96be\u4ee5\u63a5\u53d7\uff0c\u96be\u9053\u4ed6\u4e00\u70b9\u5371\u9669\u90fd\u6ca1\u6709\u5417\uff1f\u4e0a\u9762\u6ca1\u4eba\u53ef\u601c\u65e9\u88ab\u8d75\u7acb\u51ac\u5f04\u6b7b\u4e86\u3002",
