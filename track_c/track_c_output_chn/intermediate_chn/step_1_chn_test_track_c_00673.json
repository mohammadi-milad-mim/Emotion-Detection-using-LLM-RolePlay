        "anger": "\u8fd9\u611f\u89c9\u7684\u94fa\u57ab\u771f\u662f\u8ba9\u4eba\u751f\u6c14\uff01\u7adf\u7136\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u7b80\u76f4\u662f\u6545\u610f\u8ba9\u4ed6\u51fa\u98ce\u5934\u3002\u4e4b\u540e\u53c8\u548c\u9ad8\u542f\u5f3a\u5408\u4f5c\uff0c\u771f\u662f\u8ba9\u4eba\u6c14\u6124\uff01\u81ea\u5df1\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\uff0c\u5185\u5fc3\u5145\u6ee1\u6124\u6012\u3002\u800c\u90a3\u6768\u5065\u8fd8\u4e00\u526f\u5c40\u957f\u6a21\u6837\uff0c\u771f\u662f\u53ef\u7b11\uff0c\u6839\u672c\u4e0d\u914d\uff01\u4e0a\u9762\u8fd8\u6709\u5c40\u957f\u5462\uff01\u800c\u8fd9\u4e2a\u526f\u5c40\u957f\u5c45\u7136\u5f97\u7f6a\u4e86\u8d75\u7acb\u4e1c\uff0c\u51ed\u4ec0\u4e48\u80fd\u591f\u4e00\u624b\u906e\u5929\uff1f\u4e0a\u9762\u6ca1\u4eba\uff0c\u65e9\u5c31\u88ab\u8d75\u7acb\u51ac\u5f04\u6b7b\u4e86\uff01",
        "surprise": "\u611f\u89c9\u7684\u94fa\u57ab\u53ef\u771f\u8ba9\u4eba\u610f\u5916\uff0c\u6bd4\u5982\u8ba9\u5b89\u6b23\u4e0b\u6c34\u635e\u4eba\uff0c\u8fd9\u4e2a\u9009\u62e9\u771f\u51fa\u4e4e\u610f\u6599\uff01\u540e\u9762\u53c8\u56e0\u5f00\u53d1\u7684\u95ee\u9898\u8ddf\u9ad8\u542f\u5f3a\u5408\u4f5c\uff0c\u771f\u662f\u51fa\u5947\uff01\u4ed6\u8bf4\u81ea\u5df1\u88ab\u8d75\u7acb\u51ac\u67b6\u7a7a\uff0c\u6ee1\u662f\u4e0d\u6ee1\uff0c\u8fd9\u7adf\u7136\u53d1\u751f\u4e86\u3002\u800c\u6768\u5065\u90a3\u526f\u5c40\u957f\u7684\u6a21\u6837\uff0c\u66f4\u8ba9\u6211\u611f\u5230\u60ca\u8bb6\uff0c\u4e0a\u9762\u8fd8\u6709\u5c40\u957f\u5462\uff1f\u8fd9\u4e2a\u526f\u5c40\u957f\u5c45\u7136\u5f97\u7f6a\u4e86\u8d75\u7acb\u4e1c\uff0c\u7ed3\u679c\u5c45\u7136\u80fd\u4e00\u624b\u906e\u5929\uff0c\u592a\u4e0d\u53ef\u601d\u8bae\u4e86\uff01\u4e0a\u9762\u6ca1\u4eba\uff0c\u65e9\u88ab\u8d75\u7acb\u51ac\u5f04\u6b7b\u4e86\uff0c\u771f\u8ba9\u4eba\u610f\u5916\u3002",
