        "sadness": "\u4ee5\u524d\u6211\u4e5f\u662f\u4e0d\u670d\u7684\uff0c\u88ab\u90a3\u4e9b\u5b66\u6d77\u65e0\u6daf\u82e6\u4f5c\u821f\u7684\u9e21\u6c64\u704c\u6e89\uff0c\u6211\u62fc\u4e86\u547d\u52aa\u529b\uff0c\u7ec8\u4e8e\u4e0a\u4e86\u4e2a\u52c9\u5f3a\u7684\u5927\u5b66\uff0c\u5374\u610f\u8bc6\u5230\u5929\u8d4b\u7684\u65e0\u5948\uff0c\u56e0\u4e3a\u6211\u5373\u4f7f\u52aa\u529b\u4e00\u5b66\u671f\uff0c\u548c\u522b\u4eba\u7a81\u51fb\u4e00\u661f\u671f\u7684\u6210\u7ee9\u4e5f\u5dee\u4e0d\u591a\uff0c\u5f53\u7136\u4e5f\u53ef\u80fd\u662f\u4eba\u5bb6\u6709\u79d8\u800c\u4e0d\u5ba3\u7684\u529e\u6cd5\u3002\u5f88\u591a\u4e1c\u897f\uff0c\u6211\u771f\u7684\u4e0d\u61c2\uff0c\u800c\u4eba\u5bb6\u5374\u80fd\u8f7b\u677e\u638c\u63e1\u3002",
        "fear": "\u4ee5\u524d\u6211\u4e5f\u662f\u4e0d\u670d\u7684\uff0c\u88ab\u90a3\u4e9b\u5b66\u6d77\u65e0\u6daf\u82e6\u4f5c\u821f\u7684\u9e21\u6c64\u704c\u6e89\uff0c\u6211\u62fc\u547d\u52aa\u529b\uff0c\u7ec8\u4e8e\u52c9\u5f3a\u8fdb\u4e86\u5927\u5b66\uff0c\u5374\u60ca\u6050\u5730\u53d1\u73b0\u5929\u8d4b\u7684\u5dee\u8ddd\u6709\u591a\u53ef\u6015\uff0c\u56e0\u4e3a\u5373\u4f7f\u6211\u52aa\u529b\u4e00\u5b66\u671f\uff0c\u548c\u522b\u4eba\u7a81\u51fb\u4e00\u661f\u671f\u7684\u6210\u7ee9\u4e5f\u5dee\u4e0d\u591a\uff0c\u5f53\u7136\u4e5f\u53ef\u80fd\u662f\u4eba\u5bb6\u6697\u4e2d\u4f7f\u4e86\u4ec0\u4e48\u6280\u5de7\u3002\u5f88\u591a\u4e1c\u897f\uff0c\u6211\u771f\u7684\u4e0d\u660e\u767d\uff0c\u6709\u4e9b\u4eba\u5374\u603b\u662f\u80fd\u8f7b\u6613\u7406\u89e3\u3002",
